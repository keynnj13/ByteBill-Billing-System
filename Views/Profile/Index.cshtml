@model ByteBill_BS.Controllers.ProfileViewModel
@{
    ViewData["Title"] = "Profile Settings";
    var isSuperAdmin = Model.RoleName == "SuperAdmin";
}

<div class="page-header" style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px;">
    <div>
        <h1 class="page-title" style="font-size: 24px; font-weight: 700; color: var(--foreground); margin-bottom: 4px;">Profile Settings</h1>
        <p class="page-subtitle" style="font-size: 14px; color: var(--muted);">Manage your personal information</p>
    </div>
</div>

<div class="pf-grid">
    <!-- Profile Card (Left) -->
    <div class="card pf-card-main">
        <div class="pf-banner">
            <div class="pf-avatar">@Model.Initials</div>
            <h2 class="pf-name">@Model.FirstName @Model.LastName</h2>
            <span class="pf-role">@Model.RoleName</span>
        </div>
        <div class="pf-meta">
            <div class="pf-meta-row">
                <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                <span>@@@Model.UserName</span>
            </div>
            @if (!isSuperAdmin)
            {
                <div class="pf-meta-row">
                    <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                    <span>@Model.ShopName</span>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.Email))
            {
                <div class="pf-meta-row">
                    <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                    <span>@Model.Email</span>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.Phone))
            {
                <div class="pf-meta-row">
                    <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                    <span>@Model.Phone</span>
                </div>
            }
            <div class="pf-meta-row">
                <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                <span>Member since @Model.CreatedAt.ToString("MMM dd, yyyy")</span>
            </div>
        </div>
    </div>

    <!-- Edit Form (Right) -->
    <div class="card">
        <div class="card-body">
            <h3 style="font-size: 16px; font-weight: 600; color: var(--foreground); margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
                <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                Edit Profile
            </h3>
            <form method="post" asp-action="UpdateProfile" asp-controller="Profile">
                @Html.AntiForgeryToken()
                <div class="pf-form-row">
                    <div class="form-group">
                        <label class="form-label">First Name <span style="color: var(--destructive);">*</span></label>
                        <input type="text" name="FirstName" class="form-input" value="@Model.FirstName" maxlength="50" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Middle Name</label>
                        <input type="text" name="MiddleName" class="form-input" value="@Model.MiddleName" maxlength="50" />
                    </div>
                </div>
                <div class="pf-form-row">
                    <div class="form-group">
                        <label class="form-label">Last Name <span style="color: var(--destructive);">*</span></label>
                        <input type="text" name="LastName" class="form-input" value="@Model.LastName" maxlength="50" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Username</label>
                        <input type="text" class="form-input" value="@Model.UserName" disabled />
                        <span style="font-size: 12px; color: var(--muted); margin-top: 4px; display: block;">Username cannot be changed</span>
                    </div>
                </div>
                <div class="pf-form-row">
                    <div class="form-group">
                        <label class="form-label">Email</label>
                        <input type="email" name="Email" class="form-input" value="@Model.Email" maxlength="150" placeholder="your@email.com" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Phone</label>
                        <input type="tel" name="Phone" id="phoneInput" class="form-input" value="@Model.Phone" maxlength="11" inputmode="numeric" pattern="09[0-9]{9}" placeholder="09XXXXXXXXX" />
                        <span style="font-size: 12px; color: var(--muted); margin-top: 4px; display: block;">Format: 09XXXXXXXXX (11 digits)</span>
                    </div>
                </div>
                <div style="display: flex; justify-content: flex-end; gap: 8px; margin-top: 8px;">
                    <button type="submit" class="btn btn-primary">
                        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        Save Changes
                    </button>
                </div>
            </form>

            <!-- Change Password (Admin/SuperAdmin only) -->
            @{ var userRole = User.FindFirst("Role")?.Value ?? ""; }
            @if (userRole is "Admin" or "SuperAdmin")
            {
            <div style="border-top: 1px solid var(--gray-light); margin-top: 24px; padding-top: 24px;">
                <h3 style="font-size: 16px; font-weight: 600; color: var(--foreground); margin-bottom: 16px; display: flex; align-items: center; gap: 8px;">
                    <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                    Change Password
                </h3>
                <form method="post" asp-action="ChangePassword" asp-controller="Profile">
                    @Html.AntiForgeryToken()
                    <div class="form-group" style="margin-bottom: 12px;">
                        <label class="form-label">Current Password <span style="color: var(--destructive);">*</span></label>
                        <input type="password" name="CurrentPassword" class="form-input" required autocomplete="current-password" />
                    </div>
                    <div class="pf-form-row">
                        <div class="form-group">
                            <label class="form-label">New Password <span style="color: var(--destructive);">*</span></label>
                            <input type="password" name="NewPassword" class="form-input" required minlength="12" autocomplete="new-password" />
                            <span style="font-size: 12px; color: var(--muted); margin-top: 4px; display: block;">Min. 12 characters with upper, lower, number & special</span>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Confirm New Password <span style="color: var(--destructive);">*</span></label>
                            <input type="password" name="ConfirmNewPassword" class="form-input" required minlength="12" autocomplete="new-password" />
                        </div>
                    </div>
                    <div style="display: flex; justify-content: flex-end; gap: 8px; margin-top: 12px;">
                        <button type="submit" class="btn btn-outline-primary">
                            <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                            Change Password
                        </button>
                    </div>
                </form>
            </div>
            }
        </div>
    </div>
</div>

<style>
    .pf-grid { display: grid; grid-template-columns: 300px 1fr; gap: 24px; max-width: 960px; }
    .pf-card-main { padding: 0; overflow: hidden; }

    .pf-banner {
        background: linear-gradient(135deg, var(--navy), var(--navy-600, #2d4a7a));
        padding: 32px 24px;
        display: flex; flex-direction: column; align-items: center; text-align: center; gap: 12px;
    }
    .pf-avatar {
        width: 80px; height: 80px; border-radius: 50%;
        background: rgba(255,255,255,0.15); color: white;
        display: flex; align-items: center; justify-content: center;
        font-size: 28px; font-weight: 700;
        border: 3px solid rgba(255,255,255,0.25);
    }
    .pf-name { color: white; font-size: 18px; font-weight: 600; margin: 0; }
    .pf-role {
        display: inline-block; padding: 4px 14px; border-radius: 20px;
        background: rgba(46, 204, 113, 0.2); color: #6ee7b7;
        font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;
    }

    .pf-meta { padding: 20px 24px; }
    .pf-meta-row {
        display: flex; align-items: center; gap: 10px;
        padding: 10px 0; font-size: 14px;
        color: var(--foreground);
        border-bottom: 1px solid var(--gray-light);
    }
    .pf-meta-row:last-child { border-bottom: none; }
    .pf-meta-row svg { color: var(--muted); flex-shrink: 0; }

    .pf-form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    [data-theme="dark"] .pf-banner {
        background: linear-gradient(135deg, hsl(222, 24%, 14%), hsl(222, 24%, 20%));
    }

    .pf-alert { display: flex; align-items: center; gap: 10px; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; font-size: 14px; }
    .pf-alert-success { background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; }
    .pf-alert-danger { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }
    [data-theme="dark"] .pf-alert-success { background: hsl(145, 40%, 12%); color: hsl(145, 50%, 65%); border-color: hsl(145, 40%, 22%); }
    [data-theme="dark"] .pf-alert-danger { background: hsl(4, 40%, 14%); color: hsl(4, 60%, 70%); border-color: hsl(4, 40%, 22%); }

    @@media (max-width: 768px) {
        .pf-grid { grid-template-columns: 1fr; }
        .pf-form-row { grid-template-columns: 1fr; }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        var phoneInput = document.getElementById('phoneInput');
        if (phoneInput) {
            phoneInput.addEventListener('input', function() {
                this.value = this.value.replace(/[^0-9]/g, '').substring(0, 11);
            });
        }
    });
</script>
