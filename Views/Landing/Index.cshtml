    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  SCRIPTS                                                   -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <script>
        // ── Plan data for calculator ─────────────────────────────
        var planData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(p => new {
            p.PlanName,
            p.MonthlyPrice,
            p.YearlyPrice,
            p.PermanentPrice,
            p.MaxUsers,
            p.MaxCustomers,
            p.MaxJobOrdersPerMonth
        })));
        var activeCycle = 'Monthly';

        // ── Billing Cycle Toggle ─────────────────────────────────
        function switchBillingCycle(cycle) {
            document.querySelectorAll('.lp-toggle-btn').forEach(function(btn) {
                btn.classList.toggle('active', btn.dataset.cycle === cycle);
            });
            document.querySelectorAll('.lp-price-amount').forEach(function(el) {
                var price = parseFloat(el.dataset[cycle.toLowerCase()]);
                el.textContent = '\u20B1' + price.toLocaleString('en-PH', { maximumFractionDigits: 0 });
            });
            document.querySelectorAll('.lp-price-period').forEach(function(el) {
                el.textContent = el.dataset[cycle.toLowerCase()];
            });
            document.querySelectorAll('.lp-plan-cta').forEach(function(link) {
                var planId = link.dataset.planId;
                link.href = '@Url.Action("CreateAccount", "Register")' + '?planId=' + planId + '&cycle=' + cycle;
            });
            activeCycle = cycle;
            updateCalculator();
        }

        // ── FAQ Accordion ────────────────────────────────────────
        function toggleFaq(btn) {
            var item = btn.parentElement;
            var isOpen = item.classList.contains('open');
            document.querySelectorAll('.lp-faq-item').forEach(function(i) { i.classList.remove('open'); });
            if (!isOpen) item.classList.add('open');
        }

        // ── Pricing Calculator ───────────────────────────────────
        function updateCalculator() {
            var users = parseInt(document.getElementById('calcUsers').value);
            var customers = parseInt(document.getElementById('calcCustomers').value);
            var jobs = parseInt(document.getElementById('calcJobs').value);

            document.getElementById('calcUsersLabel').textContent = users;
            document.getElementById('calcCustomersLabel').textContent = customers;
            document.getElementById('calcJobsLabel').textContent = jobs;

            // Find the cheapest plan that can accommodate the requirements
            var recommended = null;
            for (var i = 0; i < planData.length; i++) {
                var p = planData[i];
                var usersOk = p.maxUsers === 0 || p.maxUsers >= users;
                var custOk = p.maxCustomers === 0 || p.maxCustomers >= customers;
                var jobsOk = p.maxJobOrdersPerMonth === 0 || p.maxJobOrdersPerMonth >= jobs;
                if (usersOk && custOk && jobsOk) {
                    recommended = p;
                    break;
                }
            }
            if (!recommended && planData.length > 0) {
                recommended = planData[planData.length - 1]; // Highest tier
            }
            if (recommended) {
                var priceKey = activeCycle === 'Yearly' ? 'yearlyPrice'
                             : activeCycle === 'Permanent' ? 'permanentPrice'
                             : 'monthlyPrice';
                var periodLabel = activeCycle === 'Yearly' ? '/year'
                                : activeCycle === 'Permanent' ? ' one-time'
                                : '/month';
                var price = recommended[priceKey];
                document.getElementById('calcPlanName').textContent = recommended.planName;
                document.getElementById('calcPlanPrice').textContent = '\u20B1' + price.toLocaleString('en-PH', { maximumFractionDigits: 0 });
                document.getElementById('calcPeriodLabel').textContent = periodLabel;
            }
        }

        // ── Nav scroll effect ────────────────────────────────────
        window.addEventListener('scroll', function() {
            document.getElementById('lpNav').classList.toggle('scrolled', window.scrollY > 20);
        });

        // ── Mobile hamburger ─────────────────────────────────────
        document.getElementById('lpHamburger').addEventListener('click', function() {
            document.getElementById('lpMobileMenu').classList.toggle('open');
            this.classList.toggle('open');
        });
        document.querySelectorAll('.lp-mobile-link').forEach(function(link) {
            link.addEventListener('click', function() {
                document.getElementById('lpMobileMenu').classList.remove('open');
                document.getElementById('lpHamburger').classList.remove('open');
            });
        });

        // ── Smooth scroll ────────────────────────────────────────
        document.querySelectorAll('a[href^="#"]').forEach(function(anchor) {
            anchor.addEventListener('click', function(e) {
                e.preventDefault();
                var target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    var top = target.getBoundingClientRect().top + window.pageYOffset - 80;
                    window.scrollTo({ top: top, behavior: 'smooth' });
                }
            });
        });

        // ── Scroll Reveal (IntersectionObserver) ─────────────────
        (function() {
            var observer = new IntersectionObserver(function(entries) {
                entries.forEach(function(entry) {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                    }
                });
            }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });

            document.querySelectorAll('.sr, .sr-scale').forEach(function(el) {
                observer.observe(el);
            });
        })();

        // ── Init calculator ──────────────────────────────────────
        updateCalculator();
    </script>
</body>
</html>
