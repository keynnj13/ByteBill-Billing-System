@model dynamic
@using ByteBill_BS.Models.Enums
@{
    string userName = Model.UserName;
    string userInitials = Model.UserInitials;
    UserRole userRole = Model.UserRole;
}

<nav class="top-nav">
    <div class="flex items-center gap-2">
        <button class="nav-toggle" id="nav-toggle" aria-label="Toggle navigation">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
        </button>
    </div>
    
    <div class="nav-actions">
        <!-- Notification Bell -->
        <div class="notif-wrapper" style="position: relative;">
            <button class="btn btn-ghost btn-icon" id="notif-bell" aria-label="Notifications" style="color: var(--gray-500); position: relative; width: 40px; height: 40px;">
                <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
                </svg>
                <span class="notif-badge" id="notif-badge">3</span>
            </button>

            <!-- Notification Dropdown -->
            <div class="notif-dropdown hidden" id="notif-dropdown">
                <div class="notif-dropdown-header">
                    <span class="notif-dropdown-title">Notifications</span>
                    <button class="notif-mark-all" id="notif-mark-all">Mark all read</button>
                </div>
                <div class="notif-dropdown-body" id="notif-list">
                    <!-- Notification items injected by JS -->
                </div>
                <div class="notif-dropdown-footer">
                    <a href="/Notifications" class="notif-view-all">View All Notifications</a>
                </div>
            </div>
        </div>
        
        <div class="nav-user" id="user-menu-toggle">
            <div class="nav-user-avatar">@userInitials</div>
            <div class="nav-user-info">
                <div class="nav-user-name">@userName</div>
                <div class="nav-user-role">@userRole.ToString()</div>
            </div>
            <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: var(--gray-400);">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
        </div>
    </div>
    
    <!-- User Dropdown Menu -->
    <div id="user-dropdown" class="user-dropdown hidden">
        <div class="user-dropdown-header">
            <div class="nav-user-avatar" style="background: var(--emerald); color: white;">@userInitials</div>
            <div>
                <div class="user-dropdown-name">@userName</div>
                <div class="user-dropdown-role">@userRole.ToString()</div>
            </div>
        </div>
        <div class="user-dropdown-divider"></div>
        <a href="/Profile" class="user-dropdown-item">
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
            </svg>
            Profile Settings
        </a>
        <a href="/Profile/Preferences" class="user-dropdown-item">
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            Preferences
        </a>
        <div class="user-dropdown-divider"></div>
        <a href="/Auth/Logout" class="user-dropdown-item user-dropdown-item-danger">
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
            </svg>
            Sign Out
        </a>
    </div>
</nav>

<style>
    .user-dropdown {
        position: fixed;
        top: 56px;
        right: 16px;
        width: 240px;
        background: var(--card);
        border: 1px solid var(--gray-border);
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-modal);
        z-index: calc(var(--z-nav) + 10);
        overflow: hidden;
    }
    
    .user-dropdown.hidden {
        display: none;
    }
    
    .user-dropdown-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 16px;
        background: var(--gray-light);
    }
    
    .user-dropdown-name {
        font-weight: 600;
        font-size: 14px;
    }
    
    .user-dropdown-role {
        font-size: 12px;
        color: var(--muted);
    }
    
    .user-dropdown-divider {
        height: 1px;
        background: var(--gray-border);
    }
    
    .user-dropdown-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 16px;
        color: var(--foreground);
        text-decoration: none;
        font-size: 14px;
        transition: background 0.2s ease;
    }
    
    .user-dropdown-item:hover {
        background: var(--gray-light);
        text-decoration: none;
    }
    
    .user-dropdown-item-danger {
        color: var(--destructive);
    }
    
    .user-dropdown-item-danger:hover {
        background: rgba(239, 68, 68, 0.1);
        color: #dc2626;
    }

    /* ── Notification Bell Badge ── */
    .notif-badge {
        position: absolute; top: 2px; right: 2px;
        min-width: 16px; height: 16px; padding: 0 4px;
        border-radius: 100px; font-size: 10px; font-weight: 700;
        line-height: 16px; text-align: center;
        background: #ef4444; color: #fff;
        pointer-events: none;
    }
    .notif-badge.hidden { display: none; }

    /* ── Notification Dropdown ── */
    .notif-dropdown {
        position: absolute; top: calc(100% + 8px); right: 0;
        width: 360px; max-height: 480px;
        background: var(--card); border: 1px solid var(--gray-border);
        border-radius: var(--radius-md); box-shadow: var(--shadow-modal);
        z-index: calc(var(--z-nav) + 20);
        display: flex; flex-direction: column; overflow: hidden;
    }
    .notif-dropdown.hidden { display: none; }

    .notif-dropdown-header {
        display: flex; align-items: center; justify-content: space-between;
        padding: 14px 16px; border-bottom: 1px solid var(--gray-border);
    }
    .notif-dropdown-title { font-size: 15px; font-weight: 700; color: var(--foreground); }
    .notif-mark-all {
        font-size: 12px; font-weight: 600; color: var(--primary);
        background: none; border: none; cursor: pointer; padding: 0;
    }
    .notif-mark-all:hover { text-decoration: underline; }

    .notif-dropdown-body { overflow-y: auto; max-height: 360px; }

    .notif-item {
        display: flex; gap: 12px; padding: 14px 16px;
        border-bottom: 1px solid var(--gray-border);
        cursor: pointer; transition: background 0.15s;
    }
    .notif-item:hover { background: var(--gray-light); }
    .notif-item.unread { background: rgba(59,130,246,0.04); }
    .notif-item:last-child { border-bottom: none; }

    .notif-icon {
        flex-shrink: 0; width: 36px; height: 36px;
        border-radius: 50%; display: flex; align-items: center; justify-content: center;
    }
    .notif-icon.adjustment  { background: rgba(245,176,65,0.12); color: #d97706; }
    .notif-icon.approved    { background: rgba(16,185,129,0.12); color: #059669; }
    .notif-icon.rejected    { background: rgba(239,68,68,0.12);  color: #dc2626; }
    .notif-icon.info        { background: rgba(59,130,246,0.10); color: #3b82f6; }

    .notif-content { flex: 1; min-width: 0; }
    .notif-title { font-size: 13px; font-weight: 600; color: var(--foreground); line-height: 1.4; }
    .notif-desc { font-size: 12px; color: var(--muted); margin-top: 2px; line-height: 1.4; }
    .notif-time { font-size: 11px; color: var(--gray-400); margin-top: 4px; }
    .notif-dot {
        flex-shrink: 0; width: 8px; height: 8px;
        border-radius: 50%; background: #3b82f6;
        margin-top: 4px;
    }
    .notif-dot.read { visibility: hidden; }

    .notif-dropdown-footer {
        padding: 10px 16px; border-top: 1px solid var(--gray-border); text-align: center;
    }
    .notif-view-all { font-size: 13px; font-weight: 600; color: var(--primary); text-decoration: none; }
    .notif-view-all:hover { text-decoration: underline; }

    .notif-empty { text-align: center; padding: 32px 16px; }
    .notif-empty-title { font-size: 14px; font-weight: 600; color: var(--muted); margin-top: 8px; }
    .notif-empty-desc { font-size: 12px; color: var(--gray-400); margin-top: 4px; }
</style>

<script>
(function () {
    const bell     = document.getElementById('notif-bell');
    const badge    = document.getElementById('notif-badge');
    const dropdown = document.getElementById('notif-dropdown');
    const list     = document.getElementById('notif-list');
    const markAll  = document.getElementById('notif-mark-all');

    let notifications = [];

    let unreadCount = 0;

    function iconSvg(type) {
        switch (type) {
            case 'adjustment': return '<svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>';
            case 'approved':   return '<svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>';
            case 'rejected':   return '<svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>';
            default:           return '<svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>';
        }
    }

    function render(uc) {
        unreadCount = uc;
        badge.textContent = unreadCount;
        if (unreadCount === 0) badge.classList.add('hidden');
        else badge.classList.remove('hidden');

        if (notifications.length === 0) {
            list.innerHTML = '<div class="notif-empty"><svg width="40" height="40" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color:var(--gray-400);margin:0 auto;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path></svg><div class="notif-empty-title">All caught up!</div><div class="notif-empty-desc">No new notifications.</div></div>';
            return;
        }

        list.innerHTML = notifications.map(n => `
            <div class="notif-item ${!n.isRead ? 'unread' : ''}" data-id="${n.notificationId}" onclick="handleNotifClick(${n.notificationId}, '${n.url || '#'}')">
                <div class="notif-icon ${n.type}">${iconSvg(n.type)}</div>
                <div class="notif-content">
                    <div class="notif-title">${n.title}</div>
                    <div class="notif-desc">${n.message}</div>
                    <div class="notif-time">${n.timeAgo}</div>
                </div>
                <div class="notif-dot ${n.isRead ? 'read' : ''}"></div>
            </div>
        `).join('');
    }

    async function loadNotifications() {
        try {
            const res = await fetch('/api/notifications');
            if (!res.ok) return;
            const data = await res.json();
            notifications = data.notifications || [];
            render(data.unreadCount || 0);
        } catch { }
    }

    window.handleNotifClick = async function (id, url) {
        // Immediately update UI: mark item as read & decrement badge
        const item = document.querySelector(`.notif-item[data-id="${id}"]`);
        if (item && item.classList.contains('unread')) {
            item.classList.remove('unread');
            const dot = item.querySelector('.notif-dot');
            if (dot) dot.classList.add('read');
            let cnt = parseInt(badge.textContent || '0', 10);
            cnt = Math.max(0, cnt - 1);
            badge.textContent = cnt;
            if (cnt === 0) badge.classList.add('hidden');
        }
        try {
            await fetch(`/api/notifications/read/${id}`, { method: 'POST' });
        } catch { }
        if (url && url !== '#') {
            if (url.includes('/DetailsModal/')) {
                // Close the notification dropdown first
                const dropdown = document.getElementById('notif-dropdown');
                if (dropdown) dropdown.classList.add('hidden');
                // Get the notification title for the modal header
                const n = notifications.find(x => x.notificationId === id);
                const modalTitle = n ? n.title : 'Details';
                openAjaxModal(url, modalTitle);
            } else {
                window.location.href = url;
            }
        }
        else loadNotifications();
    };

    // Initial load
    loadNotifications();

    // Real-time notifications via SignalR
    if (window.signalR) {
        const connection = new signalR.HubConnectionBuilder()
            .withUrl('/hubs/notifications')
            .withAutomaticReconnect()
            .build();

        connection.on('ReceiveNotification', function (notif) {
            // Prepend to local array and re-render
            notifications.unshift({
                notificationId: notif.id,
                title: notif.title,
                message: notif.message,
                type: notif.type,
                url: notif.url || '#',
                isRead: false,
                timeAgo: 'just now'
            });
            unreadCount++;
            render(unreadCount);
        });

        connection.start().catch(function () {
            // Fallback to polling if SignalR fails
            setInterval(loadNotifications, 30000);
        });
    } else {
        // Fallback: poll every 30 seconds
        setInterval(loadNotifications, 30000);
    }

    // Toggle dropdown
    bell.addEventListener('click', function (e) {
        e.stopPropagation();
        const userDropdown = document.getElementById('user-dropdown');
        if (userDropdown) userDropdown.classList.add('hidden');
        dropdown.classList.toggle('hidden');
    });

    // Mark all read
    markAll.addEventListener('click', async function () {
        // Immediately update UI
        badge.textContent = '0';
        badge.classList.add('hidden');
        document.querySelectorAll('.notif-item.unread').forEach(el => {
            el.classList.remove('unread');
            const dot = el.querySelector('.notif-dot');
            if (dot) dot.classList.add('read');
        });
        try {
            await fetch('/api/notifications/read-all', { method: 'POST' });
            loadNotifications();
        } catch { }
    });

    // Close on outside click
    document.addEventListener('click', function (e) {
        if (!dropdown.contains(e.target) && e.target !== bell && !bell.contains(e.target)) {
            dropdown.classList.add('hidden');
        }
    });

    // Close notification dropdown when user menu opens
    const userToggle = document.getElementById('user-menu-toggle');
    if (userToggle) {
        userToggle.addEventListener('click', function () {
            dropdown.classList.add('hidden');
        });
    }
})();
</script>