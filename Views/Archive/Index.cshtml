@using ByteBill_BS.Models
@using ByteBill_BS.Models.Enums
@using ByteBill_BS.ViewModels.Admin
@using ByteBill_BS.ViewModels.JobOrders
@using ByteBill_BS.ViewModels.Invoices
@using ByteBill_BS.ViewModels.Common
@{
    ViewData["Title"] = "Archive";
    var tab = (string)ViewBag.ActiveTab;
    var joModel = (JobOrderListViewModel)ViewBag.JobOrders;
    var invModel = (InvoiceListViewModel)ViewBag.Invoices;
    var usrModel = (UserListViewModel)ViewBag.DeactivatedUsers;
    var archivedCustomers = (List<Customer>)ViewBag.ArchivedCustomers;
    var archivedServices = (List<ServiceCatalog>)ViewBag.ArchivedServices;
    var archivedInventory = (List<InventoryItem>)ViewBag.ArchivedInventory;
    int custTotal = (int)ViewBag.ArchivedCustomersTotal;
    int svcTotal = (int)ViewBag.ArchivedServicesTotal;
    int invtTotal = (int)ViewBag.ArchivedInventoryTotal;
    int custPage = (int)ViewBag.ArchivedCustomersPage;
    int svcPage = (int)ViewBag.ArchivedServicesPage;
    int invtPage = (int)ViewBag.ArchivedInventoryPage;
    int pageSize = (int)ViewBag.PageSize;
    int custTotalPages = (int)Math.Ceiling((double)custTotal / pageSize);
    int svcTotalPages = (int)Math.Ceiling((double)svcTotal / pageSize);
    int invtTotalPages = (int)Math.Ceiling((double)invtTotal / pageSize);
}

<partial name="~/Views/Shared/_Breadcrumbs.cshtml" model="@(new BreadcrumbViewModel { Items = new List<BreadcrumbViewModel.BreadcrumbItem> { new() { Label = "Dashboard", Url = Url.Action("Index", "Home") }, new() { Label = "Archive", IsActive = true } } })" />

<div class="arc-page-header">
    <div>
        <h1 class="arc-title">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -3px; margin-right: 6px;"><polyline points="21 8 21 21 3 21 3 8"></polyline><rect x="1" y="3" width="22" height="5"></rect><line x1="10" y1="12" x2="14" y2="12"></line></svg>
            Archive
        </h1>
        <p class="arc-subtitle">Archived records and deactivated users</p>
    </div>
</div>



<!-- Tab Navigation -->
<div class="arc-tabs no-print">
    <button class="arc-tab @(tab == "joborders" ? "arc-tab-active" : "")" data-tab="joborders" onclick="switchArchiveTab('joborders')">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path></svg>
        Job Orders
        <span class="arc-tab-badge">@joModel.TotalCount</span>
    </button>
    <button class="arc-tab @(tab == "invoices" ? "arc-tab-active" : "")" data-tab="invoices" onclick="switchArchiveTab('invoices')">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2z"></path></svg>
        Invoices
        <span class="arc-tab-badge">@invModel.TotalCount</span>
    </button>
    <button class="arc-tab @(tab == "users" ? "arc-tab-active" : "")" data-tab="users" onclick="switchArchiveTab('users')">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><line x1="23" y1="13" x2="17" y2="13"></line></svg>
        Users
        <span class="arc-tab-badge">@usrModel.TotalCount</span>
    </button>
    <button class="arc-tab @(tab == "customers" ? "arc-tab-active" : "")" data-tab="customers" onclick="switchArchiveTab('customers')">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
        Customers
        <span class="arc-tab-badge">@custTotal</span>
    </button>
    <button class="arc-tab @(tab == "services" ? "arc-tab-active" : "")" data-tab="services" onclick="switchArchiveTab('services')">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"></path></svg>
        Services
        <span class="arc-tab-badge">@svcTotal</span>
    </button>
    <button class="arc-tab @(tab == "inventory" ? "arc-tab-active" : "")" data-tab="inventory" onclick="switchArchiveTab('inventory')">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg>
        Inventory
        <span class="arc-tab-badge">@invtTotal</span>
    </button>
</div>

<!-- ═══════ JOB ORDERS TAB ═══════ -->
<div class="arc-tab-panel @(tab == "joborders" ? "arc-tab-panel-active" : "")" id="tab-joborders">
    <div class="card">
        <div class="card-header">
            <form method="get" class="filter-form">
                <input type="hidden" name="tab" value="joborders" />
                <div class="search-input-wrapper">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="search-icon"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    <input type="text" name="search" value="@joModel.SearchTerm" placeholder="Search archived orders..." class="form-input search-input" />
                </div>
                <select name="joStatus" class="form-select" onchange="this.form.submit()">
                    <option value="">All Statuses</option>
                    @foreach (JobOrderStatus s in Enum.GetValues(typeof(JobOrderStatus)))
                    {
                        <option value="@s" selected="@(joModel.StatusFilter == s)">@s</option>
                    }
                </select>
                <button type="submit" class="btn btn-outline-primary">Filter</button>
            </form>
        </div>
        <div class="card-body p-0">
            @if (joModel.JobOrders.Any())
            {
                <div class="table-container">
                    <table class="table" style="table-layout: fixed;">
                        <colgroup>
                            <col style="width: 13%;" />
                            <col style="width: 20%;" />
                            <col style="width: 17%;" />
                            <col style="width: 13%;" />
                            <col style="width: 14%;" />
                            <col style="width: 13%;" />
                            <col style="width: 10%;" />
                        </colgroup>
                        <thead>
                            <tr>
                                <th>Order #</th>
                                <th>Customer</th>
                                <th>Device</th>
                                <th class="text-center">Status</th>
                                <th>Technician</th>
                                <th>Created</th>
                                <th class="text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in joModel.JobOrders)
                            {
                                <tr>
                                    <td><span class="order-link">@order.JobNumber</span></td>
                                    <td>
                                        <div class="customer-cell">
                                            <div class="avatar-xs">@order.CustomerInitials</div>
                                            <span class="customer-text">@order.CustomerName</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="device-cell">
                                            <span class="device-text">@order.DeviceType</span>
                                            @if (!string.IsNullOrEmpty(order.DeviceBrand))
                                            {
                                                <span class="device-sub">@order.DeviceBrand @order.DeviceModel</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="text-center"><span class="status-indicator @order.StatusClass">@order.StatusDisplay</span></td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(order.TechnicianName))
                                        {
                                            <span class="tech-name">@order.TechnicianName</span>
                                        }
                                        else
                                        {
                                            <span class="unassigned">Unassigned</span>
                                        }
                                    </td>
                                    <td><span class="date-text">@order.CreatedAt.ToString("MMM d, yyyy")</span></td>
                                    <td>
                                        <div class="action-buttons">
                                            <form asp-action="RestoreJobOrder" asp-controller="Archive" asp-route-id="@order.Id" method="post" style="display: inline;">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn-action restore-btn" title="Restore" onclick="return confirm('Restore this job order?');">
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"></polyline><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path></svg>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (joModel.TotalPages > 1)
                {
                    <partial name="~/Views/Shared/_Pagination.cshtml" model="@(new PaginationViewModel
                    {
                        CurrentPage = joModel.CurrentPage,
                        TotalPages = joModel.TotalPages,
                        TotalItems = joModel.TotalCount,
                        PageSize = joModel.PageSize,
                        BaseUrl = Url.Action("Index", "Archive", new { tab = "joborders", search = joModel.SearchTerm, joStatus = joModel.StatusFilter })!
                    })" />
                }
            }
            else
            {
                <div class="empty-state" style="padding: 60px 20px; text-align: center;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#d1d5db" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 16px;">
                        <polyline points="21 8 21 21 3 21 3 8"></polyline><rect x="1" y="3" width="22" height="5"></rect><line x1="10" y1="12" x2="14" y2="12"></line>
                    </svg>
                    <h3 style="color: #6b7280; font-size: 16px; margin-bottom: 4px;">No archived job orders</h3>
                    <p style="color: #9ca3af; font-size: 14px;">Archived job orders will appear here.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- ═══════ INVOICES TAB ═══════ -->
<div class="arc-tab-panel @(tab == "invoices" ? "arc-tab-panel-active" : "")" id="tab-invoices">
    <div class="card">
        <div class="card-header">
            <form method="get" class="filter-form">
                <input type="hidden" name="tab" value="invoices" />
                <div class="search-input-wrapper">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="search-icon"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    <input type="text" name="search" value="@invModel.SearchTerm" placeholder="Search archived invoices..." class="form-input search-input" />
                </div>
                <select name="invStatus" class="form-select" onchange="this.form.submit()">
                    <option value="">All Statuses</option>
                    @foreach (var s in Enum.GetValues<InvoiceStatus>())
                    {
                        <option value="@s" selected="@(invModel.StatusFilter == s)">@s</option>
                    }
                </select>
                <button type="submit" class="btn btn-outline-primary">Filter</button>
            </form>
        </div>
        <div class="card-body p-0">
            @if (invModel.Invoices.Any())
            {
                <div class="table-container">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Invoice</th>
                                <th>Customer</th>
                                <th class="text-center">Job #</th>
                                <th class="text-right">Total</th>
                                <th class="text-right">Balance</th>
                                <th class="text-center">Status</th>
                                <th class="text-center">Due Date</th>
                                <th class="text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var inv in invModel.Invoices)
                            {
                                <tr>
                                    <td>
                                        <div class="inv-cell">
                                            <span class="inv-number">@inv.InvoiceNumber</span>
                                            <span class="inv-date">@inv.CreatedAt.ToString("MMM d, yyyy")</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="customer-cell">
                                            <div class="avatar-sm">@inv.CustomerInitials</div>
                                            <span class="customer-name">@inv.CustomerName</span>
                                        </div>
                                    </td>
                                    <td class="text-center"><span class="job-link">@(inv.JobNumber ?? "—")</span></td>
                                    <td class="text-right font-medium">@inv.Total.ToString("C")</td>
                                    <td class="text-right">
                                        <span class="@(inv.Balance > 0 ? "text-danger font-medium" : "")">@inv.Balance.ToString("C")</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="status-indicator @inv.StatusClass">@inv.StatusDisplay</span>
                                    </td>
                                    <td class="text-center">
                                        @if (inv.DueDate.HasValue)
                                        {
                                            <span>@inv.DueDate.Value.ToString("MMM d, yyyy")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-right">
                                        <form asp-action="RestoreInvoice" asp-controller="Archive" asp-route-id="@inv.Id" method="post" style="display: inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn-action restore-btn" title="Restore" onclick="return confirm('Restore this invoice?');">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"></polyline><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path></svg>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (invModel.TotalPages > 1)
                {
                    <partial name="~/Views/Shared/_Pagination.cshtml" model="@(new PaginationViewModel
                    {
                        CurrentPage = invModel.CurrentPage,
                        TotalPages = invModel.TotalPages,
                        TotalItems = invModel.TotalCount,
                        PageSize = invModel.PageSize,
                        BaseUrl = Url.Action("Index", "Archive", new { tab = "invoices", search = invModel.SearchTerm, invStatus = invModel.StatusFilter })!
                    })" />
                }
            }
            else
            {
                <div class="empty-state" style="padding: 60px 20px; text-align: center;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#d1d5db" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 16px;">
                        <polyline points="21 8 21 21 3 21 3 8"></polyline><rect x="1" y="3" width="22" height="5"></rect><line x1="10" y1="12" x2="14" y2="12"></line>
                    </svg>
                    <h3 style="color: #6b7280; font-size: 16px; margin-bottom: 4px;">No archived invoices</h3>
                    <p style="color: #9ca3af; font-size: 14px;">Archived invoices will appear here.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- ═══════ USERS TAB ═══════ -->
<div class="arc-tab-panel @(tab == "users" ? "arc-tab-panel-active" : "")" id="tab-users">
    <div class="card">
        <div class="card-header">
            <form method="get" class="filter-form">
                <input type="hidden" name="tab" value="users" />
                <div class="search-input-wrapper">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="search-icon"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    <input type="text" name="search" value="@usrModel.SearchTerm" placeholder="Search deactivated users..." class="form-input search-input" />
                </div>
                <button type="submit" class="btn btn-outline-primary">Filter</button>
            </form>
        </div>
        <div class="card-body p-0">
            @if (usrModel.Users.Any())
            {
                <div class="table-container">
                    <table class="table" style="table-layout: fixed;">
                        <colgroup>
                            <col style="width: 22%;" />
                            <col style="width: 22%;" />
                            <col style="width: 14%;" />
                            <col style="width: 12%;" />
                            <col style="width: 10%;" />
                            <col style="width: 10%;" />
                            <col style="width: 10%;" />
                        </colgroup>
                        <thead>
                            <tr>
                                <th>User</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th class="text-center">Role</th>
                                <th class="text-center">Status</th>
                                <th>Created</th>
                                <th class="text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in usrModel.Users)
                            {
                                <tr>
                                    <td>
                                        <div class="customer-cell">
                                            <div class="avatar-xs">@user.Initials</div>
                                            <span class="customer-text">@user.FullName</span>
                                        </div>
                                    </td>
                                    <td><span style="font-size:13px; color:#6b7280;">@user.Email</span></td>
                                    <td class="text-muted" style="font-size:13px;">@user.Phone</td>
                                    <td class="text-center"><span class="status-indicator @user.RoleClass">@user.RoleName</span></td>
                                    <td class="text-center"><span class="status-indicator status-muted">Inactive</span></td>
                                    <td><span class="date-text">@user.CreatedAt.ToString("MMM d, yyyy")</span></td>
                                    <td>
                                        <div class="action-buttons">
                                            <form asp-action="ReactivateUser" asp-controller="Archive" asp-route-id="@user.Id" method="post" style="display: inline;">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn-action restore-btn" title="Reactivate" onclick="return confirm('Reactivate this user?');">
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"></polyline><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path></svg>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (usrModel.TotalPages > 1)
                {
                    <partial name="~/Views/Shared/_Pagination.cshtml" model="@(new PaginationViewModel
                    {
                        CurrentPage = usrModel.CurrentPage,
                        TotalPages = usrModel.TotalPages,
                        TotalItems = usrModel.TotalCount,
                        PageSize = usrModel.PageSize,
                        BaseUrl = Url.Action("Index", "Archive", new { tab = "users", search = usrModel.SearchTerm })!
                    })" />
                }
            }
            else
            {
                <div class="empty-state" style="padding: 60px 20px; text-align: center;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#d1d5db" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 16px;">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle>
                    </svg>
                    <h3 style="color: #6b7280; font-size: 16px; margin-bottom: 4px;">No deactivated users</h3>
                    <p style="color: #9ca3af; font-size: 14px;">Deactivated users will appear here.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- ═══════ CUSTOMERS TAB ═══════ -->
<div class="arc-tab-panel @(tab == "customers" ? "arc-tab-panel-active" : "")" id="tab-customers">
    <div class="card">
        <div class="card-header">
            <form method="get" class="filter-form">
                <input type="hidden" name="tab" value="customers" />
                <div class="search-input-wrapper">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="search-icon"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    <input type="text" name="search" value="@(tab == "customers" ? ViewBag.Search : "")" placeholder="Search archived customers..." class="form-input search-input" />
                </div>
                <button type="submit" class="btn btn-outline-primary">Filter</button>
            </form>
        </div>
        <div class="card-body p-0">
            @if (archivedCustomers.Any())
            {
                <div class="table-container">
                    <table class="table" style="table-layout: fixed;">
                        <colgroup>
                            <col style="width: 25%;" /><col style="width: 25%;" /><col style="width: 20%;" /><col style="width: 20%;" /><col style="width: 10%;" />
                        </colgroup>
                        <thead>
                            <tr><th>Customer</th><th>Email</th><th>Phone</th><th>Created</th><th class="text-right">Actions</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var c in archivedCustomers)
                            {
                                <tr>
                                    <td><div class="customer-cell"><div class="avatar-xs">@c.Initials</div><span class="customer-text">@c.FullName</span></div></td>
                                    <td style="font-size:13px;color:#6b7280;">@(c.Email ?? "—")</td>
                                    <td style="font-size:13px;color:#6b7280;">@(c.Phone ?? "—")</td>
                                    <td><span class="date-text">@c.CreatedAt.ToString("MMM d, yyyy")</span></td>
                                    <td>
                                        <div class="action-buttons">
                                            <form asp-action="RestoreCustomer" asp-controller="Archive" asp-route-id="@c.CustomerId" method="post" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn-action restore-btn" title="Restore" onclick="return confirm('Restore this customer?');">
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"></polyline><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path></svg>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (custTotalPages > 1)
                {
                    <partial name="~/Views/Shared/_Pagination.cshtml" model="@(new PaginationViewModel { CurrentPage = custPage, TotalPages = custTotalPages, TotalItems = custTotal, PageSize = pageSize, BaseUrl = Url.Action("Index", "Archive", new { tab = "customers", search = (tab == "customers" ? (string?)ViewBag.Search : null) })! })" />
                }
            }
            else
            {
                <div class="empty-state" style="padding: 60px 20px; text-align: center;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#d1d5db" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 16px;"><polyline points="21 8 21 21 3 21 3 8"></polyline><rect x="1" y="3" width="22" height="5"></rect><line x1="10" y1="12" x2="14" y2="12"></line></svg>
                    <h3 style="color: #6b7280; font-size: 16px; margin-bottom: 4px;">No archived customers</h3>
                    <p style="color: #9ca3af; font-size: 14px;">Archived customers will appear here.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- ═══════ SERVICES TAB ═══════ -->
<div class="arc-tab-panel @(tab == "services" ? "arc-tab-panel-active" : "")" id="tab-services">
    <div class="card">
        <div class="card-header">
            <form method="get" class="filter-form">
                <input type="hidden" name="tab" value="services" />
                <div class="search-input-wrapper">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="search-icon"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    <input type="text" name="search" value="@(tab == "services" ? ViewBag.Search : "")" placeholder="Search archived services..." class="form-input search-input" />
                </div>
                <button type="submit" class="btn btn-outline-primary">Filter</button>
            </form>
        </div>
        <div class="card-body p-0">
            @if (archivedServices.Any())
            {
                <div class="table-container">
                    <table class="table" style="table-layout: fixed;">
                        <colgroup>
                            <col style="width: 30%;" /><col style="width: 20%;" /><col style="width: 15%;" /><col style="width: 15%;" /><col style="width: 10%;" />
                        </colgroup>
                        <thead>
                            <tr><th>Service</th><th>Category</th><th class="text-right">Price</th><th>Duration</th><th class="text-right">Actions</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var s in archivedServices)
                            {
                                <tr>
                                    <td style="font-size:13px;font-weight:500;color:#1f2937;">@s.ServiceName</td>
                                    <td><span class="category-badge">@(s.ServiceCategory?.CategoryName ?? "—")</span></td>
                                    <td class="text-right" style="font-size:13px;">@s.BasePrice.ToString("C")</td>
                                    <td style="font-size:13px;color:#6b7280;">@s.EstimatedDuration min</td>
                                    <td>
                                        <div class="action-buttons">
                                            <form asp-action="RestoreService" asp-controller="Archive" asp-route-id="@s.ServiceId" method="post" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn-action restore-btn" title="Restore" onclick="return confirm('Restore this service?');">
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"></polyline><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path></svg>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (svcTotalPages > 1)
                {
                    <partial name="~/Views/Shared/_Pagination.cshtml" model="@(new PaginationViewModel { CurrentPage = svcPage, TotalPages = svcTotalPages, TotalItems = svcTotal, PageSize = pageSize, BaseUrl = Url.Action("Index", "Archive", new { tab = "services", search = (tab == "services" ? (string?)ViewBag.Search : null) })! })" />
                }
            }
            else
            {
                <div class="empty-state" style="padding: 60px 20px; text-align: center;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#d1d5db" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 16px;"><polyline points="21 8 21 21 3 21 3 8"></polyline><rect x="1" y="3" width="22" height="5"></rect><line x1="10" y1="12" x2="14" y2="12"></line></svg>
                    <h3 style="color: #6b7280; font-size: 16px; margin-bottom: 4px;">No archived services</h3>
                    <p style="color: #9ca3af; font-size: 14px;">Archived services will appear here.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- ═══════ INVENTORY TAB ═══════ -->
<div class="arc-tab-panel @(tab == "inventory" ? "arc-tab-panel-active" : "")" id="tab-inventory">
    <div class="card">
        <div class="card-header">
            <form method="get" class="filter-form">
                <input type="hidden" name="tab" value="inventory" />
                <div class="search-input-wrapper">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="search-icon"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    <input type="text" name="search" value="@(tab == "inventory" ? ViewBag.Search : "")" placeholder="Search archived inventory..." class="form-input search-input" />
                </div>
                <button type="submit" class="btn btn-outline-primary">Filter</button>
            </form>
        </div>
        <div class="card-body p-0">
            @if (archivedInventory.Any())
            {
                <div class="table-container">
                    <table class="table" style="table-layout: fixed;">
                        <colgroup>
                            <col style="width: 12%;" /><col style="width: 22%;" /><col style="width: 15%;" /><col style="width: 12%;" /><col style="width: 12%;" /><col style="width: 15%;" /><col style="width: 12%;" />
                        </colgroup>
                        <thead>
                            <tr><th>SKU</th><th>Item</th><th>Category</th><th class="text-center">Stock</th><th class="text-right">Cost</th><th class="text-right">Price</th><th class="text-right">Actions</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var i in archivedInventory)
                            {
                                <tr>
                                    <td><span style="font-family:monospace;font-size:12px;color:#6b7280;background:#f9fafb;padding:3px 8px;border-radius:4px;">@i.SKU</span></td>
                                    <td style="font-size:13px;font-weight:500;color:#1f2937;">@i.ItemName</td>
                                    <td><span class="category-badge">@(i.InventoryCategory?.CategoryName ?? "—")</span></td>
                                    <td class="text-center" style="font-size:13px;">@i.QtyOnHand</td>
                                    <td class="text-right" style="font-size:13px;">@i.UnitCost.ToString("C")</td>
                                    <td class="text-right" style="font-size:13px;font-weight:500;">@i.UnitPrice.ToString("C")</td>
                                    <td>
                                        <div class="action-buttons">
                                            <form asp-action="RestoreInventory" asp-controller="Archive" asp-route-id="@i.ItemId" method="post" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn-action restore-btn" title="Restore" onclick="return confirm('Restore this item?');">
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"></polyline><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path></svg>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (invtTotalPages > 1)
                {
                    <partial name="~/Views/Shared/_Pagination.cshtml" model="@(new PaginationViewModel { CurrentPage = invtPage, TotalPages = invtTotalPages, TotalItems = invtTotal, PageSize = pageSize, BaseUrl = Url.Action("Index", "Archive", new { tab = "inventory", search = (tab == "inventory" ? (string?)ViewBag.Search : null) })! })" />
                }
            }
            else
            {
                <div class="empty-state" style="padding: 60px 20px; text-align: center;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#d1d5db" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 16px;"><polyline points="21 8 21 21 3 21 3 8"></polyline><rect x="1" y="3" width="22" height="5"></rect><line x1="10" y1="12" x2="14" y2="12"></line></svg>
                    <h3 style="color: #6b7280; font-size: 16px; margin-bottom: 4px;">No archived inventory items</h3>
                    <p style="color: #9ca3af; font-size: 14px;">Archived inventory items will appear here.</p>
                </div>
            }
        </div>
    </div>
</div>

<script>
function switchArchiveTab(tab) {
    document.querySelectorAll('.arc-tab').forEach(t => t.classList.remove('arc-tab-active'));
    document.querySelector('[data-tab="' + tab + '"]').classList.add('arc-tab-active');
    document.querySelectorAll('.arc-tab-panel').forEach(p => p.classList.remove('arc-tab-panel-active'));
    document.getElementById('tab-' + tab).classList.add('arc-tab-panel-active');
}
</script>

<style>
    .arc-page-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px; }
    .arc-title { font-size: 24px; font-weight: 700; color: #1f2937; margin-bottom: 4px; }
    .arc-subtitle { font-size: 14px; color: #6b7280; }

    /* Tabs (pill style matching Integrations) */
    .arc-tabs { display: flex; gap: 4px; margin-bottom: 24px; border-bottom: 2px solid #e5e7eb; padding-bottom: 0; }
    .arc-tab { display: flex; align-items: center; gap: 8px; padding: 12px 20px; font-size: 14px; font-weight: 500; color: #6b7280; background: none; border: none; border-bottom: 2px solid transparent; margin-bottom: -2px; cursor: pointer; transition: all 0.15s; border-radius: 8px 8px 0 0; }
    .arc-tab:hover { color: #1f2937; background: #f9fafb; }
    .arc-tab-active { color: #1e3a8a; border-bottom-color: #1e3a8a; background: #f0f4ff; }
    .arc-tab-badge { font-size: 11px; padding: 2px 8px; border-radius: 10px; font-weight: 600; background: #f3f4f6; color: #6b7280; }
    .arc-tab-active .arc-tab-badge { background: #dbeafe; color: #1e3a8a; }

    /* Tab Panels */
    .arc-tab-panel { display: none; }
    .arc-tab-panel-active { display: block; }

    .filter-form { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
    .search-input-wrapper { position: relative; flex: 1; min-width: 200px; }
    .search-icon { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #9ca3af; }
    .search-input { padding-left: 40px; min-width: 240px; }
    .customer-cell { display: flex; align-items: center; gap: 8px; }
    .avatar-xs { width: 28px; height: 28px; border-radius: 50%; background: rgba(59,130,246,0.1); color: #3b82f6; display: flex; align-items: center; justify-content: center; font-weight: 600; font-size: 11px; flex-shrink: 0; }
    .avatar-sm { width: 30px; height: 30px; border-radius: 50%; background: linear-gradient(135deg, #667eea, #764ba2); color: white; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 600; flex-shrink: 0; }
    .customer-text { font-size: 13px; font-weight: 500; color: #374151; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .customer-name { font-weight: 500; color: #1f2937; font-size: 13px; }
    .order-link { font-weight: 600; color: #3b82f6; font-size: 13px; }
    .device-cell { display: flex; flex-direction: column; gap: 1px; }
    .device-text { font-size: 13px; color: #374151; }
    .device-sub { font-size: 12px; color: #9ca3af; }
    .tech-name { font-size: 13px; color: #374151; }
    .unassigned { font-size: 13px; color: #d1d5db; font-style: italic; }
    .date-text { font-size: 13px; color: #6b7280; }
    .inv-cell { display: flex; flex-direction: column; gap: 2px; }
    .inv-number { font-weight: 500; color: #1f2937; font-size: 13px; }
    .inv-date { font-size: 12px; color: #9ca3af; }
    .job-link { font-size: 12px; color: #6b7280; font-weight: 500; }
    .text-danger { color: #dc2626; }
    .font-medium { font-weight: 500; }
    .action-buttons { display: flex; gap: 4px; justify-content: flex-end; }
    .btn-action { width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; border-radius: 6px; color: #6b7280; transition: all 0.15s; border: none; background: none; cursor: pointer; }
    .restore-btn:hover { background: #ecfdf5; color: #16a34a; }
    .category-badge { font-size: 11px; padding: 3px 10px; border-radius: 99px; background: #f3f4f6; color: #374151; font-weight: 500; display: inline-block; }
    @@media (max-width: 768px) {
        .arc-page-header { flex-direction: column; gap: 12px; }
        .arc-tabs { flex-direction: column; }
        .filter-form { flex-direction: column; width: 100%; }
        .search-input { min-width: 100%; }
    }
</style>
