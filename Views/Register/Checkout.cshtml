@model ByteBill_BS.ViewModels.Register.CheckoutViewModel
@{
    Layout = null;
    ViewData["Title"] = $"Checkout — {Model.PlanName} Plan";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — ByteBill</title>
    <link rel="icon" type="image/png" href="~/img/bytelogo.png" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
    <style>
        body { background: linear-gradient(135deg, hsl(213, 54%, 97%) 0%, hsl(145, 40%, 96%) 50%, hsl(213, 54%, 95%) 100%); min-height: 100vh; }
        .ck-page { display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 40px 24px; }
        .ck-card { background: white; border-radius: 16px; box-shadow: 0 20px 40px rgba(0,0,0,0.08); max-width: 520px; width: 100%; overflow: hidden; }
        .ck-header { background: var(--lp-navy); padding: 32px; text-align: center; color: white; }
        .ck-header h1 { font-size: 24px; font-weight: 800; margin-bottom: 4px; }
        .ck-header p { opacity: 0.7; font-size: 14px; }
        .ck-body { padding: 32px; }
        .ck-plan-badge { display: inline-block; padding: 4px 12px; background: var(--lp-emerald-light); color: var(--lp-emerald-dark, hsl(145,63%,38%)); border-radius: 9999px; font-size: 12px; font-weight: 700; text-transform: uppercase; margin-bottom: 16px; }
        .ck-plan-name { font-size: 28px; font-weight: 800; color: var(--lp-navy); margin-bottom: 8px; }
        .ck-price { font-size: 36px; font-weight: 800; color: var(--lp-navy); margin-bottom: 4px; }
        .ck-price-period { font-size: 14px; color: var(--lp-text-muted); margin-bottom: 24px; }
        .ck-cycle-group { display: flex; gap: 8px; margin-bottom: 24px; }
        .ck-cycle-btn { flex: 1; padding: 10px; border: 1.5px solid var(--lp-border); border-radius: 10px; background: white; font-family: var(--lp-font); font-size: 13px; font-weight: 600; color: var(--lp-text-muted); cursor: pointer; text-align: center; transition: all 0.2s; text-decoration: none; display: block; }
        .ck-cycle-btn:hover { border-color: var(--lp-navy); color: var(--lp-navy); }
        .ck-cycle-btn.active { border-color: var(--lp-emerald); background: var(--lp-emerald-light); color: var(--lp-emerald-dark, hsl(145,63%,38%)); }
        .ck-features { list-style: none; padding: 0; margin: 0 0 28px; }
        .ck-features li { display: flex; align-items: center; gap: 10px; padding: 8px 0; font-size: 14px; color: var(--lp-text); border-bottom: 1px solid hsl(210, 14%, 95%); }
        .ck-features li:last-child { border-bottom: none; }
        .ck-features li svg { flex-shrink: 0; color: var(--lp-emerald); }
        .ck-features li.disabled { color: var(--lp-text-muted); opacity: 0.5; }
        .ck-features li.disabled svg { color: var(--lp-text-muted); }
        .ck-divider { height: 1px; background: var(--lp-border); margin: 24px 0; }
        .ck-total { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 24px; }
        .ck-total-label { font-size: 16px; font-weight: 600; color: var(--lp-text); }
        .ck-total-amount { font-size: 24px; font-weight: 800; color: var(--lp-navy); }
        .ck-methods { display: flex; gap: 8px; justify-content: center; margin-bottom: 16px; }
        .ck-method { padding: 6px 14px; background: var(--lp-bg-alt); border-radius: 8px; font-size: 12px; font-weight: 600; color: var(--lp-text-muted); }
        .ck-submit { width: 100%; padding: 14px; background: var(--lp-emerald); color: white; border: none; border-radius: 12px; font-family: var(--lp-font); font-size: 16px; font-weight: 700; cursor: pointer; transition: all 0.2s; }
        .ck-submit:hover { background: var(--lp-emerald-hover); transform: translateY(-1px); box-shadow: 0 4px 12px rgba(16,185,129,0.3); }
        .ck-submit:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }
        .ck-back { display: block; text-align: center; margin-top: 16px; color: var(--lp-text-muted); font-size: 14px; text-decoration: none; }
        .ck-back:hover { color: var(--lp-navy); }
        .ck-error { background: var(--lp-red-light); border: 1px solid hsl(4, 74%, 85%); color: hsl(4, 74%, 40%); padding: 12px 16px; border-radius: 10px; font-size: 14px; margin-bottom: 20px; }
        .ck-secure { display: flex; align-items: center; justify-content: center; gap: 6px; margin-top: 12px; font-size: 12px; color: var(--lp-text-muted); }
        .ck-secure svg { color: var(--lp-emerald); }
    </style>
</head>
<body>
    <div class="ck-page">
        <div class="ck-card">
            <div class="ck-header">
                <h1>Complete Your Subscription</h1>
                <p>Secure payment powered by PayMongo</p>
            </div>
            <div class="ck-body">

                <div class="ck-plan-badge">@Model.BillingCycle Plan</div>
                <div class="ck-plan-name">@Model.PlanName</div>
                @if (!string.IsNullOrEmpty(Model.PlanDescription))
                {
                    <p style="color: var(--lp-text-muted); font-size: 14px; margin-bottom: 20px;">@Model.PlanDescription</p>
                }

                <!-- Billing Cycle Selection -->
                <div class="ck-cycle-group">
                    <a href="@Url.Action("Checkout", new { planId = Model.PlanId, cycle = "Monthly" })"
                       class="ck-cycle-btn @(Model.BillingCycle == "Monthly" ? "active" : "")">Monthly</a>
                    <a href="@Url.Action("Checkout", new { planId = Model.PlanId, cycle = "Yearly" })"
                       class="ck-cycle-btn @(Model.BillingCycle == "Yearly" ? "active" : "")">Yearly (−20%)</a>
                    <a href="@Url.Action("Checkout", new { planId = Model.PlanId, cycle = "Permanent" })"
                       class="ck-cycle-btn @(Model.BillingCycle == "Permanent" ? "active" : "")">Lifetime</a>
                </div>

                <!-- Features -->
                <ul class="ck-features">
                    <li>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4 12 14.01l-3-3"/></svg>
                        @(Model.MaxUsers == 0 ? "Unlimited" : Model.MaxUsers.ToString()) users
                    </li>
                    <li>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4 12 14.01l-3-3"/></svg>
                        @(Model.MaxCustomers == 0 ? "Unlimited" : Model.MaxCustomers.ToString()) customers
                    </li>
                    <li>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4 12 14.01l-3-3"/></svg>
                        @(Model.MaxJobOrdersPerMonth == 0 ? "Unlimited" : Model.MaxJobOrdersPerMonth.ToString()) job orders/month
                    </li>
                    @if (Model.HasAdvancedReports)
                    {
                        <li>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4 12 14.01l-3-3"/></svg>
                            Advanced reports
                        </li>
                    }
                    @if (Model.HasXeroIntegration)
                    {
                        <li>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4 12 14.01l-3-3"/></svg>
                            Xero accounting integration
                        </li>
                    }
                    @if (Model.HasPrioritySupport)
                    {
                        <li>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4 12 14.01l-3-3"/></svg>
                            Priority support
                        </li>
                    }
                </ul>

                <div class="ck-divider"></div>

                <div class="ck-total">
                    <span class="ck-total-label">Total</span>
                    <span class="ck-total-amount">₱@Model.Price.ToString("N0")</span>
                </div>

                <div class="ck-methods">
                    <span class="ck-method">GCash</span>
                    <span class="ck-method">Card</span>
                    <span class="ck-method">GrabPay</span>
                    <span class="ck-method">Maya</span>
                </div>

                <form method="post" asp-action="InitiatePayment" id="paymentForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="planId" value="@Model.PlanId" />
                    <input type="hidden" name="cycle" value="@Model.BillingCycle" />
                    <button type="submit" class="ck-submit" id="payBtn">
                        Proceed to Payment
                    </button>
                </form>

                <div class="ck-secure">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    256-bit SSL encrypted &bull; Powered by PayMongo
                </div>

                <a href="@Url.Action("Index", "Landing")" class="ck-back">&larr; Back to plans</a>
            </div>
        </div>
    </div>

    <script>
        document.getElementById('paymentForm').addEventListener('submit', function () {
            var btn = document.getElementById('payBtn');
            btn.disabled = true;
            btn.textContent = 'Redirecting to PayMongo...';
        });
    </script>
</body>
</html>
