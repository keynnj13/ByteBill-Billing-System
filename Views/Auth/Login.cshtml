@model ByteBill_BS.ViewModels.Auth.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    ViewData["HideNavigation"] = true;
}

<div class="login-page">
    <!-- Floating Particles -->
    <div class="login-particles" id="loginParticles"></div>

    <!-- Gradient Orbs -->
    <div class="login-orb login-orb-1"></div>
    <div class="login-orb login-orb-2"></div>
    <div class="login-orb login-orb-3"></div>

    <!-- Glassmorphism Card -->
    <div class="login-card-container">
        <div class="login-card">
            <!-- Logo -->
            <div class="login-card-logo">
                <img src="~/img/bytelogo.png" alt="ByteBill" onerror="this.parentElement.innerHTML='<h2 style=\'color:white;font-size:36px;font-weight:800;letter-spacing:-0.5px\'>ByteBill</h2>'" />
            </div>

            <div class="login-card-header">
                <h2>Welcome back</h2>
                <p>Sign in to continue to your dashboard</p>
            </div>

            @if (ViewBag.LockoutMessage != null)
            {
                <div class="login-alert login-alert-danger">
                    <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4.5c-.77-.833-2.694-.833-3.464 0L3.34 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
                    </svg>
                    <span>@ViewBag.LockoutMessage</span>
                </div>
            }

            <form method="post" asp-action="Login" asp-controller="Auth" id="loginForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />
                <partial name="_ValidationSummary" />

                <div class="login-field">
                    <label for="UserName" class="login-field-label">Username</label>
                    <div class="login-input-wrap">
                        <svg class="login-input-icon" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                        </svg>
                        <input type="text" id="UserName" asp-for="UserName"
                               class="login-input @(ViewData.ModelState["UserName"]?.Errors.Any() == true ? "is-invalid" : "")"
                               placeholder="Enter your username"
                               autocomplete="username" required />
                    </div>
                    <span asp-validation-for="UserName" class="form-error"></span>
                </div>

                <div class="login-field">
                    <label for="Password" class="login-field-label">Password</label>
                    <div class="login-input-wrap">
                        <svg class="login-input-icon" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                        </svg>
                        <input type="password" id="Password" asp-for="Password"
                               class="login-input @(ViewData.ModelState["Password"]?.Errors.Any() == true ? "is-invalid" : "")"
                               placeholder="Enter your password"
                               autocomplete="current-password" required />
                        <button type="button" class="pwd-toggle" id="togglePassword" tabindex="-1" aria-label="Toggle password visibility">
                            <svg id="eyeShow" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                            </svg>
                            <svg id="eyeHide" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="display:none;">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.878 9.878L3 3m6.878 6.878L21 21"></path>
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="form-error"></span>
                </div>

                <button type="submit" class="login-submit-btn" id="loginBtn">
                    <span id="loginBtnText">Sign In</span>
                    <svg id="loginBtnArrow" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                    </svg>
                    <span id="loginBtnSpinner" style="display:none;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" style="animation: spin 1s linear infinite;">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
                        </svg>
                        Signing in...
                    </span>
                </button>
            </form>

            <p class="login-footer-note">
                <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M12 2a10 10 0 100 20 10 10 0 000-20z"></path></svg>
                Contact your administrator to reset your password
            </p>
        </div>
    </div>
</div>

@section Styles {
<style>
    /* ── Login Page Layout ── */
    .login-page {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        padding: 40px 20px;
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);
        position: relative;
        overflow: hidden;
    }

    /* ── Animated Gradient Orbs ── */
    .login-orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        opacity: 0.5;
        pointer-events: none;
    }
    .login-orb-1 {
        width: 500px; height: 500px;
        background: radial-gradient(circle, rgba(46, 204, 113, 0.35), transparent 70%);
        top: -15%; left: -10%;
        animation: orb-float-1 18s ease-in-out infinite;
    }
    .login-orb-2 {
        width: 400px; height: 400px;
        background: radial-gradient(circle, rgba(59, 130, 246, 0.3), transparent 70%);
        bottom: -10%; right: -8%;
        animation: orb-float-2 22s ease-in-out infinite;
    }
    .login-orb-3 {
        width: 300px; height: 300px;
        background: radial-gradient(circle, rgba(139, 92, 246, 0.2), transparent 70%);
        top: 50%; left: 60%;
        animation: orb-float-3 15s ease-in-out infinite;
    }
    @@keyframes orb-float-1 {
        0%, 100% { transform: translate(0, 0) scale(1); }
        33% { transform: translate(60px, 40px) scale(1.1); }
        66% { transform: translate(-30px, 60px) scale(0.95); }
    }
    @@keyframes orb-float-2 {
        0%, 100% { transform: translate(0, 0) scale(1); }
        33% { transform: translate(-50px, -30px) scale(1.15); }
        66% { transform: translate(40px, -50px) scale(0.9); }
    }
    @@keyframes orb-float-3 {
        0%, 100% { transform: translate(0, 0) scale(1); }
        50% { transform: translate(-60px, -40px) scale(1.2); }
    }

    /* ── Floating Particles ── */
    .login-particles {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 0;
    }
    .login-particle {
        position: absolute;
        border-radius: 50%;
        pointer-events: none;
        opacity: 0;
        animation: particle-drift linear infinite;
    }
    @@keyframes particle-drift {
        0% { opacity: 0; transform: translateY(0) scale(0); }
        10% { opacity: 1; }
        90% { opacity: 1; }
        100% { opacity: 0; transform: translateY(-100vh) scale(1); }
    }

    /* ── Card Container ── */
    .login-card-container {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: 460px;
        animation: card-enter 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    @@keyframes card-enter {
        0% { opacity: 0; transform: translateY(30px) scale(0.96); }
        100% { opacity: 1; transform: translateY(0) scale(1); }
    }

    /* ── Glassmorphism Card ── */
    .login-card {
        background: rgba(255, 255, 255, 0.08);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        border-radius: 24px;
        padding: 44px 40px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        box-shadow: 0 32px 64px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.1);
    }
    @@media (max-width: 768px) {
        .login-card { padding: 36px 28px; }
        .login-card-container { max-width: 100%; }
    }

    /* ── Logo ── */
    .login-card-logo {
        display: flex;
        justify-content: center;
        margin-bottom: 28px;
    }
    .login-card-logo img {
        max-width: 240px;
        height: auto;
        filter: brightness(0) invert(1) drop-shadow(0 2px 12px rgba(46, 204, 113, 0.25));
    }
    @@media (max-width: 768px) {
        .login-card-logo img { max-width: 200px; }
    }

    .login-card-header {
        text-align: center;
        margin-bottom: 32px;
    }
    .login-card-header h2 {
        font-size: 24px;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 6px;
        letter-spacing: -0.3px;
    }
    .login-card-header p {
        font-size: 14px;
        color: rgba(255, 255, 255, 0.55);
    }

    /* ── Form Fields ── */
    .login-field { margin-bottom: 20px; }
    .login-field-label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.7);
        margin-bottom: 7px;
        letter-spacing: 0.2px;
    }
    .login-input-wrap { position: relative; }
    .login-input-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: rgba(255, 255, 255, 0.35);
        pointer-events: none;
        transition: color 0.25s;
    }
    .login-input-wrap:focus-within .login-input-icon {
        color: #2ecc71;
    }
    .login-input {
        width: 100%;
        height: 48px;
        padding: 0 44px;
        border: 1.5px solid rgba(255, 255, 255, 0.12);
        border-radius: 12px;
        font-family: inherit;
        font-size: 14px;
        color: #ffffff;
        background: rgba(255, 255, 255, 0.06);
        transition: all 0.3s ease;
    }
    .login-input:focus {
        outline: none;
        border-color: rgba(46, 204, 113, 0.6);
        background: rgba(255, 255, 255, 0.1);
        box-shadow: 0 0 0 3px rgba(46, 204, 113, 0.12), 0 0 20px rgba(46, 204, 113, 0.08);
    }
    .login-input::placeholder { color: rgba(255, 255, 255, 0.3); }
    .login-input.is-invalid { border-color: #ef4444; }
    .login-input:-webkit-autofill,
    .login-input:-webkit-autofill:focus {
        -webkit-text-fill-color: #ffffff;
        -webkit-box-shadow: 0 0 0 40px rgba(30, 41, 59, 0.99) inset;
        transition: background-color 5000s ease-in-out 0s;
    }

    /* ── Password Toggle ── */
    .pwd-toggle {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        cursor: pointer;
        color: rgba(255, 255, 255, 0.35);
        padding: 4px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: color 0.2s;
        z-index: 2;
    }
    .pwd-toggle:hover { color: rgba(255, 255, 255, 0.7); }



    /* ── Submit Button ── */
    .login-submit-btn {
        width: 100%;
        height: 50px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: linear-gradient(135deg, #2ecc71, #27ae60);
        color: white;
        border: none;
        border-radius: 12px;
        font-family: inherit;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        letter-spacing: 0.3px;
        position: relative;
        overflow: hidden;
    }
    .login-submit-btn::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, rgba(255,255,255,0.15), transparent);
        opacity: 0;
        transition: opacity 0.3s;
    }
    .login-submit-btn:hover:not(:disabled)::before { opacity: 1; }
    .login-submit-btn:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(46, 204, 113, 0.35), 0 0 40px rgba(46, 204, 113, 0.1);
    }
    .login-submit-btn:active:not(:disabled) {
        transform: translateY(0);
    }
    .login-submit-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    /* ── Footer Note ── */
    .login-footer-note {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        margin-top: 20px;
        font-size: 12px;
        color: rgba(255, 255, 255, 0.35);
    }

    /* ── Lockout Alert ── */
    .login-alert {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 16px;
        border-radius: 10px;
        margin-bottom: 20px;
        font-size: 13px;
        line-height: 1.4;
    }
    .login-alert-danger {
        background: rgba(239, 68, 68, 0.12);
        color: #fca5a5;
        border: 1px solid rgba(239, 68, 68, 0.2);
    }
    .login-alert svg { flex-shrink: 0; }

    /* ── Validation errors ── */
    .login-card .form-error { color: #fca5a5; }
    .login-card .validation-summary-errors { color: #fca5a5; background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.2); border-radius: 10px; padding: 10px 14px; margin-bottom: 16px; font-size: 13px; }
    .login-card .validation-summary-errors ul { margin: 0; padding-left: 16px; }

    @@keyframes spin { to { transform: rotate(360deg); } }

    /* ═══════════════════════════════════════════════════════
       LIGHT MODE — follows saved cookie preference
       ═══════════════════════════════════════════════════════ */
    [data-theme="light"] .login-page {
        background: linear-gradient(135deg, #0f1b2d 0%, #162544 40%, #1a365d 70%, #1e3a5f 100%);
    }
    [data-theme="light"] .login-orb-1 { background: radial-gradient(circle, rgba(59,130,246,0.20), transparent 70%); }
    [data-theme="light"] .login-orb-2 { background: radial-gradient(circle, rgba(46,204,113,0.15), transparent 70%); }
    [data-theme="light"] .login-orb-3 { background: radial-gradient(circle, rgba(99,102,241,0.12), transparent 70%); }

    [data-theme="light"] .login-card {
        background: rgba(255, 255, 255, 0.95);
        border: 1px solid rgba(255, 255, 255, 0.3);
        box-shadow: 0 24px 48px rgba(0, 0, 0, 0.2), 0 8px 16px rgba(0, 0, 0, 0.1);
    }
    [data-theme="light"] .login-card-logo img {
        filter: drop-shadow(0 2px 8px rgba(46,204,113,0.2));
    }
    [data-theme="light"] .login-card-header h2 { color: #1e293b; }
    [data-theme="light"] .login-card-header p { color: #64748b; }
    [data-theme="light"] .login-field-label { color: #475569; }
    [data-theme="light"] .login-input-icon { color: #94a3b8; }
    [data-theme="light"] .login-input-wrap:focus-within .login-input-icon { color: #2ecc71; }
    [data-theme="light"] .login-input {
        color: #1e293b;
        background: rgba(255, 255, 255, 0.8);
        border-color: #cbd5e1;
    }
    [data-theme="light"] .login-input:focus {
        background: #ffffff;
        border-color: rgba(46,204,113,0.5);
        box-shadow: 0 0 0 3px rgba(46,204,113,0.12);
    }
    [data-theme="light"] .login-input::placeholder { color: #94a3b8; }
    [data-theme="light"] .login-input:-webkit-autofill,
    [data-theme="light"] .login-input:-webkit-autofill:focus {
        -webkit-text-fill-color: #1e293b;
        -webkit-box-shadow: 0 0 0 40px #ffffff inset;
    }
    [data-theme="light"] .pwd-toggle { color: #94a3b8; }
    [data-theme="light"] .pwd-toggle:hover { color: #475569; }
    [data-theme="light"] .login-footer-note { color: #94a3b8; }
    [data-theme="light"] .login-alert-danger {
        background: rgba(239,68,68,0.08);
        color: #dc2626;
        border-color: rgba(239,68,68,0.18);
    }
    [data-theme="light"] .login-card .form-error { color: #dc2626; }
    [data-theme="light"] .login-card .validation-summary-errors {
        color: #dc2626;
        background: rgba(239,68,68,0.06);
        border-color: rgba(239,68,68,0.15);
    }
</style>
}

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // ── Password toggle ──
        var toggle = document.getElementById('togglePassword');
        var pwdInput = document.getElementById('Password');
        var eyeShow = document.getElementById('eyeShow');
        var eyeHide = document.getElementById('eyeHide');

        if (toggle && pwdInput) {
            toggle.addEventListener('click', function () {
                var isPassword = pwdInput.type === 'password';
                pwdInput.type = isPassword ? 'text' : 'password';
                eyeShow.style.display = isPassword ? 'none' : 'block';
                eyeHide.style.display = isPassword ? 'block' : 'none';
                pwdInput.focus();
            });
        }

        // ── Submit spinner ──
        var form = document.getElementById('loginForm');
        if (form) {
            form.addEventListener('submit', function () {
                var btn = document.getElementById('loginBtn');
                var text = document.getElementById('loginBtnText');
                var arrow = document.getElementById('loginBtnArrow');
                var spinner = document.getElementById('loginBtnSpinner');
                if (btn && text && arrow && spinner) {
                    btn.disabled = true;
                    text.style.display = 'none';
                    arrow.style.display = 'none';
                    spinner.style.display = 'inline-flex';
                }
            });
        }

        // ── Floating particles ──
        var container = document.getElementById('loginParticles');
        if (container) {
            var colors = ['rgba(46,204,113,0.6)', 'rgba(59,130,246,0.5)', 'rgba(139,92,246,0.4)', 'rgba(255,255,255,0.3)'];
            for (var i = 0; i < 30; i++) {
                var p = document.createElement('div');
                p.className = 'login-particle';
                var size = Math.random() * 4 + 2;
                var dur = Math.random() * 15 + 10;
                var delay = Math.random() * 15;
                p.style.cssText = 'width:' + size + 'px;height:' + size + 'px;left:' + (Math.random() * 100) + '%;bottom:-10px;background:' + colors[Math.floor(Math.random() * colors.length)] + ';animation-duration:' + dur + 's;animation-delay:' + delay + 's;';
                container.appendChild(p);
            }
        }
    });
</script>