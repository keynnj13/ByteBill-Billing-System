@model ByteBill_BS.ViewModels.Auth.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    ViewData["HideNavigation"] = true;
}

<div class="login-page">
    <!-- Single Centered Card -->
    <div class="login-card-container">
        <div class="login-card">
            <!-- Large Logo -->
            <div class="login-card-logo">
                <img src="~/img/bytelogo.png" alt="ByteBill" onerror="this.parentElement.innerHTML='<h2 style=color:var(--navy);font-size:32px;font-weight:700>ByteBill</h2>'" />
            </div>

            <div class="login-card-header">
                <h2>Sign in to your account</h2>
                <p>Enter your credentials to access your dashboard</p>
            </div>
            
            @if (ViewBag.LockoutMessage != null)
            {
                <div class="login-alert login-alert-danger">
                    <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4.5c-.77-.833-2.694-.833-3.464 0L3.34 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
                    </svg>
                    <span>@ViewBag.LockoutMessage</span>
                </div>
            }

            <form method="post" asp-action="Login" asp-controller="Auth" id="loginForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />
                <partial name="_ValidationSummary" />
                
                <div class="login-field">
                    <label for="UserName" class="login-field-label">Username</label>
                    <div class="login-input-wrap">
                        <svg class="login-input-icon" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                        </svg>
                        <input type="text" id="UserName" asp-for="UserName"
                               class="login-input @(ViewData.ModelState["UserName"]?.Errors.Any() == true ? "is-invalid" : "")"
                               placeholder="Enter your username"
                               autocomplete="username" required />
                    </div>
                    <span asp-validation-for="UserName" class="form-error"></span>
                </div>
                
                <div class="login-field">
                    <label for="Password" class="login-field-label">Password</label>
                    <div class="login-input-wrap">
                        <svg class="login-input-icon" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                        </svg>
                        <input type="password" id="Password" asp-for="Password"
                               class="login-input @(ViewData.ModelState["Password"]?.Errors.Any() == true ? "is-invalid" : "")"
                               placeholder="Enter your password"
                               autocomplete="current-password" required />
                        <button type="button" class="pwd-toggle" id="togglePassword" tabindex="-1" aria-label="Toggle password visibility">
                            <svg id="eyeShow" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                            </svg>
                            <svg id="eyeHide" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="display:none;">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.878 9.878L3 3m6.878 6.878L21 21"></path>
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="form-error"></span>
                </div>
                
                <div class="login-options">
                    <label class="form-check">
                        <input type="checkbox" asp-for="RememberMe" class="form-check-input" />
                        <span class="form-check-label">Remember me</span>
                    </label>
                    <a href="#" class="login-forgot">Forgot password?</a>
                </div>
                
                <button type="submit" class="login-submit-btn" id="loginBtn">
                    <span id="loginBtnText">Sign In</span>
                    <svg id="loginBtnArrow" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                    </svg>
                    <span id="loginBtnSpinner" style="display:none;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" style="animation: spin 1s linear infinite;">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
                        </svg>
                        Signing in...
                    </span>
                </button>
            </form>
        </div>
    </div>
</div>

@section Styles {
<style>
    /* ── Login Page Layout ── */
    .login-page {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        padding: 40px 20px;
        background: linear-gradient(135deg, 
            hsl(213, 54%, 22%) 0%,
            hsl(213, 54%, 28%) 25%,
            hsl(213, 54%, 32%) 50%,
            hsl(213, 54%, 28%) 75%,
            hsl(213, 54%, 24%) 100%);
        position: relative;
        overflow: hidden;
    }
    .login-page::before {
        content: '';
        position: absolute;
        inset: 0;
        background: 
            radial-gradient(circle at 15% 20%, rgba(46, 204, 113, 0.15) 0%, transparent 35%),
            radial-gradient(circle at 85% 80%, rgba(46, 204, 113, 0.12) 0%, transparent 40%),
            radial-gradient(circle at 50% 50%, rgba(46, 204, 113, 0.08) 0%, transparent 50%);
        animation: emerald-pulse 12s ease-in-out infinite alternate;
    }
    .login-page::after {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 60% 40%, rgba(255, 255, 255, 0.03) 0%, transparent 40%);
        animation: subtle-shimmer 10s ease-in-out infinite alternate;
    }
    @@keyframes emerald-pulse {
        0% { opacity: 1; transform: scale(1); }
        100% { opacity: 0.7; transform: scale(1.1); }
    }
    @@keyframes subtle-shimmer {
        0% { opacity: 0.5; }
        100% { opacity: 1; }
    }

    /* ── Single Centered Card Container ── */
    .login-card-container {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 520px;
    }

    /* ── Login Card ── */
    .login-card {
        background: white;
        border-radius: 24px;
        padding: 48px 44px;
        box-shadow: 0 20px 80px rgba(0,0,0,0.3), 0 8px 32px rgba(0,0,0,0.2);
        border: 1px solid rgba(255,255,255,0.1);
    }
    @@media (max-width: 768px) {
        .login-card {
            padding: 40px 32px;
        }
    }

    /* ── Large Logo ── */
    .login-card-logo {
        display: flex;
        justify-content: center;
        margin-bottom: 32px;
    }
    .login-card-logo img {
        max-width: 290px;
        height: auto;
        filter: drop-shadow(0 2px 12px rgba(0,0,0,0.1));
    }
    @@media (max-width: 768px) {
        .login-card-logo img { max-width: 240px; }
    }

    .login-card-header {
        text-align: center;
        margin-bottom: 28px;
    }
    .login-card-header h2 {
        font-size: 22px;
        font-weight: 700;
        color: var(--gray-900);
        margin-bottom: 6px;
    }
    .login-card-header p {
        font-size: 14px;
        color: var(--muted);
    }

    /* ── Form Fields ── */
    .login-field {
        margin-bottom: 20px;
    }
    .login-field-label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: var(--gray-700);
        margin-bottom: 6px;
    }
    .login-input-wrap {
        position: relative;
    }
    .login-input-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--gray-400);
        pointer-events: none;
    }
    .login-input {
        width: 100%;
        height: 46px;
        padding: 0 44px;
        border: 1.5px solid var(--gray-200);
        border-radius: 10px;
        font-family: inherit;
        font-size: 14px;
        color: var(--foreground);
        background: var(--gray-50);
        transition: all 0.2s ease;
    }
    .login-input:focus {
        outline: none;
        border-color: var(--emerald);
        background: white;
        box-shadow: 0 0 0 3px rgba(46, 204, 113, 0.1);
    }
    .login-input::placeholder {
        color: var(--gray-400);
    }
    .login-input.is-invalid {
        border-color: var(--destructive);
    }

    /* ── Password Toggle ── */
    .pwd-toggle {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        cursor: pointer;
        color: var(--gray-400);
        padding: 4px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: color 0.2s;
        z-index: 2;
    }
    .pwd-toggle:hover { color: var(--gray-700); }

    /* ── Login Options Row ── */
    .login-options {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }
    .login-forgot {
        font-size: 13px;
        color: var(--emerald);
        text-decoration: none;
        font-weight: 500;
    }
    .login-forgot:hover {
        text-decoration: underline;
    }

    /* ── Submit Button ── */
    .login-submit-btn {
        width: 100%;
        height: 48px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: var(--navy);
        color: white;
        border: none;
        border-radius: 10px;
        font-family: inherit;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        letter-spacing: 0.2px;
    }
    .login-submit-btn:hover:not(:disabled) {
        background: var(--navy-600);
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(27, 58, 95, 0.25);
    }
    .login-submit-btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    /* ── Lockout Alert ── */
    .login-alert {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 16px;
        border-radius: 10px;
        margin-bottom: 20px;
        font-size: 13px;
        line-height: 1.4;
    }
    .login-alert-danger {
        background: #fef2f2;
        color: #dc2626;
        border: 1px solid rgba(220, 38, 38, 0.12);
    }
    .login-alert svg { flex-shrink: 0; }

    @@keyframes spin { to { transform: rotate(360deg); } }
</style>
}

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const toggle = document.getElementById('togglePassword');
        const pwdInput = document.getElementById('Password');
        const eyeShow = document.getElementById('eyeShow');
        const eyeHide = document.getElementById('eyeHide');

        if (toggle && pwdInput) {
            toggle.addEventListener('click', function () {
                const isPassword = pwdInput.type === 'password';
                pwdInput.type = isPassword ? 'text' : 'password';
                eyeShow.style.display = isPassword ? 'none' : 'block';
                eyeHide.style.display = isPassword ? 'block' : 'none';
                pwdInput.focus();
            });
        }

        var form = document.getElementById('loginForm');
        if (form) {
            form.addEventListener('submit', function () {
                var btn = document.getElementById('loginBtn');
                var text = document.getElementById('loginBtnText');
                var arrow = document.getElementById('loginBtnArrow');
                var spinner = document.getElementById('loginBtnSpinner');
                if (btn && text && arrow && spinner) {
                    btn.disabled = true;
                    text.style.display = 'none';
                    arrow.style.display = 'none';
                    spinner.style.display = 'inline-flex';
                }
            });
        }
    });
</script>