@model ByteBill_BS.ViewModels.Auth.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    ViewData["HideNavigation"] = true;
}

<div class="login-page">
    <!-- Floating Particles -->
    <div class="login-particles" id="loginParticles"></div>

    <!-- Gradient Orbs -->
    <div class="login-orb login-orb-1"></div>
    <div class="login-orb login-orb-2"></div>
    <div class="login-orb login-orb-3"></div>

    <!-- Discord-style 2-Panel Card -->
    <a href="@Url.Action("Index", "Landing")" class="login-back-link">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Back to Home
    </a>
    <div class="login-card-container">
        <div class="login-card">
            <!-- ═══ LEFT PANEL — Login Form ═══ -->
            <div class="login-panel-left">
                <!-- Logo -->
                <div class="login-card-logo">
                    <img src="~/img/bytelogo.png" alt="ByteBill" onerror="this.parentElement.innerHTML='<h2 style=\'color:white;font-size:28px;font-weight:800;letter-spacing:-0.5px\'>ByteBill</h2>'" />
                </div>

                <div class="login-card-header">
                    <h2>Welcome back</h2>
                    <p>Sign in to continue to your dashboard</p>
                </div>

                @if (TempData["AuthMessage"] != null)
                {
                    <div class="login-alert login-alert-info">
                        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M12 2a10 10 0 100 20 10 10 0 000-20z"></path>
                        </svg>
                        <span>@TempData["AuthMessage"]</span>
                    </div>
                }

                @if (ViewBag.LockoutMessage != null)
                {
                    <div class="login-alert login-alert-danger">
                        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4.5c-.77-.833-2.694-.833-3.464 0L3.34 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
                        </svg>
                        <span>@ViewBag.LockoutMessage</span>
                    </div>
                }

                <form method="post" asp-action="Login" asp-controller="Auth" id="loginForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />
                    <input type="hidden" asp-for="RecaptchaToken" id="RecaptchaToken" />
                    <partial name="_ValidationSummary" />

                    <div class="login-field">
                        <label for="UserName" class="login-field-label">Username or Email</label>
                        <div class="login-input-wrap">
                            <svg class="login-input-icon" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                            </svg>
                            <input type="text" id="UserName" asp-for="UserName"
                                   class="login-input @(ViewData.ModelState["UserName"]?.Errors.Any() == true ? "is-invalid" : "")"
                                   placeholder="Enter username or email"
                                   autocomplete="username" required />
                        </div>
                        <span asp-validation-for="UserName" class="form-error"></span>
                    </div>

                    <div class="login-field">
                        <label for="Password" class="login-field-label">Password</label>
                        <div class="login-input-wrap">
                            <svg class="login-input-icon" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                            </svg>
                            <input type="password" id="Password" asp-for="Password"
                                   class="login-input @(ViewData.ModelState["Password"]?.Errors.Any() == true ? "is-invalid" : "")"
                                   placeholder="Enter your password"
                                   autocomplete="current-password" required />
                            <button type="button" class="pwd-toggle" id="togglePassword" tabindex="-1" aria-label="Toggle password visibility">
                                <svg id="eyeShow" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                </svg>
                                <svg id="eyeHide" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="display:none;">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.878 9.878L3 3m6.878 6.878L21 21"></path>
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="form-error"></span>
                    </div>

                    <div class="login-actions-row">
                        <a asp-controller="Auth" asp-action="ForgotPassword" class="login-forgot-link">Forgot password?</a>
                    </div>

                    <button type="submit" class="login-submit-btn" id="loginBtn">
                        <span id="loginBtnText">Sign In</span>
                        <svg id="loginBtnArrow" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                        </svg>
                        <span id="loginBtnSpinner" style="display:none;">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" style="animation: spin 1s linear infinite;">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
                            </svg>
                            Signing in...
                        </span>
                    </button>
                </form>

                <p class="login-footer-note">
                    <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M12 2a10 10 0 100 20 10 10 0 000-20z"></path></svg>
                    Secure account recovery is available via email
                </p>
            </div>

            <!-- ═══ RIGHT PANEL — Feature Highlights ═══ -->
            <div class="login-panel-right">
                <div class="login-right-content">
                    <div class="login-right-badge">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                        Business ERP Platform
                    </div>
                    <h3 class="login-right-title">Everything your shop needs to grow</h3>
                    <p class="login-right-subtitle">Manage your entire business in one platform</p>

                    <div class="login-features">
                        <div class="login-feature">
                            <div class="login-feature-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
                            </div>
                            <div>
                                <div class="login-feature-label">Invoicing & Billing</div>
                                <div class="login-feature-desc">BIR-compliant invoices with automatic tax computation</div>
                            </div>
                        </div>
                        <div class="login-feature">
                            <div class="login-feature-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg>
                            </div>
                            <div>
                                <div class="login-feature-label">Job Orders</div>
                                <div class="login-feature-desc">Track repairs, assign technicians, monitor progress</div>
                            </div>
                        </div>
                        <div class="login-feature">
                            <div class="login-feature-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
                            </div>
                            <div>
                                <div class="login-feature-label">Inventory</div>
                                <div class="login-feature-desc">Real-time stock tracking with parts catalog</div>
                            </div>
                        </div>
                        <div class="login-feature">
                            <div class="login-feature-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                            </div>
                            <div>
                                <div class="login-feature-label">Online Payments</div>
                                <div class="login-feature-desc">GCash, credit card, GrabPay & Maya</div>
                            </div>
                        </div>
                        <div class="login-feature">
                            <div class="login-feature-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>
                            </div>
                            <div>
                                <div class="login-feature-label">Team Management</div>
                                <div class="login-feature-desc">Role-based access for your entire staff</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="login-right-foot">
                    &copy; @DateTime.Now.Year ByteBill &middot; All rights reserved
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
<style>
    /* ── Login Page Layout ── */
    .login-page {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        padding: 40px 20px;
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);
        position: relative;
        overflow: hidden;
    }

    /* ── Animated Gradient Orbs ── */
    .login-orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        opacity: 0.5;
        pointer-events: none;
    }
    .login-orb-1 {
        width: 500px; height: 500px;
        background: radial-gradient(circle, rgba(46, 204, 113, 0.35), transparent 70%);
        top: -15%; left: -10%;
        animation: orb-float-1 18s ease-in-out infinite;
    }
    .login-orb-2 {
        width: 400px; height: 400px;
        background: radial-gradient(circle, rgba(59, 130, 246, 0.3), transparent 70%);
        bottom: -10%; right: -8%;
        animation: orb-float-2 22s ease-in-out infinite;
    }
    .login-orb-3 {
        width: 300px; height: 300px;
        background: radial-gradient(circle, rgba(139, 92, 246, 0.2), transparent 70%);
        top: 50%; left: 60%;
        animation: orb-float-3 15s ease-in-out infinite;
    }
    @@keyframes orb-float-1 {
        0%, 100% { transform: translate(0, 0) scale(1); }
        33% { transform: translate(60px, 40px) scale(1.1); }
        66% { transform: translate(-30px, 60px) scale(0.95); }
    }
    @@keyframes orb-float-2 {
        0%, 100% { transform: translate(0, 0) scale(1); }
        33% { transform: translate(-50px, -30px) scale(1.15); }
        66% { transform: translate(40px, -50px) scale(0.9); }
    }
    @@keyframes orb-float-3 {
        0%, 100% { transform: translate(0, 0) scale(1); }
        50% { transform: translate(-60px, -40px) scale(1.2); }
    }

    /* ── Floating Particles ── */
    .login-particles {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 0;
    }
    .login-particle {
        position: absolute;
        border-radius: 50%;
        pointer-events: none;
        opacity: 0;
        animation: particle-drift linear infinite;
    }
    @@keyframes particle-drift {
        0% { opacity: 0; transform: translateY(0) scale(0); }
        10% { opacity: 1; }
        90% { opacity: 1; }
        100% { opacity: 0; transform: translateY(-100vh) scale(1); }
    }

    /* ── Back to Home Link ── */
    .login-back-link {
        position: absolute;
        top: 28px;
        left: 32px;
        z-index: 10;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: rgba(255,255,255,0.7);
        text-decoration: none;
        font-size: 14px;
        font-weight: 500;
        transition: color 0.2s;
    }
    .login-back-link:hover {
        color: #2ecc71;
    }

    /* ── Card Container ── */
    .login-card-container {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: 880px;
        animation: card-enter 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    @@keyframes card-enter {
        0% { opacity: 0; transform: translateY(30px) scale(0.96); }
        100% { opacity: 1; transform: translateY(0) scale(1); }
    }

    /* ── 2-Panel Card ── */
    .login-card {
        display: flex;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 32px 64px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.1);
    }

    /* ── Left Panel (Form) ── */
    .login-panel-left {
        flex: 1;
        min-width: 0;
        background: rgba(255, 255, 255, 0.08);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        border-left: 1px solid rgba(255, 255, 255, 0.08);
        padding: 44px 40px;
        order: 2;
    }

    /* ── Right Panel (Features) ── */
    .login-panel-right {
        width: 340px;
        flex-shrink: 0;
        background: linear-gradient(160deg, hsl(213, 54%, 18%) 0%, hsl(213, 54%, 14%) 100%);
        background-image: radial-gradient(ellipse at 30% 90%, hsla(145, 63%, 42%, 0.10) 0%, transparent 50%),
                          radial-gradient(ellipse at 70% 10%, hsla(213, 54%, 40%, 0.12) 0%, transparent 50%),
                          linear-gradient(160deg, hsl(213, 54%, 18%) 0%, hsl(213, 54%, 14%) 100%);
        padding: 40px 28px;
        display: flex;
        flex-direction: column;
        color: white;
        order: 1;
    }

    .login-right-content { flex: 1; }

    .login-right-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(46, 204, 113, 0.12);
        border: 1px solid rgba(46, 204, 113, 0.18);
        padding: 5px 12px;
        border-radius: 8px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        color: hsl(145, 63%, 60%);
        margin-bottom: 24px;
    }

    .login-right-title {
        font-size: 22px;
        font-weight: 800;
        line-height: 1.25;
        letter-spacing: -0.3px;
        margin-bottom: 8px;
    }

    .login-right-subtitle {
        font-size: 13px;
        opacity: 0.45;
        line-height: 1.5;
        margin-bottom: 32px;
    }

    .login-features {
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .login-feature {
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }

    .login-feature-icon {
        width: 36px;
        height: 36px;
        border-radius: 9px;
        background: rgba(46, 204, 113, 0.10);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        color: hsl(145, 63%, 55%);
    }

    .login-feature-label {
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 2px;
    }

    .login-feature-desc {
        font-size: 12px;
        opacity: 0.45;
        line-height: 1.4;
    }

    .login-right-foot {
        font-size: 11px;
        opacity: 0.2;
        margin-top: 28px;
        padding-top: 16px;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
    }

    /* ── Logo ── */
    .login-card-logo {
        display: flex;
        justify-content: center;
        margin-bottom: 28px;
    }
    .login-card-logo img {
        max-width: 280px;
        height: auto;
        filter: brightness(0) invert(1) drop-shadow(0 4px 16px rgba(46, 204, 113, 0.35));
    }

    .login-card-header {
        text-align: center;
        margin-bottom: 32px;
    }
    .login-card-header h2 {
        font-size: 24px;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 6px;
        letter-spacing: -0.3px;
    }
    .login-card-header p {
        font-size: 14px;
        color: rgba(255, 255, 255, 0.55);
    }

    /* ── Form Fields ── */
    .login-field { margin-bottom: 20px; }
    .login-field-label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.7);
        margin-bottom: 7px;
        letter-spacing: 0.2px;
    }
    .login-actions-row {
        margin-top: -4px;
        margin-bottom: 14px;
        display: flex;
        justify-content: flex-end;
    }
    .login-forgot-link {
        color: #93c5fd;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        transition: color 0.2s ease;
    }
    .login-forgot-link:hover {
        color: #bfdbfe;
        text-decoration: underline;
    }
    .login-input-wrap { position: relative; }
    .login-input-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: rgba(255, 255, 255, 0.35);
        pointer-events: none;
        transition: color 0.25s;
    }
    .login-input-wrap:focus-within .login-input-icon {
        color: #2ecc71;
    }
    .login-input {
        width: 100%;
        height: 48px;
        padding: 0 44px;
        border: 1.5px solid rgba(255, 255, 255, 0.12);
        border-radius: 12px;
        font-family: inherit;
        font-size: 14px;
        color: #ffffff;
        background: rgba(255, 255, 255, 0.06);
        transition: all 0.3s ease;
    }
    .login-input:focus {
        outline: none;
        border-color: rgba(46, 204, 113, 0.6);
        background: rgba(255, 255, 255, 0.1);
        box-shadow: 0 0 0 3px rgba(46, 204, 113, 0.12), 0 0 20px rgba(46, 204, 113, 0.08);
    }
    .login-input::placeholder { color: rgba(255, 255, 255, 0.3); }
    .login-input.is-invalid { border-color: #ef4444; }
    .login-input:-webkit-autofill,
    .login-input:-webkit-autofill:focus {
        -webkit-text-fill-color: #ffffff;
        -webkit-box-shadow: 0 0 0 40px rgba(30, 41, 59, 0.99) inset;
        transition: background-color 5000s ease-in-out 0s;
    }

    /* ── Password Toggle ── */
    .pwd-toggle {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        cursor: pointer;
        color: rgba(255, 255, 255, 0.35);
        padding: 4px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: color 0.2s;
        z-index: 2;
    }
    .pwd-toggle:hover { color: rgba(255, 255, 255, 0.7); }

    /* ── Submit Button ── */
    .login-submit-btn {
        width: 100%;
        height: 50px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: linear-gradient(135deg, #2ecc71, #27ae60);
        color: white;
        border: none;
        border-radius: 12px;
        font-family: inherit;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        letter-spacing: 0.3px;
        position: relative;
        overflow: hidden;
    }
    .login-submit-btn::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, rgba(255,255,255,0.15), transparent);
        opacity: 0;
        transition: opacity 0.3s;
    }
    .login-submit-btn:hover:not(:disabled)::before { opacity: 1; }
    .login-submit-btn:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(46, 204, 113, 0.35), 0 0 40px rgba(46, 204, 113, 0.1);
    }
    .login-submit-btn:active:not(:disabled) {
        transform: translateY(0);
    }
    .login-submit-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    /* ── Footer Note ── */
    .login-footer-note {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        margin-top: 20px;
        font-size: 12px;
        color: rgba(255, 255, 255, 0.35);
    }

    /* ── Lockout Alert ── */
    .login-alert {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 16px;
        border-radius: 10px;
        margin-bottom: 20px;
        font-size: 13px;
        line-height: 1.4;
    }
    .login-alert-danger {
        background: rgba(239, 68, 68, 0.12);
        color: #fca5a5;
        border: 1px solid rgba(239, 68, 68, 0.2);
    }
    .login-alert-info {
        background: rgba(56, 189, 248, 0.14);
        color: #bae6fd;
        border: 1px solid rgba(56, 189, 248, 0.28);
    }
    .login-alert svg { flex-shrink: 0; }

    /* ── Validation errors ── */
    .login-card .form-error,
    .login-panel-left .form-error { color: #fca5a5; }
    .login-card .validation-summary-errors,
    .login-panel-left .validation-summary-errors { color: #fca5a5; background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.2); border-radius: 10px; padding: 10px 14px; margin-bottom: 16px; font-size: 13px; }
    .login-card .validation-summary-errors ul,
    .login-panel-left .validation-summary-errors ul { margin: 0; padding-left: 16px; }

    @@keyframes spin { to { transform: rotate(360deg); } }

    /* ── Responsive: stack panels on mobile ── */
    @@media (max-width: 768px) {
        .login-card { flex-direction: column; }
        .login-panel-left { padding: 36px 28px; border-left: none; }
