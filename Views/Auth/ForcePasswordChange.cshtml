@model ByteBill_BS.ViewModels.Auth.ForcePasswordChangeViewModel
@{
    ViewData["Title"] = "Create New Password";
    ViewData["HideNavigation"] = true;
}

<div class="recovery-page">
    <div class="card recovery-card recovery-card-wide recovery-card-modern force-password-shell">
        <div class="recovery-header-meta force-password-header">
            <span class="recovery-kicker">Account Security</span>
            <div class="force-password-header-actions">
                <span class="recovery-session-pill">Required Step</span>
                <a href="/Auth/Logout" class="btn btn-ghost btn-sm force-password-logout" aria-label="Sign out and continue later">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H9"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13 20H6a2 2 0 01-2-2V6a2 2 0 012-2h7"></path>
                    </svg>
                    Sign Out
                </a>
            </div>
        </div>

        <h1 class="recovery-title">Create your new password</h1>
        <p class="recovery-subtitle">This is required for account protection before you can continue to your dashboard.</p>

        <form method="post" asp-action="ForcePasswordChange" asp-controller="Auth" id="forcePwForm" class="recovery-form" novalidate>
            @Html.AntiForgeryToken()
            <partial name="_ValidationSummary" />

            <div class="recovery-form-grid">
                <div class="recovery-form-main">
                    <div class="form-group">
                        <label asp-for="NewPassword" class="form-label">New Password</label>
                        <div class="recovery-password-wrap">
                            <input asp-for="NewPassword" class="form-input" type="password" autocomplete="new-password" id="newPasswordInput" aria-describedby="newPasswordHelp newPasswordError" aria-required="true" />
                            <button type="button" class="recovery-password-toggle" data-target="newPasswordInput" data-password-toggle aria-label="Show new password" aria-controls="newPasswordInput" aria-pressed="false">
                                <svg data-eye-open width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                                <svg data-eye-closed width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none;"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24" /><line x1="1" y1="1" x2="23" y2="23" /></svg>
                            </button>
                        </div>
                        <p id="newPasswordHelp" class="recovery-input-note">Use 12+ characters including uppercase, lowercase, number, and special character.</p>
                        <span asp-validation-for="NewPassword" id="newPasswordError" class="form-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                        <div class="recovery-password-wrap">
                            <input asp-for="ConfirmPassword" class="form-input" type="password" autocomplete="new-password" id="confirmPasswordInput" aria-describedby="confirmPasswordError confirmInlineError" aria-required="true" />
                            <button type="button" class="recovery-password-toggle" data-target="confirmPasswordInput" data-password-toggle aria-label="Show confirm password" aria-controls="confirmPasswordInput" aria-pressed="false">
                                <svg data-eye-open width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                                <svg data-eye-closed width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none;"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24" /><line x1="1" y1="1" x2="23" y2="23" /></svg>
                            </button>
                        </div>
                        <p id="confirmInlineError" class="form-error" aria-live="polite"></p>
                        <span asp-validation-for="ConfirmPassword" id="confirmPasswordError" class="form-error"></span>
                    </div>

                    <div class="recovery-strength" aria-live="polite" aria-atomic="true" role="status">
                        <div class="recovery-strength-row">
                            <span>Password strength</span>
                            <span id="pwStrengthLabel">Weak</span>
                        </div>
                        <div class="recovery-strength-track">
                            <span id="pwStrengthFill" class="recovery-strength-fill is-weak"></span>
                        </div>
                    </div>
                </div>

                <div class="recovery-form-side">
                    <div class="recovery-checklist" id="pwChecklist" aria-live="polite" aria-label="Password requirements">
                        <h2 class="recovery-checklist-title">Password requirements</h2>

                        <div class="recovery-check-item" data-rule="length">
                            <span class="recovery-check-dot" aria-hidden="true"></span>
                            <span>At least 12 characters</span>
                        </div>
                        <div class="recovery-check-item" data-rule="upper">
                            <span class="recovery-check-dot" aria-hidden="true"></span>
                            <span>At least one uppercase letter</span>
                        </div>
                        <div class="recovery-check-item" data-rule="lower">
                            <span class="recovery-check-dot" aria-hidden="true"></span>
                            <span>At least one lowercase letter</span>
                        </div>
                        <div class="recovery-check-item" data-rule="number">
                            <span class="recovery-check-dot" aria-hidden="true"></span>
                            <span>At least one number</span>
                        </div>
                        <div class="recovery-check-item" data-rule="special">
                            <span class="recovery-check-dot" aria-hidden="true"></span>
                            <span>At least one special character</span>
                        </div>
                        <div class="recovery-check-item" data-rule="match">
                            <span class="recovery-check-dot" aria-hidden="true"></span>
                            <span>Passwords match</span>
                        </div>
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-primary recovery-submit" id="savePasswordBtn" disabled>
                Save Password and Continue
            </button>
            <p class="recovery-footnote">You will be redirected automatically once your password is saved.</p>
        </form>
    </div>
</div>

@section Styles {
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/auth-recovery.css" asp-append-version="true" />
}

@section Scripts {
<script>
    (function () {
        var form = document.getElementById('forcePwForm');
        var newPasswordInput = document.getElementById('newPasswordInput');
        var confirmPasswordInput = document.getElementById('confirmPasswordInput');
        var submitBtn = document.getElementById('savePasswordBtn');
        var strengthFill = document.getElementById('pwStrengthFill');
        var strengthLabel = document.getElementById('pwStrengthLabel');
        var confirmInlineError = document.getElementById('confirmInlineError');

        if (!form || !newPasswordInput || !confirmPasswordInput || !submitBtn) {
            return;
        }

        var rules = {
            length: function (v) { return v.length >= 12; },
            upper: function (v) { return /[A-Z]/.test(v); },
            lower: function (v) { return /[a-z]/.test(v); },
            number: function (v) { return /\d/.test(v); },
            special: function (v) { return /[^A-Za-z0-9]/.test(v); },
            match: function (v, c) { return v.length > 0 && v === c; }
        };

        function setRuleState(ruleName, passed) {
            var item = document.querySelector('[data-rule="' + ruleName + '"]');
            if (!item) {
                return;
            }

            item.classList.toggle('ok', !!passed);
        }

        function evaluateRules() {
            var newValue = newPasswordInput.value || '';
            var confirmValue = confirmPasswordInput.value || '';

            var lengthOk = rules.length(newValue);
            var upperOk = rules.upper(newValue);
            var lowerOk = rules.lower(newValue);
            var numberOk = rules.number(newValue);
            var specialOk = rules.special(newValue);
            var matchOk = rules.match(newValue, confirmValue);

            setRuleState('length', lengthOk);
            setRuleState('upper', upperOk);
            setRuleState('lower', lowerOk);
            setRuleState('number', numberOk);
            setRuleState('special', specialOk);
            setRuleState('match', matchOk);

            var allOk = lengthOk && upperOk && lowerOk && numberOk && specialOk && matchOk;

            var strengthScore = 0;
            if (newValue.length >= 12) strengthScore += 1;
            if (upperOk) strengthScore += 1;
            if (lowerOk) strengthScore += 1;
            if (numberOk) strengthScore += 1;
            if (specialOk) strengthScore += 1;

            if (strengthFill && strengthLabel) {
                var fillClass = 'is-weak';
                var strengthText = 'Weak';
                var strengthWidth = '20%';

                if (strengthScore >= 5) {
                    fillClass = 'is-excellent';
                    strengthText = 'Strong';
                    strengthWidth = '100%';
                } else if (strengthScore >= 4) {
                    fillClass = 'is-strong';
                    strengthText = 'Good';
                    strengthWidth = '80%';
                } else if (strengthScore >= 3) {
                    fillClass = 'is-fair';
                    strengthText = 'Fair';
                    strengthWidth = '55%';
                }

                if (!newValue.length) {
                    fillClass = 'is-weak';
                    strengthText = 'Weak';
                    strengthWidth = '0%';
                }

                strengthFill.className = 'recovery-strength-fill ' + fillClass;
                strengthFill.style.width = strengthWidth;
                strengthLabel.textContent = strengthText;
            }

            if (confirmInlineError) {
                confirmInlineError.textContent = confirmValue.length && !matchOk ? 'Passwords do not match yet.' : '';
            }

            confirmPasswordInput.setCustomValidity(confirmValue.length && !matchOk ? 'Passwords do not match.' : '');

            submitBtn.disabled = !allOk;
            return allOk;
        }

        document.querySelectorAll('[data-password-toggle]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var targetId = btn.getAttribute('data-target');
                var input = document.getElementById(targetId);
                if (!input) return;

                var isPassword = input.type === 'password';
                input.type = isPassword ? 'text' : 'password';

                btn.setAttribute('aria-pressed', isPassword ? 'true' : 'false');
                btn.setAttribute('aria-label', (isPassword ? 'Hide ' : 'Show ') + (targetId === 'newPasswordInput' ? 'new password' : 'confirm password'));

                var openIcon = btn.querySelector('[data-eye-open]');
                var closedIcon = btn.querySelector('[data-eye-closed]');
                if (openIcon && closedIcon) {
                    openIcon.style.display = isPassword ? 'none' : '';
                    closedIcon.style.display = isPassword ? '' : 'none';
                }
            });
        });

        newPasswordInput.addEventListener('input', evaluateRules);
        confirmPasswordInput.addEventListener('input', evaluateRules);

        form.addEventListener('submit', function (e) {
            if (!evaluateRules()) {
                e.preventDefault();
                if (newPasswordInput.value.length < 12) {
                    newPasswordInput.focus();
                } else {
                    confirmPasswordInput.focus();
                }
                return;
            }

            submitBtn.disabled = true;
            submitBtn.textContent = 'Saving password...';
        });

        evaluateRules();
    })();
</script>
}
