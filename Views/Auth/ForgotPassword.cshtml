@model ByteBill_BS.ViewModels.Auth.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    ViewData["HideNavigation"] = true;
}

<div class="recovery-page">
    <div class="recovery-card card">
        <a asp-controller="Auth" asp-action="Login" class="recovery-back-link">Back to Sign In</a>
        <span class="recovery-kicker">Account Recovery</span>
        <h1 class="recovery-title">Forgot your password?</h1>
        <p class="recovery-subtitle">Enter your account email and we will send a secure reset link.</p>

        @if (TempData["AuthMessage"] != null)
        {
            <div class="recovery-alert recovery-alert-warning" role="status">@TempData["AuthMessage"]</div>
        }

        @if (ViewBag.SuccessMessage != null)
        {
            <div class="recovery-alert recovery-alert-success" role="status">@ViewBag.SuccessMessage</div>
        }

        <form method="post" asp-action="ForgotPassword" asp-controller="Auth" id="forgotForm" class="recovery-form">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="RecaptchaToken" id="ForgotRecaptchaToken" />
            <partial name="_ValidationSummary" />

            <div class="form-group">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-input" autocomplete="email" placeholder="name@company.com" />
                <span asp-validation-for="Email" class="form-error"></span>
            </div>

            <button type="submit" class="btn btn-primary recovery-submit" id="forgotSubmitBtn">Send Reset Link</button>
        </form>

        <p class="recovery-footnote">For security, the reset link expires after a short period.</p>
    </div>
</div>

@section Styles {
<link rel="stylesheet" href="~/css/auth-recovery.css" asp-append-version="true" />
}

@if (ViewBag.RecaptchaEnabled == true)
{
    <script src="https://www.google.com/recaptcha/api.js?render=@ViewBag.RecaptchaSiteKey"></script> <!-- NOSONAR -->
}

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var form = document.getElementById('forgotForm');
        var submitBtn = document.getElementById('forgotSubmitBtn');
        if (!form) {
            return;
        }

        function setBusy(isBusy) {
            if (!submitBtn) {
                return;
            }

            submitBtn.disabled = isBusy;
            submitBtn.textContent = isBusy ? 'Sending reset link...' : 'Send Reset Link';
        }

        form.addEventListener('submit', function (event) {
            if (@(ViewBag.RecaptchaEnabled == true ? "true" : "false") && typeof grecaptcha !== 'undefined') {
                event.preventDefault();
                setBusy(true);
                grecaptcha.ready(function () {
                    grecaptcha.execute('@ViewBag.RecaptchaSiteKey', { action: 'forgot_password' }).then(function (token) {
                        var tokenInput = document.getElementById('ForgotRecaptchaToken');
                        if (tokenInput) {
                            tokenInput.value = token;
                        }
                        form.submit();
                    }).catch(function () {
                        setBusy(false);
                    });
                });
                return;
            }

            setBusy(true);
        });
    });
</script>
