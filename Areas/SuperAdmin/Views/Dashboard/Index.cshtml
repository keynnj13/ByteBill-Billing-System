@model DashboardViewModel
@{
    ViewData["Title"] = "Super Admin Dashboard";
}

<partial name="~/Views/Shared/_Breadcrumbs.cshtml" model="@(new BreadcrumbViewModel { Items = new List<BreadcrumbViewModel.BreadcrumbItem> { new() { Label = "Dashboard", IsActive = true } } })" />

<!-- ═══ Page Header ═══ -->
<div class="dash-header">
    <div>
        <h1 class="dash-title">System Overview</h1>
        <p class="dash-subtitle">Welcome back, <strong>@Model.UserName</strong> — here's the platform status.</p>
    </div>
</div>

<!-- ═══ KPI Cards ═══ -->
<div class="kpi-grid">
    <div class="kpi-card">
        <div class="kpi-icon kpi-icon-green">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
        </div>
        <div class="kpi-body">
            <span class="kpi-label">Total Shops</span>
            <span class="kpi-value">@(ViewBag.TotalShops ?? 0)</span>
            <span class="kpi-sub">@(ViewBag.ActiveShops ?? 0) active</span>
        </div>
    </div>

    <div class="kpi-card">
        <div class="kpi-icon kpi-icon-blue">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 00-3-3.87"></path><path d="M16 3.13a4 4 0 010 7.75"></path></svg>
        </div>
        <div class="kpi-body">
            <span class="kpi-label">Total Users</span>
            <span class="kpi-value">@(ViewBag.TotalUsers ?? 0)</span>
            <span class="kpi-sub">Across all shops</span>
        </div>
    </div>

    <div class="kpi-card">
        <div class="kpi-icon kpi-icon-purple">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"></path></svg>
        </div>
        <div class="kpi-body">
            <span class="kpi-label">System Revenue</span>
            <span class="kpi-value">@(((decimal?)ViewBag.SystemRevenue ?? 0m).ToString("C"))</span>
            <span class="kpi-sub">This month</span>
        </div>
    </div>

    <div class="kpi-card">
        <div class="kpi-icon kpi-icon-amber">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
        </div>
        <div class="kpi-body">
            <span class="kpi-label">Active Jobs</span>
            <span class="kpi-value">@(ViewBag.ActiveJobs ?? 0)</span>
            <span class="kpi-sub">@(ViewBag.NewShopsThisMonth ?? 0) new shop(s) this month</span>
        </div>
    </div>
</div>

<!-- ═══ Charts Row ═══ -->
<div class="charts-row">
    <div class="card chart-card">
        <div class="card-header">
            <h3 class="card-title">System Revenue Trend</h3>
            <span class="card-badge">Last 6 months</span>
        </div>
        <div class="card-body">
            <canvas id="revenueChart" height="260"></canvas>
        </div>
    </div>

    <div class="card chart-card chart-card-sm">
        <div class="card-header">
            <h3 class="card-title">Shops Growth</h3>
            <span class="card-badge">Cumulative</span>
        </div>
        <div class="card-body">
            <canvas id="shopsChart" height="260"></canvas>
        </div>
    </div>
</div>

<!-- ═══ Bottom Row ═══ -->
<div class="tables-row">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Recent Activity</h3>
        </div>
        <div class="card-body p-0">
            @if (Model.RecentActivity.Any())
            {
                <ul class="activity-list">
                    @foreach (var activity in Model.RecentActivity)
                    {
                        <li class="activity-item">
                            <div class="activity-dot activity-dot-@activity.IconColor"></div>
                            <div class="activity-content">
                                <p class="activity-title">@activity.Title</p>
                                <p class="activity-description">@activity.Description</p>
                            </div>
                            @if (!string.IsNullOrEmpty(activity.BadgeText))
                            {
                                <span class="status-indicator @(activity.BadgeClass)" style="font-size:11px;">@activity.BadgeText</span>
                            }
                            <span class="activity-time">@activity.TimeAgo</span>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">System Health</h3>
        </div>
        <div class="card-body">
            <div class="health-item">
                <div class="health-row">
                    <span class="health-label-text">Database</span>
                    <span class="status-indicator status-success">Healthy</span>
                </div>
                <div class="progress-track"><div class="progress-fill" style="width: 15%; background: #10b981;"></div></div>
                <span class="health-sub">15% storage used</span>
            </div>
            <div class="health-item">
                <div class="health-row">
                    <span class="health-label-text">API Response Time</span>
                    <span class="status-indicator status-success">Fast</span>
                </div>
                <div class="progress-track"><div class="progress-fill" style="width: 25%; background: #3b82f6;"></div></div>
                <span class="health-sub">Avg: 45ms</span>
            </div>
            <div class="health-item">
                <div class="health-row">
                    <span class="health-label-text">Active Sessions</span>
                    <span class="status-indicator status-info">@(ViewBag.TotalUsers ?? 0)</span>
                </div>
                <div class="progress-track"><div class="progress-fill" style="width: 60%; background: #8b5cf6;"></div></div>
                <span class="health-sub">60% capacity</span>
            </div>
            <div class="health-item">
                <div class="health-row">
                    <span class="health-label-text">Uptime</span>
                    <span class="status-indicator status-success">99.9%</span>
                </div>
                <div class="progress-track"><div class="progress-fill" style="width: 99%; background: #10b981;"></div></div>
                <span class="health-sub">Last 30 days</span>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        var colors = { primary: '#3b82f6', green: '#10b981', gridLine: 'rgba(0,0,0,0.04)', text: '#374151' };
        Chart.defaults.font.family = "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif";
        Chart.defaults.color = colors.text;

        var revenueLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueChart.Select(c => c.Label)));
        var revenueValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueChart.Select(c => c.Value)));

        new Chart(document.getElementById('revenueChart'), {
            type: 'line',
            data: {
                labels: revenueLabels,
                datasets: [{
                    label: 'Revenue',
                    data: revenueValues,
                    borderColor: colors.primary,
                    backgroundColor: 'rgba(59,130,246,0.08)',
                    borderWidth: 2.5,
                    fill: true,
                    tension: 0.4,
                    pointBackgroundColor: colors.primary,
                    pointRadius: 4,
                    pointHoverRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false }, tooltip: { backgroundColor: '#1f2937', padding: 12, cornerRadius: 8, callbacks: { label: function (ctx) { return '\u20B1' + ctx.parsed.y.toLocaleString(undefined, { minimumFractionDigits: 2 }); } } } },
                scales: { x: { grid: { display: false }, ticks: { font: { size: 12 } } }, y: { beginAtZero: true, grid: { color: colors.gridLine }, border: { display: false }, ticks: { font: { size: 12 }, callback: function (val) { return '\u20B1' + (val / 1000).toFixed(0) + 'k'; } } } }
            }
        });

        var shopsLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.JobOrderChart.Select(c => c.Label)));
        var shopsValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.JobOrderChart.Select(c => c.Value)));

        new Chart(document.getElementById('shopsChart'), {
            type: 'bar',
            data: {
                labels: shopsLabels,
                datasets: [{
                    label: 'Total Shops',
                    data: shopsValues,
                    backgroundColor: colors.green,
                    borderRadius: 6,
                    borderSkipped: false,
                    barThickness: 28
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false }, tooltip: { backgroundColor: '#1f2937', padding: 12, cornerRadius: 8 } },
                scales: { x: { grid: { display: false }, ticks: { font: { size: 12 } } }, y: { beginAtZero: true, grid: { color: colors.gridLine }, border: { display: false }, ticks: { font: { size: 12 }, stepSize: 1 } } }
            }
        });
    });
</script>

<style>
    .dash-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 28px; }
    .dash-title { font-size: 24px; font-weight: 700; color: var(--gray-900, #1f2937); margin-bottom: 4px; }
    .dash-subtitle { font-size: 14px; color: var(--muted); }
    .dash-subtitle strong { color: var(--gray-700, #374151); }
    .kpi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 28px; }
    .kpi-card { display: flex; align-items: flex-start; gap: 16px; padding: 20px; background: white; border-radius: var(--radius-md); border: 1px solid var(--gray-border); box-shadow: var(--shadow-card); transition: box-shadow 0.2s, transform 0.2s; }
    .kpi-card:hover { box-shadow: var(--shadow-md, 0 4px 12px rgba(0,0,0,0.08)); transform: translateY(-1px); }
    .kpi-icon { width: 44px; height: 44px; border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .kpi-icon-green  { background: rgba(16,185,129,0.1); color: #10b981; }
    .kpi-icon-blue   { background: rgba(59,130,246,0.1);  color: #3b82f6; }
    .kpi-icon-purple { background: rgba(139,92,246,0.1);  color: #8b5cf6; }
    .kpi-icon-amber  { background: rgba(245,158,11,0.1);  color: #f59e0b; }
    .kpi-body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .kpi-label { font-size: 13px; color: var(--muted); font-weight: 500; }
    .kpi-value { font-size: 24px; font-weight: 700; color: var(--gray-900, #1f2937); line-height: 1.2; }
    .kpi-sub   { font-size: 12px; color: var(--gray-400, #9ca3af); margin-top: 2px; }
    .charts-row { display: grid; grid-template-columns: 1.6fr 1fr; gap: 24px; margin-bottom: 28px; }
    .chart-card .card-body { padding: 20px; }
    .card-badge { font-size: 11px; padding: 3px 10px; border-radius: var(--radius-full); background: var(--gray-100, #f1f5f9); color: var(--muted); font-weight: 500; }
    .tables-row { display: grid; grid-template-columns: 1.2fr 1fr; gap: 24px; }
    .activity-list { list-style: none; padding: 0; margin: 0; }
    .activity-item { display: flex; align-items: flex-start; gap: 12px; padding: 14px 20px; border-bottom: 1px solid var(--gray-100, #f1f5f9); }
    .activity-item:last-child { border-bottom: none; }
    .activity-dot { width: 8px; height: 8px; border-radius: 50%; margin-top: 6px; flex-shrink: 0; }
    .activity-dot-success { background: #10b981; }
    .activity-dot-primary { background: #3b82f6; }
    .activity-dot-warning { background: #f59e0b; }
    .activity-dot-danger  { background: #ef4444; }
    .activity-dot-info    { background: #06b6d4; }
    .activity-content { flex: 1; min-width: 0; }
    .activity-title { font-weight: 500; font-size: 13px; color: var(--gray-900, #1f2937); margin-bottom: 1px; }
    .activity-description { font-size: 12px; color: var(--muted); }
    .activity-time { font-size: 11px; color: var(--gray-400, #9ca3af); white-space: nowrap; margin-top: 2px; }
    .health-item { margin-bottom: 20px; }
    .health-item:last-child { margin-bottom: 0; }
    .health-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
    .health-label-text { font-size: 13px; font-weight: 500; color: var(--gray-700, #374151); }
    .progress-track { height: 6px; background: var(--gray-100, #f1f5f9); border-radius: 99px; overflow: hidden; margin-bottom: 4px; }
    .progress-fill { height: 100%; border-radius: 99px; transition: width 0.5s ease; }
    .health-sub { font-size: 12px; color: var(--gray-400, #9ca3af); }
    @@media (max-width: 1280px) { .kpi-grid { grid-template-columns: repeat(2, 1fr); } .charts-row { grid-template-columns: 1fr; } .tables-row { grid-template-columns: 1fr; } }
    @@media (max-width: 768px) { .kpi-grid { grid-template-columns: 1fr; } .dash-header { flex-direction: column; gap: 16px; } }
</style>
