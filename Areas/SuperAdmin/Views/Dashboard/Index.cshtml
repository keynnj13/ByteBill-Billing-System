@model DashboardViewModel
@{
    ViewData["Title"] = "Super Admin Dashboard";
    var period = (string?)ViewBag.Period ?? "6months";
    var previousRevenue = (decimal?)ViewBag.PreviousMonthRevenue ?? 0m;
    var currentRevenue = (decimal?)ViewBag.SystemRevenue ?? 0m;
    var revenueChange = previousRevenue > 0 ? ((currentRevenue - previousRevenue) / previousRevenue * 100) : 0m;
    var activeSubscriptions = (int?)ViewBag.ActiveSubscriptions ?? 0;
    var expiringSubscriptions = (int?)ViewBag.ExpiringSubscriptions ?? 0;
    var overduePayments = (int?)ViewBag.OverduePayments ?? 0;
    var subscriptionDist = (List<ChartDataPoint>?)ViewBag.SubscriptionDistribution ?? new List<ChartDataPoint>();
}

<partial name="~/Views/Shared/_Breadcrumbs.cshtml" model="@(new BreadcrumbViewModel { Items = new List<BreadcrumbViewModel.BreadcrumbItem> { new() { Label = "Dashboard", IsActive = true } } })" />

<!-- ═══ Page Header ═══ -->
<div class="dash-header">
    <div>
        <h1 class="dash-title">System Overview</h1>
        <p class="dash-subtitle">Welcome back, <strong>@Model.UserName</strong> — here's the platform status.</p>
    </div>
    <div class="dash-period-filter">
        <select id="periodFilter" class="form-select" onchange="changePeriod(this.value)" style="min-width: 170px;">
            @{ var periodOptions = new[] { ("week","Last Week"), ("month","This Month"), ("3months","Last 3 Months"), ("6months","Last 6 Months"), ("year","This Year") }; }
            @foreach (var (val, label) in periodOptions)
            {
                if (period == val) { <option value="@val" selected>@label</option> }
                else { <option value="@val">@label</option> }
            }
        </select>
    </div>
</div>

<!-- ═══ Alert Banner (Subscription Alerts) ═══ -->
@if (expiringSubscriptions > 0 || overduePayments > 0)
{
    <div class="sa-alert-banner">
        @if (expiringSubscriptions > 0)
        {
            <div class="sa-alert sa-alert-warning">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                <span><strong>@expiringSubscriptions subscription(s)</strong> expiring within 7 days</span>
                <a href="@Url.Action("Index", "Subscriptions", new { area = "SuperAdmin", status = "Active" })" class="sa-alert-link">View →</a>
            </div>
        }
        @if (overduePayments > 0)
        {
            <div class="sa-alert sa-alert-danger">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
                <span><strong>@overduePayments overdue payment(s)</strong> require attention</span>
                <a href="@Url.Action("Index", "Payments", new { area = "SuperAdmin", status = "Pending" })" class="sa-alert-link">View →</a>
            </div>
        }
    </div>
}

<!-- ═══ KPI Cards ═══ -->
<div class="kpi-grid">
    <div class="kpi-card">
        <div class="kpi-icon kpi-icon-green">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
        </div>
        <div class="kpi-body">
            <span class="kpi-label">Total Shops</span>
            <span class="kpi-value">@(ViewBag.TotalShops ?? 0)</span>
            <span class="kpi-sub">@(ViewBag.ActiveShops ?? 0) active</span>
        </div>
    </div>

    <div class="kpi-card">
        <div class="kpi-icon kpi-icon-blue">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 00-3-3.87"></path><path d="M16 3.13a4 4 0 010 7.75"></path></svg>
        </div>
        <div class="kpi-body">
            <span class="kpi-label">Total Users</span>
            <span class="kpi-value">@(ViewBag.TotalUsers ?? 0)</span>
            <span class="kpi-sub">Across all shops</span>
        </div>
    </div>

    <div class="kpi-card">
        <div class="kpi-icon kpi-icon-purple">
            <svg width="22" height="22" viewBox="0 0 24 24"><text x="12" y="18" text-anchor="middle" font-size="18" font-weight="600" fill="currentColor" font-family="Inter, sans-serif">&#8369;</text></svg>
        </div>
        <div class="kpi-body">
            <span class="kpi-label">Subscription Revenue</span>
            <span class="kpi-value">₱@currentRevenue.ToString("N2")</span>
            <span class="kpi-sub @(revenueChange >= 0 ? "kpi-up" : "kpi-down")">
                @(revenueChange >= 0 ? "↑" : "↓") @Math.Abs(revenueChange).ToString("0.0")% vs last month
            </span>
        </div>
    </div>

    <div class="kpi-card">
        <div class="kpi-icon kpi-icon-amber">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
        </div>
        <div class="kpi-body">
            <span class="kpi-label">Active Subscriptions</span>
            <span class="kpi-value">@activeSubscriptions</span>
            <span class="kpi-sub">@(ViewBag.NewShopsThisMonth ?? 0) new shop(s) this month</span>
        </div>
    </div>
</div>

<!-- ═══ Charts Row ═══ -->
<div class="charts-row">
    <div class="card chart-card">
        <div class="card-header">
            <h3 class="card-title">Subscription Revenue Trend</h3>
            <span class="card-badge">@(period switch { "week" => "This Week", "month" => "This Month", "3months" => "Last 3 Months", "year" => "This Year", _ => "Last 6 Months" })</span>
        </div>
        <div class="card-body">
            <canvas id="revenueChart" height="260"></canvas>
        </div>
    </div>

    <div class="card chart-card chart-card-sm">
        <div class="card-header">
            <h3 class="card-title">Shops Growth</h3>
            <span class="card-badge">Cumulative</span>
        </div>
        <div class="card-body">
            <canvas id="shopsChart" height="260"></canvas>
        </div>
    </div>
</div>

<!-- ═══ Bottom Row ═══ -->
<div class="tables-row">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Recent Activity</h3>
            <a href="@Url.Action("Index", "Shops", new { area = "SuperAdmin" })" class="card-link">View All</a>
        </div>
        <div class="card-body p-0">
            @if (Model.RecentActivity.Any())
            {
                <ul class="activity-list">
                    @foreach (var activity in Model.RecentActivity.Take(5))
                    {
                        <li class="activity-item">
                            <div class="activity-dot activity-dot-@activity.IconColor"></div>
                            <div class="activity-content">
                                <p class="activity-title">@activity.Title</p>
                                <p class="activity-description">@activity.Description</p>
                            </div>
                            @if (!string.IsNullOrEmpty(activity.BadgeText))
                            {
                                <span class="status-indicator @(activity.BadgeClass)" style="font-size:11px;">@activity.BadgeText</span>
                            }
                            <span class="activity-time">@activity.TimeAgo</span>
                        </li>
                    }
                </ul>
            }
            else
            {
                <div style="padding: 40px 0; text-align: center; color: #9ca3af; font-size: 14px;">
                    No recent activity to display.
                </div>
            }
        </div>
    </div>

    <div class="card sub-dist-card">
        <div class="card-header">
            <h3 class="card-title">Subscription Distribution</h3>
        </div>
        <div class="card-body">
            @if (subscriptionDist.Any())
            {
                var distColors = new[] { "#3b82f6", "#8b5cf6", "#10b981", "#f59e0b", "#ef4444" };
                <div class="sub-dist-chart-wrap">
                    <canvas id="subDistChart"></canvas>
                </div>
                <div class="sub-dist-legend">
                    @for (int i = 0; i < subscriptionDist.Count; i++)
                    {
                        <div class="sub-dist-item">
                            <div class="sub-dist-label-group">
                                <span class="sub-dist-dot" style="background: @distColors[i % distColors.Length]"></span>
                                <span class="sub-dist-label">@subscriptionDist[i].Label</span>
                            </div>
                            <span class="sub-dist-value">@((int)subscriptionDist[i].Value) shop(s)</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div style="padding: 40px 0; text-align: center; color: #9ca3af; font-size: 14px;">
                    No active subscriptions yet.
                </div>
            }
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js" integrity="sha384-vsrfeLOOY6KuIYKDlmVH5UiBmgIdB1oEf7p01YgWHuqmOHfZr374+odEv96n9tNC" crossorigin="anonymous"></script>
<script>
    function changePeriod(val) {
        window.location.href = '@Url.Action("Index", "Dashboard", new { area = "SuperAdmin" })?period=' + val;
    }

    document.addEventListener('DOMContentLoaded', function () {
        var colors = { primary: '#3b82f6', green: '#10b981', purple: '#8b5cf6', amber: '#f59e0b', gridLine: 'rgba(0,0,0,0.04)', text: '#374151' };
        Chart.defaults.font.family = "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif";
        Chart.defaults.color = colors.text;

        var revenueLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueChart.Select(c => c.Label)));
        var revenueValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueChart.Select(c => c.Value)));

        new Chart(document.getElementById('revenueChart'), {
            type: 'line',
            data: {
                labels: revenueLabels,
                datasets: [{
                    label: 'Revenue',
                    data: revenueValues,
                    borderColor: colors.primary,
                    backgroundColor: 'rgba(59,130,246,0.08)',
                    borderWidth: 2.5,
                    fill: true,
                    tension: 0.4,
                    pointBackgroundColor: colors.primary,
                    pointRadius: 4,
                    pointHoverRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false }, tooltip: { backgroundColor: '#1f2937', padding: 12, cornerRadius: 8, callbacks: { label: function (ctx) { return '\u20B1' + ctx.parsed.y.toLocaleString(undefined, { minimumFractionDigits: 2 }); } } } },
                scales: { x: { grid: { display: false }, ticks: { font: { size: 12 } } }, y: { beginAtZero: true, grid: { color: colors.gridLine }, border: { display: false }, ticks: { font: { size: 12 }, callback: function (val) { return '\u20B1' + (val / 1000).toFixed(0) + 'k'; } } } }
            }
        });

        var shopsLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.JobOrderChart.Select(c => c.Label)));
        var shopsValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.JobOrderChart.Select(c => c.Value)));

        new Chart(document.getElementById('shopsChart'), {
            type: 'bar',
            data: {
                labels: shopsLabels,
                datasets: [{
                    label: 'Total Shops',
                    data: shopsValues,
                    backgroundColor: colors.green,
                    borderRadius: 6,
                    borderSkipped: false,
                    barThickness: 28
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false }, tooltip: { backgroundColor: '#1f2937', padding: 12, cornerRadius: 8 } },
                scales: { x: { grid: { display: false }, ticks: { font: { size: 12 } } }, y: { beginAtZero: true, grid: { color: colors.gridLine }, border: { display: false }, ticks: { font: { size: 12 }, stepSize: 1 } } }
            }
        });

        // Subscription Distribution Doughnut
        var distCanvas = document.getElementById('subDistChart');
        if (distCanvas) {
            var distLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(subscriptionDist.Select(d => d.Label)));
            var distValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(subscriptionDist.Select(d => d.Value)));
            var distColors = ['#3b82f6', '#8b5cf6', '#10b981', '#f59e0b', '#ef4444'];

            new Chart(distCanvas, {
                type: 'doughnut',
                data: {
                    labels: distLabels,
                    datasets: [{
                        data: distValues,
                        backgroundColor: distColors.slice(0, distLabels.length),
                        borderWidth: 2,
                        borderColor: '#fff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    cutout: '65%',
                    plugins: {
                        legend: { display: false },
                        tooltip: { backgroundColor: '#1f2937', padding: 12, cornerRadius: 8 }
                    }
                }
            });
        }
    });
</script>

<style>
    .dash-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 28px; }
    .dash-title { font-size: 24px; font-weight: 700; color: var(--gray-900, #1f2937); margin-bottom: 4px; }
    .dash-subtitle { font-size: 14px; color: var(--muted); }
    .dash-subtitle strong { color: var(--gray-700, #374151); }
    .dash-period-filter { display: flex; align-items: center; gap: 8px; }
    .sa-alert-banner { display: flex; flex-direction: column; gap: 8px; margin-bottom: 20px; }
    .sa-alert { display: flex; align-items: center; gap: 10px; padding: 10px 16px; border-radius: 8px; font-size: 13px; }
    .sa-alert-warning { background: #fffbeb; border: 1px solid #fde68a; color: #92400e; }
    .sa-alert-danger { background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; }
    .sa-alert-link { margin-left: auto; font-weight: 600; text-decoration: none; color: inherit; white-space: nowrap; }
    .sa-alert-link:hover { text-decoration: underline; }
    .kpi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 28px; }
    .kpi-card { position: relative; padding: 20px; background: white; border-radius: var(--radius-md); border: 1px solid var(--gray-border); box-shadow: var(--shadow-card); transition: box-shadow 0.2s, transform 0.2s; }
    .kpi-card:hover { box-shadow: var(--shadow-md, 0 4px 12px rgba(0,0,0,0.08)); transform: translateY(-1px); }
    .kpi-icon { width: 42px; height: 42px; border-radius: 10px; display: flex; align-items: center; justify-content: center; position: absolute; top: 20px; right: 20px; }
    .kpi-icon-green  { background: rgba(16,185,129,0.1); color: #10b981; }
    .kpi-icon-blue   { background: rgba(59,130,246,0.1);  color: #3b82f6; }
    .kpi-icon-purple { background: rgba(139,92,246,0.1);  color: #8b5cf6; }
    .kpi-icon-amber  { background: rgba(245,158,11,0.1);  color: #f59e0b; }
    .kpi-body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .kpi-label { font-size: 13px; color: var(--muted); font-weight: 500; }
    .kpi-value { font-size: 24px; font-weight: 700; color: var(--gray-900, #1f2937); line-height: 1.2; }
    .kpi-sub   { font-size: 12px; color: var(--gray-400, #9ca3af); margin-top: 2px; }
    .kpi-up { color: #10b981 !important; }
    .kpi-down { color: #ef4444 !important; }
    .charts-row { display: grid; grid-template-columns: 1.6fr 1fr; gap: 24px; margin-bottom: 28px; }
    .chart-card .card-body { padding: 20px; }
    .card-badge { font-size: 11px; padding: 3px 10px; border-radius: var(--radius-full); background: var(--gray-100, #f1f5f9); color: var(--muted); font-weight: 500; }
    .card-link { font-size: 13px; color: #3b82f6; text-decoration: none; font-weight: 500; }
    .card-link:hover { text-decoration: underline; }
    .tables-row { display: grid; grid-template-columns: 1.2fr 1fr; gap: 24px; align-items: start; }
    .activity-list { list-style: none; padding: 0; margin: 0; }
    .activity-item { display: flex; align-items: flex-start; gap: 12px; padding: 14px 20px; border-bottom: 1px solid var(--gray-100, #f1f5f9); }
    .activity-item:last-child { border-bottom: none; }
    .activity-dot { width: 8px; height: 8px; border-radius: 50%; margin-top: 6px; flex-shrink: 0; }
    .activity-dot-success { background: #10b981; }
    .activity-dot-primary { background: #3b82f6; }
    .activity-dot-warning { background: #f59e0b; }
    .activity-dot-danger  { background: #ef4444; }
    .activity-dot-info    { background: #06b6d4; }
    .activity-content { flex: 1; min-width: 0; }
    .activity-title { font-weight: 500; font-size: 13px; color: var(--gray-900, #1f2937); margin-bottom: 1px; }
    .activity-description { font-size: 12px; color: var(--muted); }
    .activity-time { font-size: 11px; color: var(--gray-400, #9ca3af); white-space: nowrap; margin-top: 2px; }
    .sub-dist-card .card-body { display: flex; flex-direction: column; }
    .sub-dist-chart-wrap { position: relative; width: 180px; height: 180px; margin: 0 auto 20px; }
    .sub-dist-legend { display: flex; flex-direction: column; gap: 6px; }
    .sub-dist-item { display: flex; justify-content: space-between; align-items: center; padding: 8px 0; border-bottom: 1px solid var(--gray-100, #f1f5f9); }
    .sub-dist-item:last-child { border-bottom: none; }
    .sub-dist-label-group { display: flex; align-items: center; gap: 8px; }
    .sub-dist-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
    .sub-dist-label { font-size: 13px; font-weight: 500; color: var(--gray-700, #374151); }
    .sub-dist-value { font-size: 12px; color: var(--muted); font-weight: 500; }
    @@media (max-width: 1280px) { .kpi-grid { grid-template-columns: repeat(2, 1fr); } .charts-row { grid-template-columns: 1fr; } .tables-row { grid-template-columns: 1fr; } }
    @@media (max-width: 768px) { .kpi-grid { grid-template-columns: 1fr; } .dash-header { flex-direction: column; gap: 16px; } }
</style>
