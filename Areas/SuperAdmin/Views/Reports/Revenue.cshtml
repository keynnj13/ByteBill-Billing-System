@model SARevenueReportViewModel
@{
    ViewData["Title"] = "Revenue Report";
}

<partial name="~/Views/Shared/_Breadcrumbs.cshtml" model="@(new BreadcrumbViewModel { Items = new List<BreadcrumbViewModel.BreadcrumbItem> { new() { Label = "Dashboard", Url = Url.Action("Index", "Dashboard") }, new() { Label = "Reports", Url = Url.Action("Index", "Reports") }, new() { Label = "Revenue Report", IsActive = true } } })" />

<div class="page-header" style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:20px;">
    <div>
        <h1 class="page-title">Revenue Report</h1>
        <p class="page-subtitle">@Model.DateRange</p>
    </div>
    <div style="display:flex; gap:10px; align-items:center;">
        <a href="@Url.Action("Index", "Reports")" class="btn btn-ghost" style="display:inline-flex; align-items:center; gap:6px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
            Back
        </a>
        <a href="@Url.Action("ExportRevenuePdf", new { range = Context.Request.Query["range"], from = Context.Request.Query["from"], to = Context.Request.Query["to"] })" class="btn btn-primary" style="display:inline-flex; align-items:center; gap:6px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Export PDF
        </a>
    </div>
</div>

<partial name="_DateRangeFilter" />

<!-- Summary Stats -->
<div class="rpt-stats">
    <div class="rpt-stat"><span class="rpt-stat-label">Total Revenue</span><span class="rpt-stat-value" style="color:#10b981;">₱@Model.TotalRevenue.ToString("N2")</span></div>
    <div class="rpt-stat"><span class="rpt-stat-label">Transactions</span><span class="rpt-stat-value">@Model.TransactionCount</span></div>
    <div class="rpt-stat"><span class="rpt-stat-label">Paying Shops</span><span class="rpt-stat-value">@Model.PayingShops</span></div>
    <div class="rpt-stat"><span class="rpt-stat-label">Avg / Shop</span><span class="rpt-stat-value">₱@Model.AvgPerShop.ToString("N2")</span></div>
</div>

<!-- Interpretation -->
@if (!string.IsNullOrEmpty(Model.Interpretation))
{
    <div class="insight-box">
        <div class="insight-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
        </div>
        <div class="insight-text">@Model.Interpretation</div>
    </div>
}

<!-- Charts -->
@if (Model.MonthlyBreakdown.Any())
{
    <div style="display:grid; grid-template-columns: 2fr 1fr; gap:20px; margin-bottom:24px;">
        <div class="card">
            <div class="card-header"><h3 style="font-size:15px; font-weight:600; margin:0;">Monthly Revenue Trend</h3></div>
            <div class="card-body"><canvas id="revBarChart" height="280"></canvas></div>
        </div>
        <div class="card">
            <div class="card-header"><h3 style="font-size:15px; font-weight:600; margin:0;">Revenue Distribution</h3></div>
            <div class="card-body" style="display:flex;align-items:center;justify-content:center;"><canvas id="revDoughnut" height="280"></canvas></div>
        </div>
    </div>
}

<!-- Monthly Breakdown Table -->
<div class="card" style="margin-bottom:20px;">
    <div class="card-header"><h3 style="font-size:15px; font-weight:600; margin:0;">Monthly Breakdown</h3></div>
    <div class="card-body p-0">
        <div class="table-container">
            <table class="table">
                <thead><tr><th>Month</th><th class="text-right">Amount</th><th class="text-center">Transactions</th></tr></thead>
                <tbody>
                    @foreach (var m in Model.MonthlyBreakdown)
                    {
                        <tr><td style="font-weight:500;">@m.Month</td><td class="text-right">₱@m.Amount.ToString("N2")</td><td class="text-center">@m.Count</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Transactions Table -->
<div class="card">
    <div class="card-header">
        <h3 style="font-size:15px; font-weight:600; margin:0;">Transactions</h3>
        <span class="text-muted" style="font-size:13px;">@Model.Payments.Count row(s)</span>
    </div>
    <div class="card-body p-0">
        @if (Model.Payments.Any())
        {
            <div class="table-container">
                <table class="table">
                    <thead><tr><th>Reference</th><th>Shop</th><th>Plan</th><th class="text-right">Amount</th><th>Paid Date</th></tr></thead>
                    <tbody>
                        @foreach (var p in Model.Payments)
                        {
                            <tr><td><code style="font-size:12px;">@p.Reference</code></td><td>@p.Shop</td><td>@p.Plan</td><td class="text-right">₱@p.Amount.ToString("N2")</td><td>@p.PaidDate</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div style="padding:60px 0; text-align:center;">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#cbd5e1" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
                <p style="margin-top:12px; color:#9ca3af; font-size:14px;">No transactions for this period</p>
            </div>
        }
    </div>
</div>

<style>
    .page-title { font-size: 24px; font-weight: 700; color: var(--text-primary, #1f2937); margin-bottom: 4px; }
    .page-subtitle { font-size: 14px; color: var(--text-secondary, #6b7280); }
    .rpt-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 24px; }
    .rpt-stat { text-align: center; padding: 16px; background: var(--bg-primary, white); border-radius: 10px; border: 1px solid var(--border-primary, #e5e7eb); }
    .rpt-stat-label { display: block; font-size: 12px; color: var(--text-muted, #9ca3af); font-weight: 500; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 6px; }
    .rpt-stat-value { display: block; font-size: 22px; font-weight: 700; color: var(--text-primary, #1f2937); }
    .insight-box { display: flex; gap: 12px; padding: 16px 20px; margin-bottom: 24px; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 10px; }
    .insight-icon { color: #3b82f6; flex-shrink: 0; margin-top: 2px; }
    .insight-text { font-size: 14px; color: #1e40af; line-height: 1.6; }
    @@media (max-width: 768px) { .rpt-stats { grid-template-columns: repeat(2, 1fr); } }
</style>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js" integrity="sha384-vsrfeLOOY6KuIYKDlmVH5UiBmgIdB1oEf7p01YgWHuqmOHfZr374+odEv96n9tNC" crossorigin="anonymous"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    var labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyBreakdown.Select(m => m.Month)));
    var values = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyBreakdown.Select(m => m.Amount)));
    var palette = ['#10b981','#6366f1','#3b82f6','#f59e0b','#ef4444','#8b5cf6','#ec4899','#14b8a6','#f97316','#06b6d4','#84cc16','#a855f7'];
    if (!labels.length) return;

    new Chart(document.getElementById('revBarChart'), {
        type: 'bar',
        data: { labels: labels, datasets: [{ label: 'Revenue (₱)', data: values, backgroundColor: '#10b98133', borderColor: '#10b981', borderWidth: 1.5, borderRadius: 6 }] },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, grid: { color: '#f3f4f6' } }, x: { grid: { display: false } } } }
    });

    var doughnut = document.getElementById('revDoughnut');
    if (doughnut) {
        new Chart(doughnut, {
            type: 'doughnut',
            data: { labels: labels, datasets: [{ data: values, backgroundColor: palette.slice(0, labels.length), borderColor: '#fff', borderWidth: 2 }] },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom', labels: { boxWidth: 12, padding: 8, font: { size: 11 } } } }, cutout: '55%' }
        });
    }
});
</script>
}
