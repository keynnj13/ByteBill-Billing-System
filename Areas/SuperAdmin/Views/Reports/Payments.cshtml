@model SAPaymentReportViewModel
@{
    ViewData["Title"] = "Payment History Report";
}

<partial name="~/Views/Shared/_Breadcrumbs.cshtml" model="@(new BreadcrumbViewModel { Items = new List<BreadcrumbViewModel.BreadcrumbItem> { new() { Label = "Dashboard", Url = Url.Action("Index", "Dashboard") }, new() { Label = "Reports", Url = Url.Action("Index", "Reports") }, new() { Label = "Payment History", IsActive = true } } })" />

<div class="page-header" style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:20px;">
    <div>
        <h1 class="page-title">Payment History Report</h1>
        <p class="page-subtitle">@Model.DateRange</p>
    </div>
    <div style="display:flex; gap:10px; align-items:center;">
        <a href="@Url.Action("Index", "Reports")" class="btn btn-ghost" style="display:inline-flex; align-items:center; gap:6px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
            Back
        </a>
        <a href="@Url.Action("ExportPaymentsPdf", new { range = Context.Request.Query["range"], from = Context.Request.Query["from"], to = Context.Request.Query["to"] })" class="btn btn-primary" style="display:inline-flex; align-items:center; gap:6px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Export PDF
        </a>
    </div>
</div>

<partial name="_DateRangeFilter" />

<!-- Summary Stats -->
<div class="rpt-stats">
    <div class="rpt-stat"><span class="rpt-stat-label">Total Collected</span><span class="rpt-stat-value" style="color:#10b981;">₱@Model.TotalCollected.ToString("N2")</span></div>
    <div class="rpt-stat"><span class="rpt-stat-label">Pending</span><span class="rpt-stat-value" style="color:#f59e0b;">₱@Model.TotalPending.ToString("N2")</span></div>
    <div class="rpt-stat"><span class="rpt-stat-label">Failed</span><span class="rpt-stat-value" style="color:#ef4444;">@Model.FailedCount</span></div>
    <div class="rpt-stat"><span class="rpt-stat-label">Transactions</span><span class="rpt-stat-value">@Model.TransactionCount</span></div>
</div>

<!-- Interpretation -->
@if (!string.IsNullOrEmpty(Model.Interpretation))
{
    <div class="insight-box">
        <div class="insight-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
        </div>
        <div class="insight-text">@Model.Interpretation</div>
    </div>
}

<!-- Charts -->
<div style="display:grid; grid-template-columns: 2fr 1fr; gap:20px; margin-bottom:24px;">
    @if (Model.MonthlyBreakdown.Any())
    {
        <div class="card">
            <div class="card-header"><h3 style="font-size:15px; font-weight:600; margin:0;">Monthly Collection Trend</h3></div>
            <div class="card-body"><canvas id="payBarChart" height="280"></canvas></div>
        </div>
    }
    @if (Model.MethodBreakdown.Any())
    {
        <div class="card">
            <div class="card-header"><h3 style="font-size:15px; font-weight:600; margin:0;">Payment Methods</h3></div>
            <div class="card-body" style="display:flex;align-items:center;justify-content:center;"><canvas id="methodDoughnut" height="280"></canvas></div>
        </div>
    }
</div>

<!-- Method Breakdown Table -->
@if (Model.MethodBreakdown.Any())
{
    <div class="card" style="margin-bottom:20px;">
        <div class="card-header"><h3 style="font-size:15px; font-weight:600; margin:0;">Payment Method Breakdown</h3></div>
        <div class="card-body p-0">
            <div class="table-container">
                <table class="table">
                    <thead><tr><th>Method</th><th class="text-right">Amount</th><th class="text-center">Count</th><th class="text-right">%</th></tr></thead>
                    <tbody>
                        @foreach (var m in Model.MethodBreakdown)
                        {
                            <tr><td style="font-weight:500;">@m.Method</td><td class="text-right">₱@m.Amount.ToString("N2")</td><td class="text-center">@m.Count</td><td class="text-right">@m.Percentage%</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- Monthly Collection Table -->
@if (Model.MonthlyBreakdown.Any())
{
    <div class="card" style="margin-bottom:20px;">
        <div class="card-header"><h3 style="font-size:15px; font-weight:600; margin:0;">Monthly Collection</h3></div>
        <div class="card-body p-0">
            <div class="table-container">
                <table class="table">
                    <thead><tr><th>Month</th><th class="text-right">Amount</th><th class="text-center">Count</th></tr></thead>
                    <tbody>
                        @foreach (var m in Model.MonthlyBreakdown)
                        {
                            <tr><td style="font-weight:500;">@m.Month</td><td class="text-right">₱@m.Amount.ToString("N2")</td><td class="text-center">@m.Count</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- Transactions Table -->
<div class="card">
    <div class="card-header">
        <h3 style="font-size:15px; font-weight:600; margin:0;">Transactions</h3>
        <span class="text-muted" style="font-size:13px;">@Model.Payments.Count row(s)</span>
    </div>
    <div class="card-body p-0">
        @if (Model.Payments.Any())
        {
            <div class="table-container">
                <table class="table">
                    <thead><tr><th>Reference</th><th>Shop</th><th class="text-right">Amount</th><th>Status</th><th>Method</th><th>Date</th></tr></thead>
                    <tbody>
                        @foreach (var p in Model.Payments)
                        {
                            <tr>
                                <td><code style="font-size:12px;">@p.Reference</code></td>
                                <td>@p.Shop</td>
                                <td class="text-right">₱@p.Amount.ToString("N2")</td>
                                <td><span class="status-badge @(p.Status == "Paid" ? "status-success" : p.Status == "Pending" ? "status-warning" : "status-danger")">@p.Status</span></td>
                                <td>@p.Method</td>
                                <td>@p.Date</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div style="padding:60px 0; text-align:center;">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#cbd5e1" stroke-width="1.5"><rect x="2" y="5" width="20" height="15" rx="2"/><path d="M2 10h20"/></svg>
                <p style="margin-top:12px; color:#9ca3af; font-size:14px;">No payments found for this period</p>
            </div>
        }
    </div>
</div>

<style>
    .page-title { font-size: 24px; font-weight: 700; color: var(--text-primary, #1f2937); margin-bottom: 4px; }
    .page-subtitle { font-size: 14px; color: var(--text-secondary, #6b7280); }
    .rpt-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 24px; }
    .rpt-stat { text-align: center; padding: 16px; background: var(--bg-primary, white); border-radius: 10px; border: 1px solid var(--border-primary, #e5e7eb); }
    .rpt-stat-label { display: block; font-size: 12px; color: var(--text-muted, #9ca3af); font-weight: 500; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 6px; }
    .rpt-stat-value { display: block; font-size: 22px; font-weight: 700; color: var(--text-primary, #1f2937); }
    .insight-box { display: flex; gap: 12px; padding: 16px 20px; margin-bottom: 24px; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 10px; }
    .insight-icon { color: #3b82f6; flex-shrink: 0; margin-top: 2px; }
    .insight-text { font-size: 14px; color: #1e40af; line-height: 1.6; }
    .status-badge { display: inline-block; padding: 2px 10px; border-radius: 20px; font-size: 12px; font-weight: 500; }
    .status-success { background: #d1fae5; color: #065f46; }
    .status-warning { background: #fef3c7; color: #92400e; }
    .status-danger { background: #fee2e2; color: #991b1b; }
    @@media (max-width: 768px) { .rpt-stats { grid-template-columns: repeat(2, 1fr); } }
</style>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js" integrity="sha384-vsrfeLOOY6KuIYKDlmVH5UiBmgIdB1oEf7p01YgWHuqmOHfZr374+odEv96n9tNC" crossorigin="anonymous"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    var palette = ['#f59e0b','#10b981','#3b82f6','#ef4444','#8b5cf6','#ec4899','#6366f1','#14b8a6'];

    // Monthly bar chart
    var mLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyBreakdown.Select(m => m.Month)));
    var mValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyBreakdown.Select(m => m.Amount)));
    var barEl = document.getElementById('payBarChart');
    if (barEl && mLabels.length) {
        new Chart(barEl, {
            type: 'bar',
            data: { labels: mLabels, datasets: [{ label: 'Collected (₱)', data: mValues, backgroundColor: '#f59e0b33', borderColor: '#f59e0b', borderWidth: 1.5, borderRadius: 6 }] },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, grid: { color: '#f3f4f6' } }, x: { grid: { display: false } } } }
        });
    }

    // Method doughnut
    var methods = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MethodBreakdown.Select(m => m.Method)));
    var mAmts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MethodBreakdown.Select(m => m.Amount)));
    var doughEl = document.getElementById('methodDoughnut');
    if (doughEl && methods.length) {
        new Chart(doughEl, {
            type: 'doughnut',
            data: { labels: methods, datasets: [{ data: mAmts, backgroundColor: palette.slice(0, methods.length), borderColor: '#fff', borderWidth: 2 }] },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom', labels: { boxWidth: 12, padding: 8, font: { size: 11 } } } }, cutout: '55%' }
        });
    }
});
</script>
}
