@model SAShopsReportViewModel
@{
    ViewData["Title"] = "Shops Activity Report";
}

<partial name="~/Views/Shared/_Breadcrumbs.cshtml" model="@(new BreadcrumbViewModel { Items = new List<BreadcrumbViewModel.BreadcrumbItem> { new() { Label = "Dashboard", Url = Url.Action("Index", "Dashboard") }, new() { Label = "Reports", Url = Url.Action("Index", "Reports") }, new() { Label = "Shops Activity", IsActive = true } } })" />

<div class="page-header" style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:20px;">
    <div>
        <h1 class="page-title">Shops Activity Report</h1>
        <p class="page-subtitle">@Model.DateRange</p>
    </div>
    <div style="display:flex; gap:10px; align-items:center;">
        <a href="@Url.Action("Index", "Reports")" class="btn btn-ghost" style="display:inline-flex; align-items:center; gap:6px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
            Back
        </a>
        <a href="@Url.Action("ExportShopsPdf", new { range = Context.Request.Query["range"], from = Context.Request.Query["from"], to = Context.Request.Query["to"] })" class="btn btn-primary" style="display:inline-flex; align-items:center; gap:6px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Export PDF
        </a>
    </div>
</div>

<partial name="_DateRangeFilter" />

<!-- Summary Stats -->
<div class="rpt-stats">
    <div class="rpt-stat"><span class="rpt-stat-label">New Shops</span><span class="rpt-stat-value" style="color:#6366f1;">@Model.NewShops</span></div>
    <div class="rpt-stat"><span class="rpt-stat-label">Total Shops</span><span class="rpt-stat-value">@Model.TotalShops</span></div>
    <div class="rpt-stat"><span class="rpt-stat-label">Active</span><span class="rpt-stat-value" style="color:#10b981;">@Model.ActiveShops</span></div>
    <div class="rpt-stat"><span class="rpt-stat-label">Inactive</span><span class="rpt-stat-value" style="color:#ef4444;">@Model.InactiveShops</span></div>
</div>

<!-- Interpretation -->
@if (!string.IsNullOrEmpty(Model.Interpretation))
{
    <div class="insight-box">
        <div class="insight-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
        </div>
        <div class="insight-text">@Model.Interpretation</div>
    </div>
}

<!-- Charts -->
@if (Model.MonthlyBreakdown.Any())
{
    <div style="display:grid; grid-template-columns: 2fr 1fr; gap:20px; margin-bottom:24px;">
        <div class="card">
            <div class="card-header"><h3 style="font-size:15px; font-weight:600; margin:0;">Monthly Shop Registrations</h3></div>
            <div class="card-body"><canvas id="shopBarChart" height="280"></canvas></div>
        </div>
        <div class="card">
            <div class="card-header"><h3 style="font-size:15px; font-weight:600; margin:0;">Active vs Inactive</h3></div>
            <div class="card-body" style="display:flex;align-items:center;justify-content:center;"><canvas id="shopDoughnut" height="280"></canvas></div>
        </div>
    </div>
}

<!-- Monthly Breakdown Table -->
<div class="card" style="margin-bottom:20px;">
    <div class="card-header"><h3 style="font-size:15px; font-weight:600; margin:0;">Monthly Breakdown</h3></div>
    <div class="card-body p-0">
        <div class="table-container">
            <table class="table">
                <thead><tr><th>Month</th><th class="text-center">New Shops</th></tr></thead>
                <tbody>
                    @foreach (var m in Model.MonthlyBreakdown)
                    {
                        <tr><td style="font-weight:500;">@m.Month</td><td class="text-center">@m.Count</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Shops Table -->
<div class="card">
    <div class="card-header">
        <h3 style="font-size:15px; font-weight:600; margin:0;">Shops Created in Period</h3>
        <span class="text-muted" style="font-size:13px;">@Model.Shops.Count row(s)</span>
    </div>
    <div class="card-body p-0">
        @if (Model.Shops.Any())
        {
            <div class="table-container">
                <table class="table">
                    <thead><tr><th>Shop</th><th>Status</th><th class="text-center">Users</th><th>Created</th></tr></thead>
                    <tbody>
                        @foreach (var s in Model.Shops)
                        {
                            <tr>
                                <td style="font-weight:500;">@s.Name</td>
                                <td><span class="status-badge @(s.Status == "Active" ? "status-success" : "status-muted")">@s.Status</span></td>
                                <td class="text-center">@s.Users</td>
                                <td>@s.Created</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div style="padding:60px 0; text-align:center;">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#cbd5e1" stroke-width="1.5"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/></svg>
                <p style="margin-top:12px; color:#9ca3af; font-size:14px;">No new shops in this period</p>
            </div>
        }
    </div>
</div>

<style>
    .page-title { font-size: 24px; font-weight: 700; color: var(--text-primary, #1f2937); margin-bottom: 4px; }
    .page-subtitle { font-size: 14px; color: var(--text-secondary, #6b7280); }
    .rpt-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 24px; }
    .rpt-stat { text-align: center; padding: 16px; background: var(--bg-primary, white); border-radius: 10px; border: 1px solid var(--border-primary, #e5e7eb); }
    .rpt-stat-label { display: block; font-size: 12px; color: var(--text-muted, #9ca3af); font-weight: 500; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 6px; }
    .rpt-stat-value { display: block; font-size: 22px; font-weight: 700; color: var(--text-primary, #1f2937); }
    .insight-box { display: flex; gap: 12px; padding: 16px 20px; margin-bottom: 24px; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 10px; }
    .insight-icon { color: #3b82f6; flex-shrink: 0; margin-top: 2px; }
    .insight-text { font-size: 14px; color: #1e40af; line-height: 1.6; }
    .status-badge { display: inline-block; padding: 2px 10px; border-radius: 20px; font-size: 12px; font-weight: 500; }
    .status-success { background: #d1fae5; color: #065f46; }
    .status-muted { background: #f3f4f6; color: #6b7280; }
    @@media (max-width: 768px) { .rpt-stats { grid-template-columns: repeat(2, 1fr); } }
</style>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js" integrity="sha384-vsrfeLOOY6KuIYKDlmVH5UiBmgIdB1oEf7p01YgWHuqmOHfZr374+odEv96n9tNC" crossorigin="anonymous"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    var labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyBreakdown.Select(m => m.Month)));
    var values = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyBreakdown.Select(m => m.Count)));
    if (!labels.length) return;

    new Chart(document.getElementById('shopBarChart'), {
        type: 'bar',
        data: { labels: labels, datasets: [{ label: 'New Shops', data: values, backgroundColor: '#6366f133', borderColor: '#6366f1', borderWidth: 1.5, borderRadius: 6 }] },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { stepSize: 1 }, grid: { color: '#f3f4f6' } }, x: { grid: { display: false } } } }
    });

    new Chart(document.getElementById('shopDoughnut'), {
        type: 'doughnut',
        data: { labels: ['Active', 'Inactive'], datasets: [{ data: [@Model.ActiveShops, @Model.InactiveShops], backgroundColor: ['#10b981', '#ef4444'], borderColor: '#fff', borderWidth: 2 }] },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom', labels: { boxWidth: 12, padding: 8, font: { size: 11 } } } }, cutout: '55%' }
    });
});
</script>
}
