@model SubscriptionPaymentDetailViewModel

<div class="pay-detail">
    <div class="pay-detail-header">
        <span class="ref-code-lg">@Model.ReferenceNumber</span>
        <span class="status-indicator @Model.StatusClass" style="font-size: 13px;">@Model.Status</span>
    </div>

    <div class="pay-detail-grid">
        <div class="pay-detail-section">
            <h4 class="pay-detail-section-title">Payment Information</h4>
            <div class="pay-detail-row">
                <span class="pay-detail-label">Amount</span>
                <span class="pay-detail-value pay-amount">@Model.Amount.ToString("C")</span>
            </div>
            <div class="pay-detail-row">
                <span class="pay-detail-label">Method</span>
                <span class="pay-detail-value">@Model.PaymentMethod</span>
            </div>
            @if (!string.IsNullOrEmpty(Model.PayMongoPaymentId))
            {
                <div class="pay-detail-row">
                    <span class="pay-detail-label">PayMongo ID</span>
                    <span class="pay-detail-value"><code>@Model.PayMongoPaymentId</code></span>
                </div>
            }
            <div class="pay-detail-row">
                <span class="pay-detail-label">Status</span>
                <span class="pay-detail-value">@Model.Status</span>
            </div>
            @if (Model.PaidAt.HasValue)
            {
                <div class="pay-detail-row">
                    <span class="pay-detail-label">Paid At</span>
                    <span class="pay-detail-value">@Model.PaidAt.Value.ToString("MMMM dd, yyyy h:mm tt")</span>
                </div>
            }
        </div>

        <div class="pay-detail-section">
            <h4 class="pay-detail-section-title">Subscription Details</h4>
            <div class="pay-detail-row">
                <span class="pay-detail-label">Shop</span>
                <span class="pay-detail-value fw-500">@Model.ShopName</span>
            </div>
            <div class="pay-detail-row">
                <span class="pay-detail-label">Plan</span>
                <span class="pay-detail-value">@Model.PlanName</span>
            </div>
            <div class="pay-detail-row">
                <span class="pay-detail-label">Billing Cycle</span>
                <span class="pay-detail-value">@Model.BillingCycle</span>
            </div>
            <div class="pay-detail-row">
                <span class="pay-detail-label">Coverage Period</span>
                <span class="pay-detail-value">@Model.PeriodStart.ToString("MMM dd, yyyy") — @Model.PeriodEnd.ToString("MMM dd, yyyy")</span>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Notes))
    {
        <div class="pay-detail-section">
            <h4 class="pay-detail-section-title">Notes</h4>
            <p class="pay-notes">@Model.Notes</p>
        </div>
    }
</div>

<style>
    .pay-detail { padding: 4px 0; }
    .pay-detail-header { display: flex; align-items: center; justify-content: space-between; padding-bottom: 16px; margin-bottom: 20px; border-bottom: 1px solid #e5e7eb; }
    .ref-code-lg { font-family: 'Courier New', monospace; font-size: 16px; font-weight: 700; color: #1f2937; background: #f3f4f6; padding: 4px 12px; border-radius: 6px; }
    .pay-detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
    .pay-detail-section { margin-bottom: 8px; }
    .pay-detail-section-title { font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: #9ca3af; margin-bottom: 12px; padding-bottom: 6px; border-bottom: 1px solid #f3f4f6; }
    .pay-detail-row { display: flex; justify-content: space-between; align-items: center; padding: 6px 0; }
    .pay-detail-label { font-size: 13px; color: #6b7280; }
    .pay-detail-value { font-size: 13px; color: #1f2937; font-weight: 500; text-align: right; }
    .pay-amount { font-size: 18px; font-weight: 700; color: #059669; }
    .pay-notes { font-size: 13px; color: #4b5563; line-height: 1.6; background: #f9fafb; padding: 12px 16px; border-radius: 8px; border: 1px solid #f3f4f6; }
    .fw-500 { font-weight: 500; }
    code { font-size: 12px; background: #f3f4f6; padding: 2px 6px; border-radius: 4px; color: #374151; word-break: break-all; }
    @@media (max-width: 640px) { .pay-detail-grid { grid-template-columns: 1fr; } }
</style>
