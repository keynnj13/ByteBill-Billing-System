@model SubscriptionPaymentDetailViewModel

<div class="modal-detail-body" style="padding: 0;">
    <!-- Hero Header -->
    <div class="pd-hero">
        <div class="pd-hero-left">
            <div class="pd-hero-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="15" rx="2"/><path d="M2 10h20"/></svg>
            </div>
            <div>
                <code class="pd-ref">@Model.ReferenceNumber</code>
                <div class="pd-date">
                    @if (Model.PaidAt.HasValue)
                    {
                        @Model.PaidAt.Value.ToString("MMM dd, yyyy · h:mm tt")
                    }
                    else
                    {
                        <span>Pending</span>
                    }
                </div>
            </div>
        </div>
        <span class="status-indicator @Model.StatusClass" style="font-size: 13px;">@Model.Status</span>
    </div>

    <!-- Amount Highlight -->
    <div class="pd-amount-card">
        <span class="pd-amount-label">Amount</span>
        <span class="pd-amount-value">₱@Model.Amount.ToString("N2")</span>
    </div>

    <!-- Info Cards Grid -->
    <div class="pd-cards">
        <!-- Payment Information -->
        <div class="pd-card">
            <h4 class="pd-card-title">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="15" rx="2"/><path d="M2 10h20"/></svg>
                Payment Information
            </h4>
            <div class="pd-field">
                <span class="pd-label">Method</span>
                <span class="pd-value">
                    <span class="pd-method-badge">@Model.PaymentMethod</span>
                </span>
            </div>
            @if (!string.IsNullOrEmpty(Model.PayMongoPaymentId))
            {
                <div class="pd-field">
                    <span class="pd-label">PayMongo ID</span>
                    <span class="pd-value"><code class="pd-code">@Model.PayMongoPaymentId</code></span>
                </div>
            }
            <div class="pd-field">
                <span class="pd-label">Status</span>
                <span class="pd-value"><span class="status-indicator @Model.StatusClass">@Model.Status</span></span>
            </div>
            @if (Model.PaidAt.HasValue)
            {
                <div class="pd-field">
                    <span class="pd-label">Paid At</span>
                    <span class="pd-value">@Model.PaidAt.Value.ToString("MMM dd, yyyy h:mm tt")</span>
                </div>
            }
        </div>

        <!-- Subscription Details -->
        <div class="pd-card">
            <h4 class="pd-card-title">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                Subscription Details
            </h4>
            <div class="pd-field">
                <span class="pd-label">Shop</span>
                <span class="pd-value" style="font-weight: 600;">@Model.ShopName</span>
            </div>
            <div class="pd-field">
                <span class="pd-label">Plan</span>
                <span class="pd-value">@Model.PlanName</span>
            </div>
            <div class="pd-field">
                <span class="pd-label">Billing Cycle</span>
                <span class="pd-value">@Model.BillingCycle</span>
            </div>
            <div class="pd-field">
                <span class="pd-label">Coverage</span>
                <span class="pd-value">@Model.PeriodStart.ToString("MMM dd, yyyy") — @Model.PeriodEnd.ToString("MMM dd, yyyy")</span>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Notes))
    {
        <div class="pd-notes">
            <h4 class="pd-card-title" style="margin-bottom: 8px;">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                Notes
            </h4>
            <p class="pd-notes-text">@Model.Notes</p>
        </div>
    }
</div>

<div class="modal-form-footer">
    <button type="button" class="btn btn-ghost" onclick="closeAjaxModal()">Close</button>
</div>

<style>
    .pd-hero { display: flex; align-items: center; justify-content: space-between; padding: 20px 24px; background: linear-gradient(135deg, #f8fafc 0%, #f0fdf4 100%); border-bottom: 1px solid #e5e7eb; }
    .pd-hero-left { display: flex; align-items: center; gap: 14px; }
    .pd-hero-icon { width: 44px; height: 44px; border-radius: 10px; background: rgba(16,185,129,0.1); color: #059669; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .pd-ref { font-family: 'Courier New', monospace; font-size: 14px; font-weight: 700; color: #1f2937; background: white; padding: 3px 10px; border-radius: 5px; border: 1px solid #e5e7eb; display: inline-block; }
    .pd-date { font-size: 12px; color: #9ca3af; margin-top: 4px; }
    .pd-amount-card { display: flex; align-items: center; justify-content: space-between; margin: 20px 24px 0; padding: 16px 20px; background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 10px; }
    .pd-amount-label { font-size: 13px; font-weight: 600; color: #166534; text-transform: uppercase; letter-spacing: 0.04em; }
    .pd-amount-value { font-size: 26px; font-weight: 800; color: #059669; letter-spacing: -0.02em; }
    .pd-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; padding: 20px 24px; }
    .pd-card { background: #f9fafb; border: 1px solid #f3f4f6; border-radius: 10px; padding: 16px; }
    .pd-card-title { display: flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: #6b7280; margin: 0 0 14px; padding-bottom: 10px; border-bottom: 1px solid #e5e7eb; }
    .pd-field { display: flex; justify-content: space-between; align-items: center; padding: 7px 0; }
    .pd-field + .pd-field { border-top: 1px solid #f3f4f6; }
    .pd-label { font-size: 13px; color: #9ca3af; }
    .pd-value { font-size: 13px; color: #1f2937; font-weight: 500; text-align: right; max-width: 60%; word-break: break-word; }
    .pd-method-badge { display: inline-block; padding: 2px 10px; border-radius: 5px; font-size: 12px; font-weight: 600; background: #ede9fe; color: #7c3aed; text-transform: capitalize; }
    .pd-code { font-size: 11px; background: #f3f4f6; padding: 2px 6px; border-radius: 4px; color: #374151; word-break: break-all; font-family: 'Courier New', monospace; }
    .pd-notes { padding: 0 24px 20px; }
    .pd-notes-text { font-size: 13px; color: #4b5563; line-height: 1.6; background: #f9fafb; padding: 12px 16px; border-radius: 8px; border: 1px solid #f3f4f6; margin: 0; }
    @@media (max-width: 640px) { .pd-cards { grid-template-columns: 1fr; } }
</style>
