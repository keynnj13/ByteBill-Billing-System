@model SystemLogDetailViewModel

<div class="modal-detail-body">
    <!-- Log Header -->
    <div style="display: flex; align-items: flex-start; gap: 16px; padding-bottom: 20px; border-bottom: 1px solid #e5e7eb; margin-bottom: 20px;">
        <div style="width: 48px; height: 48px; border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;
            background: @(Model.Type == "Error" || Model.Type == "Critical" ? "rgba(239,68,68,0.1)" : Model.Type == "Warning" ? "rgba(245,158,11,0.1)" : "rgba(6,182,212,0.1)");
            color: @(Model.Type == "Error" || Model.Type == "Critical" ? "#ef4444" : Model.Type == "Warning" ? "#f59e0b" : "#06b6d4");">
            @if (Model.Type == "Error" || Model.Type == "Critical")
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
            }
            else if (Model.Type == "Warning")
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
            }
            else
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
            }
        </div>
        <div style="flex: 1;">
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
                <span class="badge @Model.TypeClass" style="font-size: 12px;">@Model.Type</span>
                <span style="font-size: 12px; color: #9ca3af;">@Model.Timestamp.ToString("MMM dd, yyyy h:mm:ss tt")</span>
            </div>
            <p style="margin: 0; font-size: 15px; font-weight: 500; color: #1f2937; line-height: 1.4;">@Model.Message</p>
        </div>
    </div>

    <!-- Details Grid -->
    <div class="form-section" style="margin-bottom: 16px;">
        <h4 class="form-section-title">Details</h4>
        <div class="detail-grid">
            <div class="detail-item">
                <span class="detail-label">User</span>
                <span class="detail-value">@Model.UserName</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Email</span>
                <span class="detail-value">@(Model.UserEmail ?? "—")</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Shop</span>
                <span class="detail-value">@(Model.ShopName ?? "System-wide")</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">IP Address</span>
                <span class="detail-value" style="font-family: monospace;">@(Model.IpAddress ?? "—")</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Source</span>
                <span class="detail-value" style="font-family: monospace;">@(Model.Source ?? "—")</span>
            </div>
            @if (!string.IsNullOrEmpty(Model.RequestUrl))
            {
                <div class="detail-item">
                    <span class="detail-label">Request URL</span>
                    <span class="detail-value" style="font-family: monospace;">@Model.RequestUrl</span>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.UserAgent))
            {
                <div class="detail-item">
                    <span class="detail-label">User Agent</span>
                    <span class="detail-value" style="font-size: 12px; word-break: break-all;">@Model.UserAgent</span>
                </div>
            }
        </div>
    </div>

    <!-- Stack Trace -->
    @if (!string.IsNullOrEmpty(Model.StackTrace))
    {
        <div class="form-section">
            <h4 class="form-section-title">Stack Trace</h4>
            <pre style="background: #1f2937; color: #e5e7eb; padding: 16px; border-radius: 8px; font-size: 12px; line-height: 1.6; overflow-x: auto; white-space: pre-wrap; word-break: break-all; font-family: 'SF Mono', 'Cascadia Code', 'Fira Code', monospace;">@Model.StackTrace</pre>
        </div>
    }
</div>

<div class="modal-form-footer">
    <button type="button" class="btn btn-secondary" onclick="closeAjaxModal()">Close</button>
</div>
