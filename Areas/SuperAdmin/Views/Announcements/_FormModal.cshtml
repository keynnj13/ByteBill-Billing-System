@model AnnouncementFormViewModel

<form id="announcementForm" asp-action="@(Model.Id > 0 ? "Edit" : "Create")" asp-controller="Announcements" asp-area="SuperAdmin" method="post" onsubmit="submitAjaxForm(event, 'announcementForm')">
    <input type="hidden" asp-for="Id" />

    <div class="ann-form-body">
        <!-- Section: Details -->
        <div class="ann-section">
            <h4 class="ann-section-title">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                Details
            </h4>

            <div class="ann-field">
                <label class="ann-label" asp-for="Title">Title <span class="ann-req">*</span></label>
                <input type="text" asp-for="Title" class="form-input" placeholder="Enter announcement title..." required />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="ann-field">
                <label class="ann-label" asp-for="Type">Type <span class="ann-req">*</span></label>
                <div class="ann-type-grid">
                    @{
                        var types = new[] {
                            ("Info", "info", "#3b82f6", "#eff6ff", "Information or general update"),
                            ("Warning", "warning", "#f59e0b", "#fffbeb", "Important notice requiring attention"),
                            ("Alert", "alert", "#ef4444", "#fef2f2", "Critical alert requiring action"),
                            ("Maintenance", "maintenance", "#8b5cf6", "#f5f3ff", "Scheduled system maintenance")
                        };
                    }
                    @foreach (var (val, cls, color, bg, desc) in types)
                    {
                        <label class="ann-type-option" data-type="@val">
                            <input type="radio" name="Type" value="@val" @(Model.Type == val ? "checked" : "") required />
                            <div class="ann-type-card">
                                <div class="ann-type-dot" style="background: @color;"></div>
                                <div>
                                    <span class="ann-type-name">@val</span>
                                    <span class="ann-type-desc">@desc</span>
                                </div>
                            </div>
                        </label>
                    }
                </div>
                <span asp-validation-for="Type" class="text-danger"></span>
            </div>

            <div class="ann-field">
                <label class="ann-label" asp-for="Content">
                    Content <span class="ann-req">*</span>
                    <span class="ann-char-count" id="charCount">0 characters</span>
                </label>
                <textarea asp-for="Content" class="form-input ann-textarea" id="annContent" rows="5" placeholder="Write the announcement content..." required></textarea>
                <span asp-validation-for="Content" class="text-danger"></span>
            </div>
        </div>

        <!-- Section: Scheduling -->
        <div class="ann-section">
            <h4 class="ann-section-title">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                Scheduling
            </h4>

            <div class="ann-field">
                <label class="ann-label" asp-for="ExpiresAt">Expiry Date <span class="ann-opt">(optional)</span></label>
                <input type="datetime-local" asp-for="ExpiresAt" class="form-input" />
                <span class="ann-help">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                    Leave blank for no expiry. Expired announcements are automatically hidden.
                </span>
            </div>
        </div>
    </div>

    <div class="modal-form-footer">
        <button type="button" class="btn btn-ghost" onclick="closeAjaxModal()">Cancel</button>
        <button type="submit" class="btn btn-primary">
            @(Model.Id > 0 ? "Update" : "Create") Announcement
        </button>
    </div>
</form>

<style>
    .ann-form-body { padding: 24px; }
    .ann-section { margin-bottom: 24px; }
    .ann-section:last-child { margin-bottom: 0; }
    .ann-section-title { display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 600; color: #374151; margin: 0 0 16px; padding-bottom: 10px; border-bottom: 1px solid #f3f4f6; }
    .ann-field { margin-bottom: 18px; }
    .ann-field:last-child { margin-bottom: 0; }
    .ann-label { display: flex; align-items: center; gap: 4px; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px; }
    .ann-req { color: #ef4444; font-weight: 700; }
    .ann-opt { color: #9ca3af; font-weight: 400; font-size: 12px; }
    .ann-char-count { margin-left: auto; font-size: 11px; font-weight: 400; color: #9ca3af; }
    .ann-textarea { resize: vertical; min-height: 100px; font-family: inherit; line-height: 1.6; }
    .ann-help { display: flex; align-items: flex-start; gap: 6px; font-size: 12px; color: #9ca3af; margin-top: 6px; line-height: 1.4; }
    .ann-type-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .ann-type-option { cursor: pointer; }
    .ann-type-option input[type="radio"] { display: none; }
    .ann-type-card { display: flex; align-items: flex-start; gap: 10px; padding: 12px; border: 2px solid #e5e7eb; border-radius: 8px; transition: all 0.15s; background: white; }
    .ann-type-option input:checked + .ann-type-card { border-color: #6366f1; background: #f5f3ff; }
    .ann-type-card:hover { border-color: #c7d2fe; }
    .ann-type-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; margin-top: 3px; }
    .ann-type-name { display: block; font-size: 13px; font-weight: 600; color: #1f2937; }
    .ann-type-desc { display: block; font-size: 11px; color: #9ca3af; margin-top: 2px; line-height: 1.3; }
    @@media (max-width: 480px) { .ann-type-grid { grid-template-columns: 1fr; } }
</style>

<script>
(function () {
    var ta = document.getElementById('annContent');
    var counter = document.getElementById('charCount');
    if (ta && counter) {
        function update() { counter.textContent = ta.value.length + ' character' + (ta.value.length !== 1 ? 's' : ''); }
        ta.addEventListener('input', update);
        update();
    }
})();
</script>
