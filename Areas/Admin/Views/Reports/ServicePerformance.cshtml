@model ServicePerformanceReportViewModel
@using ByteBill_BS.ViewModels.Admin
@{
    ViewData["Title"] = "Service Performance";
}

<partial name="~/Views/Shared/_Breadcrumbs.cshtml" model="@(new BreadcrumbViewModel { Items = new List<BreadcrumbViewModel.BreadcrumbItem> { new() { Label = "Dashboard", Url = Url.Action("Index", "Dashboard") }, new() { Label = "Reports", Url = Url.Action("Index", "Reports") }, new() { Label = "Service Performance", IsActive = true } } })" />

<div class="page-header">
    <div>
        <h1 class="page-title">Service Performance</h1>
        <p class="page-subtitle">@Model.DateFrom.ToString("MMM dd, yyyy") — @Model.DateTo.ToString("MMM dd, yyyy")</p>
    </div>
    <div class="page-actions">
        <a asp-action="Index" class="btn btn-ghost">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
            Back to Reports
        </a>
    </div>
</div>

<!-- Date Range -->
<div class="section-card" style="margin-bottom: 20px;">
    <form method="get" asp-action="ServicePerformance" class="filter-bar">
        <div style="min-width: 160px;">
            <label style="font-size: 12px; font-weight: 500; color: var(--text-muted); display: block; margin-bottom: 4px;">From</label>
            <input type="date" name="from" value="@Model.DateFrom.ToString("yyyy-MM-dd")" class="form-input" />
        </div>
        <div style="min-width: 160px;">
            <label style="font-size: 12px; font-weight: 500; color: var(--text-muted); display: block; margin-bottom: 4px;">To</label>
            <input type="date" name="to" value="@Model.DateTo.ToString("yyyy-MM-dd")" class="form-input" />
        </div>
        <div style="padding-top: 18px;">
            <button type="submit" class="btn btn-primary">Apply</button>
        </div>
    </form>
</div>

<!-- Summary -->
<div class="svc-stats">
    <div class="svc-stat-card">
        <div>
            <span class="svc-stat-label">Total Job Orders</span>
            <span class="svc-stat-value" style="color: var(--navy);">@Model.TotalJobOrders</span>
        </div>
    </div>
    <div class="svc-stat-card">
        <div>
            <span class="svc-stat-label">Avg. Completion</span>
            <span class="svc-stat-value">@Model.AverageCompletionDays.ToString("N1") days</span>
        </div>
    </div>
    <div class="svc-stat-card">
        <div>
            <span class="svc-stat-label">Service Revenue</span>
            <span class="svc-stat-value" style="color: var(--emerald);">&#8369;@Model.TotalServiceRevenue.ToString("N2")</span>
        </div>
    </div>
</div>

<!-- Top Services -->
<div class="section-card" style="margin-bottom: 20px;">
    <h3 style="margin: 0 0 16px; font-size: 15px; font-weight: 600;">Top Services by Usage</h3>
    <div class="table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Service</th>
                    <th>Category</th>
                    <th style="text-align: center;">Usage</th>
                    <th style="text-align: right;">Revenue</th>
                    <th style="text-align: right;">Avg. Price</th>
                </tr>
            </thead>
            <tbody>
                @{ int rank = 0; }
                @foreach (var s in Model.Services)
                {
                    rank++;
                    <tr>
                        <td>
                            <span style="display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px; border-radius: 50%; font-size: 11px; font-weight: 600;
                                background: @(rank <= 3 ? "var(--navy)" : "#f1f5f9");
                                color: @(rank <= 3 ? "white" : "var(--text-muted)");">
                                @rank
                            </span>
                        </td>
                        <td class="fw-medium">@s.ServiceName</td>
                        <td><span class="badge badge-muted">@s.Category</span></td>
                        <td style="text-align: center;">@s.UsageCount</td>
                        <td style="text-align: right;">&#8369;@s.Revenue.ToString("N2")</td>
                        <td style="text-align: right;">&#8369;@s.AveragePrice.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Category Performance -->
<div class="section-card">
    <h3 style="margin: 0 0 16px; font-size: 15px; font-weight: 600;">Performance by Category</h3>
    <div class="table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Category</th>
                    <th style="text-align: center;">Services</th>
                    <th style="text-align: center;">Total Usage</th>
                    <th style="text-align: right;">Revenue</th>
                    <th style="text-align: right;">Share</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Categories)
                {
                    <tr>
                        <td class="fw-medium">@c.Category</td>
                        <td style="text-align: center;">@c.ServiceCount</td>
                        <td style="text-align: center;">@c.UsageCount</td>
                        <td style="text-align: right;">&#8369;@c.Revenue.ToString("N2")</td>
                        <td style="text-align: right;">
                            <div style="display: flex; align-items: center; justify-content: flex-end; gap: 8px;">
                                <div style="width: 80px; height: 6px; background: #e2e8f0; border-radius: 3px; overflow: hidden;">
                                    <div style="height: 100%; width: @c.Percentage%; background: #7c3aed; border-radius: 3px;"></div>
                                </div>
                                <span style="font-size: 13px; min-width: 42px;">@c.Percentage.ToString("N1")%</span>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
