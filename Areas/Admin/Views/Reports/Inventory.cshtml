@model InventoryReportViewModel
@using ByteBill_BS.ViewModels.Admin
@{
    ViewData["Title"] = "Inventory Report";
}

<partial name="~/Views/Shared/_Breadcrumbs.cshtml" model="@(new BreadcrumbViewModel { Items = new List<BreadcrumbViewModel.BreadcrumbItem> { new() { Label = "Dashboard", Url = Url.Action("Index", "Dashboard") }, new() { Label = "Reports", Url = Url.Action("Index", "Reports") }, new() { Label = "Inventory", IsActive = true } } })" />

<div class="page-header">
    <div>
        <h1 class="page-title">Inventory Report</h1>
        <p class="page-subtitle">Stock levels and valuation overview</p>
    </div>
    <div class="page-actions">
        <a asp-action="Index" class="btn btn-ghost">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
            Back to Reports
        </a>
    </div>
</div>

<!-- Summary -->
<div class="svc-stats">
    <div class="svc-stat-card">
        <div>
            <span class="svc-stat-label">Total Items</span>
            <span class="svc-stat-value" style="color: var(--navy);">@Model.TotalItems</span>
        </div>
    </div>
    <div class="svc-stat-card">
        <div>
            <span class="svc-stat-label">Low Stock</span>
            <span class="svc-stat-value" style="color: #d97706;">@Model.LowStockItems</span>
        </div>
    </div>
    <div class="svc-stat-card">
        <div>
            <span class="svc-stat-label">Out of Stock</span>
            <span class="svc-stat-value" style="color: #dc2626;">@Model.OutOfStockItems</span>
        </div>
    </div>
    <div class="svc-stat-card">
        <div>
            <span class="svc-stat-label">Stock Value (Cost)</span>
            <span class="svc-stat-value" style="color: var(--emerald);">&#8369;@Model.TotalStockValue.ToString("N2")</span>
        </div>
    </div>
</div>

<!-- Stock Alert / Low Stock Items -->
@{
    var alertItems = Model.Items.Where(i => i.IsLowStock).ToList();
}
@if (alertItems.Any())
{
    <div class="section-card" style="margin-bottom: 20px; border-left: 4px solid #d97706;">
        <h3 style="margin: 0 0 12px; font-size: 15px; font-weight: 600; color: #d97706;">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle; margin-right: 6px;"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
            Reorder Alerts (@alertItems.Count items)
        </h3>
        <div style="display: flex; flex-wrap: wrap; gap: 10px;">
            @foreach (var item in alertItems)
            {
                <div style="background: #fffbeb; border: 1px solid #fde68a; border-radius: 8px; padding: 10px 14px; font-size: 13px;">
                    <span class="fw-medium">@item.ItemName</span>
                    <span class="text-muted">(@item.SKU)</span>
                    —
                    <span style="color: @(item.QtyOnHand == 0 ? "#dc2626" : "#d97706"); font-weight: 600;">
                        @(item.QtyOnHand == 0 ? "OUT OF STOCK" : $"{item.QtyOnHand} left (reorder at {item.ReorderLevel})")
                    </span>
                </div>
            }
        </div>
    </div>
}

<!-- Full Stock List -->
<div class="section-card" style="margin-bottom: 20px;">
    <h3 style="margin: 0 0 16px; font-size: 15px; font-weight: 600;">Stock Levels</h3>
    <div class="table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>SKU</th>
                    <th>Item</th>
                    <th>Category</th>
                    <th style="text-align: center;">Qty</th>
                    <th style="text-align: center;">Reorder Level</th>
                    <th style="text-align: right;">Unit Cost</th>
                    <th style="text-align: right;">Stock Value</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="text-muted" style="font-size: 12px; font-family: monospace;">@item.SKU</td>
                        <td class="fw-medium">@item.ItemName</td>
                        <td><span class="badge badge-muted">@item.Category</span></td>
                        <td style="text-align: center; font-weight: 600; color: @(item.QtyOnHand == 0 ? "#dc2626" : item.IsLowStock ? "#d97706" : "var(--text-primary)");">@item.QtyOnHand</td>
                        <td style="text-align: center;" class="text-muted">@item.ReorderLevel</td>
                        <td style="text-align: right;">&#8369;@item.UnitCost.ToString("N2")</td>
                        <td style="text-align: right; font-weight: 500;">&#8369;@item.StockValue.ToString("N2")</td>
                        <td>
                            @if (item.QtyOnHand == 0)
                            {
                                <span class="badge badge-danger">Out of Stock</span>
                            }
                            else if (item.IsLowStock)
                            {
                                <span class="badge badge-warning">Low Stock</span>
                            }
                            else
                            {
                                <span class="badge badge-success">In Stock</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr style="font-weight: 600; border-top: 2px solid var(--border);">
                    <td colspan="6">Total Stock Value</td>
                    <td style="text-align: right;">&#8369;@Model.TotalStockValue.ToString("N2")</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<!-- Category Breakdown -->
<div class="section-card">
    <h3 style="margin: 0 0 16px; font-size: 15px; font-weight: 600;">Value by Category</h3>
    <div class="table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Category</th>
                    <th style="text-align: center;">Items</th>
                    <th style="text-align: center;">Total Qty</th>
                    <th style="text-align: right;">Value</th>
                    <th style="text-align: right;">Share</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.CategoryBreakdown)
                {
                    <tr>
                        <td class="fw-medium">@c.Category</td>
                        <td style="text-align: center;">@c.ItemCount</td>
                        <td style="text-align: center;">@c.TotalQty</td>
                        <td style="text-align: right;">&#8369;@c.TotalValue.ToString("N2")</td>
                        <td style="text-align: right;">
                            <div style="display: flex; align-items: center; justify-content: flex-end; gap: 8px;">
                                <div style="width: 80px; height: 6px; background: #e2e8f0; border-radius: 3px; overflow: hidden;">
                                    <div style="height: 100%; width: @c.Percentage%; background: #d97706; border-radius: 3px;"></div>
                                </div>
                                <span style="font-size: 13px; min-width: 42px;">@c.Percentage.ToString("N1")%</span>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
