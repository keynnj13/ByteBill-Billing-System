@model CustomerListViewModel
@{
    ViewData["Title"] = "Customers";
}

<partial name="~/Views/Shared/_Breadcrumbs.cshtml" model="@(new BreadcrumbViewModel { Items = new List<BreadcrumbViewModel.BreadcrumbItem> { new() { Label = "Dashboard", Url = Url.Action("Index", "Dashboard") }, new() { Label = "Customers", IsActive = true } } })" />

<div class="page-header">
    <div>
        <h1 class="page-title">Customers</h1>
        <p class="page-subtitle">@Model.TotalCount total customers</p>
    </div>
    <div class="page-actions">
        <button type="button" class="btn btn-primary" onclick="openAjaxModal('@Url.Action("CreateModal", "Customers", new { area = "Admin" })', 'New Customer')">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            Add Customer
        </button>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" style="margin-bottom: 20px; padding: 12px 16px; background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 8px; color: #065f46; font-size: 14px;">
        @TempData["Success"]
    </div>
}

<div class="card">
    <div class="card-header">
        <form method="get" class="search-form">
            <div class="search-input-wrapper">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="search-icon"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                <input type="text" name="search" value="@Model.SearchTerm" placeholder="Search customers by name, email, or phone..." class="form-input search-input" />
            </div>
            <button type="submit" class="btn btn-outline-primary">Search</button>
        </form>
    </div>
    <div class="card-body p-0">
        @if (Model.Customers.Any())
        {
            <div class="table-container">
                <table class="table" style="table-layout: fixed;">
                    <colgroup>
                        <col style="width: 25%;" />
                        <col style="width: 25%;" />
                        <col style="width: 10%;" />
                        <col style="width: 14%;" />
                        <col style="width: 12%;" />
                        <col style="width: 14%;" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>Customer</th>
                            <th>Contact</th>
                            <th class="text-center">Orders</th>
                            <th class="text-right">Total Spent</th>
                            <th class="text-center">Status</th>
                            <th class="text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var customer in Model.Customers)
                        {
                            <tr class="clickable-row" onclick="openAjaxModal('@Url.Action("DetailsModal", "Customers", new { area = "Admin", id = customer.Id })', '@customer.Name')">
                                <td>
                                    <div class="customer-cell">
                                        <div class="avatar avatar-sm">@customer.Initials</div>
                                        <span class="customer-name">@customer.Name</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="contact-info">
                                        <span class="contact-email">@customer.Email</span>
                                        <span class="contact-phone">@customer.Phone</span>
                                    </div>
                                </td>
                                <td class="text-center"><span class="text-medium">@customer.TotalOrders</span></td>
                                <td class="text-right"><span class="text-medium">@customer.TotalSpent.ToString("C")</span></td>
                                <td class="text-center">
                                    <span class="badge @(customer.IsActive ? "badge-success" : "badge-muted")">
                                        @(customer.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td>
                                    <div class="action-buttons">
                                        <button type="button" class="btn-action" title="Edit" onclick="event.stopPropagation(); openAjaxModal('@Url.Action("EditModal", "Customers", new { area = "Admin", id = customer.Id })', 'Edit Customer')">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <partial name="~/Views/Shared/_Pagination.cshtml" model="@(new PaginationViewModel { CurrentPage = Model.CurrentPage, TotalPages = (int)Math.Ceiling(Model.TotalCount / 10.0), BaseUrl = Url.Action("Index") })" />
        }
        else
        {
            <partial name="~/Views/Shared/_EmptyState.cshtml" model="@(new { Icon = "users", Title = "No customers found", Description = Model.SearchTerm != null ? "Try a different search term" : "Add your first customer to get started" })" />
        }
    </div>
</div>

<style>
    .page-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px; }
    .page-title { font-size: 24px; font-weight: 700; color: #1f2937; margin-bottom: 4px; }
    .page-subtitle { font-size: 14px; color: #6b7280; }
    .search-form { display: flex; gap: 12px; align-items: center; }
    .search-input-wrapper { position: relative; flex: 1; }
    .search-icon { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #9ca3af; }
    .search-input { padding-left: 40px; min-width: 280px; }
    .customer-cell { display: flex; align-items: center; gap: 12px; }
    .avatar { width: 36px; height: 36px; border-radius: 50%; background: rgba(59,130,246,0.1); color: #3b82f6; display: flex; align-items: center; justify-content: center; font-weight: 600; font-size: 13px; flex-shrink: 0; }
    .customer-name { font-weight: 500; color: #1f2937; text-decoration: none; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .customer-name:hover { color: #3b82f6; }
    .contact-info { display: flex; flex-direction: column; gap: 2px; }
    .contact-email { font-size: 13px; color: #374151; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .contact-phone { font-size: 12px; color: #9ca3af; }
    .text-medium { font-weight: 500; color: #374151; }
    .action-buttons { display: flex; gap: 4px; justify-content: flex-end; }
    .btn-action { width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; border-radius: 6px; color: #6b7280; transition: all 0.15s; border: none; background: none; cursor: pointer; text-decoration: none; }
    .btn-action:hover { background: #f3f4f6; color: #3b82f6; }
    .clickable-row { cursor: pointer; transition: background-color 0.15s ease; }
    .clickable-row:hover { background-color: #f0f7ff; }
    @@media (max-width: 768px) {
        .page-header { flex-direction: column; gap: 12px; }
        .search-form { flex-direction: column; width: 100%; }
        .search-input { min-width: 100%; }
        .table { table-layout: auto !important; }
    }
</style>
