@model CustomerFormViewModel
@{
    ViewData["Title"] = "Edit Customer";
}

<partial name="~/Views/Shared/_Breadcrumbs.cshtml" model="@(new BreadcrumbViewModel { Items = new List<BreadcrumbViewModel.BreadcrumbItem> { new() { Label = "Dashboard", Url = Url.Action("Index", "Dashboard") }, new() { Label = "Customers", Url = Url.Action("Index") }, new() { Label = "Edit Customer", IsActive = true } } })" />

<div class="page-header">
    <div>
        <h1 class="page-title">Edit Customer</h1>
        <p class="page-subtitle">Update customer information</p>
    </div>
</div>

<div class="card form-card">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <partial name="~/Views/Shared/_ValidationSummary.cshtml" />
            <input type="hidden" asp-for="Id" />

            <div class="form-section">
                <h3 class="form-section-title">Personal Information</h3>
                <div class="form-group">
                    <label asp-for="Name" class="form-label">Full Name <span class="required">*</span></label>
                    <input asp-for="Name" class="form-input" placeholder="Enter customer's full name" />
                    <span asp-validation-for="Name" class="field-error"></span>
                </div>
            </div>

            <div class="form-section">
                <h3 class="form-section-title">Contact Details</h3>
                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="Email" class="form-label">Email Address <span class="required">*</span></label>
                        <input asp-for="Email" type="email" class="form-input" placeholder="customer@email.com" />
                        <span asp-validation-for="Email" class="field-error"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Phone" class="form-label">Phone Number</label>
                        <input asp-for="Phone" type="tel" class="form-input" placeholder="(555) 123-4567" />
                        <span asp-validation-for="Phone" class="field-error"></span>
                    </div>
                </div>
                <div class="form-group">
                    <label asp-for="Address" class="form-label">Address</label>
                    <textarea asp-for="Address" class="form-input" rows="2" placeholder="Street address, city, state, zip"></textarea>
                    <span asp-validation-for="Address" class="field-error"></span>
                </div>
            </div>

            <div class="form-section">
                <h3 class="form-section-title">Additional Information</h3>
                <div class="form-group">
                    <label asp-for="Notes" class="form-label">Notes</label>
                    <textarea asp-for="Notes" class="form-input" rows="3" placeholder="Any special notes about this customer..."></textarea>
                    <span asp-validation-for="Notes" class="field-error"></span>
                </div>
            </div>

            <div class="form-actions">
                <a asp-action="Index" class="btn btn-ghost">Cancel</a>
                <button type="submit" class="btn btn-primary">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
                    Update Customer
                </button>
            </div>
        </form>
    </div>
</div>

<style>
    .page-header { margin-bottom: 24px; }
    .page-title { font-size: 24px; font-weight: 700; color: #1f2937; margin-bottom: 4px; }
    .page-subtitle { font-size: 14px; color: #6b7280; }
    .form-card { max-width: 680px; }
    .form-section { margin-bottom: 28px; }
    .form-section:last-of-type { margin-bottom: 0; }
    .form-section-title { font-size: 15px; font-weight: 600; color: #374151; margin-bottom: 16px; padding-bottom: 8px; border-bottom: 1px solid #f3f4f6; }
    .form-row { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
    .form-group { margin-bottom: 16px; }
    .form-label { font-size: 13px; font-weight: 500; color: #374151; margin-bottom: 6px; display: block; }
    .required { color: #ef4444; }
    .field-error { font-size: 12px; color: #ef4444; margin-top: 4px; display: block; }
    .form-actions { display: flex; justify-content: flex-end; gap: 12px; margin-top: 28px; padding-top: 20px; border-top: 1px solid #f3f4f6; }
    @@media (max-width: 640px) { .form-row { grid-template-columns: 1fr; } }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
