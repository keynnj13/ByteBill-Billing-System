@model JobOrderCreateViewModel

<form asp-action="Create" asp-controller="JobOrders" asp-area="Admin" method="post" data-ajax="true">
    @Html.AntiForgeryToken()
    <partial name="~/Views/Shared/_ValidationSummary.cshtml" />
    
    <div class="modal-form-body modal-wizard">
        <!-- Wizard Progress Steps -->
        <div class="modal-wizard-steps">
            <div class="modal-wizard-step active" data-step="1">
                <span class="step-number">1</span>
                <span class="step-label">Customer</span>
            </div>
            <div class="modal-wizard-connector"></div>
            <div class="modal-wizard-step" data-step="2">
                <span class="step-number">2</span>
                <span class="step-label">Device</span>
            </div>
            <div class="modal-wizard-connector"></div>
            <div class="modal-wizard-step" data-step="3">
                <span class="step-number">3</span>
                <span class="step-label">Issue & Assignment</span>
            </div>
        </div>
        
        <!-- Wizard Panels -->
        <div class="modal-wizard-content">
            <!-- Step 1: Customer -->
            <div class="modal-wizard-panel active" data-panel="1">
                <div class="wizard-panel-card">
                    <div class="wizard-panel-header">
                        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                        </svg>
                        <div>
                            <h3>Select Customer</h3>
                            <p>Choose the customer for this job order</p>
                        </div>
                    </div>
                    <div class="wizard-panel-body">
                        <div class="form-group">
                            <label asp-for="CustomerId" class="form-label">Customer <span class="text-danger">*</span></label>
                            <select asp-for="CustomerId" class="form-select">
                                <option value="">Select a customer...</option>
                                @foreach (var customer in Model.AvailableCustomers)
                                {
                                    <option value="@customer.Id">@customer.FullName (@customer.Phone)</option>
                                }
                            </select>
                            <span asp-validation-for="CustomerId" class="text-danger text-sm"></span>
                        </div>
                        <p class="text-sm text-muted" style="margin-top: 8px;">
                            <a href="#" onclick="alert('Add customer modal would open here'); return false;" class="text-primary">+ Add new customer</a>
                        </p>
                    </div>
                </div>
            </div>
            
            <!-- Step 2: Device -->
            <div class="modal-wizard-panel" data-panel="2">
                <div class="wizard-panel-card">
                    <div class="wizard-panel-header">
                        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                        </svg>
                        <div>
                            <h3>Device Information</h3>
                            <p>Enter device details and accessories</p>
                        </div>
                    </div>
                    <div class="wizard-panel-body">
                        <div class="form-row">
                            <div class="form-group">
                                <label asp-for="DeviceType" class="form-label">Device Type <span class="text-danger">*</span></label>
                                <input asp-for="DeviceType" class="form-input" placeholder="e.g., MacBook Pro 2021, iPhone 14" />
                                <span asp-validation-for="DeviceType" class="text-danger text-sm"></span>
                            </div>
                            <div class="form-group">
                                <label asp-for="DeviceSerial" class="form-label">Serial Number</label>
                                <input asp-for="DeviceSerial" class="form-input" placeholder="Device serial number" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label asp-for="DeviceAccessories" class="form-label">Accessories</label>
                            <input asp-for="DeviceAccessories" class="form-input" placeholder="e.g., Charger, Mouse, Laptop bag" />
                            <span class="text-sm text-muted">List any accessories the customer is leaving with the device</span>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Step 3: Issue & Assignment -->
            <div class="modal-wizard-panel" data-panel="3">
                <div class="wizard-panel-card">
                    <div class="wizard-panel-header">
                        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                        <div>
                            <h3>Issue Details</h3>
                            <p>Describe the problem and assign technician</p>
                        </div>
                    </div>
                    <div class="wizard-panel-body">
                        <div class="form-group">
                            <label asp-for="ProblemDescription" class="form-label">Problem Description <span class="text-danger">*</span></label>
                            <textarea asp-for="ProblemDescription" class="form-input" rows="4" placeholder="Describe the issue or problem reported by the customer..."></textarea>
                            <span asp-validation-for="ProblemDescription" class="text-danger text-sm"></span>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label asp-for="Priority" class="form-label">Priority</label>
                                <select asp-for="Priority" class="form-select">
                                    <option value="Low">Low</option>
                                    <option value="Normal" selected>Normal</option>
                                    <option value="High">High</option>
                                    <option value="Urgent">Urgent</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label asp-for="AssignedTechnicianId" class="form-label">Assign Technician</label>
                                <select asp-for="AssignedTechnicianId" class="form-select">
                                    <option value="">Unassigned</option>
                                    @foreach (var tech in Model.AvailableTechnicians)
                                    {
                                        <option value="@tech.Id">@tech.FullName (@tech.ActiveJobOrders active jobs)</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="form-group">
                            <label asp-for="EstimatedCompletionDate" class="form-label">Estimated Completion</label>
                            <input asp-for="EstimatedCompletionDate" type="date" class="form-input" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Modal Footer with Wizard Navigation -->
    <div class="modal-form-footer wizard-footer">
        <button type="button" class="btn btn-ghost wizard-prev-btn" style="display: none;">
            <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            Previous
        </button>
        <span class="wizard-step-indicator">Step <strong id="currentStepNum">1</strong> of 3</span>
        <div class="wizard-action-buttons">
            <button type="button" class="btn btn-ghost" onclick="closeAjaxModal()">Cancel</button>
            <button type="button" class="btn btn-primary wizard-next-btn">
                Next
                <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
            </button>
            <button type="submit" class="btn btn-primary wizard-submit-btn" style="display: none;">
                <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                Create Job Order
            </button>
        </div>
    </div>
</form>

<script>
(function() {
    var wizard = document.querySelector('.modal-wizard');
    if (!wizard) return;
    
    var steps = wizard.querySelectorAll('.modal-wizard-step');
    var panels = wizard.querySelectorAll('.modal-wizard-panel');
    var connectors = wizard.querySelectorAll('.modal-wizard-connector');
    var prevBtn = document.querySelector('.wizard-prev-btn');
    var nextBtn = document.querySelector('.wizard-next-btn');
    var submitBtn = document.querySelector('.wizard-submit-btn');
    var stepNumDisplay = document.getElementById('currentStepNum');
    var currentStep = 1;
    var totalSteps = 3;

    function updateWizard() {
        steps.forEach(function(step, index) {
            step.classList.remove('active', 'completed');
            if (index + 1 < currentStep) step.classList.add('completed');
            if (index + 1 === currentStep) step.classList.add('active');
        });
        
        connectors.forEach(function(conn, index) {
            conn.classList.toggle('completed', index + 1 < currentStep);
        });
        
        panels.forEach(function(panel) {
            panel.classList.toggle('active', parseInt(panel.dataset.panel) === currentStep);
        });
        
        prevBtn.style.display = currentStep > 1 ? 'inline-flex' : 'none';
        nextBtn.style.display = currentStep < totalSteps ? 'inline-flex' : 'none';
        submitBtn.style.display = currentStep === totalSteps ? 'inline-flex' : 'none';
        
        if (stepNumDisplay) stepNumDisplay.textContent = currentStep;
        
        var modalBody = document.querySelector('.ajax-modal-content');
        if (modalBody) modalBody.scrollTop = 0;
    }

    prevBtn.addEventListener('click', function() {
        if (currentStep > 1) { currentStep--; updateWizard(); }
    });
    nextBtn.addEventListener('click', function() {
        if (currentStep < totalSteps) { currentStep++; updateWizard(); }
    });

    updateWizard();
})();
</script>
