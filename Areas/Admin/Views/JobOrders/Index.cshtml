@model JobOrderListViewModel
@{
    ViewData["Title"] = "Job Orders";
}

<partial name="~/Views/Shared/_Breadcrumbs.cshtml" model="@(new BreadcrumbViewModel { Items = new List<BreadcrumbViewModel.BreadcrumbItem> { new() { Label = "Dashboard", Url = Url.Action("Index", "Dashboard") }, new() { Label = "Job Orders", IsActive = true } } })" />

<div class="page-header">
    <div>
        <h1 class="page-title">Job Orders</h1>
        <p class="page-subtitle">@Model.TotalCount total orders</p>
    </div>
    <div class="page-actions">
        <button type="button" class="btn btn-primary" onclick="openAjaxModal('@Url.Action("CreateModal")', 'New Job Order')">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            New Job Order
        </button>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" style="margin-bottom: 20px; padding: 12px 16px; background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 8px; color: #065f46; font-size: 14px;">
        @TempData["Success"]
    </div>
}

<div class="card">
    <div class="card-header">
        <form method="get" class="filter-form">
            <div class="search-input-wrapper">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="search-icon"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                <input type="text" name="search" value="@Model.SearchTerm" placeholder="Search by order number, customer..." class="form-input search-input" />
            </div>
            <select name="status" class="form-select" onchange="this.form.submit()">
                <option value="">All Statuses</option>
                @foreach (JobOrderStatus status in Enum.GetValues(typeof(JobOrderStatus)))
                {
                    <option value="@status" selected="@(Model.StatusFilter == status)">@status</option>
                }
            </select>
            <button type="submit" class="btn btn-outline-primary">Filter</button>
        </form>
    </div>
    <div class="card-body p-0">
        @if (Model.JobOrders.Any())
        {
            <div class="table-container">
                <table class="table" style="table-layout: fixed;">
                    <colgroup>
                        <col style="width: 13%;" />
                        <col style="width: 18%;" />
                        <col style="width: 17%;" />
                        <col style="width: 13%;" />
                        <col style="width: 14%;" />
                        <col style="width: 13%;" />
                        <col style="width: 12%;" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>Order #</th>
                            <th>Customer</th>
                            <th>Device</th>
                            <th class="text-center">Status</th>
                            <th>Technician</th>
                            <th>Created</th>
                            <th class="text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.JobOrders)
                        {
                            <tr class="clickable-row" onclick="openAjaxModal('@Url.Action("DetailsModal", "JobOrders", new { area = "Admin", id = order.Id })', '@order.JobNumber')">
                                <td>
                                    <span class="order-link">@order.JobNumber</span>
                                </td>
                                <td>
                                    <div class="customer-cell">
                                        <div class="avatar-xs">@order.CustomerInitials</div>
                                        <span class="customer-text">@order.CustomerName</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="device-cell">
                                        <span class="device-text">@order.DeviceType</span>
                                        @if (!string.IsNullOrEmpty(order.DeviceBrand))
                                        {
                                            <span class="device-sub">@order.DeviceBrand @order.DeviceModel</span>
                                        }
                                    </div>
                                </td>
                                <td class="text-center"><span class="badge @order.StatusClass">@order.StatusDisplay</span></td>
                                <td>
                                    @if (!string.IsNullOrEmpty(order.TechnicianName))
                                    {
                                        <span class="tech-name">@order.TechnicianName</span>
                                    }
                                    else
                                    {
                                        <span class="unassigned">Unassigned</span>
                                    }
                                </td>
                                <td><span class="date-text">@order.CreatedAt.ToString("MMM d, yyyy")</span></td>
                                <td>
                                    <div class="action-buttons">
                                        <button type="button" class="btn-action" title="Edit" onclick="event.stopPropagation(); openAjaxModal('@Url.Action("EditModal", "JobOrders", new { area = "Admin", id = order.Id })', 'Edit Job Order')">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <partial name="~/Views/Shared/_EmptyState.cshtml" model="@(new { Icon = "clipboard", Title = "No job orders found", Description = "Create your first job order to get started" })" />
        }
    </div>
</div>

<style>
    .page-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px; }
    .page-title { font-size: 24px; font-weight: 700; color: #1f2937; margin-bottom: 4px; }
    .page-subtitle { font-size: 14px; color: #6b7280; }
    .filter-form { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
    .search-input-wrapper { position: relative; flex: 1; min-width: 200px; }
    .search-icon { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #9ca3af; }
    .search-input { padding-left: 40px; min-width: 240px; }
    .customer-cell { display: flex; align-items: center; gap: 8px; }
    .avatar-xs { width: 28px; height: 28px; border-radius: 50%; background: rgba(59,130,246,0.1); color: #3b82f6; display: flex; align-items: center; justify-content: center; font-weight: 600; font-size: 11px; flex-shrink: 0; }
    .customer-text { font-size: 13px; font-weight: 500; color: #374151; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .order-link { font-weight: 600; color: #3b82f6; text-decoration: none; font-size: 13px; }
    .order-link:hover { text-decoration: underline; }
    .device-cell { display: flex; flex-direction: column; gap: 1px; }
    .device-text { font-size: 13px; color: #374151; }
    .device-sub { font-size: 12px; color: #9ca3af; }
    .tech-name { font-size: 13px; color: #374151; }
    .unassigned { font-size: 13px; color: #d1d5db; font-style: italic; }
    .date-text { font-size: 13px; color: #6b7280; }
    .action-buttons { display: flex; gap: 4px; justify-content: flex-end; }
    .btn-action { width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; border-radius: 6px; color: #6b7280; transition: all 0.15s; border: none; background: none; cursor: pointer; text-decoration: none; }
    .btn-action:hover { background: #f3f4f6; color: #3b82f6; }
    .clickable-row { cursor: pointer; transition: background-color 0.15s ease; }
    .clickable-row:hover { background-color: #f0f7ff; }
    .order-link { font-weight: 600; color: #3b82f6; font-size: 13px; }
    @@media (max-width: 768px) {
        .page-header { flex-direction: column; gap: 12px; }
        .filter-form { flex-direction: column; width: 100%; }
        .search-input { min-width: 100%; }
        .table { table-layout: auto !important; }
    }
</style>