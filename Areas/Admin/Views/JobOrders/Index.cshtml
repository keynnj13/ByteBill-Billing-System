@model JobOrderListViewModel
@{
    ViewData["Title"] = "Job Orders";
}

<partial name="~/Views/Shared/_Breadcrumbs.cshtml" model="@(new BreadcrumbViewModel { Items = new List<BreadcrumbViewModel.BreadcrumbItem> { new() { Label = "Dashboard", Url = Url.Action("Index", "Dashboard") }, new() { Label = "Job Orders", IsActive = true } } })" />

<div class="page-header">
    <div>
        <h1 class="page-title">Job Orders</h1>
        <p class="page-subtitle">@Model.TotalCount total job orders</p>
    </div>
    <div class="page-actions">
        <button type="button" class="btn btn-primary" onclick="openAjaxModal('@Url.Action("CreateModal", "JobOrders", new { area = "Admin" })', 'New Job Order')">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            New Job Order
        </button>
    </div>
</div>

<!-- Stat Cards -->
<div class="stat-cards">
    <div class="stat-card">
        <div class="stat-icon bg-primary-light">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
        </div>
        <div class="stat-content">
            <span class="stat-value">@Model.TotalCount</span>
            <span class="stat-label">Total Job Orders</span>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon bg-warning-light">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>
        </div>
        <div class="stat-content">
            <span class="stat-value">@Model.InProgressCount</span>
            <span class="stat-label">In Progress</span>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon bg-success-light">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
        </div>
        <div class="stat-content">
            <span class="stat-value">@Model.CompletedCount</span>
            <span class="stat-label">Completed</span>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon bg-orange-light">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#f97316" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
        </div>
        <div class="stat-content">
            <span class="stat-value">@Model.PendingInvoicingCount</span>
            <span class="stat-label">Pending Invoicing</span>
        </div>
    </div>
</div>



<div class="card">
    <div class="card-header">
        <form method="get" class="filter-form">
            <div class="search-input-wrapper">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="search-icon"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                <input type="text" name="search" value="@Model.SearchTerm" placeholder="Search by order number, customer..." class="form-input search-input" id="joSearch" />
            </div>
            <select name="status" class="form-select" id="joStatus">
                <option value="">All Statuses</option>
                @foreach (JobOrderStatus status in Enum.GetValues(typeof(JobOrderStatus)))
                {
                    <option value="@status" selected="@(Model.StatusFilter == status)">@status</option>
                }
            </select>
            <noscript><button type="submit" class="btn btn-outline-primary">Filter</button></noscript>
        </form>
    </div>
    <div class="card-body p-0">
        @if (Model.JobOrders.Any())
        {
            <div class="table-container">
                <table class="table" style="table-layout: fixed;">
                    <colgroup>
                        <col style="width: 13%;" />
                        <col style="width: 18%;" />
                        <col style="width: 17%;" />
                        <col style="width: 13%;" />
                        <col style="width: 14%;" />
                        <col style="width: 13%;" />
                        <col style="width: 12%;" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>Order #</th>
                            <th>Customer</th>
                            <th>Device</th>
                            <th class="text-center">Status</th>
                            <th>Technician</th>
                            <th>Created</th>
                            <th class="text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.JobOrders)
                        {
                            <tr class="clickable-row" data-jobnumber="@order.JobNumber.ToLower()" data-customer="@order.CustomerName.ToLower()" data-device="@((order.DeviceType ?? "").ToLower()) @((order.DeviceBrand ?? "").ToLower()) @((order.DeviceModel ?? "").ToLower())" data-status="@order.StatusDisplay" data-technician="@((order.TechnicianName ?? "").ToLower())" onclick="openAjaxModal('@Url.Action("DetailsModal", "JobOrders", new { area = "Admin", id = order.Id })', '@order.JobNumber')">
                                <td>
                                    <span class="order-link">@order.JobNumber</span>
                                </td>
                                <td>
                                    <div class="customer-cell">
                                        <div class="avatar-xs">@order.CustomerInitials</div>
                                        <span class="customer-text">@order.CustomerName</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="device-cell">
                                        <span class="device-text">@order.DeviceType</span>
                                        @if (!string.IsNullOrEmpty(order.DeviceBrand))
                                        {
                                            <span class="device-sub">@order.DeviceBrand @order.DeviceModel</span>
                                        }
                                    </div>
                                </td>
                                <td class="text-center"><span class="status-indicator @order.StatusClass">@order.StatusDisplay</span></td>
                                <td>
                                    @if (!string.IsNullOrEmpty(order.TechnicianName))
                                    {
                                        <span class="tech-name">@order.TechnicianName</span>
                                    }
                                    else
                                    {
                                        <span class="unassigned">Unassigned</span>
                                    }
                                </td>
                                <td><span class="date-text">@order.CreatedAt.ToString("MMM d, yyyy")</span></td>
                                <td>
                                    <div class="action-buttons">
                                        <button type="button" class="btn-action" title="Edit" onclick="event.stopPropagation(); openAjaxModal('@Url.Action("EditModal", "JobOrders", new { area = "Admin", id = order.Id })', 'Edit Job Order')">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                        </button>
                                        <form asp-action="ArchiveJobOrder" asp-controller="JobOrders" asp-area="Admin" method="post" style="display: inline;" onclick="event.stopPropagation();">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@order.Id" />
                                            <button type="submit" class="btn-action" title="Archive" onclick="return confirm('Archive this job order?');" style="color:#f59e0b;">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="21 8 21 21 3 21 3 8"></polyline><rect x="1" y="3" width="22" height="5"></rect><line x1="10" y1="12" x2="14" y2="12"></line></svg>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Model.TotalPages > 1)
            {
                <partial name="~/Views/Shared/_Pagination.cshtml" model="@(new PaginationViewModel { CurrentPage = Model.CurrentPage, TotalPages = Model.TotalPages, TotalItems = Model.TotalCount, PageSize = Model.PageSize, BaseUrl = Url.Action("Index") })" />
            }        }
        else
        {
            <partial name="~/Views/Shared/_EmptyState.cshtml" model="@(new { Icon = "clipboard", Title = "No job orders found", Description = "Create your first job order to get started" })" />
        }
    </div>
</div>

<style>
    .page-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px; }
    .page-title { font-size: 24px; font-weight: 700; color: #1f2937; margin-bottom: 4px; }
    .page-subtitle { font-size: 14px; color: #6b7280; }
    .stat-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px; }
    .stat-card { background: white; border: 1px solid #e5e7eb; border-radius: 12px; padding: 20px; position: relative; }
    .stat-icon { width: 44px; height: 44px; border-radius: 10px; display: flex; align-items: center; justify-content: center; position: absolute; top: 20px; right: 20px; }
    .bg-primary-light { background: #eff6ff; }
    .bg-warning-light { background: #fffbeb; }
    .bg-success-light { background: #ecfdf5; }
    .bg-orange-light { background: #fff7ed; }
    .stat-content { display: flex; flex-direction: column; }
    .stat-value { font-size: 22px; font-weight: 700; color: #1f2937; }
    .stat-label { font-size: 13px; color: #6b7280; }
    .filter-form { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
    .search-input-wrapper { position: relative; flex: 1; min-width: 200px; }
    .search-icon { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #9ca3af; }
    .search-input { padding-left: 40px; min-width: 240px; }
    .customer-cell { display: flex; align-items: center; gap: 8px; }
    .avatar-xs { width: 28px; height: 28px; border-radius: 50%; background: linear-gradient(135deg, #667eea, #764ba2); color: white; display: flex; align-items: center; justify-content: center; font-weight: 600; font-size: 11px; flex-shrink: 0; }
    .customer-text { font-size: 13px; font-weight: 500; color: #374151; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .order-link { font-weight: 600; color: #3b82f6; text-decoration: none; font-size: 13px; }
    .order-link:hover { text-decoration: underline; }
    .device-cell { display: flex; flex-direction: column; gap: 1px; }
    .device-text { font-size: 13px; color: #374151; }
    .device-sub { font-size: 12px; color: #9ca3af; }
    .tech-name { font-size: 13px; color: #374151; }
    .unassigned { font-size: 13px; color: #d1d5db; font-style: italic; }
    .date-text { font-size: 13px; color: #6b7280; }

    .clickable-row { cursor: pointer; transition: background-color 0.15s ease; }
    .clickable-row:hover { background-color: #f0f7ff; }
    .order-link { font-weight: 600; color: #3b82f6; font-size: 13px; }
    @@media (max-width: 768px) {
        .page-header { flex-direction: column; gap: 12px; }
        .filter-form { flex-direction: column; width: 100%; }
        .search-input { min-width: 100%; }
        .table { table-layout: auto !important; }
    }
</style>

<script>
(function() {
    var searchInput = document.getElementById('joSearch');
    var statusSelect = document.getElementById('joStatus');
    var rows = document.querySelectorAll('tr.clickable-row[data-jobnumber]');
    var tableContainer = rows.length > 0 ? rows[0].closest('.table-container') : null;
    var emptyState = null;

    function filterRows() {
        var q = (searchInput ? searchInput.value : '').toLowerCase().trim();
        var st = statusSelect ? statusSelect.value : '';
        var visibleCount = 0;
        rows.forEach(function(row) {
            var matchSearch = !q
                || row.dataset.jobnumber.indexOf(q) !== -1
                || row.dataset.customer.indexOf(q) !== -1
                || row.dataset.device.indexOf(q) !== -1
                || row.dataset.technician.indexOf(q) !== -1;
            var matchStatus = !st || row.dataset.status === st;
            var visible = matchSearch && matchStatus;
            row.style.display = visible ? '' : 'none';
            if (visible) visibleCount++;
        });
        if (!emptyState) {
            emptyState = document.createElement('div');
            emptyState.style.cssText = 'padding:40px 20px; text-align:center; color:#9ca3af; font-size:14px; display:none;';
            emptyState.innerHTML = '<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#d1d5db" stroke-width="1.5" style="margin:0 auto 12px;display:block;"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>No job orders match your filters';
            if (tableContainer) tableContainer.parentNode.insertBefore(emptyState, tableContainer.nextSibling);
        }
        if (emptyState) emptyState.style.display = visibleCount === 0 && rows.length > 0 ? 'block' : 'none';
        if (tableContainer) tableContainer.style.display = visibleCount === 0 && rows.length > 0 ? 'none' : '';
    }

    if (searchInput) searchInput.addEventListener('input', filterRows);
    if (statusSelect) statusSelect.addEventListener('change', filterRows);
    filterRows();
})();
</script>