@model JobOrderDetailViewModel

<div class="modal-detail-body">
    <!-- Header with Status -->
    <div class="modal-detail-header">
        <div>
            <h3 class="modal-detail-name">@Model.OrderNumber</h3>
            <p class="modal-detail-sub">Created @Model.CreatedAt.ToString("MMMM d, yyyy 'at' h:mm tt")</p>
        </div>
        <div class="modal-detail-actions">
            @{
                var statusClass = Model.Status switch
                {
                    JobOrderStatus.CheckedIn => "info",
                    JobOrderStatus.Diagnosis => "warning",
                    JobOrderStatus.WaitingForParts => "secondary",
                    JobOrderStatus.InProgress => "primary",
                    JobOrderStatus.Completed => "success",
                    JobOrderStatus.ReadyForPickup => "info",
                    JobOrderStatus.Delivered => "success",
                    _ => "secondary"
                };
            }
            <span class="badge badge-lg badge-@statusClass">@Model.Status</span>
        </div>
    </div>

    <!-- Two-Column Layout -->
    <div class="modal-detail-grid">
        <div class="modal-detail-main">
            <!-- Device Information -->
            <div class="modal-detail-section">
                <h4 class="modal-section-title">Device Information</h4>
                <dl class="modal-detail-grid-2col">
                    <div class="modal-detail-item">
                        <dt>Device</dt>
                        <dd>@Model.DeviceType</dd>
                    </div>
                    <div class="modal-detail-item">
                        <dt>Serial Number</dt>
                        <dd>@(Model.DeviceSerial ?? "Not provided")</dd>
                    </div>
                    <div class="modal-detail-item">
                        <dt>Accessories</dt>
                        <dd>@(Model.DeviceAccessories ?? "None")</dd>
                    </div>
                    <div class="modal-detail-item">
                        <dt>Priority</dt>
                        <dd><span class="badge badge-@(Model.Priority == "High" || Model.Priority == "Urgent" ? "danger" : "secondary")">@Model.Priority</span></dd>
                    </div>
                </dl>
            </div>

            <!-- Issue Description -->
            <div class="modal-detail-section">
                <h4 class="modal-section-title">Issue Description</h4>
                <p class="modal-detail-text">@Model.IssueDescription</p>
            </div>

            @if (!string.IsNullOrEmpty(Model.TechnicianNotes))
            {
                <div class="modal-detail-section">
                    <h4 class="modal-section-title">Technician Notes</h4>
                    <p class="modal-detail-text">@Model.TechnicianNotes</p>
                </div>
            }

            <!-- Line Items -->
            @if (Model.LineItems.Any())
            {
                <div class="modal-detail-section">
                    <h4 class="modal-section-title">Services & Parts</h4>
                    <div class="table-container">
                        <table class="table table-compact">
                            <thead>
                                <tr>
                                    <th>Description</th>
                                    <th>Type</th>
                                    <th class="text-right">Qty</th>
                                    <th class="text-right">Price</th>
                                    <th class="text-right">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.LineItems)
                                {
                                    <tr>
                                        <td>@item.Description</td>
                                        <td><span class="badge badge-@(item.Type == "Service" ? "primary" : "secondary")">@item.Type</span></td>
                                        <td class="text-right">@item.Quantity</td>
                                        <td class="text-right">@item.UnitPrice.ToString("C")</td>
                                        <td class="text-right">@item.Total.ToString("C")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="4" class="text-right"><strong>Subtotal</strong></td>
                                    <td class="text-right">@Model.Subtotal.ToString("C")</td>
                                </tr>
                                <tr>
                                    <td colspan="4" class="text-right">Tax (@Model.TaxRate%)</td>
                                    <td class="text-right">@Model.TaxAmount.ToString("C")</td>
                                </tr>
                                <tr>
                                    <td colspan="4" class="text-right"><strong>Total</strong></td>
                                    <td class="text-right"><strong>@Model.Total.ToString("C")</strong></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            }
        </div>

        <div class="modal-detail-sidebar">
            <!-- Customer -->
            <div class="modal-sidebar-card">
                <h5 class="modal-sidebar-title">Customer</h5>
                <p class="font-medium">@Model.CustomerName</p>
                <p class="text-sm text-muted">@Model.CustomerEmail</p>
                <p class="text-sm text-muted">@Model.CustomerPhone</p>
            </div>

            <!-- Assignment -->
            <div class="modal-sidebar-card">
                <h5 class="modal-sidebar-title">Assignment</h5>
                <p class="font-medium">@(Model.AssignedTechnicianName ?? "Unassigned")</p>
                @if (Model.EstimatedCompletionDate.HasValue)
                {
                    <p class="text-sm text-muted">Est. completion: @Model.EstimatedCompletionDate.Value.ToString("MMM d, yyyy")</p>
                }
            </div>

            <!-- Timeline -->
            <div class="modal-sidebar-card">
                <h5 class="modal-sidebar-title">Timeline</h5>
                <div class="mini-timeline">
                    @foreach (var item in Model.Timeline)
                    {
                        <div class="mini-timeline-item">
                            <div class="mini-timeline-marker"></div>
                            <div class="mini-timeline-content">
                                <p class="mini-timeline-title">@item.Title</p>
                                <p class="mini-timeline-meta">@item.Timestamp.ToString("MMM d, h:mm tt")</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal-form-footer">
    <button type="button" class="btn btn-ghost" onclick="closeAjaxModal()">Close</button>
    @if (Model.Status == JobOrderStatus.Completed && !Model.HasInvoice)
    {
        <a asp-action="Create" asp-controller="Invoices" asp-area="Admin" asp-route-jobOrderId="@Model.Id" class="btn btn-primary">Create Invoice</a>
    }
</div>
