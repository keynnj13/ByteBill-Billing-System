@model InventoryFormViewModel
@{
    ViewData["Title"] = "Edit Inventory Item";
}

<partial name="~/Views/Shared/_Breadcrumbs.cshtml" model="@(new BreadcrumbViewModel { Items = new List<BreadcrumbViewModel.BreadcrumbItem> { new() { Label = "Dashboard", Url = Url.Action("Index", "Dashboard") }, new() { Label = "Inventory", Url = Url.Action("Index") }, new() { Label = "Edit Item", IsActive = true } } })" />

<div class="page-header">
    <div>
        <h1 class="page-title">Edit Inventory Item</h1>
        <p class="page-subtitle">@Model.SKU &middot; @Model.Name</p>
    </div>
</div>

<div class="form-layout">
    <form asp-action="Edit" method="post">
        <partial name="~/Views/Shared/_ValidationSummary.cshtml" />
        <input type="hidden" asp-for="Id" />

        <!-- Basic Info -->
        <div class="card form-card">
            <div class="card-header">
                <h3 class="card-title">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg>
                    Item Details
                </h3>
            </div>
            <div class="card-body">
                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="SKU" class="form-label">SKU <span class="required">*</span></label>
                        <input asp-for="SKU" class="form-input" placeholder="e.g., SSD-500-SAM" />
                        <span asp-validation-for="SKU" class="field-error"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Name" class="form-label">Item Name <span class="required">*</span></label>
                        <input asp-for="Name" class="form-input" placeholder="e.g., Samsung 870 EVO 500GB SSD" />
                        <span asp-validation-for="Name" class="field-error"></span>
                    </div>
                </div>
                <div class="form-group">
                    <label asp-for="Description" class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-input" rows="2" placeholder="Brief description of the item..."></textarea>
                    <span asp-validation-for="Description" class="field-error"></span>
                </div>
                <div class="form-row form-row-3">
                    <div class="form-group">
                        <label asp-for="Category" class="form-label">Category</label>
                        <select asp-for="Category" class="form-select">
                            <option value="">Select category</option>
                            @foreach (var cat in Model.ExistingCategories)
                            {
                                <option value="@cat">@cat</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label asp-for="Brand" class="form-label">Brand</label>
                        <select asp-for="Brand" class="form-select">
                            <option value="">Select brand</option>
                            @foreach (var brand in Model.ExistingBrands)
                            {
                                <option value="@brand">@brand</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label asp-for="Unit" class="form-label">Unit <span class="required">*</span></label>
                        <select asp-for="Unit" class="form-select">
                            <option value="pcs">Pieces</option>
                            <option value="m">Meters</option>
                            <option value="kg">Kilograms</option>
                            <option value="set">Sets</option>
                            <option value="box">Boxes</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pricing -->
        <div class="card form-card">
            <div class="card-header">
                <h3 class="card-title">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                    Pricing & Stock
                </h3>
            </div>
            <div class="card-body">
                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="CostPrice" class="form-label">Cost Price</label>
                        <div class="input-prefix-wrap">
                            <span class="input-prefix">&#8369;</span>
                            <input asp-for="CostPrice" type="number" step="0.01" class="form-input input-with-prefix" placeholder="0.00" />
                        </div>
                        <span asp-validation-for="CostPrice" class="field-error"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="SellingPrice" class="form-label">Selling Price <span class="required">*</span></label>
                        <div class="input-prefix-wrap">
                            <span class="input-prefix">&#8369;</span>
                            <input asp-for="SellingPrice" type="number" step="0.01" class="form-input input-with-prefix" placeholder="0.00" />
                        </div>
                        <span asp-validation-for="SellingPrice" class="field-error"></span>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="QuantityInStock" class="form-label">Quantity in Stock <span class="required">*</span></label>
                        <input asp-for="QuantityInStock" type="number" class="form-input" placeholder="0" />
                        <span asp-validation-for="QuantityInStock" class="field-error"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="ReorderLevel" class="form-label">Reorder Level</label>
                        <input asp-for="ReorderLevel" type="number" class="form-input" placeholder="5" />
                        <span class="field-hint">Alert when stock falls below this level</span>
                    </div>
                </div>
                <div class="form-group">
                    <label class="checkbox-label">
                        <input asp-for="IsActive" type="checkbox" />
                        <span>Active — item is available for use in job orders</span>
                    </label>
                </div>
            </div>
        </div>

        <div class="form-actions">
            <a asp-action="Index" class="btn btn-ghost">Cancel</a>
            <button type="submit" class="btn btn-primary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
                Update Item
            </button>
        </div>
    </form>
</div>

<style>
    .page-header { margin-bottom: 24px; }
    .page-title { font-size: 24px; font-weight: 700; color: #1f2937; margin-bottom: 4px; }
    .page-subtitle { font-size: 14px; color: #6b7280; }
    .form-layout { max-width: 740px; }
    .form-card { margin-bottom: 20px; }
    .form-card .card-title { display: flex; align-items: center; gap: 8px; font-size: 15px; }
    .form-card .card-title svg { color: #6b7280; }
    .form-row { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
    .form-row-3 { grid-template-columns: repeat(3, 1fr); }
    .form-group { margin-bottom: 16px; }
    .form-label { font-size: 13px; font-weight: 500; color: #374151; margin-bottom: 6px; display: block; }
    .required { color: #ef4444; }
    .field-error { font-size: 12px; color: #ef4444; margin-top: 4px; display: block; }
    .field-hint { font-size: 12px; color: #9ca3af; margin-top: 4px; display: block; }
    .input-prefix-wrap { position: relative; }
    .input-prefix { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #9ca3af; font-size: 14px; font-weight: 500; pointer-events: none; }
    .input-with-prefix { padding-left: 32px; }
    .checkbox-label { display: flex; align-items: center; gap: 8px; font-size: 14px; color: #374151; cursor: pointer; }
    .checkbox-label input { accent-color: #3b82f6; width: 16px; height: 16px; }
    .form-actions { display: flex; justify-content: flex-end; gap: 12px; padding-top: 8px; }
    @@media (max-width: 640px) { .form-row, .form-row-3 { grid-template-columns: 1fr; } }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
