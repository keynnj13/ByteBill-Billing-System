@model InventoryDetailViewModel

<div class="modal-detail-body">
    <!-- Item Header -->
    <div class="modal-detail-header">
        <div class="detail-icon-lg detail-icon-indigo">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg>
        </div>
        <div>
            <h3 class="modal-detail-name">@Model.Name</h3>
            <p class="modal-detail-sub">
                <span style="font-family: monospace; font-size: 12px; color: #6b7280;">@Model.SKU</span>
                <span class="badge @(Model.IsActive ? "badge-success" : "badge-muted")" style="margin-left: 8px;">@(Model.IsActive ? "Active" : "Inactive")</span>
            </p>
        </div>
    </div>

    <!-- Stock Stats -->
    <div class="modal-stats-row">
        <div class="modal-stat">
            <span class="modal-stat-label">In Stock</span>
            <span class="modal-stat-value @(Model.IsLowStock ? "text-warning" : "")">@Model.QtyOnHand @Model.Unit</span>
        </div>
        <div class="modal-stat">
            <span class="modal-stat-label">Stock Value</span>
            <span class="modal-stat-value">@Model.TotalValue.ToString("C")</span>
        </div>
        <div class="modal-stat">
            <span class="modal-stat-label">Retail Value</span>
            <span class="modal-stat-value">@Model.TotalRetailValue.ToString("C")</span>
        </div>
    </div>

    @if (Model.IsLowStock)
    {
        <div class="low-stock-alert">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            <span>Low stock — below reorder level of @Model.ReorderLevel</span>
        </div>
    }

    <!-- Item Details -->
    <div class="modal-detail-section">
        <h4 class="modal-section-title">Item Details</h4>
        <dl class="modal-detail-list">
            <div class="modal-detail-item">
                <dt>SKU</dt>
                <dd style="font-family: monospace;">@Model.SKU</dd>
            </div>
            <div class="modal-detail-item">
                <dt>Category</dt>
                <dd>@Model.Category</dd>
            </div>
            @if (!string.IsNullOrEmpty(Model.Brand))
            {
                <div class="modal-detail-item">
                    <dt>Brand</dt>
                    <dd>@Model.Brand</dd>
                </div>
            }
            <div class="modal-detail-item">
                <dt>Unit</dt>
                <dd>@Model.Unit</dd>
            </div>
        </dl>
    </div>

    <!-- Pricing -->
    <div class="modal-detail-section">
        <h4 class="modal-section-title">Pricing</h4>
        <dl class="modal-detail-list">
            <div class="modal-detail-item">
                <dt>Cost Price</dt>
                <dd>@Model.UnitCost.ToString("C")</dd>
            </div>
            <div class="modal-detail-item">
                <dt>Selling Price</dt>
                <dd class="font-medium">@Model.UnitPrice.ToString("C")</dd>
            </div>
            <div class="modal-detail-item">
                <dt>Margin</dt>
                <dd>@((Model.UnitCost > 0 ? ((Model.UnitPrice - Model.UnitCost) / Model.UnitCost * 100).ToString("F1") : "—"))%</dd>
            </div>
        </dl>
    </div>

    <!-- Recent Transactions -->
    <div class="modal-detail-section">
        <h4 class="modal-section-title">Recent Transactions</h4>
        @if (Model.RecentTransactions.Any())
        {
            <div class="table-container">
                <table class="table table-compact">
                    <thead>
                        <tr>
                            <th>Type</th>
                            <th class="text-center">Qty</th>
                            <th>Reference</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var txn in Model.RecentTransactions)
                        {
                            <tr>
                                <td>
                                    <span class="badge @(txn.TxnType == "In" ? "badge-success" : "badge-warning")">@txn.TxnType</span>
                                </td>
                                <td class="text-center font-medium">@txn.Quantity</td>
                                <td class="text-sm">@(txn.Remarks ?? "—")</td>
                                <td class="text-sm">@txn.CreatedAt.ToString("MMM d, yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-box-sm">
                <p class="text-muted">No transactions yet</p>
            </div>
        }
    </div>
</div>

<div class="modal-form-footer">
    <button type="button" class="btn btn-ghost" onclick="closeAjaxModal()">Close</button>
    <button type="button" class="btn btn-primary" onclick="closeAjaxModal(); openAjaxModal('@Url.Action("EditModal", "Inventory", new { area = "Admin", id = Model.Id })', 'Edit Item')">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
        Edit
    </button>
</div>

<style>
    .detail-icon-lg { width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .detail-icon-indigo { background: rgba(99,102,241,0.1); color: #6366f1; }
    .text-warning { color: #f59e0b; }
    .font-medium { font-weight: 500; }
    .text-sm { font-size: 13px; color: #6b7280; }
    .low-stock-alert { display: flex; align-items: center; gap: 8px; padding: 10px 14px; background: #fef3c7; border: 1px solid #fde68a; border-radius: 8px; color: #92400e; font-size: 13px; font-weight: 500; margin-bottom: 16px; }
    .empty-box-sm { padding: 20px; text-align: center; background: #f9fafb; border-radius: 8px; }
    .text-muted { color: #9ca3af; }
    .badge-success { background: #d1fae5; color: #065f46; }
    .badge-warning { background: #fef3c7; color: #92400e; }
    .badge-muted { background: #f3f4f6; color: #6b7280; }
</style>
