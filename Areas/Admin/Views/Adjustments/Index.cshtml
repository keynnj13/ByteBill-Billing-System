@using ByteBill_BS.Services
@{
    ViewData["Title"] = "Adjustments";
    var metrics = (AdjustmentMetricsDto)ViewBag.Metrics;
    var pendingRequests = (List<AdjustmentListItemDto>)ViewBag.PendingRequests;
    var historyItems = (List<AdjustmentListItemDto>)ViewBag.AllAdjustments;
    var typeConfigs = (List<AdjustmentTypeConfigDto>)ViewBag.TypeConfigs;
}

<partial name="~/Views/Shared/_Breadcrumbs.cshtml" model="@(new BreadcrumbViewModel { Items = new List<BreadcrumbViewModel.BreadcrumbItem> { new() { Label = "Dashboard", Url = Url.Action("Index", "Dashboard") }, new() { Label = "Adjustments", IsActive = true } } })" />

<div class="page-header" style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px;">
    <div>
        <h1 class="page-title">Adjustments</h1>
        <p class="page-subtitle">Review and manage billing adjustment requests</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" style="margin-bottom: 20px; padding: 12px 16px; background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 8px; color: #065f46; font-size: 14px;">
        @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" style="margin-bottom: 20px; padding: 12px 16px; background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; color: #991b1b; font-size: 14px;">
        @TempData["Error"]
    </div>
}

<!-- Stat Cards -->
<div class="stats-grid" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 24px;">
    <div class="adj-stat-card">
        <div class="stat-card-icon emerald">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <div>
            <div class="adj-stat-label">Approved</div>
            <div class="adj-stat-value">@metrics.Approved</div>
        </div>
    </div>
    <div class="adj-stat-card">
        <div class="stat-card-icon" style="background: rgba(245,176,65,0.1); color: #f5b041;">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <div>
            <div class="adj-stat-label">Pending</div>
            <div class="adj-stat-value">@metrics.Pending</div>
        </div>
    </div>
    <div class="adj-stat-card">
        <div class="stat-card-icon" style="background: rgba(225,95,72,0.1); color: #e15f48;">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <div>
            <div class="adj-stat-label">Rejected</div>
            <div class="adj-stat-value">@metrics.Rejected</div>
        </div>
    </div>
    <div class="adj-stat-card">
        <div class="stat-card-icon navy">
            <span style="font-size: 18px; font-weight: 700;">₱</span>
        </div>
        <div>
            <div class="adj-stat-label">Total Value</div>
            <div class="adj-stat-value">₱@metrics.TotalValue.ToString("N2")</div>
        </div>
    </div>
</div>

<!-- Tabs -->
<div class="adj-tabs">
    <button class="adj-tab active" data-tab="pending" onclick="switchTab('pending')">
        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path></svg>
        Pending Requests
        @if (pendingRequests.Count > 0) { <span class="adj-tab-badge">@pendingRequests.Count</span> }
    </button>
    <button class="adj-tab" data-tab="history" onclick="switchTab('history')">
        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        Adjustment History
    </button>
    <button class="adj-tab" data-tab="settings" onclick="switchTab('settings')">
        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
        Type Settings
    </button>
</div>

<!-- Tab: Pending Requests -->
<div class="adj-tab-content active" id="tab-pending">
    <div class="card">
        <div class="card-header" style="padding: 12px 24px;">
            <div style="position:relative; max-width:320px;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:#9ca3af;"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                <input type="text" id="adjSearch" placeholder="Search adjustments..." class="form-input" style="padding-left:40px;width:100%;" />
            </div>
        </div>
        <div class="card-body" style="padding: 0;">
            <div style="padding: 20px 24px 12px;">
                <p class="adj-section-desc">@pendingRequests.Count adjustment request(s) awaiting your review</p>
            </div>

            @if (pendingRequests.Count == 0)
            {
                <div style="padding: 40px 24px; text-align: center;">
                    <svg width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: #9ca3af; margin: 0 auto 12px;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    <p style="color: #6b7280; font-weight: 600;">All caught up!</p>
                    <p style="color: #9ca3af; font-size: 14px;">No pending adjustment requests at this time.</p>
                </div>
            }
            else
            {
                <div class="table-container" style="overflow-x: auto;">
                    <table class="table" style="min-width: 900px; table-layout: fixed;">
                        <colgroup>
                            <col style="width: 8%;" />
                            <col style="width: 13%;" />
                            <col style="width: 14%;" />
                            <col style="width: 11%;" />
                            <col style="width: 16%;" />
                            <col style="width: 11%;" />
                            <col style="width: 14%;" />
                            <col style="width: 13%;" />
                        </colgroup>
                        <thead>
                            <tr>
                                <th>TYPE</th>
                                <th>INVOICE</th>
                                <th>CUSTOMER</th>
                                <th class="text-right">AMOUNT</th>
                                <th>REASON</th>
                                <th>REQUESTED BY</th>
                                <th>DATE</th>
                                <th class="text-center">ACTIONS</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var req in pendingRequests)
                            {
                                var badgeClass = req.AdjustmentType == "Credit" ? "status-info" : req.AdjustmentType == "Refund" ? "status-warning" : "status-purple";
                                var isCredit = req.AdjustmentType is "Credit" or "Refund";
                                <tr data-type="@req.AdjustmentType.ToLower()" data-invoice="@req.InvoiceNumber.ToLower()" data-customer="@req.CustomerName.ToLower()" data-reason="@req.Reason.ToLower()">
                                    <td><span class="status-indicator @badgeClass">@req.AdjustmentType</span></td>
                                    <td class="adj-inv-link">@req.InvoiceNumber</td>
                                    <td class="fw-medium">@req.CustomerName</td>
                                    <td class="text-right"><span class="@(isCredit ? "adj-amount-credit" : "adj-amount-debit")">@(isCredit ? "−" : "+")₱@req.Amount.ToString("N2")</span></td>
                                    <td><span class="adj-reason" title="@req.Reason">@(req.Reason.Length > 40 ? req.Reason[..37] + "..." : req.Reason)</span></td>
                                    <td>@req.RequestedBy</td>
                                    <td class="text-muted" style="white-space:nowrap; font-size:12px;">@req.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        <div class="adj-action-group">
                                            <form asp-action="Approve" method="post" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@req.AdjustmentId" />
                                                <button type="submit" class="adj-btn-approve" title="Approve" onclick="return confirm('Approve this adjustment?');">
                                                    <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                                                    Approve
                                                </button>
                                            </form>
                                            <form asp-action="Reject" method="post" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@req.AdjustmentId" />
                                                <button type="submit" class="adj-btn-reject" title="Reject" onclick="return confirm('Reject this adjustment?');">
                                                    <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                                                    Reject
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Tab: Adjustment History -->
<div class="adj-tab-content" id="tab-history">
    <div class="card">
        <div class="card-body" style="padding: 0;">
            @if (historyItems.Count == 0)
            {
                <div style="padding: 40px 24px; text-align: center;">
                    <p style="color: #9ca3af; font-size: 14px;">No adjustment history yet.</p>
                </div>
            }
            else
            {
                <div class="table-container">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>TYPE</th>
                                <th>INVOICE</th>
                                <th>CUSTOMER</th>
                                <th class="text-right">AMOUNT</th>
                                <th>REASON</th>
                                <th>REQUESTED BY</th>
                                <th>REVIEWED BY</th>
                                <th>STATUS</th>
                                <th>DATE</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var adj in historyItems)
                            {
                                var badgeClass = adj.AdjustmentType == "Credit" ? "status-info" : adj.AdjustmentType == "Refund" ? "status-warning" : "status-purple";
                                var statusBadge = adj.Status == "Approved" ? "adj-badge-approved" : adj.Status == "Rejected" ? "adj-badge-rejected" : "adj-badge-pending";
                                var isCredit = adj.AdjustmentType is "Credit" or "Refund";
                                <tr data-type="@adj.AdjustmentType.ToLower()" data-invoice="@adj.InvoiceNumber.ToLower()" data-customer="@adj.CustomerName.ToLower()" data-status="@adj.Status" data-reason="@adj.Reason.ToLower()">
                                    <td><span class="status-indicator @badgeClass">@adj.AdjustmentType</span></td>
                                    <td class="adj-inv-link">@adj.InvoiceNumber</td>
                                    <td class="fw-medium">@adj.CustomerName</td>
                                    <td class="text-right"><span class="@(isCredit ? "adj-amount-credit" : "adj-amount-debit")">@(isCredit ? "−" : "+")₱@adj.Amount.ToString("N2")</span></td>
                                    <td><span class="adj-reason" title="@adj.Reason">@(adj.Reason.Length > 35 ? adj.Reason[..32] + "..." : adj.Reason)</span></td>
                                    <td>@adj.RequestedBy</td>
                                    <td class="text-muted">@(adj.ReviewedBy ?? "—")</td>
                                    <td><span class="adj-badge @statusBadge">@adj.Status</span></td>
                                    <td class="text-muted" style="white-space:nowrap;">@adj.CreatedAt.ToString("MMM dd, yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Tab: Type Settings -->
<div class="adj-tab-content" id="tab-settings">
    <div class="card" style="margin-bottom: 24px;">
        <div class="card-body">
            <h3 class="adj-section-title" style="margin-bottom: 16px;">
                <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
                Add Adjustment Type
            </h3>
            <form asp-action="CreateTypeConfig" method="post" style="display: flex; gap: 12px; align-items: flex-end; flex-wrap: wrap;">
                @Html.AntiForgeryToken()
                <div class="form-group" style="flex: 2; min-width: 180px;">
                    <label class="form-label">Name</label>
                    <input type="text" name="name" class="form-input" placeholder="e.g. Senior Citizen Discount" required />
                </div>
                <div class="form-group" style="flex: 1; min-width: 120px;">
                    <label class="form-label">Category</label>
                    <select name="category" class="form-input" required>
                        <option value="Credit">Credit</option>
                        <option value="Debit">Debit</option>
                        <option value="Refund">Refund</option>
                    </select>
                </div>
                <div class="form-group" style="flex: 1; min-width: 100px;">
                    <label class="form-label">Percentage (%)</label>
                    <input type="number" name="percentage" class="form-input" placeholder="0" min="0" max="100" step="0.01" required />
                </div>
                <button type="submit" class="btn btn-primary btn-sm" style="height: 38px;">Add Type</button>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-body" style="padding: 0;">
            <div style="padding: 20px 24px 12px;">
                <h3 class="adj-section-title">Configured Adjustment Types</h3>
            </div>
            @if (typeConfigs.Count == 0)
            {
                <div style="padding: 40px 24px; text-align: center;">
                    <p style="color: #9ca3af; font-size: 14px;">No adjustment types configured yet. Add one above.</p>
                </div>
            }
            else
            {
                <div class="table-container">
                    <table class="table" style="table-layout: fixed;">
                        <colgroup>
                            <col style="width: 30%;" />
                            <col style="width: 20%;" />
                            <col style="width: 20%;" />
                            <col style="width: 30%;" />
                        </colgroup>
                        <thead>
                            <tr>
                                <th>NAME</th>
                                <th>CATEGORY</th>
                                <th class="text-right">PERCENTAGE</th>
                                <th class="text-center">ACTIONS</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var tc in typeConfigs)
                            {
                                var catClass = tc.Category == "Credit" ? "status-info" : tc.Category == "Refund" ? "status-warning" : "status-purple";
                                <tr id="type-row-@tc.Id" data-id="@tc.Id">
                                    <!-- Display Mode -->
                                    <td class="fw-medium type-display" data-field="name">@tc.Name</td>
                                    <td class="type-display" data-field="category"><span class="status-indicator @catClass">@tc.Category</span></td>
                                    <td class="text-right type-display" data-field="percentage" style="font-weight: 600;">@tc.Percentage.ToString("F2")%</td>
                                    <td class="text-center type-display">
                                        <div style="display: flex; gap: 6px; justify-content: center;">
                                            <button type="button" class="adj-btn-edit" title="Edit" onclick="startEditType(@tc.Id, this)">
                                                <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                                            </button>
                                            <form asp-action="DeleteTypeConfig" method="post" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="configId" value="@tc.Id" />
                                                <button type="submit" class="adj-btn-reject" title="Delete" onclick="return confirm('Remove this adjustment type?');" style="padding: 4px 8px;">
                                                    <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                    <!-- Edit Mode (hidden by default) -->
                                    <td class="type-edit" style="display:none;">
                                        <input type="text" class="form-input form-input-sm edit-name" value="@tc.Name" style="font-size:13px; padding:5px 8px;" />
                                    </td>
                                    <td class="type-edit" style="display:none;">
                                        <select class="form-input form-input-sm edit-category" style="font-size:13px; padding:5px 8px;">
                                            @{
                                                var cats = new[] { "Credit", "Debit", "Refund" };
                                                foreach (var cat in cats)
                                                {
                                                    if (tc.Category == cat)
                                                    {
                                                        <option value="@cat" selected="selected">@cat</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@cat">@cat</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </td>
                                    <td class="type-edit" style="display:none;">
                                        <input type="number" class="form-input form-input-sm edit-percentage" value="@tc.Percentage" min="0" max="100" step="0.01" style="font-size:13px; padding:5px 8px;" />
                                    </td>
                                    <td class="text-center type-edit" style="display:none;">
                                        <div style="display: flex; gap: 6px; justify-content: center;">
                                            <button type="button" class="adj-btn-approve" title="Save" onclick="saveEditType(@tc.Id)" style="padding: 4px 8px;">
                                                <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                                            </button>
                                            <button type="button" class="adj-btn-reject" title="Cancel" onclick="cancelEditType(@tc.Id)" style="padding: 4px 8px;">
                                                <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .adj-stat-card { display: flex; align-items: center; gap: 16px; background: white; border: 1px solid var(--gray-border); border-radius: var(--radius-md); padding: 20px; box-shadow: var(--shadow-card); }
    .adj-stat-label { font-size: 12px; color: #9ca3af; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600; }
    .adj-stat-value { font-size: 22px; font-weight: 700; color: #1f2937; margin-top: 2px; }
    .adj-section-title { font-size: 16px; font-weight: 600; color: #1f2937; display: flex; align-items: center; gap: 8px; margin: 0; }
    .adj-section-desc { font-size: 13px; color: #9ca3af; margin-top: 2px; }
    .adj-inv-link { color: #3b82f6; font-weight: 500; font-size: 13px; }
    .adj-reason { color: #374151; font-size: 13px; max-width: 200px; display: inline-block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .adj-amount-credit { color: #059669; font-weight: 600; font-size: 13px; }
    .adj-amount-debit { color: #dc2626; font-weight: 600; font-size: 13px; }

    /* Tabs */
    .adj-tabs { display: flex; gap: 4px; margin-bottom: 20px; border-bottom: 2px solid #e5e7eb; }
    .adj-tab { display: inline-flex; align-items: center; gap: 6px; padding: 10px 18px; font-size: 13px; font-weight: 600; color: #6b7280; background: none; border: none; cursor: pointer; border-bottom: 2px solid transparent; margin-bottom: -2px; transition: all 0.2s; font-family: inherit; }
    .adj-tab:hover { color: #1f2937; }
    .adj-tab.active { color: #2563eb; border-bottom-color: #2563eb; }
    .adj-tab-badge { background: #ef4444; color: white; font-size: 10px; font-weight: 700; padding: 1px 6px; border-radius: 99px; min-width: 18px; text-align: center; }
    .adj-tab-content { display: none; }
    .adj-tab-content.active { display: block; }

    /* Action Buttons - proper spacing */
    .adj-action-group { display: flex; gap: 6px; justify-content: center; flex-wrap: nowrap; }
    .adj-btn-approve { display: inline-flex; align-items: center; gap: 4px; padding: 5px 10px; border-radius: 6px; font-size: 12px; font-weight: 600; font-family: inherit; border: 1px solid #10b981; color: #10b981; background: transparent; cursor: pointer; transition: all 0.15s; white-space: nowrap; }
    .adj-btn-approve:hover { background: #10b981; color: white; }
    .adj-btn-reject { display: inline-flex; align-items: center; gap: 4px; padding: 5px 10px; border-radius: 6px; font-size: 12px; font-weight: 600; font-family: inherit; border: 1px solid #ef4444; color: #ef4444; background: transparent; cursor: pointer; transition: all 0.15s; white-space: nowrap; }
    .adj-btn-reject:hover { background: #ef4444; color: white; }
    .adj-btn-edit { display: inline-flex; align-items: center; gap: 4px; padding: 4px 8px; border-radius: 6px; font-size: 12px; font-weight: 600; font-family: inherit; border: 1px solid #3b82f6; color: #3b82f6; background: transparent; cursor: pointer; transition: all 0.15s; }
    .adj-btn-edit:hover { background: #3b82f6; color: white; }

    /* Status Badges */
    .adj-badge { display: inline-flex; align-items: center; padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: 600; }
    .adj-badge-pending  { background: rgba(245,176,65,0.12); color: #d97706; }
    .adj-badge-approved { background: rgba(16,185,129,0.12); color: #059669; }
    .adj-badge-rejected { background: rgba(239,68,68,0.12);  color: #dc2626; }

    @@media (max-width: 1024px) { .stats-grid { grid-template-columns: repeat(2, 1fr) !important; } }
    @@media (max-width: 640px) { .stats-grid { grid-template-columns: 1fr !important; } }
</style>

<script>
    function switchTab(tabName) {
        document.querySelectorAll('.adj-tab').forEach(t => t.classList.remove('active'));
        document.querySelectorAll('.adj-tab-content').forEach(c => c.classList.remove('active'));
        document.querySelector(`[data-tab="${tabName}"]`).classList.add('active');
        document.getElementById(`tab-${tabName}`).classList.add('active');
    }

    setInterval(function() {
        if (document.querySelector('.modal:not(.hidden)') || document.activeElement?.tagName === 'INPUT' || document.activeElement?.tagName === 'TEXTAREA' || document.activeElement?.tagName === 'SELECT') return;
        location.reload();
    }, 30000);

    function startEditType(id) {
        var row = document.getElementById('type-row-' + id);
        row.querySelectorAll('.type-display').forEach(el => el.style.display = 'none');
        row.querySelectorAll('.type-edit').forEach(el => el.style.display = '');
    }

    function cancelEditType(id) {
        var row = document.getElementById('type-row-' + id);
        row.querySelectorAll('.type-display').forEach(el => el.style.display = '');
        row.querySelectorAll('.type-edit').forEach(el => el.style.display = 'none');
    }

    function saveEditType(id) {
        var row = document.getElementById('type-row-' + id);
        var name = row.querySelector('.edit-name').value;
        var category = row.querySelector('.edit-category').value;
        var percentage = row.querySelector('.edit-percentage').value;

        var form = document.createElement('form');
        form.method = 'POST';
        form.action = '@Url.Action("UpdateTypeConfig", "Adjustments", new { area = "Admin" })';
        form.style.display = 'none';

        var token = document.querySelector('#tab-types input[name="__RequestVerificationToken"]').value;
        var fields = { '__RequestVerificationToken': token, 'configId': id, 'name': name, 'category': category, 'percentage': percentage, 'isActive': 'true' };
        for (var key in fields) {
            var input = document.createElement('input');
            input.type = 'hidden';
            input.name = key;
            input.value = fields[key];
            form.appendChild(input);
        }
        document.body.appendChild(form);
        form.submit();
    }

    (function () {
        var search = document.getElementById('adjSearch');
        if (!search) return;

        function filterAdj() {
            var q = search.value.toLowerCase();
            var tabs = ['tab-pending', 'tab-history'];
            tabs.forEach(function (tabId) {
                var tb = document.querySelector('#' + tabId + ' tbody');
                if (!tb) return;
                var rows = tb.querySelectorAll('tr');
                var visible = 0;
                rows.forEach(function (row) {
                    if (!row.dataset.type) return;
                    var match = !q || row.dataset.type.indexOf(q) > -1 || row.dataset.invoice.indexOf(q) > -1 || row.dataset.customer.indexOf(q) > -1 || (row.dataset.reason && row.dataset.reason.indexOf(q) > -1);
                    row.style.display = match ? '' : 'none';
                    if (match) visible++;
                });
            });
        }

        search.addEventListener('input', filterAdj);
    })();
</script>
