@using ByteBill_BS.Services
@{
    ViewData["Title"] = "Adjustments";
    var metrics = (AdjustmentMetricsDto)ViewBag.Metrics;
    var pendingRequests = (List<AdjustmentListItemDto>)ViewBag.PendingRequests;
    var historyItems = (List<AdjustmentListItemDto>)ViewBag.AllAdjustments;
}

<partial name="~/Views/Shared/_Breadcrumbs.cshtml" model="@(new BreadcrumbViewModel { Items = new List<BreadcrumbViewModel.BreadcrumbItem> { new() { Label = "Dashboard", Url = Url.Action("Index", "Dashboard") }, new() { Label = "Adjustments", IsActive = true } } })" />

<div class="page-header" style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px;">
    <div>
        <h1 class="page-title">Adjustments</h1>
        <p class="page-subtitle">Review and manage billing adjustment requests</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" style="margin-bottom: 20px; padding: 12px 16px; background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 8px; color: #065f46; font-size: 14px;">
        @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" style="margin-bottom: 20px; padding: 12px 16px; background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; color: #991b1b; font-size: 14px;">
        @TempData["Error"]
    </div>
}

<!-- Stat Cards -->
<div class="stats-grid" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 24px;">
    <div class="adj-stat-card">
        <div class="stat-card-icon emerald">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <div>
            <div class="adj-stat-label">Approved</div>
            <div class="adj-stat-value">@metrics.Approved</div>
        </div>
    </div>
    <div class="adj-stat-card">
        <div class="stat-card-icon" style="background: rgba(245,176,65,0.1); color: #f5b041;">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <div>
            <div class="adj-stat-label">Pending</div>
            <div class="adj-stat-value">@metrics.Pending</div>
        </div>
    </div>
    <div class="adj-stat-card">
        <div class="stat-card-icon" style="background: rgba(225,95,72,0.1); color: #e15f48;">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <div>
            <div class="adj-stat-label">Rejected</div>
            <div class="adj-stat-value">@metrics.Rejected</div>
        </div>
    </div>
    <div class="adj-stat-card">
        <div class="stat-card-icon navy">
            <span style="font-size: 18px; font-weight: 700;">₱</span>
        </div>
        <div>
            <div class="adj-stat-label">Total Value</div>
            <div class="adj-stat-value">₱@metrics.TotalValue.ToString("N2")</div>
        </div>
    </div>
</div>

<!-- Pending Requests -->
<div class="card" style="margin-bottom: 24px;">
    <div class="card-body" style="padding: 0;">
        <div style="padding: 20px 24px 12px;">
            <h3 class="adj-section-title">
                <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path></svg>
                Pending Requests
            </h3>
            <p class="adj-section-desc">@pendingRequests.Count adjustment request(s) awaiting your review</p>
        </div>

        @if (pendingRequests.Count == 0)
        {
            <div style="padding: 40px 24px; text-align: center;">
                <svg width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: #9ca3af; margin: 0 auto 12px;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                <p style="color: #6b7280; font-weight: 600;">All caught up!</p>
                <p style="color: #9ca3af; font-size: 14px;">No pending adjustment requests at this time.</p>
            </div>
        }
        else
        {
            <div class="table-container">
                <table class="table">
                    <thead>
                        <tr>
                            <th>TYPE</th>
                            <th>INVOICE</th>
                            <th>CUSTOMER</th>
                            <th class="text-right">AMOUNT</th>
                            <th>REASON</th>
                            <th>REQUESTED BY</th>
                            <th>DATE</th>
                            <th class="text-center">ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var req in pendingRequests)
                        {
                            var badgeClass = req.AdjustmentType == "Credit" ? "status-info" : req.AdjustmentType == "Refund" ? "status-warning" : "status-purple";
                            var isCredit = req.AdjustmentType is "Credit" or "Refund";
                            <tr>
                                <td><span class="status-indicator @badgeClass">@req.AdjustmentType</span></td>
                                <td class="adj-inv-link">@req.InvoiceNumber</td>
                                <td class="fw-medium">@req.CustomerName</td>
                                <td class="text-right"><span class="@(isCredit ? "adj-amount-credit" : "adj-amount-debit")">@(isCredit ? "−" : "+")₱@req.Amount.ToString("N2")</span></td>
                                <td><span class="adj-reason" title="@req.Reason">@(req.Reason.Length > 40 ? req.Reason[..37] + "..." : req.Reason)</span></td>
                                <td>@req.RequestedBy</td>
                                <td class="text-muted" style="white-space:nowrap;">@req.CreatedAt.ToString("MMM dd, yyyy h:mm tt")</td>
                                <td class="text-center">
                                    <div style="display: flex; gap: 6px; justify-content: center;">
                                        <form asp-action="Approve" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@req.AdjustmentId" />
                                            <button type="submit" class="adj-btn-approve" onclick="return confirm('Approve this adjustment? The invoice balance will be updated automatically.');">
                                                <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                                                Approve
                                            </button>
                                        </form>
                                        <form asp-action="Reject" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@req.AdjustmentId" />
                                            <button type="submit" class="adj-btn-reject" onclick="return confirm('Reject this adjustment?');">
                                                <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                                                Reject
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Adjustment History -->
<div class="card">
    <div class="card-body" style="padding: 0;">
        <div style="padding: 20px 24px 12px;">
            <h3 class="adj-section-title">
                <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                Adjustment History
            </h3>
        </div>

        @if (historyItems.Count == 0)
        {
            <div style="padding: 40px 24px; text-align: center;">
                <p style="color: #9ca3af; font-size: 14px;">No adjustment history yet.</p>
            </div>
        }
        else
        {
            <div class="table-container">
                <table class="table">
                    <thead>
                        <tr>
                            <th>TYPE</th>
                            <th>INVOICE</th>
                            <th>CUSTOMER</th>
                            <th class="text-right">AMOUNT</th>
                            <th>REASON</th>
                            <th>REQUESTED BY</th>
                            <th>REVIEWED BY</th>
                            <th>STATUS</th>
                            <th>DATE</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var adj in historyItems)
                        {
                            var badgeClass = adj.AdjustmentType == "Credit" ? "status-info" : adj.AdjustmentType == "Refund" ? "status-warning" : "status-purple";
                            var statusBadge = adj.Status == "Approved" ? "status-success" : adj.Status == "Rejected" ? "status-danger" : "status-pending";
                            var isCredit = adj.AdjustmentType is "Credit" or "Refund";
                            <tr>
                                <td><span class="status-indicator @badgeClass">@adj.AdjustmentType</span></td>
                                <td class="adj-inv-link">@adj.InvoiceNumber</td>
                                <td class="fw-medium">@adj.CustomerName</td>
                                <td class="text-right"><span class="@(isCredit ? "adj-amount-credit" : "adj-amount-debit")">@(isCredit ? "−" : "+")₱@adj.Amount.ToString("N2")</span></td>
                                <td><span class="adj-reason" title="@adj.Reason">@(adj.Reason.Length > 35 ? adj.Reason[..32] + "..." : adj.Reason)</span></td>
                                <td>@adj.RequestedBy</td>
                                <td class="text-muted">@(adj.ReviewedBy ?? "—")</td>
                                <td><span class="status-indicator @statusBadge">@adj.Status</span></td>
                                <td class="text-muted" style="white-space:nowrap;">@adj.CreatedAt.ToString("MMM dd, yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<style>
    .adj-stat-card { display: flex; align-items: center; gap: 16px; background: white; border: 1px solid var(--gray-border); border-radius: var(--radius-md); padding: 20px; box-shadow: var(--shadow-card); }
    .adj-stat-label { font-size: 12px; color: #9ca3af; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600; }
    .adj-stat-value { font-size: 22px; font-weight: 700; color: #1f2937; margin-top: 2px; }
    .adj-section-title { font-size: 16px; font-weight: 600; color: #1f2937; display: flex; align-items: center; gap: 8px; margin: 0; }
    .adj-section-desc { font-size: 13px; color: #9ca3af; margin-top: 2px; }
    .adj-inv-link { color: #3b82f6; font-weight: 500; font-size: 13px; }
    .adj-reason { color: #374151; font-size: 13px; max-width: 200px; display: inline-block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .adj-amount-credit { color: #059669; font-weight: 600; font-size: 13px; }
    .adj-amount-debit { color: #dc2626; font-weight: 600; font-size: 13px; }
    .adj-btn-approve { display: inline-flex; align-items: center; gap: 4px; padding: 6px 12px; border-radius: 6px; font-size: 12px; font-weight: 600; font-family: inherit; border: 1px solid #10b981; color: #10b981; background: transparent; cursor: pointer; transition: all 0.2s; }
    .adj-btn-approve:hover { background: #10b981; color: white; }
    .adj-btn-reject { display: inline-flex; align-items: center; gap: 4px; padding: 6px 12px; border-radius: 6px; font-size: 12px; font-weight: 600; font-family: inherit; border: 1px solid #ef4444; color: #ef4444; background: transparent; cursor: pointer; transition: all 0.2s; }
    .adj-btn-reject:hover { background: #ef4444; color: white; }
    @@media (max-width: 1024px) { .stats-grid { grid-template-columns: repeat(2, 1fr) !important; } }
    @@media (max-width: 640px) { .stats-grid { grid-template-columns: 1fr !important; } }
</style>
