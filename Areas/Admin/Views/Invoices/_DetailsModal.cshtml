@model InvoiceDetailViewModel

<div class="modal-detail-body">
    <!-- Invoice Header -->
    <div class="modal-detail-header" style="justify-content: space-between;">
        <div style="display: flex; align-items: center; gap: 14px;">
            <div class="detail-icon-lg detail-icon-blue">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
            </div>
            <div>
                <h3 class="modal-detail-name">@Model.InvoiceNumber</h3>
                <p class="modal-detail-sub">Issued @Model.CreatedAt.ToString("MMMM d, yyyy")</p>
            </div>
        </div>
        <span class="badge @Model.StatusClass" style="font-size: 13px; padding: 6px 14px;">@Model.StatusDisplay</span>
    </div>

    <!-- Summary Stats -->
    <div class="modal-stats-row">
        <div class="modal-stat">
            <span class="modal-stat-label">Total</span>
            <span class="modal-stat-value">@Model.Total.ToString("C")</span>
        </div>
        <div class="modal-stat">
            <span class="modal-stat-label">Paid</span>
            <span class="modal-stat-value" style="color: #10b981;">@Model.AmountPaid.ToString("C")</span>
        </div>
        <div class="modal-stat">
            <span class="modal-stat-label">Balance</span>
            <span class="modal-stat-value @(Model.Balance > 0 ? "text-danger" : "")">@Model.Balance.ToString("C")</span>
        </div>
    </div>

    <!-- Customer & Job -->
    <div class="modal-detail-section">
        <h4 class="modal-section-title">Customer & Job Order</h4>
        <dl class="modal-detail-list">
            <div class="modal-detail-item">
                <dt>Customer</dt>
                <dd>@Model.CustomerName</dd>
            </div>
            @if (!string.IsNullOrEmpty(Model.CustomerEmail))
            {
                <div class="modal-detail-item">
                    <dt>Email</dt>
                    <dd><a href="mailto:@Model.CustomerEmail" class="text-link">@Model.CustomerEmail</a></dd>
                </div>
            }
            <div class="modal-detail-item">
                <dt>Phone</dt>
                <dd>@(Model.CustomerPhone ?? "—")</dd>
            </div>
            <div class="modal-detail-item">
                <dt>Job Order</dt>
                <dd class="font-medium">@Model.JobNumber</dd>
            </div>
            @if (Model.DueDate.HasValue)
            {
                <div class="modal-detail-item">
                    <dt>Due Date</dt>
                    <dd class="@(Model.DueDate < DateTime.Today && Model.Balance > 0 ? "text-danger font-medium" : "")">
                        @Model.DueDate.Value.ToString("MMMM d, yyyy")
                    </dd>
                </div>
            }
        </dl>
    </div>

    <!-- Line Items -->
    <div class="modal-detail-section">
        <h4 class="modal-section-title">Line Items</h4>
        <div class="table-container">
            <table class="table table-compact">
                <thead>
                    <tr>
                        <th>Description</th>
                        <th class="text-center">Qty</th>
                        <th class="text-right">Unit Price</th>
                        <th class="text-right">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.LineItems)
                    {
                        <tr>
                            <td>@item.Description</td>
                            <td class="text-center">@item.Quantity</td>
                            <td class="text-right">@item.UnitPrice.ToString("C")</td>
                            <td class="text-right font-medium">@item.Total.ToString("C")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3" class="text-right" style="color: #6b7280;">Subtotal</td>
                        <td class="text-right">@Model.Subtotal.ToString("C")</td>
                    </tr>
                    @if (Model.TaxAmount > 0)
                    {
                        <tr>
                            <td colspan="3" class="text-right" style="color: #6b7280;">Tax (@Model.TaxRate%)</td>
                            <td class="text-right">@Model.TaxAmount.ToString("C")</td>
                        </tr>
                    }
                    @if (Model.DiscountAmount > 0)
                    {
                        <tr>
                            <td colspan="3" class="text-right" style="color: #6b7280;">Discount</td>
                            <td class="text-right text-danger">-@Model.DiscountAmount.ToString("C")</td>
                        </tr>
                    }
                    <tr style="border-top: 2px solid #e5e7eb;">
                        <td colspan="3" class="text-right font-bold" style="font-size: 14px;">Total</td>
                        <td class="text-right font-bold" style="font-size: 14px;">@Model.Total.ToString("C")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <!-- Payment History -->
    <div class="modal-detail-section">
        <h4 class="modal-section-title">Payment History</h4>
        @if (Model.Payments.Any())
        {
            <div class="table-container">
                <table class="table table-compact">
                    <thead>
                        <tr>
                            <th>Payment #</th>
                            <th>Method</th>
                            <th>Date</th>
                            <th class="text-right">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var payment in Model.Payments)
                        {
                            <tr>
                                <td class="font-medium">@payment.PaymentNumber</td>
                                <td>@payment.Method.ToString()</td>
                                <td>@payment.PaidAt.ToString("MMM d, yyyy")</td>
                                <td class="text-right font-medium @(payment.IsVoid ? "text-line-through text-muted" : "")">@payment.Amount.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-box-sm">
                <p class="text-muted">No payments recorded</p>
            </div>
        }
    </div>

    @if (!string.IsNullOrEmpty(Model.Notes))
    {
        <div class="modal-detail-section">
            <h4 class="modal-section-title">Notes</h4>
            <p style="font-size: 13px; color: #6b7280; line-height: 1.6;">@Model.Notes</p>
        </div>
    }
</div>

<div class="modal-form-footer">
    <button type="button" class="btn btn-ghost" onclick="closeAjaxModal()">Close</button>
</div>

<style>
    .detail-icon-lg { width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .detail-icon-blue { background: rgba(59,130,246,0.1); color: #3b82f6; }
    .font-bold { font-weight: 700; }
    .text-danger { color: #dc2626; }
    .font-medium { font-weight: 500; }
    .text-line-through { text-decoration: line-through; }
    .text-muted { color: #9ca3af; }
    .empty-box-sm { padding: 20px; text-align: center; background: #f9fafb; border-radius: 8px; }
    .badge-pending { background: #fef3c7; color: #92400e; }
    .badge-partial { background: #dbeafe; color: #1e40af; }
    .badge-paid { background: #d1fae5; color: #065f46; }
    .badge-void { background: #f3f4f6; color: #6b7280; }
</style>
