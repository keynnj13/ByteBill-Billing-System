@model DashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<partial name="~/Views/Shared/_Breadcrumbs.cshtml" model="@(new BreadcrumbViewModel { Items = new List<BreadcrumbViewModel.BreadcrumbItem> { new() { Label = "Dashboard", IsActive = true } } })" />

<!-- ═══ Page Header ═══ -->
<div class="dash-header">
    <div>
        <h1 class="dash-title">Welcome back, @Model.UserName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault()</h1>
        <p class="dash-subtitle">Here's what's happening at <strong>@Model.ShopName</strong> today.</p>
    </div>
    <div class="dash-live-badge" id="dash-live-status">
        <span class="live-dot" id="live-dot"></span>
        <span id="live-text">Live</span>
    </div>
</div>

<!-- ═══ Date Filter ═══ -->
<div class="dash-filter" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:24px;">
    <a href="@Url.Action("Index")" class="filter-btn @(Model.ActivePeriod == "all" ? "filter-btn-active" : "")">All Time</a>
    <a href="@Url.Action("Index", new { period = "today" })" class="filter-btn @(Model.ActivePeriod == "today" ? "filter-btn-active" : "")">Today</a>
    <a href="@Url.Action("Index", new { period = "week" })" class="filter-btn @(Model.ActivePeriod == "week" ? "filter-btn-active" : "")">This Week</a>
    <a href="@Url.Action("Index", new { period = "month" })" class="filter-btn @(Model.ActivePeriod == "month" ? "filter-btn-active" : "")">This Month</a>
    <a href="@Url.Action("Index", new { period = "last30" })" class="filter-btn @(Model.ActivePeriod == "last30" ? "filter-btn-active" : "")">Last 30 Days</a>
    <a href="@Url.Action("Index", new { period = "last3mo" })" class="filter-btn @(Model.ActivePeriod == "last3mo" ? "filter-btn-active" : "")">Last 3 Months</a>
    <span style="width:1px;height:24px;background:#e5e7eb;margin:0 4px;"></span>
    <form method="get" style="display:flex;gap:6px;align-items:center;">
        <input type="hidden" name="period" value="custom" />
        <input type="date" name="from" value="@(Model.ActivePeriod == "custom" && Model.FilterFrom.HasValue ? Model.FilterFrom.Value.ToString("yyyy-MM-dd") : "")" class="form-input" style="font-size:13px;padding:6px 10px;width:150px;" placeholder="mm/dd/yyyy" />
        <span style="color:#9ca3af;font-size:13px;">to</span>
        <input type="date" name="to" value="@(Model.ActivePeriod == "custom" && Model.FilterTo.HasValue ? Model.FilterTo.Value.ToString("yyyy-MM-dd") : "")" class="form-input" style="font-size:13px;padding:6px 10px;width:150px;" placeholder="mm/dd/yyyy" />
        <button type="submit" class="btn btn-outline-primary btn-sm">Apply</button>
    </form>
</div>

@{
    string PeriodLabel(string baseName) => Model.ActivePeriod switch
    {
        "all"     => $"Total {baseName}",
        "today"   => $"Today's {baseName}",
        "week"    => $"Weekly {baseName}",
        "month"   => $"Monthly {baseName}",
        "last30"  => $"Last 30 Days {baseName}",
        "last3mo" => $"Last 3 Months {baseName}",
        "custom"  => Model.FilterFrom.HasValue && Model.FilterTo.HasValue
                     ? $"{baseName} ({Model.FilterFrom.Value:MMM d} – {Model.FilterTo.Value:MMM d})"
                     : baseName,
        _         => baseName
    };
}

<!-- ═══ KPI Cards ═══ -->
<div class="kpi-grid">
    <!-- Revenue -->
    <div class="kpi-card">
        <div class="kpi-icon kpi-icon-green">
            <span class="kpi-peso-icon">₱</span>
        </div>
        <div class="kpi-body">
            <span class="kpi-label" id="kpi-revenue-label">@PeriodLabel("Revenue")</span>
            <span class="kpi-value" id="kpi-today-revenue">₱@Model.PeriodRevenue.ToString("N2")</span>
            @if (Model.ActivePeriod == "today")
            {
                <span class="kpi-sub" id="kpi-week-revenue">Week: ₱@Model.WeekRevenue.ToString("N2")</span>
            }
        </div>
    </div>

    <!-- Pending Job Orders -->
    <div class="kpi-card">
        <div class="kpi-icon kpi-icon-blue">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg>
        </div>
        <div class="kpi-body">
            <span class="kpi-label">Pending Jobs</span>
            <span class="kpi-value" id="kpi-pending-jobs">@Model.PendingJobOrdersCount</span>
            <span class="kpi-sub" id="kpi-inprogress-jobs">In progress: @Model.InProgressJobOrders</span>
        </div>
    </div>

    <!-- Outstanding Invoices -->
    <div class="kpi-card">
        <div class="kpi-icon kpi-icon-amber">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        </div>
        <div class="kpi-body">
            <span class="kpi-label">Unpaid Invoices</span>
            <span class="kpi-value" id="kpi-unpaid-invoices">@Model.PendingInvoices</span>
            <span class="kpi-sub" id="kpi-outstanding">₱@Model.OutstandingAmount.ToString("N2") outstanding</span>
        </div>
    </div>

    <!-- Low Stock Alert -->
    <div class="kpi-card">
        <div class="kpi-icon kpi-icon-red">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        </div>
        <div class="kpi-body">
            <span class="kpi-label">Low Stock Items</span>
            <span class="kpi-value" id="kpi-low-stock">@Model.LowStockItems</span>
            <span class="kpi-sub">Needs reorder</span>
        </div>
    </div>
</div>

<!-- ═══ Charts Row ═══ -->
<div class="charts-row">
    <!-- Monthly Revenue Chart -->
    <div class="card chart-card">
        <div class="card-header">
            <h3 class="card-title">Monthly Revenue</h3>
            <div style="display:flex;align-items:center;gap:8px;"><span class="live-dot"></span><span class="card-badge">Last 6 months</span></div>
        </div>
        <div class="card-body">
            <canvas id="revenueChart" height="260"></canvas>
        </div>
    </div>

    <!-- Job Order Status Distribution -->
    <div class="card chart-card chart-card-sm">
        <div class="card-header">
            <h3 class="card-title">Job Order Status</h3>
        </div>
        <div class="card-body" style="display: flex; align-items: center; justify-content: center;">
            <canvas id="jobStatusChart" height="240"></canvas>
        </div>
    </div>
</div>

<!-- ═══ Tables Row ═══ -->
<div class="tables-row">
    <!-- Recent Job Orders -->
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Recent Job Orders</h3>
            <a asp-action="Index" asp-controller="JobOrders" class="btn btn-ghost btn-sm">View All</a>
        </div>
        <div class="card-body p-0">
            <div class="table-container">
                <table class="table" style="table-layout: fixed;">
                    <colgroup>
                        <col style="width: 22%;" />
                        <col style="width: 22%;" />
                        <col style="width: 18%;" />
                        <col style="width: 20%;" />
                        <col style="width: 18%;" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>Order #</th>
                            <th>Customer</th>
                            <th>Device</th>
                            <th>Technician</th>
                            <th class="text-center">Status</th>
                        </tr>
                    </thead>
                    <tbody id="recent-jobs-body">
                        @foreach (var job in Model.RecentJobOrders)
                        {
                            <tr>
                                <td>
                                    <a asp-action="Details" asp-controller="JobOrders" asp-route-id="@job.Id" class="text-primary font-medium" style="font-weight:600;color:#3b82f6;text-decoration:none;font-size:13px;">@job.JobNumber</a>
                                </td>
                                <td style="font-size:13px;color:#374151;">@job.CustomerName</td>
                                <td style="font-size:13px;color:#374151;">@job.DeviceType</td>
                                <td style="font-size:13px;color:@(job.TechnicianName != null ? "#374151" : "#d1d5db");@(job.TechnicianName == null ? "font-style:italic;" : "")">@(job.TechnicianName ?? "Unassigned")</td>
                                <td class="text-center"><span class="status-indicator status-@job.StatusBadgeClass">@job.StatusName</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Recent Activity -->
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Recent Activity</h3>
        </div>
        <div class="card-body p-0">
            <ul class="activity-list" id="activity-list">
                @foreach (var activity in Model.RecentActivity)
                {
                    <li class="activity-item">
                        <div class="activity-dot activity-dot-@activity.IconColor"></div>
                        <div class="activity-content">
                            <p class="activity-title">@activity.Title</p>
                            <p class="activity-description">@activity.Description</p>
                        </div>
                        <span class="activity-time">@activity.TimeAgo</span>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>

<!-- ═══ Chart.js CDN ═══ -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Theme-aware colors
        var colors = {
            primary: '#3b82f6',
            primaryLight: 'rgba(59,130,246,0.1)',
            green: '#10b981',
            amber: '#f59e0b',
            red: '#ef4444',
            purple: '#8b5cf6',
            cyan: '#06b6d4',
            indigo: '#6366f1',
            teal: '#14b8a6',
            gray: '#6b7280',
            gridLine: 'rgba(0,0,0,0.04)',
            text: '#374151'
        };

        // ── Semantic color map for Job Order Statuses ──
        var statusColorMap = {
            'Completed':      colors.green,
            'InProgress':     colors.primary,
            'Pending':        colors.amber,
            'Diagnosis':      colors.cyan,
            'WaitingForParts': colors.purple,
            'Cancelled':      colors.red,
            'CheckedIn':      colors.indigo
        };
        var fallbackColor = colors.gray;

        Chart.defaults.font.family = "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif";
        Chart.defaults.color = colors.text;

        // ── Revenue Bar Chart ──
        var revenueLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueChart.Select(c => c.Label)));
        var revenueValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueChart.Select(c => c.Value)));

        var revenueChart = new Chart(document.getElementById('revenueChart'), {
            type: 'bar',
            data: {
                labels: revenueLabels,
                datasets: [{
                    label: 'Revenue',
                    data: revenueValues,
                    backgroundColor: colors.primary,
                    borderRadius: 6,
                    borderSkipped: false,
                    barThickness: 32
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#1f2937',
                        padding: 12,
                        cornerRadius: 8,
                        titleFont: { weight: '600' },
                        callbacks: {
                            label: function (ctx) {
                                return '₱' + ctx.parsed.y.toLocaleString(undefined, { minimumFractionDigits: 2 });
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        ticks: { font: { size: 12 } }
                    },
                    y: {
                        beginAtZero: true,
                        grid: { color: colors.gridLine },
                        border: { display: false },
                        ticks: {
                            font: { size: 12 },
                            callback: function (val) {
                                if (val >= 1000) return '₱' + (val / 1000).toFixed(0) + 'k';
                                return '₱' + val;
                            }
                        }
                    }
                }
            }
        });

        // ── Job Status Doughnut Chart (semantic colors) ──
        var statusLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.JobOrderChart.Select(c => c.Label)));
        var statusValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.JobOrderChart.Select(c => c.Value)));
        var statusColors = statusLabels.map(function(label) {
            return statusColorMap[label] || fallbackColor;
        });

        var jobStatusChart = new Chart(document.getElementById('jobStatusChart'), {
            type: 'doughnut',
            data: {
                labels: statusLabels,
                datasets: [{
                    data: statusValues,
                    backgroundColor: statusColors,
                    borderWidth: 0,
                    spacing: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '65%',
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            padding: 16,
                            usePointStyle: true,
                            pointStyleWidth: 8,
                            font: { size: 12 },
                            generateLabels: function(chart) {
                                var data = chart.data;
                                return data.labels.map(function(label, i) {
                                    return {
                                        text: label,
                                        fillStyle: data.datasets[0].backgroundColor[i],
                                        strokeStyle: 'transparent',
                                        pointStyle: 'circle',
                                        hidden: false,
                                        index: i
                                    };
                                });
                            }
                        }
                    },
                    tooltip: {
                        backgroundColor: '#1f2937',
                        padding: 12,
                        cornerRadius: 8
                    }
                }
            }
        });

        // ══════════════════════════════════════════════════
        //  Real-time Polling (every 5 seconds)
        // ══════════════════════════════════════════════════
        var _pollInterval = 5000;
        var _pollTimer = null;

        function formatPeso(val) {
            return '₱' + Number(val).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function getStatusClass(status) {
            switch (status) {
                case 'Completed': return 'success';
                case 'InProgress': return 'primary';
                case 'Pending': return 'warning';
                case 'Cancelled': return 'danger';
                case 'WaitingForParts': return 'secondary';
                default: return 'info';
            }
        }

        function updateLiveStatus(ok) {
            var dot = document.getElementById('live-dot');
            var txt = document.getElementById('live-text');
            if (!dot || !txt) return;
            if (ok) {
                dot.className = 'live-dot live-dot-ok';
                var now = new Date();
                txt.textContent = 'Updated ' + now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
            } else {
                dot.className = 'live-dot live-dot-err';
                txt.textContent = 'Reconnecting\u2026';
            }
        }

        function pollDashboard() {
            var pollUrl = '@Url.Action("Poll", "Dashboard", new { area = "Admin" })';
            var qs = [];
            var activePeriod = '@Model.ActivePeriod';
            if (activePeriod && activePeriod !== 'all') qs.push('period=' + activePeriod);
            @if (Model.FilterFrom.HasValue) { <text>qs.push('from=@Model.FilterFrom.Value.ToString("yyyy-MM-dd")');</text> }
            @if (Model.FilterTo.HasValue) { <text>qs.push('to=@Model.FilterTo.Value.ToString("yyyy-MM-dd")');</text> }
            if (qs.length) pollUrl += (pollUrl.indexOf('?') >= 0 ? '&' : '?') + qs.join('&');

            fetch(pollUrl)
                .then(function(r) {
                    if (!r.ok) throw new Error('HTTP ' + r.status);
                    return r.json();
                })
                .then(function(d) {
                    updateLiveStatus(true);

                    // ── Update KPI cards ──
                    var el;
                    el = document.getElementById('kpi-today-revenue');
                    if (el) el.textContent = formatPeso(d.periodRevenue);
                    el = document.getElementById('kpi-week-revenue');
                    if (el) el.textContent = 'Week: ' + formatPeso(d.weekRevenue);
                    el = document.getElementById('kpi-pending-jobs');
                    if (el) el.textContent = d.pendingJobs;
                    el = document.getElementById('kpi-inprogress-jobs');
                    if (el) el.textContent = 'In progress: ' + d.inProgressJobs;
                    el = document.getElementById('kpi-unpaid-invoices');
                    if (el) el.textContent = d.unpaidInvoices;
                    el = document.getElementById('kpi-outstanding');
                    if (el) el.textContent = formatPeso(d.outstandingAmount) + ' outstanding';
                    el = document.getElementById('kpi-low-stock');
                    if (el) el.textContent = d.lowStockCount;

                    // ── Update Revenue Bar Chart ──
                    if (revenueChart && d.revenueChart && d.revenueChart.length) {
                        revenueChart.data.labels = d.revenueChart.map(function(c) { return c.label; });
                        revenueChart.data.datasets[0].data = d.revenueChart.map(function(c) { return c.value; });
                        revenueChart.update('none');
                    }

                    // ── Update Job Status Doughnut ──
                    if (jobStatusChart && d.jobOrderChart && d.jobOrderChart.length) {
                        var newLabels = d.jobOrderChart.map(function(c) { return c.label; });
                        var newValues = d.jobOrderChart.map(function(c) { return c.value; });
                        var newColors = newLabels.map(function(l) { return statusColorMap[l] || fallbackColor; });
                        jobStatusChart.data.labels = newLabels;
                        jobStatusChart.data.datasets[0].data = newValues;
                        jobStatusChart.data.datasets[0].backgroundColor = newColors;
                        jobStatusChart.update('none');
                    }

                    // ── Update Recent Job Orders table ──
                    var tbody = document.getElementById('recent-jobs-body');
                    if (tbody && d.recentJobOrders) {
                        tbody.innerHTML = d.recentJobOrders.map(function(job) {
                            var techHtml = job.technicianName
                                ? '<td style="font-size:13px;color:#374151;">' + job.technicianName + '</td>'
                                : '<td style="font-size:13px;color:#d1d5db;font-style:italic;">Unassigned</td>';
                            return '<tr>' +
                                '<td><a href="/Admin/JobOrders/Details/' + job.id + '" class="text-primary font-medium" style="font-weight:600;color:#3b82f6;text-decoration:none;font-size:13px;">' + job.jobNumber + '</a></td>' +
                                '<td style="font-size:13px;color:#374151;">' + job.customerName + '</td>' +
                                '<td style="font-size:13px;color:#374151;">' + job.deviceType + '</td>' +
                                techHtml +
                                '<td class="text-center"><span class="status-indicator status-' + getStatusClass(job.statusName) + '">' + job.statusName + '</span></td>' +
                                '</tr>';
                        }).join('');
                    }

                    // ── Update Recent Activity ──
                    var actList = document.getElementById('activity-list');
                    if (actList && d.recentActivity) {
                        actList.innerHTML = d.recentActivity.map(function(a) {
                            return '<li class="activity-item">' +
                                '<div class="activity-dot activity-dot-' + a.iconColor + '"></div>' +
                                '<div class="activity-content">' +
                                '<p class="activity-title">' + a.title + '</p>' +
                                '<p class="activity-description">' + a.description + '</p>' +
                                '</div>' +
                                '<span class="activity-time">' + a.timeAgo + '</span>' +
                                '</li>';
                        }).join('');
                    }
                })
                .catch(function(err) {
                    console.warn('Dashboard poll error:', err);
                    updateLiveStatus(false);
                });
        }

        // ── Visibility-aware polling: pause when tab is hidden ──
        function startPolling() {
            if (_pollTimer) return;
            pollDashboard();
            _pollTimer = setInterval(pollDashboard, _pollInterval);
        }
        function stopPolling() {
            if (_pollTimer) { clearInterval(_pollTimer); _pollTimer = null; }
        }
        document.addEventListener('visibilitychange', function() {
            if (document.hidden) stopPolling(); else startPolling();
        });

        // Start immediately
        startPolling();
    });
</script>

<!-- ═══ Dashboard Styles ═══ -->
<style>
    /* Header */
    .dash-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: var(--space-6);
    }
    .dash-title {
        font-size: 24px;
        font-weight: 700;
        color: var(--gray-900, #1f2937);
        margin-bottom: 4px;
    }
    .dash-subtitle {
        font-size: 14px;
        color: var(--muted);
    }
    .dash-subtitle strong { color: var(--gray-700, #374151); }
    .dash-actions { display: flex; gap: 12px; }

    /* Live status badge */
    .dash-live-badge {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 6px 14px;
        background: var(--gray-50, #f9fafb);
        border: 1px solid var(--gray-200, #e5e7eb);
        border-radius: var(--radius-full, 9999px);
        font-size: 12px;
        font-weight: 500;
        color: var(--gray-500, #6b7280);
        white-space: nowrap;
        height: fit-content;
        margin-top: 4px;
    }
    .live-dot-ok { background: #10b981 !important; }
    .live-dot-err { background: #ef4444 !important; animation: none !important; }

    /* Filter buttons */
    .filter-btn {
        display: inline-block;
        padding: 6px 14px;
        border-radius: var(--radius-full, 9999px);
        font-size: 13px;
        font-weight: 500;
        color: var(--gray-600, #4b5563);
        background: var(--gray-100, #f3f4f6);
        border: 1px solid transparent;
        text-decoration: none;
        transition: all 0.15s;
        cursor: pointer;
    }
    .filter-btn:hover {
        background: var(--gray-200, #e5e7eb);
        color: var(--gray-800, #1f2937);
        text-decoration: none;
    }
    .filter-btn-active {
        background: var(--primary, #3b82f6);
        color: #fff !important;
        border-color: var(--primary, #3b82f6);
    }
    .filter-btn-active:hover {
        background: #2563eb;
    }

    /* KPI Grid */
    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 28px;
    }
    .kpi-card {
        display: flex;
        align-items: flex-start;
        gap: 16px;
        padding: 20px;
        background: white;
        border-radius: var(--radius-md);
        border: 1px solid var(--gray-border);
        box-shadow: var(--shadow-card);
        transition: box-shadow 0.2s, transform 0.2s;
    }
    .kpi-card:hover {
        box-shadow: var(--shadow-md, 0 4px 12px rgba(0,0,0,0.08));
        transform: translateY(-1px);
    }
    .kpi-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .kpi-icon-green  { background: rgba(16,185,129,0.1); color: #10b981; }
