@model UserDetailViewModel
@using ByteBill_BS.ViewModels.Admin

<div class="modal-detail-body">
    <!-- User Header -->
    <div style="display: flex; align-items: center; gap: 16px; padding-bottom: 20px; border-bottom: 1px solid var(--border); margin-bottom: 20px;">
        <div class="avatar" style="width: 56px; height: 56px; background: var(--navy-light); color: var(--navy); font-weight: 700; font-size: 20px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
            @Model.Initials
        </div>
        <div style="flex: 1;">
            <h3 style="margin: 0; font-size: 18px; font-weight: 600; color: var(--text-primary);">@Model.FullName</h3>
            <div style="display: flex; align-items: center; gap: 8px; margin-top: 4px;">
                <span class="badge @Model.RoleClass">@Model.RoleName</span>
                @if (Model.IsActive)
                {
                    <span class="badge badge-success">Active</span>
                }
                else
                {
                    <span class="badge badge-muted">Inactive</span>
                }
            </div>
        </div>
        <button type="button" class="btn btn-secondary btn-sm" onclick="openAjaxModal('@Url.Action("EditModal", "Users", new { area = "Admin", id = Model.Id })', 'Edit User')">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="m18.5 2.5 2.5 2.5L12 14l-4 1 1-4 9-9.5z"></path></svg>
            Edit
        </button>
    </div>

    <!-- Quick Stats -->
    <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin-bottom: 20px;">
        <div style="background: #f8fafc; border-radius: 8px; padding: 14px; text-align: center;">
            <div style="font-size: 22px; font-weight: 700; color: var(--navy);">@Model.JobOrdersHandled</div>
            <div style="font-size: 12px; color: var(--text-muted); margin-top: 2px;">Jobs Handled</div>
        </div>
        <div style="background: #f8fafc; border-radius: 8px; padding: 14px; text-align: center;">
            <div style="font-size: 22px; font-weight: 700; color: var(--emerald);">@Model.PaymentsProcessed</div>
            <div style="font-size: 12px; color: var(--text-muted); margin-top: 2px;">Payments Processed</div>
        </div>
    </div>

    <!-- Contact Information -->
    <div class="form-section" style="margin-bottom: 16px;">
        <h4 class="form-section-title">Contact Information</h4>
        <div class="detail-grid">
            <div class="detail-item">
                <span class="detail-label">Email</span>
                <span class="detail-value">@Model.Email</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Phone</span>
                <span class="detail-value">@(Model.Phone ?? "—")</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Member Since</span>
                <span class="detail-value">@Model.CreatedAt.ToString("MMM dd, yyyy")</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Last Login</span>
                <span class="detail-value">
                    @if (Model.LastLoginAt.HasValue)
                    {
                        @Model.LastLoginAt.Value.ToString("MMM dd, yyyy h:mm tt")
                    }
                    else
                    {
                        <span class="text-muted">Never</span>
                    }
                </span>
            </div>
        </div>
    </div>

    <!-- Recent Activity -->
    @if (Model.RecentActivity.Any())
    {
        <div class="form-section">
            <h4 class="form-section-title">Recent Activity</h4>
            <div style="display: flex; flex-direction: column; gap: 0;">
                @foreach (var activity in Model.RecentActivity.Take(5))
                {
                    <div style="display: flex; align-items: flex-start; gap: 12px; padding: 10px 0; border-bottom: 1px solid #f1f5f9;">
                        <div style="min-width: 8px; height: 8px; border-radius: 50%; background: var(--navy); margin-top: 6px;"></div>
                        <div style="flex: 1;">
                            <div style="font-size: 13px; font-weight: 500; color: var(--text-primary);">@activity.Action</div>
                            <div style="font-size: 12px; color: var(--text-muted); margin-top: 2px;">@activity.Description</div>
                        </div>
                        <div style="font-size: 11px; color: var(--text-muted); white-space: nowrap;">
                            @activity.Timestamp.ToString("MMM dd, h:mm tt")
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<div class="modal-form-footer">
    <button type="button" class="btn btn-secondary" onclick="closeAjaxModal()">Close</button>
</div>
