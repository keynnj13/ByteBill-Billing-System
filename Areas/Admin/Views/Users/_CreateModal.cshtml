@model UserFormViewModel
@using ByteBill_BS.ViewModels.Admin
@using ByteBill_BS.Models.Enums

<form asp-action="Create" asp-controller="Users" asp-area="Admin" method="post"
      data-ajax="true" data-ajax-method="POST" id="createUserForm">
    @Html.AntiForgeryToken()

    <div class="modal-form-body">
        <!-- Personal Information -->
        <div class="form-section">
            <h4 class="form-section-title">Personal Information</h4>
            <div class="form-row">
                <div class="form-group" style="flex: 1;">
                    <label asp-for="FirstName" class="form-label">First Name <span class="required">*</span></label>
                    <input asp-for="FirstName" class="form-input js-name-only" placeholder="Enter first name" />
                    <span asp-validation-for="FirstName" class="field-validation-error"></span>
                </div>
                <div class="form-group" style="flex: 1;">
                    <label asp-for="MiddleName" class="form-label">Middle Name</label>
                    <input asp-for="MiddleName" class="form-input js-name-only" placeholder="Enter middle name" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-group" style="flex: 1;">
                    <label asp-for="LastName" class="form-label">Last Name <span class="required">*</span></label>
                    <input asp-for="LastName" class="form-input js-name-only" placeholder="Enter last name" />
                    <span asp-validation-for="LastName" class="field-validation-error"></span>
                </div>
                <div class="form-group" style="flex: 1;">
                    <label asp-for="Phone" class="form-label">Phone</label>
                    <input asp-for="Phone" type="tel" class="form-input js-phone-digits-only" maxlength="11" inputmode="numeric" pattern="[0-9]{11}" placeholder="09XXXXXXXXX" />
                </div>
            </div>
        </div>

        <!-- Account Information -->
        <div class="form-section">
            <h4 class="form-section-title">Account Information</h4>
            <div class="form-group">
                <label asp-for="UserName" class="form-label">Username <span class="required">*</span></label>
                <input asp-for="UserName" class="form-input" placeholder="Enter username (e.g. john.doe)" />
                <span asp-validation-for="UserName" class="field-validation-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Email" class="form-label">Email Address <span class="required">*</span></label>
                <input asp-for="Email" class="form-input" type="email" placeholder="user@company.com" />
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>
            <div class="form-row">
                <div class="form-group" style="flex: 1;">
                    <label asp-for="Role" class="form-label">Role <span class="required">*</span></label>
                    <select asp-for="Role" class="form-input">
                        <option value="">Select a role</option>
                        @foreach (var r in Enum.GetValues<UserRole>())
                        {
                            if (r != UserRole.SuperAdmin && r != UserRole.Admin)
                            {
                                <option value="@r">@r</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="Role" class="field-validation-error"></span>
                </div>
                <div class="form-group" style="flex: 1;">
                    <span class="form-label" aria-hidden="true">&nbsp;</span>
                    <label class="toggle-label" style="display: flex; align-items: center; gap: 8px; padding-top: 8px;">
                        <input type="checkbox" asp-for="IsActive" style="width: auto;" />
                        <span>Active Account</span>
                    </label>
                </div>
            </div>
        </div>

        <!-- Password -->
        <div class="form-section">
            <h4 class="form-section-title">Password</h4>
            <div class="form-row">
                <div class="form-group" style="flex: 1;">
                    <label asp-for="Password" class="form-label">Password <span class="required">*</span></label>
                    <input asp-for="Password" class="form-input" type="password" placeholder="Minimum 6 characters" />
                    <span asp-validation-for="Password" class="field-validation-error"></span>
                </div>
                <div class="form-group" style="flex: 1;">
                    <label asp-for="ConfirmPassword" class="form-label">Confirm Password <span class="required">*</span></label>
                    <input asp-for="ConfirmPassword" class="form-input" type="password" placeholder="Re-enter password" />
                    <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="modal-form-footer">
        <button type="button" class="btn btn-secondary" onclick="closeAjaxModal()">Cancel</button>
        <button type="submit" class="btn btn-primary" onclick="submitAjaxForm(event, 'createUserForm')">Create User</button>
    </div>
</form>

<script>
    (function () {
        var root = document.getElementById('createUserForm');
        if (!root) return;

        root.querySelectorAll('.js-name-only').forEach(function (input) {
            input.addEventListener('input', function () {
                var cleaned = input.value.replace(/[^A-Za-z\s]/g, '').replace(/\s{2,}/g, ' ');
                if (cleaned !== input.value) {
                    input.value = cleaned;
                }
            });
        });

        root.querySelectorAll('.js-phone-digits-only').forEach(function (input) {
            input.addEventListener('input', function () {
                var cleaned = input.value.replace(/\D/g, '').slice(0, 11);
                if (cleaned !== input.value) {
                    input.value = cleaned;
                }
            });
        });
    })();
</script>
