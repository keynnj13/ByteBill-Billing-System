@model IntegrationIndexViewModel
@using ByteBill_BS.ViewModels.Admin
@{
    ViewData["Title"] = "Integrations";
}

<partial name="~/Views/Shared/_Breadcrumbs.cshtml" model="@(new BreadcrumbViewModel { Items = new List<BreadcrumbViewModel.BreadcrumbItem> { new() { Label = "Dashboard", Url = Url.Action("Index", "Dashboard") }, new() { Label = "Integrations", IsActive = true } } })" />

<div class="ig-page-header">
    <div>
        <h1 class="ig-title">Integrations</h1>
        <p class="ig-subtitle">Manage third-party connections</p>
    </div>
</div>

<!-- Tab Navigation -->
<div class="ig-tabs no-print">
    <button class="ig-tab ig-tab-active" data-tab="xero" onclick="switchTab('xero')">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"></path><line x1="4" y1="22" x2="4" y2="15"></line></svg>
        Xero Accounting
        @if (Model.XeroConnected) { <span class="ig-tab-badge ig-badge-green">Connected</span> }
    </button>
    <button class="ig-tab" data-tab="paymongo" onclick="switchTab('paymongo')">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
        PayMongo
        @if (Model.PayMongoEnabled) { <span class="ig-tab-badge ig-badge-green">Enabled</span> }
    </button>
</div>

<!-- ═══════ XERO TAB ═══════ -->
<div class="ig-tab-panel ig-tab-panel-active" id="tab-xero">
    <!-- Xero Header -->
    <div class="card" style="margin-bottom: 20px;">
        <div class="card-body">
            <div class="ig-integration-header">
                <div class="ig-integration-info">
                    <div class="ig-icon ig-icon-blue">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"></path><line x1="4" y1="22" x2="4" y2="15"></line></svg>
                    </div>
                    <div>
                        <h3 class="ig-integration-name">Xero Accounting</h3>
                        <div class="ig-integration-meta">
                            @if (Model.XeroConnected)
                            {
                                <span class="status-indicator status-success">Connected</span>
                                <span class="ig-meta-text">Last sync: @(Model.XeroLastSyncAt?.ToString("MMM dd, h:mm tt") ?? "Never")</span>
                            }
                            else
                            {
                                <span class="status-indicator status-muted">Not Connected</span>
                            }
                        </div>
                    </div>
                </div>
                <div style="display: flex; gap: 8px; align-items: center;">
                    @if (Model.XeroConnected)
                    {
                        <form asp-action="SyncXero" method="post" style="margin: 0;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-primary btn-sm" onclick="this.disabled=true; this.innerText='Syncing...'; this.form.submit();">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"></polyline><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path></svg>
                                Sync Now
                            </button>
                        </form>
                        <form asp-action="DisconnectXero" method="post" style="margin: 0;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Disconnect from Xero? You will need to re-authorize to sync again.');">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18.36 6.64a9 9 0 1 1-12.73 0"></path><line x1="12" y1="2" x2="12" y2="12"></line></svg>
                                Disconnect
                            </button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="ConnectXero" method="post" style="margin: 0;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-primary btn-sm" onclick="this.disabled=true; this.innerText='Connecting...'; this.form.submit();">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
                                Connect Xero
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Xero Stats -->
    <div class="ig-stats ig-stats-3">
        <div class="ig-stat-card">
            <div class="ig-stat-icon ig-stat-navy">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"></polyline><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path></svg>
            </div>
            <div class="ig-stat-content">
                <span class="ig-stat-label">Total Syncs</span>
                <span class="ig-stat-value" style="color: #1e3a8a;">@Model.XeroSyncCount</span>
            </div>
        </div>
        <div class="ig-stat-card">
            <div class="ig-stat-icon ig-stat-emerald">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
            </div>
            <div class="ig-stat-content">
                <span class="ig-stat-label">Successful</span>
                <span class="ig-stat-value" style="color: #059669;">@(Model.XeroSyncCount - Model.XeroFailedCount)</span>
            </div>
        </div>
        <div class="ig-stat-card">
            <div class="ig-stat-icon ig-stat-red">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
            </div>
            <div class="ig-stat-content">
                <span class="ig-stat-label">Failed</span>
                <span class="ig-stat-value" style="color: #dc2626;">@Model.XeroFailedCount</span>
            </div>
        </div>
    </div>

    <!-- Xero Sync Log Table -->
    <div class="card">
        <div class="card-header">
            <div class="filter-form">
                <h3 class="ig-section-title" style="white-space:nowrap;margin-right:8px;">Sync Activity</h3>
                <div class="search-input-wrapper">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="search-icon"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    <input type="text" placeholder="Search by reference, Xero ID, user..." class="form-input search-input" id="xeroSearch" />
                </div>
                <select class="form-select" id="xeroTypeFilter" style="min-width:130px;">
                    <option value="">All Types</option>
                    <option value="Invoice">Invoice</option>
                    <option value="Payment">Payment</option>
                    <option value="Contact">Contact</option>
                    <option value="CreditNote">Credit Note</option>
                </select>
                <select class="form-select" id="xeroStatusFilter" style="min-width:130px;">
                    <option value="">All Statuses</option>
                    <option value="Success">Success</option>
                    <option value="Failed">Failed</option>
                    <option value="Pending">Pending</option>
                </select>
            </div>
        </div>
        <div class="card-body p-0">
            @if (Model.RecentXeroSyncs.Any())
            {
                <div class="table-container" id="xeroTableContainer">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Timestamp</th>
                                <th>Type</th>
                                <th>Reference</th>
                                <th>Status</th>
                                <th>Xero ID</th>
                                <th>Synced By</th>
                                <th>Message</th>
                            </tr>
                        </thead>
                        <tbody id="xeroTableBody">
                            @foreach (var sync in Model.RecentXeroSyncs)
                            {
                                <tr data-type="@sync.SyncType" data-status="@sync.Status"
                                    data-ref="@(sync.EntityReference?.ToLower() ?? "")"
                                    data-xeroid="@(sync.XeroRecordId?.ToLower() ?? "")"
                                    data-user="@sync.SyncedByName.ToLower()"
                                    data-msg="@(sync.Message?.ToLower() ?? "")">
                                    <td class="ig-ts">@sync.SyncedAt.ToString("MMM dd, h:mm tt")</td>
                                    <td><span class="status-indicator status-muted">@sync.SyncType</span></td>
                                    <td class="fw-medium">@(sync.EntityReference ?? "—")</td>
                                    <td><span class="status-indicator @sync.StatusClass">@sync.Status</span></td>
                                    <td class="ig-mono">@(sync.XeroRecordId != null ? sync.XeroRecordId[..Math.Min(8, sync.XeroRecordId.Length)] + "…" : "—")</td>
                                    <td class="text-muted" style="font-size: 13px;">@sync.SyncedByName</td>
                                    <td class="ig-msg" title="@sync.Message">@(sync.Message ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div id="xeroEmptyFilter" style="padding:40px 20px; text-align:center; color:#9ca3af; font-size:14px; display:none;">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#d1d5db" stroke-width="1.5" style="margin:0 auto 12px;display:block;"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    No sync records match your filters
                </div>
                <div class="pagination-bar" id="xeroPagination"></div>
            }
            else
            {
                <div style="padding:40px 20px; text-align:center; color:#9ca3af;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#d1d5db" stroke-width="1.5" style="margin:0 auto 12px;display:block;"><polyline points="23 4 23 10 17 10"></polyline><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path></svg>
                    <p style="font-size:14px;">No sync activity yet</p>
                    <p style="font-size:12px;">Click "Sync Now" to push your invoices and payments to Xero.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- ═══════ PAYMONGO TAB ═══════ -->
<div class="ig-tab-panel" id="tab-paymongo">
    <!-- PayMongo Header -->
    <div class="card" style="margin-bottom: 20px;">
        <div class="card-body">
            <div class="ig-integration-header">
                <div class="ig-integration-info">
                    <div class="ig-icon ig-icon-green">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
                    </div>
                    <div>
                        <h3 class="ig-integration-name">PayMongo</h3>
                        <div class="ig-integration-meta">
                            @if (Model.PayMongoEnabled)
                            {
                                <span class="status-indicator status-success">Enabled</span>
                            }
                            else
                            {
                                <span class="status-indicator status-muted">Disabled</span>
                            }
                        </div>
                    </div>
                </div>
                <button type="button" class="btn btn-secondary btn-sm" id="btnTestPayMongo" onclick="testPayMongoConnection()">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                    Test Connection
                </button>
            </div>
        </div>
    </div>

    <!-- PayMongo Configuration Panel -->
    <div class="card" style="margin-bottom: 20px;">
        <div class="card-header"><h3 class="ig-section-title">Configuration</h3></div>
        <div class="card-body">
            <div class="ig-config-grid">
                <div class="ig-config-item">
                    <span class="ig-config-label">API Key Status</span>
                    @if (Model.PayMongoHasKeys)
                    {
                        <span class="status-indicator status-success">Configured @(Model.PayMongoKeyLastFour != null ? $"({Model.PayMongoKeyLastFour})" : "")</span>
                    }
                    else
                    {
                        <span class="status-indicator status-danger">Not Configured</span>
                    }
                </div>
                <div class="ig-config-item">
                    <span class="ig-config-label">Webhook URL</span>
                    <div class="ig-config-copy">
                        <code class="ig-mono" id="webhookUrl">@Model.PayMongoWebhookUrl</code>
                        <button type="button" class="btn btn-ghost btn-sm" onclick="copyWebhookUrl()" title="Copy to clipboard">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                        </button>
                    </div>
                </div>
                <div class="ig-config-item">
                    <span class="ig-config-label">Supported Methods</span>
                    <div style="display:flex;gap:6px;flex-wrap:wrap;">
                        <span class="ig-method-badge">GCash</span>
                        <span class="ig-method-badge">Card</span>
                        <span class="ig-method-badge">GrabPay</span>
                        <span class="ig-method-badge">PayMaya</span>
                    </div>
                </div>
                <div class="ig-config-item">
                    <span class="ig-config-label">Currency</span>
                    <span class="fw-medium">PHP (₱)</span>
                </div>
            </div>
        </div>
    </div>

    <!-- PayMongo Stats -->
    <div class="ig-stats ig-stats-3">
        <div class="ig-stat-card">
            <div class="ig-stat-icon ig-stat-navy">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
            </div>
            <div class="ig-stat-content">
                <span class="ig-stat-label">Transactions</span>
                <span class="ig-stat-value" style="color: #1e3a8a;">@Model.PayMongoTransactions</span>
            </div>
        </div>
        <div class="ig-stat-card">
            <div class="ig-stat-icon ig-stat-emerald">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
            </div>
            <div class="ig-stat-content">
                <span class="ig-stat-label">Total Processed</span>
                <span class="ig-stat-value" style="color: #059669;">₱@Model.PayMongoTotalAmount.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</span>
            </div>
        </div>
        <div class="ig-stat-card">
            <div class="ig-stat-icon" style="background: rgba(59,130,246,0.08); color: #3b82f6;">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
            </div>
            <div class="ig-stat-content">
                <span class="ig-stat-label">Connection</span>
                <span class="ig-stat-value" id="pmConnectionStatus" style="color: @(Model.PayMongoHasKeys ? "#059669" : "#dc2626"); font-size:14px;">
                    @(Model.PayMongoHasKeys ? "Keys Configured" : "Not Configured")
                </span>
            </div>
        </div>
    </div>

    <!-- PayMongo Transaction Table -->
    <div class="card">
        <div class="card-header">
            <div class="filter-form">
                <h3 class="ig-section-title" style="white-space:nowrap;margin-right:8px;">Transactions</h3>
                <div class="search-input-wrapper">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="search-icon"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    <input type="text" placeholder="Search by PayMongo ID, customer, invoice..." class="form-input search-input" id="pmSearch" />
                </div>
                <select class="form-select" id="pmTypeFilter" style="min-width:130px;">
                    <option value="">All Types</option>
                    <option value="Payment">Payment</option>
                    <option value="Checkout">Checkout</option>
                    <option value="Refund">Refund</option>
                </select>
                <select class="form-select" id="pmStatusFilter" style="min-width:130px;">
                    <option value="">All Statuses</option>
                    <option value="Paid">Paid</option>
                    <option value="Pending">Pending</option>
                    <option value="Failed">Failed</option>
                    <option value="Refunded">Refunded</option>
                </select>
            </div>
        </div>
        <div class="card-body p-0">
            @if (Model.RecentPayMongoTxns.Any())
            {
                <div class="table-container" id="pmTableContainer">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>PayMongo ID</th>
                                <th>Type</th>
                                <th>Customer</th>
                                <th>Invoice</th>
                                <th class="text-right">Amount</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody id="pmTableBody">
                            @foreach (var txn in Model.RecentPayMongoTxns)
                            {
                                <tr class="clickable-row" onclick="showTxnDetail(@txn.Id)" style="cursor:pointer;"
                                    data-pmid="@txn.PayMongoId.ToLower()"
                                    data-type="@txn.Type"
                                    data-status="@txn.Status"
                                    data-customer="@(txn.CustomerName?.ToLower() ?? "")"
                                    data-invoice="@(txn.InvoiceNo?.ToLower() ?? "")">
                                    <td class="ig-ts">@txn.CreatedAt.ToString("MMM dd, h:mm tt")</td>
                                    <td class="ig-mono">@txn.PayMongoId</td>
                                    <td><span class="status-indicator status-muted">@txn.Type</span></td>
                                    <td class="fw-medium">@(txn.CustomerName ?? "—")</td>
                                    <td class="text-muted">@(txn.InvoiceNo ?? "—")</td>
                                    <td class="text-right fw-medium">₱@txn.Amount.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</td>
                                    <td><span class="status-indicator @txn.StatusClass">@txn.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div id="pmEmptyFilter" style="padding:40px 20px; text-align:center; color:#9ca3af; font-size:14px; display:none;">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#d1d5db" stroke-width="1.5" style="margin:0 auto 12px;display:block;"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    No transactions match your filters
                </div>
                <div class="pagination-bar" id="pmPagination"></div>
            }
            else
            {
                <div style="padding:40px 20px; text-align:center; color:#9ca3af;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#d1d5db" stroke-width="1.5" style="margin:0 auto 12px;display:block;"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
                    <p style="font-size:14px;">No PayMongo transactions yet</p>
                    <p style="font-size:12px;">Transactions will appear here once customers pay via PayMongo links or checkout sessions.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- PayMongo Transaction Detail Modal -->
<div class="modal-overlay" id="pmDetailModal" style="display:none;">
    <div class="modal-container" style="max-width:520px;">
        <div class="modal-header">
            <h3 class="modal-title">Transaction Details</h3>
            <button type="button" class="modal-close" onclick="closePmModal()">&times;</button>
        </div>
        <div class="modal-body" id="pmDetailBody">
            <div style="text-align:center;padding:30px;color:#9ca3af;">Loading...</div>
        </div>
    </div>
</div>

<script>
function switchTab(tab) {
    document.querySelectorAll('.ig-tab').forEach(t => t.classList.remove('ig-tab-active'));
    document.querySelector('[data-tab="' + tab + '"]').classList.add('ig-tab-active');
    document.querySelectorAll('.ig-tab-panel').forEach(p => p.classList.remove('ig-tab-panel-active'));
    document.getElementById('tab-' + tab).classList.add('ig-tab-panel-active');
}

function copyWebhookUrl() {
    var url = document.getElementById('webhookUrl').textContent;
    navigator.clipboard.writeText(url).then(function() {
        if (typeof Toast !== 'undefined') Toast.success('Webhook URL copied!');
    });
}

function testPayMongoConnection() {
    var btn = document.getElementById('btnTestPayMongo');
    btn.disabled = true;
    btn.innerHTML = '<svg class="spin" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 11-6.219-8.56"></path></svg> Testing...';
    var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value
             || document.querySelector('meta[name="csrf-token"]')?.content || '';
    fetch('@Url.Action("TestPayMongoConnection", "Integrations", new { area = "Admin" })', {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token, 'Content-Type': 'application/json' }
    })
    .then(r => r.json())
    .then(data => {
        btn.disabled = false;
        btn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg> Test Connection';
        if (data.success) { if (typeof Toast !== 'undefined') Toast.success(data.message); }
        else { if (typeof Toast !== 'undefined') Toast.error(data.message); }
    })
    .catch(() => { btn.disabled = false; btn.innerHTML = 'Test Connection'; if (typeof Toast !== 'undefined') Toast.error('Connection test failed.'); });
}

function showTxnDetail(id) {
    document.getElementById('pmDetailModal').style.display = 'flex';
    document.getElementById('pmDetailBody').innerHTML = '<div style="text-align:center;padding:30px;color:#9ca3af;">Loading...</div>';
    fetch('@Url.Action("PayMongoTxnDetail", "Integrations", new { area = "Admin" })?id=' + id)
    .then(r => r.json())
    .then(data => {
        var statusColor = data.payMongoStatus === 'paid' ? '#059669' : data.payMongoStatus === 'failed' ? '#dc2626' : '#d97706';
        document.getElementById('pmDetailBody').innerHTML = '<div class="ig-detail-grid">'
            + '<div class="ig-detail-row"><span class="ig-detail-label">PayMongo ID</span><span class="ig-mono">' + data.payMongoPaymentIntentId + '</span></div>'
            + '<div class="ig-detail-row"><span class="ig-detail-label">Type</span><span>' + data.resourceType + '</span></div>'
            + '<div class="ig-detail-row"><span class="ig-detail-label">Status</span><span style="color:' + statusColor + ';font-weight:600;">' + data.payMongoStatus + '</span></div>'
            + '<div class="ig-detail-row"><span class="ig-detail-label">Amount</span><span class="fw-medium">₱' + data.amount.toFixed(2) + '</span></div>'
            + '<div class="ig-detail-row"><span class="ig-detail-label">Payment Method</span><span>' + (data.payMongoPaymentMethod || '—') + '</span></div>'
            + '<div class="ig-detail-row"><span class="ig-detail-label">Customer</span><span>' + (data.customerName || '—') + '</span></div>'
            + '<div class="ig-detail-row"><span class="ig-detail-label">Invoice</span><span>' + (data.invoiceNo || '—') + '</span></div>'
            + '<div class="ig-detail-row"><span class="ig-detail-label">Payment Record</span><span>' + (data.paymentNo || '—') + '</span></div>'
            + '<div class="ig-detail-row"><span class="ig-detail-label">Created</span><span>' + new Date(data.createdAt).toLocaleString() + '</span></div>'
            + (data.updatedAt ? '<div class="ig-detail-row"><span class="ig-detail-label">Updated</span><span>' + new Date(data.updatedAt).toLocaleString() + '</span></div>' : '')
            + (data.checkoutUrl ? '<div class="ig-detail-row"><span class="ig-detail-label">Checkout URL</span><a href="' + data.checkoutUrl + '" target="_blank" class="ig-mono" style="font-size:11px;word-break:break-all;">Open Link →</a></div>' : '')
            + '</div>';
    })
    .catch(() => { document.getElementById('pmDetailBody').innerHTML = '<div style="text-align:center;padding:20px;color:#dc2626;">Failed to load details.</div>'; });
}

function closePmModal() { document.getElementById('pmDetailModal').style.display = 'none'; }
document.getElementById('pmDetailModal').addEventListener('click', function(e) { if (e.target === this) closePmModal(); });

// ═══════════════════════════════════════════════════════════════
//  Reusable client-side search / filter / pagination engine
// ═══════════════════════════════════════════════════════════════
function createTableEngine(cfg) {
    var rows = Array.from(document.querySelectorAll(cfg.rowSelector));
    var container = document.getElementById(cfg.containerId);
    var emptyEl = document.getElementById(cfg.emptyId);
    var pagEl = document.getElementById(cfg.paginationId);
    var PAGE_SIZE = 15;
    var currentPage = 1;
    var filtered = [];

    function applyFilters() {
        var q = (cfg.searchEl ? cfg.searchEl.value : '').toLowerCase().trim();
        filtered = rows.filter(function(row) {
            // Check search
            if (q) {
                var searchable = cfg.searchFields.map(function(f) { return row.dataset[f] || ''; }).join(' ');
                if (searchable.indexOf(q) === -1) return false;
            }
            // Check filters
            for (var i = 0; i < cfg.filters.length; i++) {
                var fv = cfg.filters[i].el.value;
                if (fv && row.dataset[cfg.filters[i].field] !== fv) return false;
            }
            return true;
        });
        currentPage = 1;
        render();
    }

    function render() {
        var total = filtered.length;
        var totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
        if (currentPage > totalPages) currentPage = totalPages;
        var start = (currentPage - 1) * PAGE_SIZE;
        var end = start + PAGE_SIZE;

        rows.forEach(function(r) { r.style.display = 'none'; });
        for (var i = start; i < end && i < filtered.length; i++) {
            filtered[i].style.display = '';
        }

        if (container) container.style.display = total === 0 && rows.length > 0 ? 'none' : '';
        if (emptyEl) emptyEl.style.display = total === 0 && rows.length > 0 ? 'block' : 'none';

        // Render pagination
        if (pagEl) {
            if (totalPages <= 1) { pagEl.innerHTML = ''; return; }
            var html = '<div class="ig-pag">';
            html += '<span class="ig-pag-info">Showing ' + (total > 0 ? start + 1 : 0) + '–' + Math.min(end, total) + ' of ' + total + '</span>';
            html += '<div class="ig-pag-btns">';
            html += '<button class="ig-pag-btn" ' + (currentPage <= 1 ? 'disabled' : '') + ' onclick="window.__igNav_' + cfg.id + '(' + (currentPage - 1) + ')">&laquo;</button>';
            var range = pagRange(currentPage, totalPages);
            for (var p = 0; p < range.length; p++) {
                if (range[p] === '...') {
                    html += '<span class="ig-pag-dots">…</span>';
                } else {
                    html += '<button class="ig-pag-btn' + (range[p] === currentPage ? ' ig-pag-active' : '') + '" onclick="window.__igNav_' + cfg.id + '(' + range[p] + ')">' + range[p] + '</button>';
                }
            }
            html += '<button class="ig-pag-btn" ' + (currentPage >= totalPages ? 'disabled' : '') + ' onclick="window.__igNav_' + cfg.id + '(' + (currentPage + 1) + ')">&raquo;</button>';
            html += '</div></div>';
            pagEl.innerHTML = html;
        }
    }

    function pagRange(cur, tot) {
        if (tot <= 7) { var r = []; for (var i = 1; i <= tot; i++) r.push(i); return r; }
        if (cur <= 3) return [1, 2, 3, 4, '...', tot];
        if (cur >= tot - 2) return [1, '...', tot - 3, tot - 2, tot - 1, tot];
        return [1, '...', cur - 1, cur, cur + 1, '...', tot];
    }

    window['__igNav_' + cfg.id] = function(page) { currentPage = page; render(); };

    // Bind events
    if (cfg.searchEl) cfg.searchEl.addEventListener('input', applyFilters);
    cfg.filters.forEach(function(f) { f.el.addEventListener('change', applyFilters); });

    applyFilters();
}

// ─── Xero Sync Table ───
(function() {
    var searchEl = document.getElementById('xeroSearch');
    var typeEl = document.getElementById('xeroTypeFilter');
    var statusEl = document.getElementById('xeroStatusFilter');
    if (!searchEl) return;
    createTableEngine({
        id: 'xero',
        rowSelector: '#xeroTableBody tr',
        containerId: 'xeroTableContainer',
        emptyId: 'xeroEmptyFilter',
        paginationId: 'xeroPagination',
        searchEl: searchEl,
        searchFields: ['ref', 'xeroid', 'user', 'msg'],
        filters: [
            { el: typeEl, field: 'type' },
            { el: statusEl, field: 'status' }
        ]
    });
})();

