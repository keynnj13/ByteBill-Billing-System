@model PaymentDetailViewModel
@{
    ViewData["Title"] = "Payment Details";
}

<partial name="~/Views/Shared/_Breadcrumbs.cshtml" model="@(new BreadcrumbViewModel { Items = new List<BreadcrumbViewModel.BreadcrumbItem> { new() { Label = "Dashboard", Url = Url.Action("Index", "Dashboard") }, new() { Label = "Payments", Url = Url.Action("Index", "Payments") }, new() { Label = "Payment Details", IsActive = true } } })" />

<div class="page-header">
    <div>
        <h1 class="page-title">Payment Details</h1>
        <p class="page-subtitle">@Model.PaymentNumber — @(Model.InvoiceNumber ?? "—")</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        Back to Payments
    </a>
</div>

<div class="detail-layout">
    <div class="detail-main">
        <!-- Payment Info -->
        <div class="card">
            <div class="card-header-section">
                <div class="header-flex">
                    <h2 class="section-title">Payment Information</h2>
                    @if (Model.IsVoid)
                    {
                        <span class="status-indicator status-muted">VOID</span>
                    }
                    else
                    {
                        <span class="status-indicator status-success">Completed</span>
                    }
                </div>
            </div>
            <div class="card-body">
                <div class="info-grid">
                    <div class="info-item">
                        <span class="info-label">Amount</span>
                        <span class="info-value amount-highlight">₱@Model.Amount.ToString("N2")</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Method</span>
                        <span class="info-value">
                            <span class="method-badge method-@Model.Method.ToString().ToLower()">@Model.MethodDisplay</span>
                        </span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Date</span>
                        <span class="info-value">@Model.PaymentDate.ToString("MMMM dd, yyyy")</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Reference No.</span>
                        <span class="info-value">@(Model.ReferenceNo ?? "—")</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Received By</span>
                        <span class="info-value">@(Model.ReceivedByName ?? "—")</span>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <div class="notes-section">
                        <span class="info-label">Notes</span>
                        <p class="notes-text">@Model.Notes</p>
                    </div>
                }
            </div>
        </div>

        <!-- Customer Info -->
        <div class="card">
            <div class="card-header-section">
                <h2 class="section-title">Customer</h2>
            </div>
            <div class="card-body">
                <div class="customer-row">
                    <div class="avatar-md">@(Model.CustomerName.Length >= 2 ? Model.CustomerName[..2].ToUpper() : "?")</div>
                    <div>
                        <div class="customer-name">@Model.CustomerName</div>
                        <div class="customer-contact">
                            @if (!string.IsNullOrWhiteSpace(Model.CustomerEmail))
                            {
                                <span>@Model.CustomerEmail</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.CustomerPhone))
                            {
                                <span> · @Model.CustomerPhone</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Allocations -->
        @if (Model.Allocations.Any())
        {
            <div class="card">
                <div class="card-header-section">
                    <h2 class="section-title">Payment Allocations</h2>
                </div>
                <div class="card-body p-0">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Invoice</th>
                                <th class="text-right">Amount Applied</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var alloc in Model.Allocations)
                            {
                                <tr>
                                    <td>
                                        <a asp-action="Details" asp-controller="Invoices" asp-route-id="@alloc.InvoiceId" class="text-primary font-medium">
                                            @alloc.InvoiceNumber
                                        </a>
                                    </td>
                                    <td class="text-right font-medium">₱@alloc.AmountApplied.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td class="font-medium">Total Applied</td>
                                <td class="text-right font-bold">₱@Model.Allocations.Sum(a => a.AmountApplied).ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        }
    </div>

    <!-- Sidebar -->
    <div class="detail-sidebar">
        <div class="card">
            <div class="card-header-section">
                <h2 class="section-title">Quick Info</h2>
            </div>
            <div class="card-body">
                <div class="sidebar-item">
                    <span class="sidebar-label">Invoice</span>
                    @if (Model.InvoiceId.HasValue)
                    {
                        <a asp-action="Details" asp-controller="Invoices" asp-route-id="@Model.InvoiceId" class="sidebar-link">@Model.InvoiceNumber</a>
                    }
                    else
                    {
                        <span class="sidebar-value">—</span>
                    }
                </div>
                <div class="sidebar-item">
                    <span class="sidebar-label">Amount</span>
                    <span class="sidebar-value font-bold">₱@Model.Amount.ToString("N2")</span>
                </div>
                <div class="sidebar-item">
                    <span class="sidebar-label">Method</span>
                    <span class="sidebar-value">@Model.MethodDisplay</span>
                </div>
                <div class="sidebar-item">
                    <span class="sidebar-label">Date</span>
                    <span class="sidebar-value">@Model.PaymentDate.ToString("MMM dd, yyyy")</span>
                </div>
                <div class="sidebar-item">
                    <span class="sidebar-label">Status</span>
                    <span class="sidebar-value">
                        @if (Model.IsVoid)
                        {
                            <span class="status-indicator status-muted">Void</span>
                        }
                        else
                        {
                            <span class="status-indicator status-success">Completed</span>
                        }
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .page-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px; }
    .page-title { font-size: 24px; font-weight: 700; color: var(--text-primary, #1f2937); margin-bottom: 4px; }
    .page-subtitle { font-size: 14px; color: var(--text-secondary, #6b7280); }
    .detail-layout { display: grid; grid-template-columns: 1fr 320px; gap: 24px; align-items: start; }
    .detail-main { display: flex; flex-direction: column; gap: 20px; }
    .detail-sidebar { display: flex; flex-direction: column; gap: 20px; }
    .card-header-section { padding: 16px 20px; border-bottom: 1px solid var(--border-primary, #f3f4f6); }
    .header-flex { display: flex; justify-content: space-between; align-items: center; }
    .section-title { font-size: 15px; font-weight: 600; color: var(--text-primary, #374151); margin: 0; }
    .info-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .info-item { display: flex; flex-direction: column; gap: 4px; }
    .info-label { font-size: 12px; color: var(--text-muted, #9ca3af); font-weight: 500; text-transform: uppercase; letter-spacing: 0.05em; }
    .info-value { font-size: 14px; color: var(--text-primary, #1f2937); font-weight: 500; }
    .amount-highlight { font-size: 20px; font-weight: 700; color: var(--text-primary, #1f2937); }
    .notes-section { margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--border-primary, #f3f4f6); }
    .notes-text { font-size: 14px; color: var(--text-secondary, #6b7280); margin-top: 6px; line-height: 1.5; }
    .customer-row { display: flex; align-items: center; gap: 14px; }
    .avatar-md { width: 42px; height: 42px; border-radius: 50%; background: var(--navy, #1e3a5f); color: white; display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 600; flex-shrink: 0; }
    .customer-name { font-size: 15px; font-weight: 600; color: var(--text-primary, #1f2937); }
    .customer-contact { font-size: 13px; color: var(--text-muted, #9ca3af); }
    .font-medium { font-weight: 500; }
    .font-bold { font-weight: 700; }
    .text-primary { color: #3b82f6; text-decoration: none; }
    .text-primary:hover { text-decoration: underline; }
    .sidebar-item { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid var(--border-primary, #f3f4f6); }
    .sidebar-item:last-child { border-bottom: none; }
    .sidebar-label { font-size: 13px; color: var(--text-muted, #9ca3af); }
    .sidebar-value { font-size: 14px; color: var(--text-primary, #1f2937); }
    .sidebar-link { font-size: 14px; color: #3b82f6; text-decoration: none; font-weight: 500; }
    .sidebar-link:hover { text-decoration: underline; }
    .method-badge { font-size: 12px; padding: 3px 10px; border-radius: 99px; font-weight: 500; }
    .method-cash { background: #ecfdf5; color: #059669; }
    .method-gcash { background: #eff6ff; color: #2563eb; }
    .method-card { background: #faf5ff; color: #7c3aed; }
    .method-banktransfer { background: #fefce8; color: #ca8a04; }

    @@media (max-width: 1024px) { .detail-layout { grid-template-columns: 1fr; } }
    @@media (max-width: 768px) { .page-header { flex-direction: column; gap: 12px; } .info-grid { grid-template-columns: 1fr 1fr; } }
</style>
