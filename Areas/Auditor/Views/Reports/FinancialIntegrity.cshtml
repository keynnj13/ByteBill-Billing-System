@model FinancialIntegrityReportViewModel
@{
    ViewData["Title"] = "Financial Integrity Report";
}

<partial name="~/Views/Shared/_Breadcrumbs.cshtml" model="@(new BreadcrumbViewModel { Items = new List<BreadcrumbViewModel.BreadcrumbItem> { new() { Label = "Dashboard", Url = Url.Action("Index", "Dashboard") }, new() { Label = "Reports", Url = Url.Action("Index", "Reports") }, new() { Label = "Financial Integrity", IsActive = true } } })" />

<div class="page-header" style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:20px;">
    <div>
        <h1 class="page-title">Financial Integrity Report</h1>
        <p class="page-subtitle">@Model.DateRange</p>
    </div>
    <div style="display:flex; gap:10px; align-items:center;">
        <a href="@Url.Action("Index", "Reports")" class="btn btn-ghost" style="display:inline-flex; align-items:center; gap:6px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
            Back
        </a>
        <a href="@Url.Action("ExportFinancialIntegrityPdf", new { range = Context.Request.Query["range"], from = Context.Request.Query["from"], to = Context.Request.Query["to"] })" class="btn btn-primary" style="display:inline-flex; align-items:center; gap:6px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Export PDF
        </a>
    </div>
</div>

<partial name="_DateRangeFilter" />

<div class="rpt-stats" style="grid-template-columns: repeat(4, 1fr);">
    <div class="rpt-stat"><span class="rpt-stat-label">Total Discounts</span><span class="rpt-stat-value">₱@Model.TotalDiscounts.ToString("N2")</span></div>
    <div class="rpt-stat"><span class="rpt-stat-label">Total Refunds</span><span class="rpt-stat-value">₱@Model.TotalRefunds.ToString("N2")</span></div>
    <div class="rpt-stat"><span class="rpt-stat-label">Total Credits</span><span class="rpt-stat-value">₱@Model.TotalCredits.ToString("N2")</span></div>
    <div class="rpt-stat"><span class="rpt-stat-label">Total Debits</span><span class="rpt-stat-value">₱@Model.TotalDebits.ToString("N2")</span></div>
</div>

<div class="rpt-stats" style="grid-template-columns: repeat(3, 1fr); margin-top:-8px;">
    <div class="rpt-stat"><span class="rpt-stat-label">Net Adjustment</span><span class="rpt-stat-value">₱@Model.NetAdjustments.ToString("N2")</span></div>
    <div class="rpt-stat"><span class="rpt-stat-label">Voided Invoices</span><span class="rpt-stat-value" style="color:#ef4444;">@Model.VoidedInvoiceCount</span></div>
    <div class="rpt-stat"><span class="rpt-stat-label">Voided Payments</span><span class="rpt-stat-value" style="color:#ef4444;">@Model.VoidedPaymentCount</span></div>
</div>

<!-- Adjustments -->
<div class="card" style="margin-bottom:20px;">
    <div class="card-header"><h3 style="font-size:15px; font-weight:600; margin:0;">Adjustments</h3></div>
    <div class="card-body p-0">
        <div class="table-container">
            <table class="table">
                <thead><tr><th>Date</th><th>Invoice</th><th>Type</th><th class="text-right">Amount</th><th>Reason</th><th>Status</th></tr></thead>
                <tbody>
                    @foreach (var a in Model.Adjustments)
                    {
                        string typeCls = a.Type switch { "Discount" => "color:#8b5cf6;", "Refund" => "color:#ef4444;", "Credit" => "color:#3b82f6;", "Debit" => "color:#f59e0b;", _ => "" };
                        string statusCls = a.Status switch { "Approved" => "color:#10b981;", "Pending" => "color:#f59e0b;", "Rejected" => "color:#ef4444;", _ => "" };
                        <tr>
                            <td>@a.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td style="font-weight:500;">@a.InvoiceNo</td>
                            <td><span style="@typeCls font-weight:500;">@a.Type</span></td>
                            <td class="text-right">₱@a.Amount.ToString("N2")</td>
                            <td style="max-width:200px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@a.Reason</td>
                            <td><span style="@statusCls font-weight:500;">@a.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (!Model.Adjustments.Any())
        {
            <div class="text-center py-4" style="color: var(--text-muted, #9ca3af); font-size: 14px;">No adjustments found in this period.</div>
        }
    </div>
</div>

<!-- Voided Invoices -->
<div class="card" style="margin-bottom:20px;">
    <div class="card-header"><h3 style="font-size:15px; font-weight:600; margin:0;">Voided Invoices</h3></div>
    <div class="card-body p-0">
        <div class="table-container">
            <table class="table">
                <thead><tr><th>Date</th><th>Invoice #</th><th>Customer</th><th class="text-right">Amount</th></tr></thead>
                <tbody>
                    @foreach (var v in Model.VoidedInvoices)
                    {
                        <tr>
                            <td>@v.Date.ToString("MMM dd, yyyy")</td>
                            <td style="font-weight:500;">@v.ReferenceNo</td>
                            <td>@v.Customer</td>
                            <td class="text-right">₱@v.Amount.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (!Model.VoidedInvoices.Any())
        {
            <div class="text-center py-4" style="color: var(--text-muted, #9ca3af); font-size: 14px;">No voided invoices found in this period.</div>
        }
    </div>
</div>

<!-- Voided Payments -->
<div class="card">
    <div class="card-header"><h3 style="font-size:15px; font-weight:600; margin:0;">Voided Payments</h3></div>
    <div class="card-body p-0">
        <div class="table-container">
            <table class="table">
                <thead><tr><th>Date</th><th>Payment #</th><th>Customer</th><th class="text-right">Amount</th></tr></thead>
                <tbody>
                    @foreach (var v in Model.VoidedPayments)
                    {
                        <tr>
                            <td>@v.Date.ToString("MMM dd, yyyy")</td>
                            <td style="font-weight:500;">@v.ReferenceNo</td>
                            <td>@v.Customer</td>
                            <td class="text-right">₱@v.Amount.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (!Model.VoidedPayments.Any())
        {
            <div class="text-center py-4" style="color: var(--text-muted, #9ca3af); font-size: 14px;">No voided payments found in this period.</div>
        }
    </div>
</div>

<style>
    .page-title { font-size: 24px; font-weight: 700; color: var(--text-primary, #1f2937); margin-bottom: 4px; }
    .page-subtitle { font-size: 14px; color: var(--text-secondary, #6b7280); }
    .rpt-stats { display: grid; gap: 16px; margin-bottom: 24px; }
    .rpt-stat { text-align: center; padding: 16px; background: var(--bg-primary, white); border-radius: 10px; border: 1px solid var(--border-primary, #e5e7eb); }
    .rpt-stat-label { display: block; font-size: 12px; color: var(--text-muted, #9ca3af); font-weight: 500; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 6px; }
    .rpt-stat-value { display: block; font-size: 22px; font-weight: 700; color: var(--text-primary, #1f2937); }
</style>
