@model PaymentCashFlowReportViewModel
@{
    ViewData["Title"] = "Payment & Cash Flow Report";
}

<partial name="~/Views/Shared/_Breadcrumbs.cshtml" model="@(new BreadcrumbViewModel { Items = new List<BreadcrumbViewModel.BreadcrumbItem> { new() { Label = "Dashboard", Url = Url.Action("Index", "Dashboard") }, new() { Label = "Reports", Url = Url.Action("Index", "Reports") }, new() { Label = "Payment & Cash Flow", IsActive = true } } })" />

<div class="page-header" style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:20px;">
    <div>
        <h1 class="page-title">Payment & Cash Flow Report</h1>
        <p class="page-subtitle">@Model.DateRange</p>
    </div>
    <a href="@Url.Action("ExportPaymentCashFlowPdf", new { range = Context.Request.Query["range"], from = Context.Request.Query["from"], to = Context.Request.Query["to"] })" class="btn btn-primary" style="display:inline-flex; align-items:center; gap:6px;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Export PDF
    </a>
</div>

<partial name="_DateRangeFilter" />

<div class="rpt-stats">
    <div class="rpt-stat"><span class="rpt-stat-label">Total Received</span><span class="rpt-stat-value" style="color:#10b981;">₱@Model.TotalReceived.ToString("N2")</span></div>
    <div class="rpt-stat"><span class="rpt-stat-label">Refunds</span><span class="rpt-stat-value" style="color:#ef4444;">₱@Model.TotalRefunds.ToString("N2")</span></div>
    <div class="rpt-stat"><span class="rpt-stat-label">Net Cash Flow</span><span class="rpt-stat-value">₱@Model.NetCashFlow.ToString("N2")</span></div>
    <div class="rpt-stat"><span class="rpt-stat-label">Transactions</span><span class="rpt-stat-value">@Model.TransactionCount</span></div>
    <div class="rpt-stat"><span class="rpt-stat-label">Average</span><span class="rpt-stat-value">₱@Model.AveragePayment.ToString("N2")</span></div>
</div>

<!-- Payment Methods -->
<div class="card" style="margin-bottom:20px;">
    <div class="card-header"><h3 style="font-size:15px; font-weight:600; margin:0;">Payment Method Breakdown</h3></div>
    <div class="card-body p-0">
        <div class="table-container">
            <table class="table">
                <thead><tr><th>Method</th><th class="text-right">Amount</th><th class="text-center">Count</th><th class="text-right">%</th></tr></thead>
                <tbody>
                    @foreach (var m in Model.MethodBreakdown)
                    {
                        <tr><td style="font-weight:500;">@m.Method</td><td class="text-right">₱@m.Amount.ToString("N2")</td><td class="text-center">@m.Count</td><td class="text-right">@m.Percentage%</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Daily Trend -->
<div class="card">
    <div class="card-header"><h3 style="font-size:15px; font-weight:600; margin:0;">Daily Cash Flow Trend</h3></div>
    <div class="card-body p-0">
        <div class="table-container">
            <table class="table">
                <thead><tr><th>Date</th><th class="text-right">Received</th><th class="text-center">Transactions</th></tr></thead>
                <tbody>
                    @foreach (var d in Model.DailyTrend)
                    {
                        <tr><td style="font-weight:500;">@d.Date.ToString("MMM d, yyyy")</td><td class="text-right" style="color:#10b981;">₱@d.Received.ToString("N2")</td><td class="text-center">@d.Count</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .page-title { font-size: 24px; font-weight: 700; color: var(--text-primary, #1f2937); margin-bottom: 4px; }
    .page-subtitle { font-size: 14px; color: var(--text-secondary, #6b7280); }
    .rpt-stats { display: grid; grid-template-columns: repeat(5, 1fr); gap: 16px; margin-bottom: 24px; }
    .rpt-stat { text-align: center; padding: 16px; background: var(--bg-primary, white); border-radius: 10px; border: 1px solid var(--border-primary, #e5e7eb); }
    .rpt-stat-label { display: block; font-size: 12px; color: var(--text-muted, #9ca3af); font-weight: 500; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 6px; }
    .rpt-stat-value { display: block; font-size: 22px; font-weight: 700; color: var(--text-primary, #1f2937); }
    @@media (max-width: 768px) { .rpt-stats { grid-template-columns: repeat(2, 1fr); } }
</style>
