@model DashboardViewModel
@{
    ViewData["Title"] = "Auditor Dashboard";
    var maxChart = Model.RevenueChart.Any() ? Model.RevenueChart.Max(c => c.Value) : 1;
    if (maxChart == 0) maxChart = 1;
    var totalStatusCount = (int)(ViewBag.PaidCount ?? 0) + (int)(ViewBag.UnpaidCount ?? 0) + (int)(ViewBag.PartialCount ?? 0) + (int)(ViewBag.VoidCount ?? 0);
    if (totalStatusCount == 0) totalStatusCount = 1;
}

<partial name="~/Views/Shared/_Breadcrumbs.cshtml" model="@(new BreadcrumbViewModel { Items = new List<BreadcrumbViewModel.BreadcrumbItem> { new() { Label = "Dashboard", IsActive = true } } })" />

<div class="page-header">
    <div>
        <h1 class="page-title">Audit Dashboard</h1>
        <p class="page-subtitle">Financial overview &amp; audit trail</p>
    </div>
</div>

@{
    string PeriodLabel(string baseName) => Model.ActivePeriod switch
    {
        "all"     => $"Total {baseName}",
        "today"   => $"{baseName} Today",
        "week"    => $"{baseName} This Week",
        "month"   => $"{baseName} MTD",
        "last30"  => $"{baseName} (Last 30 Days)",
        "last3mo" => $"{baseName} (Last 3 Months)",
        "custom"  => Model.FilterFrom.HasValue && Model.FilterTo.HasValue
                     ? $"{baseName} ({Model.FilterFrom.Value:MMM d} – {Model.FilterTo.Value:MMM d})"
                     : baseName,
        _         => baseName
    };
}

<!-- Date Filter -->
<div class="dash-filter" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:24px;">
    <a href="@Url.Action("Index")" class="filter-btn @(Model.ActivePeriod == "all" ? "filter-btn-active" : "")">All Time</a>
    <a href="@Url.Action("Index", new { period = "today" })" class="filter-btn @(Model.ActivePeriod == "today" ? "filter-btn-active" : "")">Today</a>
    <a href="@Url.Action("Index", new { period = "week" })" class="filter-btn @(Model.ActivePeriod == "week" ? "filter-btn-active" : "")">This Week</a>
    <a href="@Url.Action("Index", new { period = "month" })" class="filter-btn @(Model.ActivePeriod == "month" ? "filter-btn-active" : "")">This Month</a>
    <a href="@Url.Action("Index", new { period = "last30" })" class="filter-btn @(Model.ActivePeriod == "last30" ? "filter-btn-active" : "")">Last 30 Days</a>
    <a href="@Url.Action("Index", new { period = "last3mo" })" class="filter-btn @(Model.ActivePeriod == "last3mo" ? "filter-btn-active" : "")">Last 3 Months</a>
    <span style="width:1px;height:24px;background:#e5e7eb;margin:0 4px;"></span>
    <form method="get" style="display:flex;gap:6px;align-items:center;">
        <input type="hidden" name="period" value="custom" />
        <input type="date" name="from" value="@(Model.ActivePeriod == "custom" && Model.FilterFrom.HasValue ? Model.FilterFrom.Value.ToString("yyyy-MM-dd") : "")" class="form-input" style="font-size:13px;padding:6px 10px;width:150px;" />
        <span style="color:#9ca3af;font-size:13px;">to</span>
        <input type="date" name="to" value="@(Model.ActivePeriod == "custom" && Model.FilterTo.HasValue ? Model.FilterTo.Value.ToString("yyyy-MM-dd") : "")" class="form-input" style="font-size:13px;padding:6px 10px;width:150px;" />
        <button type="submit" class="btn btn-outline-primary btn-sm">Apply</button>
    </form>
</div>

<!-- ═══════ Stat Cards ═══════ -->
<div class="stats-grid">
    <div class="stat-card stat-card-emerald">
        <div class="stat-icon-wrap">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" stroke="none"><text x="12" y="18" text-anchor="middle" font-size="18" font-weight="700" font-family="sans-serif">₱</text></svg>
        </div>
        <div class="stat-content">
            <span class="stat-label" id="statRevenueLabel">@PeriodLabel("Revenue")</span>
            <span class="stat-value" id="statRevenue">₱@(((decimal)ViewBag.TotalRevenueMTD).ToString("N2"))</span>
            <span class="stat-sub">@((int)(ViewBag.PaymentCountMTD ?? 0)) payments received</span>
        </div>
    </div>
    <div class="stat-card stat-card-red">
        <div class="stat-icon-wrap">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
        </div>
        <div class="stat-content">
            <span class="stat-label">@PeriodLabel("Refunds")</span>
            <span class="stat-value" id="statRefunds">₱@(((decimal)ViewBag.TotalRefundsMTD).ToString("N2"))</span>
        </div>
    </div>
    <div class="stat-card stat-card-amber">
        <div class="stat-icon-wrap">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
        </div>
        <div class="stat-content">
            <span class="stat-label">@PeriodLabel("Adjustments")</span>
            <span class="stat-value" id="statAdj">₱@(((decimal)ViewBag.TotalAdjustmentsMTD).ToString("N2"))</span>
        </div>
    </div>
    <div class="stat-card stat-card-blue">
        <div class="stat-icon-wrap">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <div class="stat-content">
            <span class="stat-label">Outstanding</span>
            <span class="stat-value">₱@Model.OutstandingBalance.ToString("N2")</span>
            <span class="stat-sub">@Model.UnpaidInvoices unpaid · @Model.OverdueInvoices overdue</span>
        </div>
    </div>
</div>

<!-- ═══════ Charts Row ═══════ -->
<div class="charts-row">
    <!-- Revenue Chart (7-day) -->
    <div class="card chart-card">
        <div class="card-header">
            <h3 class="card-title">Revenue — Last 7 Days</h3>
        </div>
        <div class="card-body">
            <div class="bar-chart">
                @foreach (var pt in Model.RevenueChart)
                {
                    var pct = maxChart > 0 ? (double)pt.Value / (double)maxChart * 100 : 0;
                    <div class="bar-col">
                        <div class="bar-tooltip">₱@pt.Value.ToString("N0")</div>
                        <div class="bar-track">
                            <div class="bar-fill" style="height:@pct.ToString("F0")%"></div>
                        </div>
                        <span class="bar-label">@pt.Label</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Invoice Status + Collection Rate -->
    <div class="card chart-card">
        <div class="card-header">
            <h3 class=\"card-title\">Invoice Breakdown</h3>
        </div>
        <div class="card-body">
            <!-- Collection rate gauge -->
            <div class="gauge-wrap">
                <div class="gauge-ring">
                    <svg viewBox="0 0 120 120">
                        <circle cx="60" cy="60" r="52" fill="none" stroke="#e5e7eb" stroke-width="10"/>
                        <circle cx="60" cy="60" r="52" fill="none" stroke="#10b981" stroke-width="10"
                                stroke-dasharray="@( (326.7 * (double)(ViewBag.CollectionRate ?? 0) / 100).ToString("F1") ) 327"
                                stroke-linecap="round" transform="rotate(-90 60 60)" class="gauge-arc"/>
                    </svg>
                    <div class="gauge-center">
                        <span class="gauge-pct">@(((decimal)(ViewBag.CollectionRate ?? 0)).ToString("F0"))%</span>
                        <span class="gauge-lbl">Collected</span>
                    </div>
                </div>
            </div>
            <!-- Status bars -->
            <div class="status-bars">
                <div class="sbar">
                    <div class="sbar-head"><span class="sbar-dot sbar-green"></span>Paid <strong>@ViewBag.PaidCount</strong></div>
                    <div class="sbar-track"><div class="sbar-fill sbar-fill-green" style="width:@( ((int)(ViewBag.PaidCount ?? 0) * 100.0 / totalStatusCount).ToString("F0") )%"></div></div>
                </div>
                <div class="sbar">
                    <div class="sbar-head"><span class="sbar-dot sbar-blue"></span>Unpaid <strong>@ViewBag.UnpaidCount</strong></div>
                    <div class="sbar-track"><div class="sbar-fill sbar-fill-blue" style="width:@( ((int)(ViewBag.UnpaidCount ?? 0) * 100.0 / totalStatusCount).ToString("F0") )%"></div></div>
                </div>
                <div class="sbar">
                    <div class="sbar-head"><span class="sbar-dot sbar-amber"></span>Partial <strong>@ViewBag.PartialCount</strong></div>
                    <div class="sbar-track"><div class="sbar-fill sbar-fill-amber" style="width:@( ((int)(ViewBag.PartialCount ?? 0) * 100.0 / totalStatusCount).ToString("F0") )%"></div></div>
                </div>
                <div class="sbar">
                    <div class="sbar-head"><span class="sbar-dot sbar-red"></span>Void <strong>@ViewBag.VoidCount</strong></div>
                    <div class="sbar-track"><div class="sbar-fill sbar-fill-red" style="width:@( ((int)(ViewBag.VoidCount ?? 0) * 100.0 / totalStatusCount).ToString("F0") )%"></div></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ═══════ Recent Data Row ═══════ -->
<div class="data-row">
    <!-- Recent Invoices -->
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Recent Invoices</h3>
            <a asp-action="Index" asp-controller="Invoices" class="btn btn-ghost btn-sm">View All</a>
        </div>
        <div class="card-body p-0">
            @if (Model.RecentInvoices.Any())
            {
                <table class="table mini-table">
                    <thead>
                        <tr><th>Invoice</th><th>Customer</th><th class="text-right">Total</th><th class="text-right">Balance</th><th class="text-center">Status</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var inv in Model.RecentInvoices)
                        {
                            <tr class="clickable-row" onclick="window.location.href='@Url.Action("Details", "Invoices", new { area = "Auditor", id = inv.Id })'">
                                <td class="font-medium">@inv.InvoiceNumber</td>
                                <td>@inv.CustomerName</td>
                                <td class="text-right">₱@inv.Total.ToString("N2")</td>
                                <td class="text-right">₱@inv.Balance.ToString("N2")</td>
                                <td class="text-center"><span class="status-indicator @inv.StatusClass">@inv.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-center text-muted py-4">No invoices yet this period.</p>
            }
        </div>
    </div>

    <!-- Recent Payments -->
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Recent Payments</h3>
            <a asp-action="Index" asp-controller="Payments" class="btn btn-ghost btn-sm">View All</a>
        </div>
        <div class="card-body p-0">
            @if (Model.RecentPayments.Any())
            {
                <table class="table mini-table">
                    <thead>
                        <tr><th>Payment #</th><th>Customer</th><th class="text-right">Amount</th><th class="text-center">Method</th><th>Date</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var pay in Model.RecentPayments)
                        {
                            <tr class="clickable-row" onclick="window.location.href='@Url.Action("Details", "Payments", new { area = "Auditor", id = pay.Id })'">
                                <td class="font-medium">@pay.PaymentNumber</td>
                                <td>@pay.CustomerName</td>
                                <td class="text-right">₱@pay.Amount.ToString("N2")</td>
                                <td class="text-center"><span class="status-indicator status-info">@pay.Method</span></td>
                                <td style="font-size:12px;color:var(--text-muted,#9ca3af);">@pay.PaidAt.ToString("MMM d, h:mm tt")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-center text-muted py-4">No payments yet this period.</p>
            }
        </div>
    </div>
</div>

<!-- ═══════ Activity + Quick Reports ═══════ -->
<div class="data-row">
    <!-- Audit Activity -->
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Recent Audit Activity</h3>
            <a asp-action="Index" asp-controller="AuditLogs" class="btn btn-ghost btn-sm">View All Logs</a>
        </div>
        <div class="card-body p-0">
            <ul class="activity-list">
                @foreach (var activity in Model.RecentActivity)
                {
                    <li class="activity-item">
                        <div class="activity-icon activity-icon-@activity.IconColor">
                            <partial name="~/Views/Shared/_NavIcon.cshtml" model="activity.Icon" />
                        </div>
                        <div class="activity-content">
                            <p class="activity-title">@activity.Title</p>
                            <p class="activity-description">@activity.Description</p>
                        </div>
                        <span class="activity-time">@activity.TimeAgo</span>
                    </li>
                }
            </ul>
        </div>
    </div>

    <!-- Quick Reports -->
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Quick Reports</h3>
        </div>
        <div class="card-body">
            <div class="report-links">
                <a asp-action="Index" asp-controller="Reports" class="report-link">
                    <div class="report-icon rpt-emerald">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="none"><text x="12" y="18" text-anchor="middle" font-size="18" font-weight="700" font-family="sans-serif">₱</text></svg>
                    </div>
                    <div>
                        <p class="report-name">Reports Hub</p>
                        <p class="report-desc">Revenue, payments, audits &amp; more</p>
                    </div>
                    <svg class="report-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
                </a>
                <a asp-action="Index" asp-controller="Invoices" class="report-link">
                    <div class="report-icon rpt-blue">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                    </div>
                    <div>
                        <p class="report-name">All Invoices</p>
                        <p class="report-desc">Browse &amp; audit invoice records</p>
                    </div>
                    <svg class="report-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
                </a>
                <a asp-action="Index" asp-controller="Payments" class="report-link">
                    <div class="report-icon rpt-purple">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                    </div>
                    <div>
                        <p class="report-name">All Payments</p>
                        <p class="report-desc">Cash-flow &amp; payment methods</p>
                    </div>
                    <svg class="report-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
                </a>
                <a asp-action="Index" asp-controller="Adjustments" class="report-link">
                    <div class="report-icon rpt-amber">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                    </div>
                    <div>
                        <p class="report-name">Adjustments</p>
                        <p class="report-desc">Credits, debits &amp; refunds</p>
                    </div>
                    <svg class="report-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    /* ── Filter buttons ── */
    .filter-btn {
        display: inline-block;
        padding: 6px 14px;
        border-radius: 9999px;
        font-size: 13px;
        font-weight: 500;
        color: #4b5563;
        background: #f3f4f6;
        border: 1px solid transparent;
        text-decoration: none;
        transition: all 0.15s;
        cursor: pointer;
    }
    .filter-btn:hover { background: #e5e7eb; color: #1f2937; text-decoration: none; }
    .filter-btn-active { background: #3b82f6; color: #fff !important; border-color: #3b82f6; }
    .filter-btn-active:hover { background: #2563eb; }

    /* ── Page ── */
    .page-header { display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:24px; }
    .page-title { font-size:26px; font-weight:700; color:var(--text-primary,#1f2937); margin-bottom:2px; }
    .page-subtitle { font-size:14px; color:var(--text-secondary,#6b7280); }

    /* ── Stat Cards ── */
    .stats-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-bottom:24px; }
    .stat-card { position:relative; padding:20px; background:var(--bg-primary,white); border-radius:12px; border:1px solid var(--border-primary,#e5e7eb); box-shadow:0 1px 3px rgba(0,0,0,.04); transition:transform .15s,box-shadow .15s; }
    .stat-card:hover { transform:translateY(-2px); box-shadow:0 4px 12px rgba(0,0,0,.08); }
    .stat-icon-wrap { width:48px;height:48px;border-radius:12px;display:flex;align-items:center;justify-content:center;position:absolute;top:20px;right:20px; }
    .stat-card-emerald .stat-icon-wrap { background:rgba(16,185,129,.12);color:#10b981; }
    .stat-card-red .stat-icon-wrap { background:rgba(239,68,68,.12);color:#ef4444; }
    .stat-card-amber .stat-icon-wrap { background:rgba(245,158,11,.12);color:#f59e0b; }
    .stat-card-blue .stat-icon-wrap { background:rgba(59,130,246,.12);color:#3b82f6; }
    .stat-content { display:flex; flex-direction:column; min-width:0; }
    .stat-label { font-size:12px; font-weight:600; text-transform:uppercase; letter-spacing:.05em; color:var(--text-muted,#9ca3af); }
    .stat-value { font-size:24px; font-weight:700; color:var(--text-primary,#1f2937); line-height:1.2; }
    .stat-sub { font-size:12px; color:var(--text-secondary,#6b7280); margin-top:2px; }

    /* ── Charts Row ── */
    .charts-row { display:grid; grid-template-columns:1.4fr 1fr; gap:20px; margin-bottom:24px; }
    .chart-card { min-height:300px; }

    /* Bar chart */
    .bar-chart { display:flex; align-items:flex-end; gap:12px; height:200px; padding:8px 0; }
    .bar-col { flex:1; display:flex; flex-direction:column; align-items:center; gap:6px; position:relative; }
    .bar-track { width:100%; height:180px; display:flex; align-items:flex-end; justify-content:center; }
    .bar-fill { width:70%; max-width:40px; min-height:4px; background:linear-gradient(180deg,#10b981,#059669); border-radius:6px 6px 0 0; transition:height .6s cubic-bezier(.4,0,.2,1); }
    .bar-label { font-size:11px; font-weight:600; color:var(--text-muted,#9ca3af); text-transform:uppercase; }
    .bar-tooltip { font-size:11px; font-weight:600; color:var(--text-primary,#1f2937); white-space:nowrap; opacity:0; transition:opacity .2s; }
    .bar-col:hover .bar-tooltip { opacity:1; }
    .bar-col:hover .bar-fill { background:linear-gradient(180deg,#34d399,#10b981); }

    /* Gauge */
    .gauge-wrap { display:flex; justify-content:center; margin-bottom:20px; }
    .gauge-ring { position:relative; width:120px; height:120px; }
    .gauge-ring svg { width:100%; height:100%; }
    .gauge-arc { transition:stroke-dasharray .8s ease; }
    .gauge-center { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; }
    .gauge-pct { font-size:26px; font-weight:700; color:var(--text-primary,#1f2937); line-height:1; }
    .gauge-lbl { font-size:11px; color:var(--text-muted,#9ca3af); font-weight:500; }

    /* Status bars */
    .status-bars { display:flex; flex-direction:column; gap:10px; }
    .sbar-head { display:flex; align-items:center; gap:6px; font-size:13px; color:var(--text-secondary,#6b7280); }
    .sbar-head strong { margin-left:auto; color:var(--text-primary,#1f2937); }
    .sbar-dot { width:8px; height:8px; border-radius:50%; }
    .sbar-green { background:#10b981; } .sbar-blue { background:#3b82f6; } .sbar-amber { background:#f59e0b; } .sbar-red { background:#ef4444; }
    .sbar-track { height:6px; background:#f3f4f6; border-radius:3px; overflow:hidden; }
    .sbar-fill { height:100%; border-radius:3px; transition:width .6s ease; }
    .sbar-fill-green { background:#10b981; } .sbar-fill-blue { background:#3b82f6; } .sbar-fill-amber { background:#f59e0b; } .sbar-fill-red { background:#ef4444; }

    /* ── Data Row ── */
    .data-row { display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:24px; }

    /* Mini table */
    .mini-table { font-size:13px; }
    .mini-table th { font-size:11px; text-transform:uppercase; letter-spacing:.05em; color:var(--text-muted,#9ca3af); }
    .clickable-row { cursor:pointer; transition:background .15s; }
    .clickable-row:hover { background:#f0f7ff; }
    .font-medium { font-weight:500; }

    /* ── Activity ── */
    .activity-list { list-style:none; padding:0; margin:0; }
    .activity-item { display:flex; align-items:flex-start; gap:12px; padding:14px 16px; border-bottom:1px solid var(--border-primary,#f3f4f6); }
    .activity-item:last-child { border-bottom:none; }
    .activity-icon { width:34px; height:34px; border-radius:50%; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
    .activity-icon-success { background:rgba(16,185,129,.12); color:#10b981; }
    .activity-icon-primary { background:rgba(59,130,246,.12); color:#3b82f6; }
    .activity-icon-warning { background:rgba(245,158,11,.12); color:#f59e0b; }
    .activity-icon-info { background:rgba(59,130,246,.12); color:#3b82f6; }
    .activity-icon-danger { background:rgba(239,68,68,.12); color:#ef4444; }
    .activity-content { flex:1; min-width:0; }
    .activity-title { font-weight:500; color:var(--text-primary,#1f2937); margin-bottom:2px; font-size:13px; }
    .activity-description { font-size:12px; color:var(--text-secondary,#6b7280); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
