@model DashboardViewModel
@{
    ViewData["Title"] = "Auditor Dashboard";
}

<partial name="~/Views/Shared/_Breadcrumbs.cshtml" model="@(new BreadcrumbViewModel { Items = new List<BreadcrumbViewModel.BreadcrumbItem> { new() { Label = "Dashboard", IsActive = true } } })" />

<div class="page-header">
    <div>
        <h1 class="page-title">Audit Dashboard</h1>
        <p class="text-muted">Financial overview and audit trail</p>
    </div>
</div>

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-icon" style="background: var(--emerald-light); color: var(--emerald);">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
        </div>
        <div class="stat-content">
            <p class="stat-label">Revenue MTD</p>
            <p class="stat-value">@(((decimal)ViewBag.TotalRevenueMTD).ToString("C"))</p>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background: var(--red-light); color: var(--red);">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>
        </div>
        <div class="stat-content">
            <p class="stat-label">Refunds MTD</p>
            <p class="stat-value">@(((decimal)ViewBag.TotalRefundsMTD).ToString("C"))</p>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background: var(--amber-light); color: var(--amber);">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
        </div>
        <div class="stat-content">
            <p class="stat-label">Adjustments MTD</p>
            <p class="stat-value">@(((decimal)ViewBag.TotalAdjustmentsMTD).ToString("C"))</p>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background: var(--purple-light); color: var(--purple);">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
        </div>
        <div class="stat-content">
            <p class="stat-label">Voided Invoices</p>
            <p class="stat-value">@ViewBag.VoidedInvoicesMTD</p>
        </div>
    </div>
</div>

<div class="grid-2">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Recent Activity Requiring Review</h3>
            <a asp-action="Index" asp-controller="AuditLogs" class="btn btn-ghost btn-sm">View All Logs</a>
        </div>
        <div class="card-body p-0">
            <ul class="activity-list">
                @foreach (var activity in Model.RecentActivity)
                {
                    <li class="activity-item">
                        <div class="activity-icon activity-icon-@activity.IconColor">
                            <partial name="~/Views/Shared/_NavIcon.cshtml" model="activity.Icon" />
                        </div>
                        <div class="activity-content">
                            <p class="activity-title">@activity.Title</p>
                            <p class="activity-description">@activity.Description</p>
                        </div>
                        <span class="activity-time">@activity.TimeAgo</span>
                    </li>
                }
            </ul>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Quick Reports</h3>
        </div>
        <div class="card-body">
            <div class="report-links">
                <a asp-action="Revenue" asp-controller="Reports" class="report-link">
                    <div class="report-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                    </div>
                    <div>
                        <p class="report-name">Revenue Report</p>
                        <p class="report-desc">Daily, weekly, monthly breakdown</p>
                    </div>
                </a>
                <a asp-action="Outstanding" asp-controller="Reports" class="report-link">
                    <div class="report-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                    </div>
                    <div>
                        <p class="report-name">Outstanding Balances</p>
                        <p class="report-desc">Aging report of unpaid invoices</p>
                    </div>
                </a>
                <a asp-action="Index" asp-controller="Adjustments" class="report-link">
                    <div class="report-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
                    </div>
                    <div>
                        <p class="report-name">Adjustments Summary</p>
                        <p class="report-desc">All discounts, refunds, write-offs</p>
                    </div>
                </a>
                <a asp-action="Index" asp-controller="AuditLogs" class="report-link">
                    <div class="report-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
                    </div>
                    <div>
                        <p class="report-name">Audit Logs</p>
                        <p class="report-desc">Complete activity trail</p>
                    </div>
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: var(--space-6);
    }
    .page-title {
        font-size: var(--text-2xl);
        font-weight: 600;
        color: var(--gray-900);
        margin-bottom: var(--space-1);
    }
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: var(--space-4);
        margin-bottom: var(--space-6);
    }
    .stat-card {
        display: flex;
        align-items: center;
        gap: var(--space-4);
        padding: var(--space-4);
        background: white;
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-sm);
    }
    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: var(--radius-md);
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .stat-label {
        font-size: var(--text-sm);
        color: var(--gray-500);
        margin-bottom: var(--space-1);
    }
    .stat-value {
        font-size: var(--text-2xl);
        font-weight: 600;
        color: var(--gray-900);
    }
    .grid-2 {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: var(--space-6);
    }
    @@media (max-width: 1024px) {
        .grid-2 { grid-template-columns: 1fr; }
    }
    .activity-list { list-style: none; padding: 0; margin: 0; }
    .activity-item {
        display: flex;
        align-items: flex-start;
        gap: var(--space-3);
        padding: var(--space-4);
        border-bottom: 1px solid var(--gray-100);
    }
    .activity-item:last-child { border-bottom: none; }
    .activity-icon {
        width: 36px;
        height: 36px;
        border-radius: var(--radius-full);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .activity-icon-success { background: var(--emerald-light); color: var(--emerald); }
    .activity-icon-primary { background: var(--blue-light); color: var(--blue); }
    .activity-icon-warning { background: var(--amber-light); color: var(--amber); }
    .activity-icon-info { background: var(--blue-light); color: var(--blue); }
    .activity-content { flex: 1; min-width: 0; }
    .activity-title { font-weight: 500; color: var(--gray-900); margin-bottom: 2px; }
    .activity-description { font-size: var(--text-sm); color: var(--gray-500); }
    .activity-time { font-size: var(--text-xs); color: var(--gray-400); white-space: nowrap; }
    .report-links { display: flex; flex-direction: column; gap: var(--space-2); }
    .report-link {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        padding: var(--space-3);
        border-radius: var(--radius-md);
        text-decoration: none;
        color: inherit;
        transition: background 0.15s;
    }
    .report-link:hover { background: var(--gray-50); }
    .report-icon {
        width: 40px;
        height: 40px;
        border-radius: var(--radius-md);
        background: var(--gray-100);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--gray-600);
    }
    .report-name { font-weight: 500; color: var(--gray-900); }
    .report-desc { font-size: var(--text-sm); color: var(--gray-500); }
</style>
