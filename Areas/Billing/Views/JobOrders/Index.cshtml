@model JobOrderListViewModel
@{
    ViewData["Title"] = "Job Orders";
}

<partial name="~/Views/Shared/_Breadcrumbs.cshtml" model="@(new BreadcrumbViewModel { Items = new List<BreadcrumbViewModel.BreadcrumbItem> { new() { Label = "Dashboard", Url = Url.Action("Index", "Dashboard") }, new() { Label = "Job Orders", IsActive = true } } })" />

<div class="page-header">
    <div>
        <h1 class="page-title">Job Orders</h1>
        <p class="page-subtitle">@Model.TotalCount total job orders</p>
    </div>
    <div class="page-actions">
        <a href="@Url.Action("Create", "JobOrders", new { area = "Billing" })" class="btn btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            New Job Order
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" style="margin-bottom: 20px; padding: 12px 16px; background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 8px; color: #065f46; font-size: 14px;">
        @TempData["Success"]
    </div>
}

<div class="card">
    <div class="card-header">
        <form method="get" class="filter-form">
            <div class="search-input-wrapper">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="search-icon"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                <input type="text" name="search" value="@Model.SearchTerm" placeholder="Search by JO number or customer..." class="form-input search-input" />
            </div>
            <select name="status" class="form-select" onchange="this.form.submit()">
                <option value="">All Statuses</option>
                @foreach (var s in Enum.GetValues<JobOrderStatus>())
                {
                    <option value="@s" selected="@(Model.StatusFilter == s)">@s</option>
                }
            </select>
            <button type="submit" class="btn btn-outline-primary">Filter</button>
        </form>
    </div>
    <div class="card-body p-0">
        @if (Model.JobOrders.Any())
        {
            <div class="table-container">
                <table class="table" style="table-layout: fixed;">
                    <colgroup>
                        <col style="width: 13%;" />
                        <col style="width: 22%;" />
                        <col style="width: 20%;" />
                        <col style="width: 13%;" />
                        <col style="width: 17%;" />
                        <col style="width: 15%;" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>JO Number</th>
                            <th>Customer</th>
                            <th>Device</th>
                            <th class="text-center">Status</th>
                            <th>Technician</th>
                            <th class="text-right">Created</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var jo in Model.JobOrders)
                        {
                            <tr class="clickable-row" onclick="window.location.href='@Url.Action("Details", "JobOrders", new { area = "Billing", id = jo.Id })'">
                                <td><span class="font-medium text-primary">@jo.JobNumber</span></td>
                                <td>
                                    <div class="customer-cell">
                                        <div class="avatar-sm">@jo.CustomerInitials</div>
                                        <span class="customer-name">@jo.CustomerName</span>
                                    </div>
                                </td>
                                <td><span class="text-truncate-cell">@jo.DeviceInfo</span></td>
                                <td class="text-center"><span class="badge @jo.StatusClass">@jo.StatusDisplay</span></td>
                                <td><span class="text-muted">@(jo.TechnicianName ?? "Unassigned")</span></td>
                                <td class="text-right"><span class="text-muted text-sm">@jo.CreatedAt.ToString("MMM dd, yyyy")</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <partial name="~/Views/Shared/_Pagination.cshtml" model="@(new PaginationViewModel { CurrentPage = Model.CurrentPage, TotalPages = Model.TotalPages, BaseUrl = Url.Action("Index") })" />
            }
        }
        else
        {
            <div class="empty-state">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="text-muted"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                <h3>No job orders found</h3>
                <p>@(string.IsNullOrEmpty(Model.SearchTerm) ? "Create your first job order to get started" : "Try a different search term")</p>
            </div>
        }
    </div>
</div>

<style>
    .page-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px; }
    .page-title { font-size: 24px; font-weight: 700; color: #1f2937; margin-bottom: 4px; }
    .page-subtitle { font-size: 14px; color: #6b7280; }
    .filter-form { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
    .search-input-wrapper { position: relative; flex: 1; min-width: 200px; }
    .search-icon { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #9ca3af; }
    .search-input { padding-left: 40px; min-width: 240px; }
    .customer-cell { display: flex; align-items: center; gap: 10px; }
    .avatar-sm { width: 32px; height: 32px; border-radius: 50%; background: linear-gradient(135deg, #6366f1, #8b5cf6); color: white; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 600; flex-shrink: 0; }
    .customer-name { font-weight: 500; color: #1f2937; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .text-truncate-cell { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block; color: #6b7280; font-size: 13px; }
    .text-primary { color: #3b82f6; }
    .font-medium { font-weight: 500; }
    .text-sm { font-size: 13px; }
    .clickable-row { cursor: pointer; transition: background-color 0.15s ease; }
    .clickable-row:hover { background-color: #f0f7ff; }
    .empty-state { text-align: center; padding: 60px 20px; color: #6b7280; }
    .empty-state h3 { margin: 16px 0 8px; color: #6b7280; font-size: 16px; }
    .empty-state p { font-size: 14px; }
    @@media (max-width: 768px) {
        .page-header { flex-direction: column; gap: 12px; }
        .filter-form { flex-direction: column; width: 100%; }
        .search-input { min-width: 100%; }
    }
</style>
