@model JobOrderListViewModel
@{
    ViewData["Title"] = "Job Orders";
}

<partial name="~/Views/Shared/_Breadcrumbs.cshtml" model="@(new BreadcrumbViewModel { Items = new List<BreadcrumbViewModel.BreadcrumbItem> { new() { Label = "Dashboard", Url = Url.Action("Index", "Dashboard") }, new() { Label = "Job Orders", IsActive = true } } })" />

<div class="page-header">
    <div>
        <h1 class="page-title">Job Orders</h1>
        <p class="page-subtitle">@Model.TotalCount total job orders</p>
    </div>
    <button class="btn btn-primary btn-sm" onclick="openAjaxModal('@Url.Action("CreateModal", "JobOrders", new { area = "Billing" })', 'New Job Order')" style="display: inline-flex; align-items: center; gap: 6px;">
        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
        New Job Order
    </button>
</div>

<!-- Stat Cards -->
<div class="stat-cards">
    <div class="stat-card">
        <div class="stat-icon bg-primary-light">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
        </div>
        <div class="stat-content">
            <span class="stat-value">@Model.TotalCount</span>
            <span class="stat-label">Total Job Orders</span>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon bg-warning-light">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>
        </div>
        <div class="stat-content">
            <span class="stat-value">@Model.InProgressCount</span>
            <span class="stat-label">In Progress</span>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon bg-success-light">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
        </div>
        <div class="stat-content">
            <span class="stat-value">@Model.CompletedCount</span>
            <span class="stat-label">Completed</span>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon bg-orange-light">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#f97316" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
        </div>
        <div class="stat-content">
            <span class="stat-value">@Model.PendingInvoicingCount</span>
            <span class="stat-label">Pending Invoicing</span>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <form method="get" class="filter-form">
            <div class="search-input-wrapper">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="search-icon"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                <input type="text" name="search" value="@Model.SearchTerm" placeholder="Search by JO number or customer..." class="form-input search-input" id="joSearch" />
            </div>
            <select name="status" class="form-select" id="joStatus">
                <option value="">All Statuses</option>
                @foreach (var s in Enum.GetValues<JobOrderStatus>())
                {
                    <option value="@s" selected="@(Model.StatusFilter == s)">@s</option>
                }
            </select>
            <noscript><button type="submit" class="btn btn-outline-primary">Filter</button></noscript>
        </form>
    </div>
    <div class="card-body p-0">
        @if (Model.JobOrders.Any())
        {
            <div class="table-container">
                <table class="table" style="table-layout: fixed;">
                    <colgroup>
                        <col style="width: 12%;" />
                        <col style="width: 20%;" />
                        <col style="width: 18%;" />
                        <col style="width: 11%;" />
                        <col style="width: 15%;" />
                        <col style="width: 12%;" />
                        <col style="width: 12%;" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>JO Number</th>
                            <th>Customer</th>
                            <th>Device</th>
                            <th class="text-center">Status</th>
                            <th>Technician</th>
                            <th class="text-right">Created</th>
                            <th class="text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var jo in Model.JobOrders)
                        {
                            <tr data-jobnumber="@jo.JobNumber.ToLower()" data-customer="@jo.CustomerName.ToLower()" data-device="@((jo.DeviceInfo ?? "").ToLower())" data-status="@jo.StatusDisplay" data-technician="@((jo.TechnicianName ?? "").ToLower())">
                                <td class="clickable-row" onclick="openAjaxModal('@Url.Action("DetailsModal", "JobOrders", new { area = "Billing", id = jo.Id })', 'Job Order — @jo.JobNumber')"><span class="font-medium text-primary">@jo.JobNumber</span></td>
                                <td class="clickable-row" onclick="openAjaxModal('@Url.Action("DetailsModal", "JobOrders", new { area = "Billing", id = jo.Id })', 'Job Order — @jo.JobNumber')">
                                    <div class="customer-cell">
                                        <div class="avatar-sm">@jo.CustomerInitials</div>
                                        <span class="customer-name">@jo.CustomerName</span>
                                    </div>
                                </td>
                                <td class="clickable-row" onclick="openAjaxModal('@Url.Action("DetailsModal", "JobOrders", new { area = "Billing", id = jo.Id })', 'Job Order — @jo.JobNumber')"><span class="text-truncate-cell">@jo.DeviceInfo</span></td>
                                <td class="text-center clickable-row" onclick="openAjaxModal('@Url.Action("DetailsModal", "JobOrders", new { area = "Billing", id = jo.Id })', 'Job Order — @jo.JobNumber')"><span class="status-indicator @jo.StatusClass">@jo.StatusDisplay</span></td>
                                <td class="clickable-row" onclick="openAjaxModal('@Url.Action("DetailsModal", "JobOrders", new { area = "Billing", id = jo.Id })', 'Job Order — @jo.JobNumber')"><span class="text-muted">@(jo.TechnicianName ?? "Unassigned")</span></td>
                                <td class="text-right clickable-row" onclick="openAjaxModal('@Url.Action("DetailsModal", "JobOrders", new { area = "Billing", id = jo.Id })', 'Job Order — @jo.JobNumber')"><span class="text-muted text-sm">@jo.CreatedAt.ToString("MMM dd, yyyy")</span></td>
                                <td>
                                    <div class="action-buttons">
                                        <button type="button" class="btn-action" title="Edit" onclick="event.stopPropagation(); openAjaxModal('@Url.Action("EditModal", "JobOrders", new { area = "Billing", id = jo.Id })', 'Edit Job Order')">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <partial name="~/Views/Shared/_Pagination.cshtml" model="@(new PaginationViewModel { CurrentPage = Model.CurrentPage, TotalPages = Model.TotalPages, TotalItems = Model.TotalCount, PageSize = Model.PageSize, BaseUrl = Url.Action("Index") })" />
            }
        }
        else
        {
            <div class="empty-state">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="text-muted"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                <h3>No job orders found</h3>
                <p>@(string.IsNullOrEmpty(Model.SearchTerm) ? "No job orders available yet" : "Try a different search term")</p>
            </div>
        }
    </div>
</div>

<style>
    .page-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px; }
    .page-title { font-size: 24px; font-weight: 700; color: #1f2937; margin-bottom: 4px; }
    .page-subtitle { font-size: 14px; color: #6b7280; }
    .stat-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px; }
    .stat-card { background: white; border: 1px solid #e5e7eb; border-radius: 12px; padding: 20px; display: flex; align-items: center; gap: 16px; }
    .stat-icon { width: 44px; height: 44px; border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .bg-primary-light { background: #eff6ff; }
    .bg-warning-light { background: #fffbeb; }
    .bg-success-light { background: #ecfdf5; }
    .bg-orange-light { background: #fff7ed; }
    .stat-content { display: flex; flex-direction: column; }
    .stat-value { font-size: 22px; font-weight: 700; color: #1f2937; }
    .stat-label { font-size: 13px; color: #6b7280; }
    .filter-form { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
    .search-input-wrapper { position: relative; flex: 1; min-width: 200px; }
    .search-icon { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #9ca3af; }
    .search-input { padding-left: 40px; min-width: 240px; }
    .customer-cell { display: flex; align-items: center; gap: 10px; }
    .avatar-sm { width: 32px; height: 32px; border-radius: 50%; background: linear-gradient(135deg, #6366f1, #8b5cf6); color: white; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 600; flex-shrink: 0; }
    .customer-name { font-weight: 500; color: #1f2937; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .text-truncate-cell { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block; color: #6b7280; font-size: 13px; }
    .text-primary { color: #3b82f6; }
    .font-medium { font-weight: 500; }
    .text-sm { font-size: 13px; }
    .clickable-row { cursor: pointer; transition: background-color 0.15s ease; }
    .clickable-row:hover { background-color: #f0f7ff; }
    .empty-state { text-align: center; padding: 60px 20px; color: #6b7280; }
    .empty-state h3 { margin: 16px 0 8px; color: #6b7280; font-size: 16px; }
    .empty-state p { font-size: 14px; }
    @@media (max-width: 768px) {
        .page-header { flex-direction: column; gap: 12px; }
        .filter-form { flex-direction: column; width: 100%; }
        .search-input { min-width: 100%; }
        .stat-cards { grid-template-columns: 1fr; }
    }
</style>

<script>
(function () {
    var search = document.getElementById('joSearch');
    var status = document.getElementById('joStatus');
    var tbody = document.querySelector('.table tbody');
    if (!search || !tbody) return;

    function filterRows() {
        var q = search.value.toLowerCase();
        var s = status ? status.value : '';
        var rows = tbody.querySelectorAll('tr');
        var visible = 0;
        rows.forEach(function (row) {
            if (!row.dataset.jobnumber) return;
            var matchSearch = !q || row.dataset.jobnumber.indexOf(q) > -1 || row.dataset.customer.indexOf(q) > -1 || row.dataset.device.indexOf(q) > -1 || row.dataset.technician.indexOf(q) > -1;
            var matchStatus = !s || row.dataset.status === s;
            row.style.display = matchSearch && matchStatus ? '' : 'none';
            if (matchSearch && matchStatus) visible++;
        });
        var empty = document.getElementById('joEmpty');
        if (!empty) { empty = document.createElement('div'); empty.id = 'joEmpty'; empty.className = 'empty-state'; empty.innerHTML = '<p>No job orders match your filter.</p>'; tbody.parentNode.parentNode.appendChild(empty); }
        empty.style.display = visible === 0 ? '' : 'none';
    }

    search.addEventListener('input', filterRows);
    status.addEventListener('change', filterRows);
})();
</script>