@model JobOrderDetailViewModel

<div class="modal-detail-body">
    <!-- Header with Status -->
    <div class="modal-detail-header">
        <div>
            <h3 class="modal-detail-name">@Model.OrderNumber</h3>
            <p class="modal-detail-sub">Created @Model.CreatedAt.ToString("MMMM d, yyyy 'at' h:mm tt")</p>
        </div>
        <div class="modal-detail-actions">
            <span class="status-indicator status-lg @Model.StatusClass">@Model.StatusDisplay</span>
        </div>
    </div>

    <!-- Two-Column Layout -->
    <div class="modal-detail-grid">
        <div class="modal-detail-main">
            <!-- Device Information -->
            <div class="modal-detail-section">
                <h4 class="modal-section-title">Device Information</h4>
                <dl class="modal-detail-grid-2col">
                    <div class="modal-detail-item">
                        <dt>Device</dt>
                        <dd>@Model.DeviceType</dd>
                    </div>
                    <div class="modal-detail-item">
                        <dt>Brand</dt>
                        <dd>@(Model.Brand ?? "—")</dd>
                    </div>
                    <div class="modal-detail-item">
                        <dt>Model</dt>
                        <dd>@(Model.DeviceModel ?? "—")</dd>
                    </div>
                    <div class="modal-detail-item">
                        <dt>Serial Number</dt>
                        <dd>@(Model.DeviceSerial ?? "Not provided")</dd>
                    </div>
                    <div class="modal-detail-item">
                        <dt>Priority</dt>
                        <dd>
                            @{
                                var priorityClass = (Model.Priority ?? "Normal") switch
                                {
                                    "Urgent" => "danger",
                                    "High" => "warning",
                                    "Normal" => "primary",
                                    "Low" => "secondary",
                                    _ => "secondary"
                                };
                            }
                            <span class="status-indicator status-@priorityClass">@(Model.Priority ?? "Normal")</span>
                        </dd>
                    </div>
                    @if (Model.EstimatedCompletionDate.HasValue)
                    {
                        <div class="modal-detail-item">
                            <dt>Est. Completion</dt>
                            <dd>@Model.EstimatedCompletionDate.Value.ToString("MMM d, yyyy")</dd>
                        </div>
                    }
                </dl>
            </div>

            <!-- Issue Description -->
            <div class="modal-detail-section">
                <h4 class="modal-section-title">Issue Description</h4>
                <p class="modal-detail-text">@Model.IssueDescription</p>
            </div>

            @if (!string.IsNullOrEmpty(Model.TechnicianNotes))
            {
                <div class="modal-detail-section">
                    <h4 class="modal-section-title">Technician Notes</h4>
                    <p class="modal-detail-text">@Model.TechnicianNotes</p>
                </div>
            }
        </div>

        <div class="modal-detail-sidebar">
            <!-- Customer -->
            <div class="modal-sidebar-card">
                <h5 class="modal-sidebar-title">Customer</h5>
                <p class="font-medium">@Model.CustomerName</p>
                <p class="text-sm text-muted">@Model.CustomerEmail</p>
                <p class="text-sm text-muted">@Model.CustomerPhone</p>
            </div>

            <!-- Assignment -->
            <div class="modal-sidebar-card">
                <h5 class="modal-sidebar-title">Assignment</h5>
                <p class="font-medium">@(Model.AssignedTechnicianName ?? "Unassigned")</p>
                @if (Model.EstimatedCompletionDate.HasValue)
                {
                    <p class="text-sm text-muted">Est. completion: @Model.EstimatedCompletionDate.Value.ToString("MMM d, yyyy")</p>
                }
            </div>

            <!-- Invoice Link -->
            @if (Model.InvoiceId.HasValue && Model.InvoiceId.Value > 0)
            {
                <div class="modal-sidebar-card">
                    <h5 class="modal-sidebar-title">Invoice</h5>
                    <a href="javascript:void(0)" class="btn btn-sm btn-outline-primary" style="width: 100%;"
                       onclick="closeAjaxModal(); setTimeout(function(){ openAjaxModal('@Url.Action("DetailsModal", "Invoices", new { area = "Billing", id = Model.InvoiceId })', 'Invoice Details'); }, 300);">
                        View Invoice
                    </a>
                </div>
            }

            <!-- Timeline -->
            @if (Model.Timeline.Any())
            {
                <div class="modal-sidebar-card">
                    <h5 class="modal-sidebar-title">Timeline</h5>
                    <div class="mini-timeline">
                        @foreach (var item in Model.Timeline)
                        {
                            <div class="mini-timeline-item">
                                <div class="mini-timeline-marker"></div>
                                <div class="mini-timeline-content">
                                    <p class="mini-timeline-title">@item.Title</p>
                                    <p class="mini-timeline-meta">@item.Timestamp.ToString("MMM d, h:mm tt")</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Services & Parts (full-width, outside grid) -->
    @if (Model.LineItems.Any())
    {
        <div class="modal-detail-section">
            <h4 class="modal-section-title">Services & Parts</h4>
            <div class="table-container">
                <table class="table table-compact" style="table-layout: auto;">
                    <thead>
                        <tr>
                            <th>Description</th>
                            <th>Type</th>
                            <th class="text-center">Qty</th>
                            <th class="text-right">Unit Price</th>
                            <th class="text-right">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.LineItems)
                        {
                            <tr>
                                <td>@item.Description</td>
                                <td><span class="status-indicator status-@(item.Type == "Service" ? "primary" : "muted")">@item.Type</span></td>
                                <td class="text-center">@item.Quantity</td>
                                <td class="text-right">₱@item.UnitPrice.ToString("N2")</td>
                                <td class="text-right">₱@item.Total.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="4" class="text-right"><strong>Subtotal</strong></td>
                            <td class="text-right">₱@Model.Subtotal.ToString("N2")</td>
                        </tr>
                        @if (Model.TaxAmount > 0)
                        {
                            <tr>
                                <td colspan="4" class="text-right" style="color: #6b7280;">Tax (@Model.TaxRate%)</td>
                                <td class="text-right">₱@Model.TaxAmount.ToString("N2")</td>
                            </tr>
                        }
                        <tr style="border-top: 2px solid #e5e7eb;">
                            <td colspan="4" class="text-right font-bold" style="font-size: 14px;"><strong>Total</strong></td>
                            <td class="text-right font-bold" style="font-size: 14px;"><strong>₱@Model.Total.ToString("N2")</strong></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    }
</div>

<div class="modal-form-footer">
    <button type="button" class="btn btn-ghost" onclick="closeAjaxModal()">Close</button>
</div>
