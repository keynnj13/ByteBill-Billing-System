@model PaymentCreateViewModel

<form id="paymentCreateForm" asp-action="Create" asp-controller="Payments" asp-area="Billing" method="post" data-ajax="true">
    @Html.AntiForgeryToken()

    <div class="modal-form-body">
        @if (Model.InvoiceId <= 0)
        {
            <!-- Invoice Selection -->
            <div class="form-section">
                <h4 class="form-section-title">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                    Select Invoice
                </h4>
                @if (Model.AvailableInvoices.Any())
                {
                    <div class="form-group">
                        <label class="form-label">Invoice <span class="required">*</span></label>
                        <select id="invoiceSelect" class="form-select" required>
                            <option value="">Select an unpaid invoice...</option>
                            @foreach (var inv in Model.AvailableInvoices)
                            {
                                <option value="@inv.InvoiceId">@inv.InvoiceNumber — @inv.CustomerName (Balance: &#8369;@inv.Balance.ToString("N2"))</option>
                            }
                        </select>
                    </div>
                    <p class="text-sm text-muted" style="margin-top: 8px;">Only unpaid or partially paid invoices are shown.</p>
                }
                else
                {
                    <div style="padding: 24px; text-align: center; color: #6b7280;">
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin: 0 auto 8px;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                        <p style="font-weight: 500;">No unpaid invoices available</p>
                        <p class="text-sm">All invoices are fully paid or there are no invoices yet.</p>
                    </div>
                }
            </div>
        }
        else
        {
            <!-- Invoice Reference (pre-selected) -->
            <div class="form-section">
                <h4 class="form-section-title">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                    Invoice Reference
                </h4>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Invoice</label>
                        <input type="text" class="form-input" value="@Model.InvoiceNumber" readonly style="background: #f9fafb;" />
                        <input type="hidden" asp-for="InvoiceId" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Customer</label>
                        <input type="text" class="form-input" value="@Model.CustomerName" readonly style="background: #f9fafb;" />
                    </div>
                </div>
                <div class="invoice-balance-box">
                    <span class="balance-label">Invoice Balance</span>
                    <span class="balance-amount">&#8369;@Model.InvoiceBalance.ToString("N2")</span>
                </div>
            </div>

            <!-- Payment Details -->
            <div class="form-section">
                <h4 class="form-section-title">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
                    Payment Details
                </h4>
                <div class="form-row" style="align-items: end;">
                    <div class="form-group">
                        <label asp-for="Amount" class="form-label">Amount <span class="required">*</span></label>
                        <div class="input-prefix-wrap">
                            <span class="input-prefix">&#8369;</span>
                            <input asp-for="Amount" type="number" step="0.01" class="form-input input-with-prefix" placeholder="0.00" />
                        </div>
                        <span asp-validation-for="Amount" class="field-error"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Payment Method</label>
                        <input type="text" class="form-input" value="Cash" readonly style="background: #f9fafb; cursor: default;" />
                        <input type="hidden" asp-for="Method" value="Cash" />
                    </div>
                </div>
            </div>

            <!-- Notes -->
            <div class="form-section">
                <h4 class="form-section-title">Additional</h4>
                <div class="form-group">
                    <label asp-for="Notes" class="form-label">Notes</label>
                    <textarea asp-for="Notes" class="form-input" rows="2" placeholder="Any payment notes..."></textarea>
                </div>
            </div>
        }
    </div>

    <div class="modal-form-footer">
        <button type="button" class="btn btn-ghost" onclick="closeAjaxModal()">Cancel</button>
        @if (Model.InvoiceId > 0)
        {
            <button type="submit" class="btn btn-primary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
                Record Payment
            </button>
        }
        else if (Model.AvailableInvoices.Any())
        {
            <button type="button" id="loadInvoiceBtn" class="btn btn-primary" disabled>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
                Load Invoice
            </button>
        }
    </div>
</form>

@if (Model.InvoiceId <= 0 && Model.AvailableInvoices.Any())
{
    <script>
    (function() {
        var select = document.getElementById('invoiceSelect');
        var loadBtn = document.getElementById('loadInvoiceBtn');
        if (!select || !loadBtn) return;

        select.addEventListener('change', function() {
            loadBtn.disabled = !this.value;
        });

        loadBtn.addEventListener('click', function() {
            var invoiceId = select.value;
            if (!invoiceId) return;
            var url = '@Url.Action("CreateModal", "Payments", new { area = "Billing" })' + '?invoiceId=' + invoiceId;
            openAjaxModal(url, 'Record Payment');
        });
    })();
    </script>
}

<style>
    .invoice-balance-box { display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; background: #fef3c7; border-radius: 8px; border: 1px solid #fde68a; margin-top: 4px; }
    .balance-label { font-size: 13px; color: #92400e; font-weight: 500; }
    .balance-amount { font-size: 18px; font-weight: 700; color: #92400e; }
</style>
