@using ByteBill_BS.Services
@{
    ViewData["Title"] = "Adjustments";
    var metrics = (AdjustmentMetricsDto)ViewBag.Metrics;
    var myRequests = (List<AdjustmentListItemDto>)ViewBag.Adjustments;
    var invoices = (IEnumerable<dynamic>)ViewBag.Invoices;
    var typeConfigs = (List<AdjustmentTypeConfigDto>)ViewBag.TypeConfigs;
}

<partial name="~/Views/Shared/_Breadcrumbs.cshtml" model="@(new BreadcrumbViewModel { Items = new List<BreadcrumbViewModel.BreadcrumbItem> { new() { Label = "Dashboard", Url = Url.Action("Index", "Dashboard") }, new() { Label = "Adjustments", IsActive = true } } })" />

<div class="page-header" style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px;">
    <div>
        <h1 class="page-title">Adjustments</h1>
        <p class="page-subtitle">Request billing adjustments for admin approval</p>
    </div>
    <button class="btn btn-primary btn-sm" id="openRequestModal" style="display: inline-flex; align-items: center; gap: 6px;">
        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
        Request Adjustment
    </button>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" style="margin-bottom: 20px; padding: 12px 16px; background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 8px; color: #065f46; font-size: 14px;">
        @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" style="margin-bottom: 20px; padding: 12px 16px; background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; color: #991b1b; font-size: 14px;">
        @TempData["Error"]
    </div>
}

<!-- Stat Cards -->
<div class="bil-adj-stats" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 16px; margin-bottom: 20px;">
    <div class="bil-adj-stat-card pending">
        <div class="bil-adj-stat-icon">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <div class="bil-adj-stat-info">
            <span class="bil-adj-stat-count">@metrics.Pending</span>
            <span class="bil-adj-stat-label">Pending</span>
        </div>
    </div>
    <div class="bil-adj-stat-card approved">
        <div class="bil-adj-stat-icon">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <div class="bil-adj-stat-info">
            <span class="bil-adj-stat-count">@metrics.Approved</span>
            <span class="bil-adj-stat-label">Approved</span>
        </div>
    </div>
    <div class="bil-adj-stat-card rejected">
        <div class="bil-adj-stat-icon">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <div class="bil-adj-stat-info">
            <span class="bil-adj-stat-count">@metrics.Rejected</span>
            <span class="bil-adj-stat-label">Rejected</span>
        </div>
    </div>
</div>

<!-- My Requests Table -->
<div class="card">
    <div class="card-body" style="padding: 0;">
        <div style="padding: 20px 24px 12px;">
            <h3 class="bil-adj-section-title">My Adjustment Requests</h3>
        </div>

        @if (myRequests.Count == 0)
        {
            <div style="padding: 40px 24px; text-align: center;">
                <svg width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: #9ca3af; margin: 0 auto 12px;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                <p style="color: #6b7280; font-weight: 600;">No requests yet</p>
                <p style="color: #9ca3af; font-size: 14px;">Click "Request Adjustment" to submit your first request.</p>
            </div>
        }
        else
        {
            <div class="table-container">
                <table class="table">
                    <thead>
                        <tr>
                            <th>TYPE</th>
                            <th>INVOICE</th>
                            <th>CUSTOMER</th>
                            <th class="text-right">AMOUNT</th>
                            <th>REASON</th>
                            <th>STATUS</th>
                            <th>SUBMITTED</th>
                            <th>REVIEWED BY</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var req in myRequests)
                        {
                            var badgeClass = req.AdjustmentType == "Credit" ? "status-info" : req.AdjustmentType == "Refund" ? "status-warning" : "status-purple";
                            var statusClass = req.Status == "Approved" ? "bil-adj-badge-approved"
                                            : req.Status == "Rejected" ? "bil-adj-badge-rejected"
                                            : "bil-adj-badge-pending";
                            var isCredit = req.AdjustmentType is "Credit" or "Refund";
                            <tr>
                                <td><span class="status-indicator @badgeClass">@req.AdjustmentType</span></td>
                                <td><span class="bil-adj-inv-link">@req.InvoiceNumber</span></td>
                                <td><span class="bil-adj-customer">@req.CustomerName</span></td>
                                <td class="text-right"><span class="@(isCredit ? "bil-adj-amount-credit" : "bil-adj-amount-debit")">@(isCredit ? "−" : "+")₱@req.Amount.ToString("N2")</span></td>
                                <td><span class="bil-adj-reason" title="@req.Reason">@(req.Reason.Length > 40 ? req.Reason[..37] + "..." : req.Reason)</span></td>
                                <td><span class="bil-adj-badge @statusClass">@req.Status</span></td>
                                <td><span class="bil-adj-date">@req.CreatedAt.ToString("MMM dd, yyyy h:mm tt")</span></td>
                                <td><span class="bil-adj-reviewer">@(req.ReviewedBy ?? "—")</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Request Adjustment Modal -->
<div class="bil-adj-overlay" id="requestOverlay"></div>
<div class="bil-adj-modal" id="requestModal">
    <div class="bil-adj-modal-header">
        <h3 class="bil-adj-modal-title">Request Adjustment</h3>
        <button type="button" class="bil-adj-modal-close" id="closeRequestModal">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
    </div>
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="bil-adj-modal-body">
            <p class="bil-adj-modal-desc">Submit an adjustment request for admin review. The admin will be notified and must approve before the adjustment is applied.</p>

            <div class="form-group" style="margin-bottom: 16px;">
                <label class="form-label">Invoice <span style="color: var(--destructive);">*</span></label>
                <select name="InvoiceId" id="invoiceSelect" class="form-input" required>
                    <option value="" data-balance="0">Select an invoice...</option>
                    @foreach (var inv in invoices)
                    {
                        <option value="@inv.InvoiceId" data-balance="@((inv.Balance as decimal?).GetValueOrDefault())">@inv.InvoiceNo — @inv.CustomerName (₱@((inv.Balance as decimal?).GetValueOrDefault().ToString("N2")))</option>
                    }
                </select>
            </div>

            <div class="form-group" style="margin-bottom: 16px;">
                <label class="form-label">Adjustment Type <span style="color: var(--destructive);">*</span></label>
                <select name="AdjustmentType" id="adjTypeSelect" class="form-input" required>
                    <option value="" data-pct="0" data-cat="">Select type...</option>
                    @foreach (var tc in typeConfigs)
                    {
                        <option value="@tc.Category" data-pct="@tc.Percentage" data-cat="@tc.Category" data-name="@tc.Name">@tc.Name (@tc.Percentage%)</option>
                    }
                </select>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
                <div class="form-group">
                    <label class="form-label">Percentage</label>
                    <input type="text" id="adjPctDisplay" class="form-input" readonly style="background: #f9fafb; color: #6b7280;" />
                </div>
                <div class="form-group">
                    <label class="form-label">Amount (₱) <span style="color: var(--destructive);">*</span></label>
                    <input type="number" name="Amount" id="adjAmountInput" class="form-input" placeholder="0.00" min="0.01" step="0.01" required />
                </div>
            </div>

            <!-- Refund Extra Fields (hidden by default) -->
            <div id="refundFields" style="display: none; margin-bottom: 16px;">
                <div style="background: #fef3c7; border: 1px solid #fcd34d; border-radius: 8px; padding: 12px 16px; margin-bottom: 12px;">
                    <p style="font-size: 12px; font-weight: 600; color: #92400e; margin: 0;">Refund requires additional information</p>
                </div>
                <div class="form-group" style="margin-bottom: 12px;">
                    <label class="form-label">Refund Reason Category <span style="color: var(--destructive);">*</span></label>
                    <select name="RefundCategory" id="refundCategorySelect" class="form-input">
                        <option value="">Select reason...</option>
                        <option value="Unit Damage">Unit Damage During Repair</option>
                        <option value="Misdiagnosis">Misdiagnosis</option>
                        <option value="Service Not Rendered">Service Not Rendered</option>
                        <option value="Overcharge">Overcharge</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
                <div class="form-group" style="margin-bottom: 12px;">
                    <label class="form-label">Detailed Explanation</label>
                    <textarea name="RefundExplanation" class="form-input" rows="2" placeholder="Provide details about the refund reason..."></textarea>
                </div>
            </div>

            <div class="form-group" style="margin-bottom: 16px;">
                <label class="form-label">Reason <span style="color: var(--destructive);">*</span></label>
                <textarea name="Reason" class="form-input" rows="3" placeholder="Explain why this adjustment is needed..." required></textarea>
            </div>

            <div class="bil-adj-notice">
                <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                <span>This request will be sent to an admin for approval. You'll be notified once it's reviewed.</span>
            </div>
        </div>
        <div class="bil-adj-modal-footer">
            <button type="button" class="btn btn-outline btn-sm" id="cancelRequestModal">Cancel</button>
            <button type="submit" class="btn btn-primary btn-sm" style="display: inline-flex; align-items: center; gap: 6px;">
                <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path></svg>
                Submit Request
            </button>
        </div>
    </form>
</div>

<style>
    .bil-adj-stat-card { display: flex; align-items: center; gap: 14px; padding: 18px 20px; border-radius: 12px; border: 1px solid var(--gray-border); background: var(--card); }
    .bil-adj-stat-card .bil-adj-stat-icon { display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 10px; }
    .bil-adj-stat-card.pending  .bil-adj-stat-icon { background: rgba(245,176,65,0.12); color: #d97706; }
    .bil-adj-stat-card.approved .bil-adj-stat-icon { background: rgba(16,185,129,0.12); color: #059669; }
    .bil-adj-stat-card.rejected .bil-adj-stat-icon { background: rgba(239,68,68,0.12);  color: #dc2626; }
    .bil-adj-stat-card .bil-adj-stat-info { display: flex; flex-direction: column; }
    .bil-adj-stat-card .bil-adj-stat-count { font-size: 22px; font-weight: 700; color: #1f2937; line-height: 1.1; }
    .bil-adj-stat-card .bil-adj-stat-label { font-size: 13px; color: #6b7280; font-weight: 500; }
    .bil-adj-stat-card.pending  .bil-adj-stat-count { color: #d97706; }
    .bil-adj-stat-card.approved .bil-adj-stat-count { color: #059669; }
    .bil-adj-stat-card.rejected .bil-adj-stat-count { color: #dc2626; }
    .bil-adj-section-title { font-size: 16px; font-weight: 600; color: #1f2937; margin: 0; }
    .bil-adj-inv-link { color: #3b82f6; font-weight: 500; font-size: 13px; }
    .bil-adj-customer { font-weight: 600; color: #1f2937; font-size: 13px; }
    .bil-adj-reason { color: #374151; font-size: 13px; max-width: 220px; display: inline-block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .bil-adj-date { color: #6b7280; font-size: 13px; white-space: nowrap; }
    .bil-adj-reviewer { color: #6b7280; font-size: 13px; }
    .bil-adj-amount-credit { color: #059669; font-weight: 600; font-size: 13px; }
    .bil-adj-amount-debit  { color: #dc2626; font-weight: 600; font-size: 13px; }
    /* Status Text Highlight */
    .bil-adj-badge { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 12px; font-weight: 600; letter-spacing: 0.02em; }
    .bil-adj-badge-pending  { background: rgba(245,176,65,0.12); color: #d97706; }
    .bil-adj-badge-approved { background: rgba(16,185,129,0.12); color: #059669; }
    .bil-adj-badge-rejected { background: rgba(239,68,68,0.12);  color: #dc2626; }
    .bil-adj-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.45); z-index: 9998; }
    .bil-adj-overlay.active { display: block; }
    .bil-adj-modal { display: none; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 520px; max-width: 95vw; max-height: 90vh; overflow-y: auto; background: var(--card); border: 1px solid var(--gray-border); border-radius: var(--radius-lg); box-shadow: var(--shadow-modal); z-index: 9999; }
    .bil-adj-modal.active { display: block; }
    .bil-adj-modal-header { display: flex; align-items: center; justify-content: space-between; padding: 20px 24px; border-bottom: 1px solid var(--gray-border); }
    .bil-adj-modal-title { font-size: 18px; font-weight: 700; color: #1f2937; margin: 0; }
    .bil-adj-modal-close { background: none; border: none; cursor: pointer; padding: 4px; border-radius: 6px; color: var(--gray-500); }
    .bil-adj-modal-close:hover { background: var(--gray-light); }
    .bil-adj-modal-body { padding: 24px; }
    .bil-adj-modal-desc { font-size: 13px; color: #6b7280; margin-bottom: 20px; line-height: 1.5; }
    .bil-adj-notice { display: flex; align-items: flex-start; gap: 10px; padding: 12px 16px; border-radius: 8px; background: rgba(59,130,246,0.08); color: #2563eb; font-size: 13px; line-height: 1.5; }
    .bil-adj-modal-footer { display: flex; justify-content: flex-end; gap: 10px; padding: 16px 24px; border-top: 1px solid var(--gray-border); }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const openBtn   = document.getElementById('openRequestModal');
        const closeBtn  = document.getElementById('closeRequestModal');
        const cancelBtn = document.getElementById('cancelRequestModal');
        const modal     = document.getElementById('requestModal');
        const overlay   = document.getElementById('requestOverlay');

        function openModal()  { modal.classList.add('active'); overlay.classList.add('active'); }
        function closeModal() { modal.classList.remove('active'); overlay.classList.remove('active'); }

        openBtn.addEventListener('click', openModal);
        closeBtn.addEventListener('click', closeModal);
        cancelBtn.addEventListener('click', closeModal);
        overlay.addEventListener('click', closeModal);

        // ── Auto-compute amount from percentage × invoice balance ──
        const invoiceSelect = document.getElementById('invoiceSelect');
        const adjTypeSelect = document.getElementById('adjTypeSelect');
        const adjAmountInput = document.getElementById('adjAmountInput');
        const adjPctDisplay = document.getElementById('adjPctDisplay');
        const refundFields = document.getElementById('refundFields');
        const refundCategorySelect = document.getElementById('refundCategorySelect');

        function computeAmount() {
            const invOpt = invoiceSelect.selectedOptions[0];
            const typeOpt = adjTypeSelect.selectedOptions[0];
            const balance = parseFloat(invOpt?.dataset.balance || '0');
            const pct = parseFloat(typeOpt?.dataset.pct || '0');
            const cat = typeOpt?.dataset.cat || '';

            adjPctDisplay.value = pct > 0 ? pct + '%' : '—';

            if (pct > 0 && balance > 0) {
                adjAmountInput.value = (balance * pct / 100).toFixed(2);
            }

            // Show/hide refund fields
            if (cat === 'Refund') {
                refundFields.style.display = 'block';
                refundCategorySelect.setAttribute('required', 'required');
            } else {
                refundFields.style.display = 'none';
                refundCategorySelect.removeAttribute('required');
            }
        }

        invoiceSelect.addEventListener('change', computeAmount);
        adjTypeSelect.addEventListener('change', computeAmount);
    });

    setInterval(function() {
        if (document.querySelector('.modal:not(.hidden)') || document.activeElement?.tagName === 'INPUT' || document.activeElement?.tagName === 'TEXTAREA' || document.activeElement?.tagName === 'SELECT') return;
        location.reload();
    }, 30000);
</script>
